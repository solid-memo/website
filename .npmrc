# No package runs code of its own when it is installed
# (docs/vendor-code.md#installing).
ignore-scripts=true

# npm resolves a package only to a version that has been public for 3 days,
# the wait renovate.json5's minimumReleaseAge sets on the version an update
# names (GOVERNANCE.md#dependency-updates). Renovate's wait covers only that
# version: this one covers every other package the update newly resolves
# into package-lock.json, whoever runs npm install. npm ci installs what
# package-lock.json already holds, whatever its age.
min-release-age=3
