# TLS for a signed-in instance (compose.tls.yml), with Caddy's own CA: no port 80,
# no attempt to install the CA. The names under localhost are for
# node-solid-server, which keeps each account's pod on a subdomain.
{
	auto_https disable_redirects
	skip_install_trust
	default_sni 127.0.0.1
	admin off
}

https://127.0.0.1:{$E2E_PORT}, https://localhost:{$E2E_PORT}, https://alice.localhost:{$E2E_PORT}, https://stranger.localhost:{$E2E_PORT} {
	tls internal
	reverse_proxy 127.0.0.1:{$E2E_UPSTREAM}
}
