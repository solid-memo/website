{
  "name": "@solid-memo/e2e-journeys",
  "description": "Solid Memo's user journeys: the built app in Chromium, Firefox, WebKit and on a phone, driven by Playwright against a Solid server.",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run -c vitest.unit.config.ts",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:journeys": "playwright test",
    "journeys:ui": "playwright test --ui",
    "journeys:headed": "playwright test --headed",
    "journeys:report": "playwright show-report",
    "screenshots": "playwright test -c screenshots.config.ts",
    "browsers": "playwright install --with-deps chromium firefox webkit",
    "css": "node harness/cssServer.ts",
    "css:prepare": "node harness/cssServer.ts prepare",
    "css:clean": "node harness/cssServer.ts clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "happy-dom": "^21.0.4"
  },
  "dependencies": {
    "@solid-memo/studio": "*",
    "@solid-memo/ui": "*"
  }
}
