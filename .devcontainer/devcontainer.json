{
  "name": "Solid Memo",
  // The image's own version, then Node's: Node 26, as CI runs (.nvmrc), at
  // 26.13 or later, which engines asks for. The digest fixes the image;
  // Renovate keeps it up to date on Node 26, and a person merges each
  // update (renovate.json5).
  // Turbo is the root devDependency, run through npm's scripts or npx.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5.2.6-26-bookworm@sha256:621f218f22c2ad132a715c26f64b13bfe030ada64d64d6dcaa50a5dbcbcb3203",

  // Each feature runs as root while the container is built. It's named by
  // its major version, and devcontainer-lock.json pins it by digest: the
  // dev container CLI fetches that digest and checks it, so a tag pushed
  // again changes nothing. Renovate proposes a new major version but
  // doesn't update the lock file, so its pull request fails CI until a
  // person locks the new version (`devcontainer upgrade`) and merges it.
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    // Docker for the end-to-end tests' servers (`npm run test:pod`, `npm
    // run journeys`), which ask for Docker Engine 28.3.3 or later
    // (docs/testing.md).
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    // Python for pySHACL's cross-check (`npm run crosscheck`), the version
    // CI runs it on.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.15"
    }
  },

  "customizations": {
    "vscode": {
      // As .vscode/extensions.json recommends.
      "extensions": [
        "anthropic.claude-code",
        "biomejs.biome",
        "vitest.explorer",
        "typescriptteam.native-preview",
        "stardog-union.stardog-rdf-grammars"
      ],
      "settings": {
        "editor.formatOnSave": false
      }
    }
  },

  "forwardPorts": [
    4173,
    5173
  ],

  // Chromium for the user journeys (`npm run journeys`), and for the docs'
  // diagrams that `npm run check` and `npm run build` draw: the full browser
  // it installs includes the headless shell `npm run browsers` would.
  "postCreateCommand": "npm ci && pip install -r scripts/requirements-ci.txt && npm run browsers -w @solid-memo/e2e-journeys",

  "remoteUser": "node"
}
