{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
        // Every action from outside the repository is pinned to a commit,
        // with its version after it (`@<sha> # vX.Y.Z`): a tag can be
        // moved to other code, a commit cannot. Renovate updates both, and
        // npm run check:actions refuses a `uses:` that is not pinned.
        'helpers:pinGitHubActionDigests',
    ],
    baseBranchPatterns: [
        'main',
    ],
    // An update is merged through a pull request once CI's ci-ok check
    // passes, as anyone's change is (docs/testing.md#continuous-integration):
    // the pull request is where the update's commit links to.
    automerge: true,
    automergeType: 'pr',
    // An update is proposed only once its version has been public for 3
    // days, so that the registry and the package's users have time to
    // find a bad or malicious version and pull it before it reaches main
    // unreviewed (GOVERNANCE.md#dependency-updates), where the release
    // job holds the deploy key (docs/releasing.md#the-deploy-key).
    // 'strict' makes no branch, and so no pull request, before then. This
    // wait is on the version an update names: the .npmrc files'
    // min-release-age and uv.toml's exclude-newer hold every package npm
    // or uv newly locks to the same 3 days. A security update is proposed
    // at once: Renovate's vulnerabilityAlerts lift the age by default, and
    // say so here too, should that default change. npm and uv still lock
    // no version younger than 3 days, so a maintainer locks such a fix by
    // hand.
    minimumReleaseAge: '3 days',
    internalChecksFilter: 'strict',
    vulnerabilityAlerts: {
        minimumReleaseAge: null,
    },
    // Its pull requests and its Dependency Dashboard carry the dependencies
    // label, so that dependency updates can be filtered in, or out, of the
    // issue and pull request lists.
    labels: ['dependencies'],
    dependencyDashboardLabels: ['dependencies'],
    // Its commits follow Conventional Commits, as everyone's do
    // (CONTRIBUTING.md#commit-messages): config:recommended's
    // :semanticPrefixFixDepsChoreOthers makes an update of what the app
    // needs at run time (dependencies) fix(deps):, which semantic-release
    // releases as a patch, and every other update (devDependencies, the
    // workflows' actions, the end-to-end tests', below) chore(deps):,
    // which releases nothing (docs/releasing.md).
    semanticCommits: 'enabled',
    // Each commit says what it updates, from what to what, where, and why,
    // and where its source and release notes are: the commit is the record
    // of the decision (docs/standard-for-public-code.md, criterion 6), and
    // its pull request has the notes in full.
    commitBody: '{{#each upgrades}}{{#if (equals updateType \'lockFileMaintenance\')}}{{#if (equals manager \'pip-compile\')}}- {{{packageFile}}}, compiled again: every package its pins need to the newest version they allow (lock file maintenance)\n{{else}}- package-lock.json: every dependency to the newest version its range allows (lock file maintenance)\n{{/if}}{{else}}- {{{depName}}} {{{displayFrom}}} → {{{displayTo}}} ({{{updateType}}}{{#if depType}}, {{{depType}}}{{/if}}) in {{{packageFile}}}{{#if sourceUrl}}; source and release notes: {{{sourceUrl}}}{{/if}}\n{{/if}}{{/each}}\nWhy: renovate.json5 keeps every dependency current, within the versions it allows, so that fixes arrive while they are small; the update was merged only after CI passed on it.',
    // The Python tools CI installs are pinned in scripts/requirements-*.in
    // and compiled by `uv pip compile`, with what they need and every
    // file's hash, into the requirements-*.txt pip installs
    // (docs/testing.md#the-workflows): Renovate bumps a pin and compiles
    // its .txt again. pip_requirements would bump a .txt alone and leave
    // its hashes stale, so it is off; these are the only requirements
    // files. A bump moves only the pins: on the first of each month,
    // Renovate compiles both files again, so that the packages the tools
    // need get their fixes too. That moves every package at once, so a
    // person merges it, after reading what moved. A compile, Renovate's or
    // a person's, locks no version younger than 3 days (uv.toml).
    'pip-compile': {
        managerFilePatterns: ['/^scripts/requirements-[a-z]+\\.txt$/'],
        lockFileMaintenance: {
            enabled: true,
            schedule: ['* 0-3 1 * *'],
            automerge: false,
        },
    },
    pip_requirements: {
        enabled: false,
    },
    // Every Monday, Renovate locks the packages in each package-lock.json
    // again, to the newest version each range allows, so that the packages
    // the dependencies need get their fixes too: an update moves only the
    // packages it names, and what they need stays as first locked. That
    // moves every package at once, so a person merges it, after reading
    // what moved. npm locks no version younger than 3 days (.npmrc). It
    // moves what the app runs, so it is fix(deps):, and is released. Its
    // branch is its own: on the default one, the monthly pip-compile run
    // would join it every Monday.
    npm: {
        lockFileMaintenance: {
            enabled: true,
            branchTopic: 'npm-lock-file-maintenance',
            commitMessageExtra: '(npm)',
            schedule: ['* 0-3 * * 1'],
            automerge: false,
            semanticCommitType: 'fix',
        },
    },
    customManagers: [
        // A tool a workflow downloads, its version after a comment that
        // names it (`# renovate: datasource=github-release-attachments
        // depName=<owner>/<repo>`), and the SHA-256 of the file it
        // downloads after that (`<NAME>_SHA256:`), which the workflow
        // checks the file against: github-release-attachments finds the
        // file of the current version by that hash, and writes the same
        // file's hash in the new version with it (npm run check:actions).
        {
            customType: 'regex',
            managerFilePatterns: ['/^\\.github/(workflows|actions)/.+\\.ya?ml$/'],
            matchStrings: [
                '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+: (?<currentValue>\\S+)\\s+[A-Z_]+_SHA256: (?<currentDigest>[0-9a-f]{64})',
            ],
        },
        // The commit of Solid-Nextcloud its end-to-end tests' image builds,
        // as the branch its Dockerfile names moves on.
        {
            customType: 'regex',
            managerFilePatterns: ['/^e2e/pod/servers/nextcloud/Dockerfile$/'],
            matchStrings: [
                '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\nARG SOLID_NEXTCLOUD_SHA=(?<currentDigest>[0-9a-f]{40})',
            ],
        },
    ],
    packageRules: [
        // A new version of a package.json dependency raises its range to
        // that version (^11.0.0 to ^11.1.0), even where the range already
        // allows it: each update is then a pull request of its own, and no
        // older version can be locked again. Left to choose, Renovate
        // proposed no update a range already allows for the workspace
        // packages, so their lockfile stayed on the versions first locked.
        // The pins below keep their own strategy.
        {
            matchManagers: ['npm'],
            matchDepTypes: ['dependencies', 'devDependencies', 'optionalDependencies'],
            rangeStrategy: 'bump',
        },
        // The end-to-end tests run against two majors of each Solid server,
        // each pinned in e2e/pod/servers/ (docs/testing.md): each stays on
        // its major, the Community Solid Server's in its compose file,
        // node-solid-server's in the lockfile its image is built from.
        // Its tags are versions, and 8's are prereleases: read as semver.
        {
            matchDepNames: ['solidproject/community-server'],
            versioning: 'semver',
        },
        {
            matchFileNames: ['e2e/pod/servers/css-6/compose.yml'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '<7',
        },
        // css-acp runs css-7's release with Access Control Policies.
        {
            matchFileNames: ['e2e/pod/servers/css-7/compose.yml', 'e2e/pod/servers/css-acp/Dockerfile'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '<8',
        },
        // The user journeys log in to 7 (e2e/journeys/css/compose.yml).
        {
            matchFileNames: ['e2e/journeys/css/compose.yml'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '<8',
        },
        // The advisory 8 follows its alphas to 8.0.0 (docs/testing.md).
        {
            matchFileNames: ['e2e/pod/servers/css-8/compose.yml'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '>=8.0.0-0 <9',
            ignoreUnstable: false,
        },
        {
            matchFileNames: ['e2e/pod/servers/nss/5/package.json'],
            matchDepNames: ['solid-server'],
            allowedVersions: '<6',
        },
        // Its image runs both node-solid-server majors: Node 24, the
        // newest both support.
        {
            matchFileNames: ['e2e/pod/servers/nss/Dockerfile'],
            matchDepNames: ['node'],
            allowedVersions: '<25',
        },
        // The dev container's image keeps to Node 24, as .nvmrc and CI do.
        // Its tags put the image's own version first and Node's after it
        // (5.2.3-24-bookworm), so the rule matches the tag's end: a range
        // such as '<25' matches none of them.
        {
            matchFileNames: ['.devcontainer/devcontainer.json'],
            matchDepNames: ['mcr.microsoft.com/devcontainers/typescript-node'],
            allowedVersions: '/-24-bookworm$/',
        },
        // Pivot's image keeps to Node 22, which Pivot's own CI runs.
        {
            matchFileNames: ['e2e/pod/servers/pivot/Dockerfile'],
            matchDepNames: ['node'],
            allowedVersions: '<23',
        },
        // Solid-Nextcloud's app is tested on Nextcloud 31 to 35, but only 31
        // and 32 must pass its CI.
        {
            matchFileNames: ['e2e/pod/servers/nextcloud/Dockerfile'],
            matchDepNames: ['nextcloud'],
            allowedVersions: '<33',
        },
        // The JavaScript Solid Server's image keeps to Node 24. Its tag names
        // the Alpine release too (alpine3.24), and Renovate keeps to it: the
        // move to the next Alpine release is a person's change.
        {
            matchFileNames: ['e2e/pod/servers/jss/Dockerfile'],
            matchDepNames: ['node'],
            allowedVersions: '<25',
        },
        // The Community Solid Server's tags are pushed again now and then:
        // a new digest for the same version is for a person to look at.
        {
            matchDepNames: ['solidproject/community-server'],
            matchUpdateTypes: ['digest'],
            automerge: false,
        },
        // An action runs in the workflows' jobs, and some of those hold the
        // deploy key and other secrets (docs/releasing.md#the-deploy-key):
        // a person merges every update to one, after reading what it
        // changes (GOVERNANCE.md#dependency-updates). A new digest under
        // the same version means its tag was moved, the case pinning to a
        // commit is for, and the 3-day wait cannot tell, since the date
        // Renovate reads comes with the tag. scripts/renovateConfig.test.ts
        // checks that no rule merges one on its own.
        {
            matchManagers: ['github-actions'],
            automerge: false,
        },
        // A tool a workflow downloads is checked against the hash its
        // update writes, and that hash is read from the same release as
        // the file: a person merges the update, after reading the release.
        // A file replaced in the release no longer matches the committed
        // hash, so the step fails until a person looks at it.
        {
            matchDatasources: ['github-release-attachments'],
            automerge: false,
        },
        // Playwright and the browser it downloads move together: one pinned
        // version, @playwright/test's in e2e/journeys/package.json and
        // playwright's in packages/site/package.json (one group, as a
        // monorepo's packages), which CI keys its browser caches by.
        {
            matchDepNames: ['@playwright/test', 'playwright'],
            rangeStrategy: 'pin',
        },
        // Mermaid draws the docs' diagrams (docs/markdown.md): pinned, and
        // bumped apart from Playwright, so a change in the drawings comes
        // from one of them at a time.
        {
            matchDepNames: ['mermaid'],
            rangeStrategy: 'pin',
        },
        // The end-to-end tests' packages and servers ship nothing to users,
        // even what they list as dependencies: chore(deps):, no release.
        {
            matchFileNames: ['e2e/**'],
            semanticCommitType: 'chore',
        },
        // The release's preset keeps to 9: 10 needs conventional-changelog-writer
        // 9, and the release notes generator semantic-release ships uses 8
        // (scripts/releaseConfig.test.ts fails on a preset it cannot render).
        // Lift this once it uses 9.
        {
            matchFileNames: ['package.json'],
            matchDepNames: ['conventional-changelog-conventionalcommits'],
            allowedVersions: '<10',
        },
        // The images the end-to-end tests build themselves are in no registry.
        {
            matchDepNames: ['/^localhost\\//'],
            enabled: false,
        },
    ],
}