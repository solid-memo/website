{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
    ],
    baseBranchPatterns: [
        'main',
    ],
    // An update is merged through a pull request once CI's ci-ok check
    // passes, as anyone's change is (docs/testing.md#continuous-integration):
    // the pull request is where the update's commit links to.
    automerge: true,
    automergeType: 'pr',
    // Its commits follow Conventional Commits, as everyone's do
    // (CONTRIBUTING.md#commit-messages): config:recommended's
    // :semanticPrefixFixDepsChoreOthers makes an update of what the app
    // needs at run time (dependencies) fix(deps):, which semantic-release
    // releases as a patch, and every other update (devDependencies, the
    // workflows' actions, the end-to-end tests', below) chore(deps):,
    // which releases nothing (docs/releasing.md).
    semanticCommits: 'enabled',
    // Each commit says what it updates, from what to what, where, and why,
    // and where its source and release notes are: the commit is the record
    // of the decision (docs/standard-for-public-code.md, criterion 6), and
    // its pull request has the notes in full.
    commitBody: '{{#each upgrades}}{{#if (equals updateType \'lockFileMaintenance\')}}- package-lock.json: every dependency to the newest version its range allows (lock file maintenance)\n{{else}}- {{{depName}}} {{{displayFrom}}} → {{{displayTo}}} ({{{updateType}}}{{#if depType}}, {{{depType}}}{{/if}}) in {{{packageFile}}}{{#if sourceUrl}}; source and release notes: {{{sourceUrl}}}{{/if}}\n{{/if}}{{/each}}\nWhy: renovate.json5 keeps every dependency current, within the versions it allows, so that fixes arrive while they are small; the update was merged only after CI passed on it.',
    customManagers: [
        // A tool a workflow downloads, its version after a comment that
        // names it (`# renovate: datasource=github-releases depName=<owner>/<repo>`).
        {
            customType: 'regex',
            managerFilePatterns: ['/^\\.github/(workflows|actions)/.+\\.ya?ml$/'],
            matchStrings: [
                '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+: (?<currentValue>\\S+)',
            ],
        },
        // The commit of Solid-Nextcloud its end-to-end tests' image builds,
        // as the branch its Dockerfile names moves on.
        {
            customType: 'regex',
            managerFilePatterns: ['/^e2e/pod/servers/nextcloud/Dockerfile$/'],
            matchStrings: [
                '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\nARG SOLID_NEXTCLOUD_SHA=(?<currentDigest>[0-9a-f]{40})',
            ],
        },
    ],
    packageRules: [
        // The end-to-end tests run against two majors of each Solid server,
        // each pinned in e2e/pod/servers/ (docs/testing.md): each stays on
        // its major, the Community Solid Server's in its compose file,
        // node-solid-server's in the lockfile its image is built from.
        // Its tags are versions, and 8's are prereleases: read as semver.
        {
            matchDepNames: ['solidproject/community-server'],
            versioning: 'semver',
        },
        {
            matchFileNames: ['e2e/pod/servers/css-6/compose.yml'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '<7',
        },
        // css-acp runs css-7's release with Access Control Policies.
        {
            matchFileNames: ['e2e/pod/servers/css-7/compose.yml', 'e2e/pod/servers/css-acp/Dockerfile'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '<8',
        },
        // The user journeys log in to 7 (e2e/journeys/css/compose.yml).
        {
            matchFileNames: ['e2e/journeys/css/compose.yml'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '<8',
        },
        // The advisory 8 follows its alphas to 8.0.0 (docs/testing.md).
        {
            matchFileNames: ['e2e/pod/servers/css-8/compose.yml'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '>=8.0.0-0 <9',
            ignoreUnstable: false,
        },
        {
            matchFileNames: ['e2e/pod/servers/nss/5/package.json'],
            matchDepNames: ['solid-server'],
            allowedVersions: '<6',
        },
        // Its image runs both node-solid-server majors: Node 24, the
        // newest both support.
        {
            matchFileNames: ['e2e/pod/servers/nss/Dockerfile'],
            matchDepNames: ['node'],
            allowedVersions: '<25',
        },
        // The dev container's image keeps to Node 24, as .nvmrc and CI do.
        // Its tags put the image's own version first and Node's after it
        // (5.2.3-24-bookworm), so the rule matches the tag's end: a range
        // such as '<25' matches none of them.
        {
            matchFileNames: ['.devcontainer/devcontainer.json'],
            matchDepNames: ['mcr.microsoft.com/devcontainers/typescript-node'],
            allowedVersions: '/-24-bookworm$/',
        },
        // Pivot's image keeps to Node 22, which Pivot's own CI runs.
        {
            matchFileNames: ['e2e/pod/servers/pivot/Dockerfile'],
            matchDepNames: ['node'],
            allowedVersions: '<23',
        },
        // Solid-Nextcloud's app is tested on Nextcloud 31 to 35, but only 31
        // and 32 must pass its CI.
        {
            matchFileNames: ['e2e/pod/servers/nextcloud/Dockerfile'],
            matchDepNames: ['nextcloud'],
            allowedVersions: '<33',
        },
        // The JavaScript Solid Server's image keeps to Node 24. Its tag names
        // the Alpine release too (alpine3.24), and Renovate keeps to it: the
        // move to the next Alpine release is a person's change.
        {
            matchFileNames: ['e2e/pod/servers/jss/Dockerfile'],
            matchDepNames: ['node'],
            allowedVersions: '<25',
        },
        // The Community Solid Server's tags are pushed again now and then:
        // a new digest for the same version is for a person to look at.
        {
            matchDepNames: ['solidproject/community-server'],
            matchUpdateTypes: ['digest'],
            automerge: false,
        },
        // Playwright and the browser it downloads move together: one pinned
        // version (e2e/journeys/package.json), which CI keys its browser
        // cache by.
        {
            matchDepNames: ['@playwright/test'],
            rangeStrategy: 'pin',
        },
        // The end-to-end tests' packages and servers ship nothing to users,
        // even what they list as dependencies: chore(deps):, no release.
        {
            matchFileNames: ['e2e/**'],
            semanticCommitType: 'chore',
        },
        // The release's preset keeps to 9: 10 needs conventional-changelog-writer
        // 9, and the release notes generator semantic-release ships uses 8
        // (scripts/releaseConfig.test.ts fails on a preset it cannot render).
        // Lift this once it uses 9.
        {
            matchFileNames: ['package.json'],
            matchDepNames: ['conventional-changelog-conventionalcommits'],
            allowedVersions: '<10',
        },
        // The images the end-to-end tests build themselves are in no registry.
        {
            matchDepNames: ['/^localhost\\//'],
            enabled: false,
        },
    ],
}