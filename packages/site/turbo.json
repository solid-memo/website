{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/CNAME",
        "$TURBO_ROOT$/ns/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/*.md"
      ],
      "env": [
        "DOCS_DIAGRAMS"
      ],
      "passThroughEnv": [
        "PLAYWRIGHT_*",
        "XDG_CACHE_HOME"
      ]
    }
  }
}
