{
  "name": "@solid-memo/vocab",
  "description": "Solid Memo's data contract: TypeScript generated from the RDF vocabulary and SHACL shapes in ns/, with the generator.",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./tooling/*": "./tooling/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "generate": "node -e \"import('./tooling/generate.ts').then((m) => m.run(process))\"",
    "generate:check": "node -e \"import('./tooling/generate.ts').then((m) => m.run(process))\" -- --check",
    "format:turtle": "node -e \"import('@solid-memo/turtle/formatTurtle').then((m) => m.run(process))\" -- fixtures ../../ns ../../decks ../../docs",
    "format:turtle:check": "node -e \"import('@solid-memo/turtle/formatTurtle').then((m) => m.run(process))\" -- --check fixtures ../../ns ../../decks ../../docs"
  },
  "devDependencies": {
    "@types/n3": "^1.26.4",
    "n3": "^2.0.0"
  },
  "dependencies": {
    "@solid-memo/turtle": "*"
  }
}
