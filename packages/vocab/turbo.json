{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/ns/**"]
    },
    "generate:check": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/ns/**"]
    },
    "format:turtle:check": {
