@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

<#answer-a>
    a solid-memo:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:answeredDeck <https://pod.example/solid-memo/main/catalog.ttl#deck-1> ;
    solid-memo:answeredCard <https://pod.example/solid-memo/main/decks/deck-1.ttl#sweden> ;
    solid-memo:answeredDirection solid-memo:frontToBack ;
    solid-memo:grade 4 ;
    solid-memo:answeredAt "2026-10-03T08:15:30.123Z"^^xsd:dateTime ;
    solid-memo:answeredOn "3 October 2026" ;
    solid-memo:nextIntervalDays 1 .
