@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .

# A draft's cards are held to card format 5 as anywhere else.
<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    solid-memo:formatVersion 1 ;
    solid-memo:studyDirection solid-memo:frontToBack .

<#q-1>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    solid-memo:front "Sweden"@en .
