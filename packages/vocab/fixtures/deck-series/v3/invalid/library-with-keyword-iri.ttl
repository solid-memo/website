@base <https://solid-memo.com/decks/index.ttl> .

@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .
@prefix foaf:       <http://xmlns.com/foaf/0.1/> .
@prefix adms:       <http://www.w3.org/ns/adms#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

<#capitals>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Capitals"@en ,
                  "Huvudstäder"@sv ;
    dcterms:description "Capitals of the world."@en ,
                        "Världens huvudstäder."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <https://solid-memo.com/ns/vocab/topics.ttl#geography> ;
    dcat:keyword <https://en.wikipedia.org/wiki/Capital_city> ;
    dcat:first <https://solid-memo.com/decks/capitals/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/capitals/v2.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/capitals/v1.ttl> ,
                    <https://solid-memo.com/decks/capitals/v2.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/capitals/v2.ttl> .

<#solid-memo>
    a foaf:Agent ;
    foaf:name "Solid Memo" .

<https://solid-memo.com/decks/capitals/v1.ttl>
    a dcat:Dataset ;
    dcterms:title "Capitals" ;
    dcterms:description "Capitals of the world." ;
    dcat:version "1" .

<https://solid-memo.com/decks/capitals/v2.ttl>
    a dcat:Dataset ;
    dcterms:title "Capitals" ;
    dcterms:description "Capitals of the world." ;
    dcat:version "2" .
