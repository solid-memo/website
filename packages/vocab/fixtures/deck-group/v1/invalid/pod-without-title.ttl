@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .
@prefix foaf:       <http://xmlns.com/foaf/0.1/> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

# A deck group without a name.
<#group-languages>
    a solid-memo:DeckGroup ,
      dcat:Catalog ;
    solid-memo:formatVersion 1 ;
    dcterms:description "Deck group: Languages."@en ;
    dcterms:publisher <https://pod.example/profile/card#me> ;
    dcat:dataset <#deck-japanese> ;
    solid-memo:position 0 .
