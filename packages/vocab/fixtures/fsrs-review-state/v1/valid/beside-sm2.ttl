@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

# A reviews document holds both schedulers' states of a prompt: each is
# checked against its own shape, told apart by solid-memo:scheduler. The
# FSRS-6 state may have any subject, since it names its card.
<#card-1>
    a solid-memo:ReviewState ;
    solid-memo:formatVersion 2 ;
    solid-memo:easeFactor 2.5 ;
    solid-memo:intervalDays 6 ;
    solid-memo:repetitions 2 ;
    solid-memo:due "2026-09-28" ;
    solid-memo:firstReviewedAt "2026-09-20T10:00:00Z"^^xsd:dateTime ;
    solid-memo:lastReviewedAt "2026-09-22T10:00:00Z"^^xsd:dateTime ;
    solid-memo:reviewOf <https://pod.example/decks/deck-1.ttl#card-1> ;
    solid-memo:reviewDirection solid-memo:frontToBack ;
    solid-memo:scheduler solid-memo:sm2 .

<#review-3f1c2a9e-0b7d-4c55-9a8e-2d6f4b1e7c30>
    a solid-memo:ReviewState ;
    solid-memo:formatVersion 1 ;
    solid-memo:scheduler solid-memo:fsrs6 ;
    solid-memo:reviewOf <https://pod.example/decks/deck-1.ttl#card-1> ;
    solid-memo:reviewDirection solid-memo:frontToBack ;
    solid-memo:stability 6.2 ;
    solid-memo:difficulty 4.93 ;
    solid-memo:due "2026-09-28" ;
    solid-memo:firstReviewedAt "2026-09-20T10:00:00Z"^^xsd:dateTime ;
    solid-memo:lastReviewedAt "2026-09-22T10:00:00Z"^^xsd:dateTime .
