@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .

# A palette with no colors for the dark theme.
<#palette-a>
    a solid-memo:Palette ;
    dcterms:title "Mine"@en ;
    solid-memo:basedOn solid-memo:standardPalette ;
    solid-memo:lightColors <#palette-a-light> .
