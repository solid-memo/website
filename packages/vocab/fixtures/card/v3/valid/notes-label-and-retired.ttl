@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

<#se>
    a solid-memo:Card ;
    solid-memo:front "Sweden" ;
    solid-memo:back "Stockholm" ;
    solid-memo:formatVersion 3 .

<#af>
    a solid-memo:Card ;
    solid-memo:frontImage <https://flagcdn.com/af.svg> ;
    solid-memo:back "Afghanistan" ;
    solid-memo:formatVersion 3 ;
    dcterms:created "2026-09-22T10:00:00Z"^^xsd:dateTime .

<#yu>
    a solid-memo:Card ;
    solid-memo:front "Yugoslavia" ;
    solid-memo:frontNote "Dissolved in 1992."@en ,
                         "Upplöst 1992."@sv ;
    solid-memo:backLabel "Capital"@en ;
    solid-memo:back "Belgrade" ;
    solid-memo:backNote "The capital until the country broke up in 1992."@en ;
    solid-memo:formatVersion 3 ;
    owl:deprecated true .
