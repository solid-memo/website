@prefix solid-memo: <https://pod.solid-memo.com/vocab/v1#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .
@prefix foaf:       <http://xmlns.com/foaf/0.1/> .
@prefix adms:       <http://www.w3.org/ns/adms#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

<#deck-1>
    a solid-memo:Deck ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Capitals" ;
    dcterms:description "Capitals of the world." ;
    dcterms:creator <#agent-anton> ;
    solid-memo:studyDirection <https://example.com/sideways> ;
    dcat:theme <https://pod.solid-memo.com/vocab/topics#geography> ;
    dcat:keyword "capitals" ;
    dcat:distribution <#deck-1-cards> ;
    solid-memo:cardsDocument <https://pod.example/solid-memo/main/decks/deck-1.ttl> ;
    solid-memo:reviewsDocument <https://pod.example/solid-memo/main/reviews/deck-1.ttl> ;
    prov:wasDerivedFrom <https://solid-memo.com/decks/capitals/1.ttl> .
