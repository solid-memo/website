@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .
@prefix foaf:       <http://xmlns.com/foaf/0.1/> .
@prefix adms:       <http://www.w3.org/ns/adms#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

<#catalog>
    a dcat:Catalog ;
    dcterms:title "Main" ;
    dcterms:description "My decks." ;
    dcterms:publisher <https://pod.example/profile/card#me> ;
    dcat:themeTaxonomy <https://solid-memo.com/ns/vocab/topics.ttl> ;
    dcat:dataset <#deck-1> .

<https://pod.example/profile/card#me>
    a foaf:Agent ;
    foaf:name "Anton" .

<#deck-1>
    a solid-memo:Deck ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Capitals" ;
    dcterms:description "Capitals of the world." ;
    dcterms:creator <#agent-anton> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    dcat:theme <https://solid-memo.com/ns/vocab/topics.ttl#geography> ;
    dcat:keyword "capitals" ;
    dcat:distribution <#deck-1-cards> ;
    solid-memo:cardsDocument <https://pod.example/solid-memo/main/decks/deck-1.ttl> ;
    solid-memo:reviewsDocument <https://pod.example/solid-memo/main/reviews/deck-1.ttl> ;
    prov:wasDerivedFrom <https://solid-memo.com/decks/capitals/1.ttl> ;
    solid-memo:deckNewCardsPerDay 5 ;
    solid-memo:deckMaxReviewsPerDay 50 .

<#agent-anton>
    a foaf:Agent ;
    foaf:name "Anton" ;
    foaf:mbox <mailto:anton@example.com> .

<#deck-1-cards>
    a dcat:Distribution ;
    dcat:accessURL <https://pod.example/solid-memo/main/decks/deck-1.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .
