  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inrupt/solid-client": "^4.0.0",
    "@inrupt/solid-client-authn-browser": "^5.0.3",
    "@solid-memo/domain": "*",
    "@solid-memo/solid-client": "*",
    "jsonld-streaming-parser": "^5.0.2",
    "n3": "^2.13.12"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.1",
    "@solid-memo/solid": "*",
    "@types/n3": "^1.26.6",
    "happy-dom": "^21.0.4"
  }
}
