{
  "name": "@solid-memo/markdown",
  "description": "Markdown in Solid Memo's data, and in the repository's own docs: parsed into a tree of its own, bounded, shown safely and checked for a release; the docs rendered to static pages, their diagrams drawn to SVG.",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./tooling/*": "./tooling/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "browsers": "playwright install --only-shell chromium"
  },
  "devDependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@types/mdast": "^4.0.4",
    "mermaid": "12.2.0",
    "playwright": "1.64.1",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@solid-memo/turtle": "*",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-cjk-friendly": "^2.0.2",
    "micromark-extension-gfm-table": "^2.1.2"
  }
}
