// markdownlint's rules for the project's Markdown (docs/testing.md#documentation):
// `npm run lint:markdown`, in npm run check (CI's check job). Every rule is on but these.
{
  "config": {
    "default": true,
    // Prose is wrapped by hand, near 72 columns; tables, commands and
    // links run as long as they need, and a wrap there would break them.
    "MD013": false,
    // A table's delimiter row is written without spaces (`|---|---|`).
    "MD060": false,
  },
  "globs": [
    "**/*.md",
  ],
  "ignores": [
    "**/node_modules/**",
  ],
}
