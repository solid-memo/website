                 "códigos de estado"@es ,
                 "códigos HTTP"@es ,
                 "web"@es ,
                 "HTTP"@fr ,
                 "codes de statut"@fr ,
                 "codes HTTP"@fr ,
                 "web"@fr ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 ;
    dcat:version "3" ;
    dcat:prev <https://solid-memo.com/decks/http-status-codes/v2.ttl> ;
    dcat:previousVersion <https://solid-memo.com/decks/http-status-codes/v2.ttl> ;
    dcterms:issued "2026-10-16T17:30:00Z"^^xsd:dateTime ;
    adms:versionNotes "A short note on every card about how the status is used in practice; no card's code or reason phrase was changed." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#http-status-codes> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#http-status-codes> ;
