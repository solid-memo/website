<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "HTTP status codes"@en ,
                  "HTTP-statuskoder"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "Every HTTP status code and its reason phrase. The list follows MDN's HTTP response status codes reference; the codes and names themselves are defined by the IETF and recorded in the IANA HTTP Status Code Registry."@en ,
                        "Varje HTTP-statuskod och dess statusfras. Listan följer MDN:s referens över HTTP-statuskoder; koderna och fraserna definieras av IETF och förs in i IANA:s register över HTTP-statuskoder. Statusfraserna står på engelska, så som de skrivs i HTTP."@sv ;
    prov:wasDerivedFrom <https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Status> ,
                        <https://www.iana.org/assignments/http-status-codes> ;
    dcterms:created "2026-09-22T16:29:47.000Z"^^xsd:dateTime ;
    dcterms:modified "2026-10-04T04:34:28.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ;
    dcat:keyword "HTTP"@en ,
                 "status codes"@en ,
                 "web"@en ,
                 "HTTP"@sv ,
                 "statuskoder"@sv ,
                 "webb"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-06T00:00:00Z"^^xsd:dateTime ;
    adms:versionNotes "First release." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#http-status-codes> ;
