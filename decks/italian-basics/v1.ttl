<#zero>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "zero"@it ;
    solid-memo:back "0"@zxx .

<#uno>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "uno"@it ;
    solid-memo:frontNote "number"@en ,
                         "tal"@sv ;
    solid-memo:back "1"@zxx ;
    solid-memo:backNote "Also the indefinite article (a, an) before z, s + consonant, gn and ps: uno zio; before most other masculine nouns: un."@en ,
                        "Också obestämd artikel (en, ett) före z, s + konsonant, gn och ps: uno zio; före de flesta andra maskulina substantiv: un."@sv .

