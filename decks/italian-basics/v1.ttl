    solid-memo:backNote "Lo before z, s + consonant, gn and ps (l' before a vowel). Plural: gli zii."@en ,
                        "Lo före z, s + konsonant, gn och ps (l' före vokal). Plural: gli zii."@sv .

<#zia>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "la zia"@it ;
    solid-memo:back "aunt"@en ,
                    "faster, moster"@sv ;
    solid-memo:backNote "Plural: le zie."@en ,
                        "Plural: le zie."@sv .

<#buongiorno>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "buongiorno"@it ;
    solid-memo:back "good morning, good day"@en ,
                    "god morgon, goddag"@sv ;
    solid-memo:backNote "Said by day, when meeting or leaving someone; also written buon giorno. In the evening: buonasera."@en ,
                        "Sägs dagtid, när man träffar eller lämnar någon; skrivs också buon giorno. På kvällen: buonasera."@sv .

<#buonasera>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "buonasera"@it ;
    solid-memo:back "good evening"@en ,
                    "god kväll"@sv ;
    solid-memo:backNote "Said in the evening or late afternoon, when meeting or leaving someone; also written buona sera."@en ,
                        "Sägs på kvällen eller sena eftermiddagen, när man träffar eller lämnar någon; skrivs också buona sera."@sv .

<#buonanotte>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "buonanotte"@it ;
    solid-memo:back "good night"@en ,
                    "god natt"@sv ;
    solid-memo:backNote "Said when parting for the night or before going to bed; also written buona notte."@en ,
                        "Sägs när man skiljs för natten eller går och lägger sig; skrivs också buona notte."@sv .

<#ciao>
    a solid-memo:Card ;
