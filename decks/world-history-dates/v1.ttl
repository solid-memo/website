<#battle-of-hastings>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Battle of Hastings"@en ,
                     "Slaget vid Hastings"@sv ;
