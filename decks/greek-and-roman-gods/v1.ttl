    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Roman counterpart of Selene"@en ,
                     "Romersk motsvarighet till Selene"@sv ;
    solid-memo:back "Luna"@en ,
                    "Luna"@sv .

