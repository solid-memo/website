    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Roman counterpart of Eos"@en ,
                     "Romersk motsvarighet till Eos"@sv ;
    solid-memo:back "Aurora"@en ,
                    "Aurora"@sv .

<#nike-roman>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Roman counterpart of Nike"@en ,
                     "Romersk motsvarighet till Nike"@sv ;
    solid-memo:back "Victoria"@en ,
                    "Victoria"@sv .

<#tyche-roman>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Roman counterpart of Tyche"@en ,
                     "Romersk motsvarighet till Tyche"@sv ;
    solid-memo:back "Fortuna"@en ,
                    "Fortuna"@sv .

<#zeus-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Zeus the god of?"@en ,
                     "Vad är Zeus gud för?"@sv ;
    solid-memo:back "the sky and thunder"@en ,
                    "himlen och åskan"@sv ;
    solid-memo:backNote "He is also the king of the gods."@en ,
                        "Han är också gudarnas kung."@sv .

<#hera-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Hera the goddess of?"@en ,
                     "Vad är Hera gudinna för?"@sv ;
    solid-memo:back "marriage and women"@en ,
                    "äktenskapet och kvinnorna"@sv ;
    solid-memo:backNote "She is also the queen of the gods, wife of Zeus."@en ,
                        "Hon är också gudarnas drottning, Zeus hustru."@sv .

<#poseidon-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Poseidon the god of?"@en ,
                     "Vad är Poseidon gud för?"@sv ;
    solid-memo:back "the sea, earthquakes and horses"@en ,
                    "havet, jordbävningarna och hästarna"@sv .

<#demeter-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Demeter the goddess of?"@en ,
                     "Vad är Demeter gudinna för?"@sv ;
    solid-memo:back "agriculture and the harvest"@en ,
                    "jordbruket och skörden"@sv .

<#athena-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Athena the goddess of?"@en ,
                     "Vad är Athena gudinna för?"@sv ;
    solid-memo:back "wisdom, war and crafts"@en ,
                    "visheten, kriget och hantverket"@sv ;
    solid-memo:backNote "In war she stands for strategy and the defence of cities, unlike Ares."@en ,
                        "I kriget står hon för strategi och städernas försvar, till skillnad från Ares."@sv .

<#apollo-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Apollo the god of?"@en ,
                     "Vad är Apollon gud för?"@sv ;
    solid-memo:back "music, prophecy and healing"@en ,
                    "musiken, spådomskonsten och läkekonsten"@sv ;
    solid-memo:backNote "His identification with the sun god Helios came later."@en ,
                        "Först senare likställdes han med solguden Helios."@sv .

<#artemis-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Artemis the goddess of?"@en ,
                     "Vad är Artemis gudinna för?"@sv ;
    solid-memo:back "the hunt and wild animals"@en ,
                    "jakten och de vilda djuren"@sv ;
    solid-memo:backNote "Apollo's twin sister."@en ,
                        "Apollons tvillingsyster."@sv .

<#ares-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Ares the god of?"@en ,
                     "Vad är Ares gud för?"@sv ;
    solid-memo:back "war"@en ,
                    "kriget"@sv ;
    solid-memo:backNote "Above all the violence of battle, unlike Athena."@en ,
                        "Framför allt stridens våld, till skillnad från Athena."@sv .

<#aphrodite-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Aphrodite the goddess of?"@en ,
                     "Vad är Afrodite gudinna för?"@sv ;
    solid-memo:back "love and beauty"@en ,
                    "kärleken och skönheten"@sv .

<#hephaestus-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Hephaestus the god of?"@en ,
                     "Vad är Hefaistos gud för?"@sv ;
    solid-memo:back "fire and the forge"@en ,
                    "elden och smideskonsten"@sv .

<#hermes-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Hermes the god of?"@en ,
                     "Vad är Hermes gud för?"@sv ;
    solid-memo:back "travellers, trade and thieves"@en ,
                    "resenärerna, handeln och tjuvarna"@sv ;
    solid-memo:backNote "He is also the messenger of the gods and guides the dead to the underworld."@en ,
                        "Han är också gudarnas budbärare och leder de döda till underjorden."@sv .

<#hestia-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Hestia the goddess of?"@en ,
                     "Vad är Hestia gudinna för?"@sv ;
    solid-memo:back "the hearth and the home"@en ,
                    "härden och hemmet"@sv .

<#dionysus-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Dionysus the god of?"@en ,
                     "Vad är Dionysos gud för?"@sv ;
    solid-memo:back "wine"@en ,
                    "vinet"@sv ;
    solid-memo:backNote "Originally a god of vegetation, worshipped with ecstatic rites."@en ,
                        "Ursprungligen en växtlighetens gud, dyrkad med extatiska riter."@sv .

<#hades-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Hades the god of?"@en ,
                     "Vad är Hades gud för?"@sv ;
    solid-memo:back "the underworld and the dead"@en ,
                    "underjorden och de döda"@sv .

<#persephone-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Persephone the goddess of?"@en ,
                     "Vad är Persefone gudinna för?"@sv ;
    solid-memo:back "the underworld and spring vegetation"@en ,
                    "underjorden och vårens växtlighet"@sv ;
    solid-memo:backNote "Queen of the underworld as the wife of Hades."@en ,
                        "Underjordens drottning som Hades hustru."@sv .

<#eros-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Eros the god of?"@en ,
                     "Vad är Eros gud för?"@sv ;
    solid-memo:back "love"@en ,
                    "kärleken"@sv ;
    solid-memo:backNote "In later myth the son of Aphrodite."@en ,
                        "I senare myter Afrodites son."@sv .

<#helios-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Helios the god of?"@en ,
                     "Vad är Helios gud för?"@sv ;
    solid-memo:back "the sun"@en ,
                    "solen"@sv .

<#selene-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Selene the goddess of?"@en ,
                     "Vad är Selene gudinna för?"@sv ;
    solid-memo:back "the moon"@en ,
                    "månen"@sv .

<#eos-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Eos the goddess of?"@en ,
                     "Vad är Eos gudinna för?"@sv ;
    solid-memo:back "the dawn"@en ,
                    "gryningen"@sv .

<#nike-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Nike the goddess of?"@en ,
                     "Vad är Nike gudinna för?"@sv ;
    solid-memo:back "victory"@en ,
                    "segern"@sv .

<#tyche-domain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "What is Tyche the goddess of?"@en ,
                     "Vad är Tyche gudinna för?"@sv ;
    solid-memo:back "fortune"@en ,
                    "lyckan"@sv .

