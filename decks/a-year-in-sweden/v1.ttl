<#q-midsummer-2a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "I remember our first fika."@en ,
                              "Ich erinnere mich an unsere erste Fika."@de ,
                              "Me acuerdo de nuestra primera fika."@es ,
                              "Je me souviens de notre première fika."@fr ,
