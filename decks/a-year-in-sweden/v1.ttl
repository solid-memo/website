      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Have a good trip, since we didn't get to see each other!"@en ,
                              "Gute Reise, da wir es nicht geschafft haben, uns zu sehen!"@de ,
