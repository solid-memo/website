      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "I'm at home cleaning."@en ,
                              "Ich bin zu Hause und putze."@de ,
                              "Estoy en casa limpiando."@es ,
                              "Je suis à la maison à faire le ménage."@fr ,
