    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Nobody was here before us."@en ,
                              "Niemand war vor uns hier."@de ,
                              "Nadie estuvo aquí antes que nosotros."@es ,
                              "Personne n'était là avant nous."@fr ,
