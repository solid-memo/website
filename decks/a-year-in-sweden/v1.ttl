<#q-plan-2b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Yes, it's a bit crowded for two."@en ,
                              "Ja, es ist ein bisschen eng für zwei."@de ,
                              "Sí, está un poco estrecha para dos."@es ,
                              "Oui, c'est un peu serré pour deux."@fr ,
                              "네, 둘이 지내기에는 좀 비좁아요."@ko ;
