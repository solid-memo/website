    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Are the machines new?"@en ,
                              "Sind die Maschinen neu?"@de ,
                              "¿Son nuevas las máquinas?"@es ,
                              "Est-ce que les machines sont neuves ?"@fr ,
                              "기계들 새 건가요?"@ko ;
    solid-memo:distractorNote "That would be Är maskinerna nya?; ledig is free, not new."@en ,
                              "Das wäre Är maskinerna nya?; ledig heißt frei, nicht neu."@de ,
                              "Eso sería Är maskinerna nya?; ledig es libre, no nuevo."@es ,
                              "Ce serait Är maskinerna nya? ; ledig veut dire libre, pas neuf."@fr ,
