<#q-health-1c-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Go home and put the kids to bed."@en ,
                              "Gehen Sie nach Hause und bringen Sie die Kinder ins Bett."@de ,
                              "Váyase a casa y acueste a los niños."@es ,
                              "Rentrez chez vous et couchez les enfants."@fr ,
                              "집에 가셔서 아이들을 재우세요."@ko ;
    solid-memo:distractorNote "That would be Gå hem och lägg barnen; lägg dig, with dig, is to lie down yourself."@en ,
                              "Das wäre Gå hem och lägg barnen; lägg dig, mit dig, heißt sich selbst hinlegen."@de ,
                              "Eso sería Gå hem och lägg barnen; lägg dig, con dig, es acostarse uno mismo."@es ,
                              "Ce serait Gå hem och lägg barnen ; lägg dig, avec dig, veut dire se coucher soi-même."@fr ,
