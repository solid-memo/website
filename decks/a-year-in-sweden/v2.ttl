    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "I've had the laundry room since nine."@en ,
                              "Ich habe die Waschküche seit neun."@de ,
                              "Tengo la lavandería desde las nueve."@es ,
                              "J'ai la buanderie depuis neuf heures."@fr ,
                              "저는 9시부터 세탁실을 쓰고 있어요."@ko ;
    solid-memo:distractorNote "That would be Jag har haft tvättid sedan klockan nio; till is until."@en ,
                              "Das wäre Jag har haft tvättid sedan klockan nio; till heißt bis."@de ,
                              "Eso sería Jag har haft tvättid sedan klockan nio; till es hasta."@es ,
                              "Ce serait Jag har haft tvättid sedan klockan nio ; till veut dire jusqu'à."@fr ,
                              "그 뜻이라면: Jag har haft tvättid sedan klockan nio; till은 '~까지'예요."@ko .

<#q-laundry-r01-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "We have the laundry room until nine."@en ,
                              "Wir haben die Waschküche bis neun."@de ,
                              "Tenemos la lavandería hasta las nueve."@es ,
                              "Nous avons la buanderie jusqu'à neuf heures."@fr ,
                              "우리는 9시까지 세탁실을 써요."@ko ;
    solid-memo:distractorNote "That would be Vi har tvättid till nio; jag is I."@en ,
                              "Das wäre Vi har tvättid till nio; jag heißt ich."@de ,
                              "Eso sería Vi har tvättid till nio; jag es yo."@es ,
                              "Ce serait Vi har tvättid till nio ; jag veut dire je."@fr ,
                              "그 뜻이라면: Vi har tvättid till nio; jag는 '나'예요."@ko .

