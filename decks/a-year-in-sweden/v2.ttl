<#q-work-2b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Can you leave a bit earlier today?"@en ,
                              "Kannst du heute etwas früher gehen?"@de ,
                              "¿Puedes irte hoy un poco antes?"@es ,
                              "Tu peux partir un peu plus tôt aujourd'hui ?"@fr ,
