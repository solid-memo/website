    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Yes, we won't miss that one!"@en ,
                              "Ja, die wollen wir nicht verpassen!"@de ,
