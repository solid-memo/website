      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Excuse me, do you have any milk?"@en ,
                              "Entschuldigung, haben Sie Milch?"@de ,
                              "Perdone, ¿tienen leche?"@es ,
                              "Excusez-moi, vous avez du lait ?"@fr ,
                              "실례지만, 우유 있어요?"@ko ;
    solid-memo:distractorNote "That would be Ursäkta, har ni mjölk?; var asks where."@en ,
                              "Das wäre Ursäkta, har ni mjölk?; var fragt nach dem Wo."@de ,
                              "Eso sería Ursäkta, har ni mjölk?; var pregunta dónde."@es ,
                              "Ce serait Ursäkta, har ni mjölk? ; var demande où."@fr ,
                              "그 뜻이라면: Ursäkta, har ni mjölk?; var는 '어디'를 물어요."@ko .

