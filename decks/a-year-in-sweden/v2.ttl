    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Yes, I didn't miss that one!"@en ,
                              "Ja, die habe ich nicht verpasst!"@de ,
                              "¡Sí, esa no me la perdí!"@es ,
                              "Oui, celle-là, je ne l'ai pas ratée !"@fr ,
                              "네, 그건 안 놓쳤어요!"@ko ;
