    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-11-18T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Det är den kallaste morgonen hittills i vinter."@sv ;
    solid-memo:back "It's the coldest morning so far this winter."@en ,
                    "Das ist der bisher kälteste Morgen in diesem Winter."@de ,
                    "Es la mañana más fría de lo que va de invierno."@es ,
                    "C'est le matin le plus froid de l'hiver jusqu'ici."@fr ,
                    "이번 겨울 들어 가장 추운 아침이에요."@ko ;
    solid-memo:backNote "Said by Anders, Elin's father, on a frosty February morning in Dalarna. Kallaste is the superlative of kall, with -e after den; hittills i vinter is so far this winter."@en ,
                        "Sagt Anders, Elins Vater, an einem frostigen Februarmorgen in Dalarna. Kallaste ist der Superlativ von kall, mit -e nach den; hittills i vinter heißt bisher in diesem Winter."@de ,
                        "Lo dice Anders, el padre de Elin, una mañana helada de febrero en Dalarna. Kallaste es el superlativo de kall, con -e después de den; hittills i vinter es en lo que va de invierno."@es ,
                        "Dit par Anders, le père d'Elin, un matin de gel de février en Dalécarlie. Kallaste est le superlatif de kall, avec -e après den ; hittills i vinter veut dire jusqu'ici cet hiver."@fr ,
                        "달라르나의 서리 내린 2월 아침에 엘린의 아버지 안데르스가 하는 말이에요. Kallaste는 kall의 최상급으로, den 뒤라서 -e가 붙어요. hittills i vinter는 '이번 겨울 들어 지금까지'예요."@ko ;
    solid-memo:distractor <#q-family-1a-d1> ,
                          <#q-family-1a-d2> ,
                          <#q-family-1a-d3> .

<#q-family-1a-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "It's a colder morning than yesterday."@en ,
                              "Das ist ein kälterer Morgen als gestern."@de ,
                              "Es una mañana más fría que la de ayer."@es ,
                              "C'est un matin plus froid qu'hier."@fr ,
                              "어제보다 더 추운 아침이에요."@ko ;
    solid-memo:distractorNote "That would be Det är en kallare morgon än i går; kallaste is the superlative, the coldest."@en ,
                              "Das wäre Det är en kallare morgon än i går; kallaste ist der Superlativ, der kälteste."@de ,
                              "Eso sería Det är en kallare morgon än i går; kallaste es el superlativo, la más fría."@es ,
                              "Ce serait Det är en kallare morgon än i går ; kallaste est le superlatif, le plus froid."@fr ,
                              "그 뜻이라면: Det är en kallare morgon än i går; kallaste는 최상급, '가장 추운'이에요."@ko .

