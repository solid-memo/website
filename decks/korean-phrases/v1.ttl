<#jeogiyo>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-16T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "저기요"@ko ;
    solid-memo:back "excuse me (to get attention)"@en ,
                    "ursäkta (för att få uppmärksamhet)"@sv ,
                    "Entschuldigung (um jemanden anzusprechen)"@de ,
                    "disculpe (para llamar la atención)"@es ,
                    "s'il vous plaît (pour appeler quelqu'un)"@fr ;
    solid-memo:backNote "Used to call a waiter or to stop a stranger; literally \"over there\". In a restaurant also 여기요."@en ,
                        "Används för att påkalla en servitörs eller en främlings uppmärksamhet; ordagrant ”där borta”. På restaurang också 여기요."@sv ,
                        "Um eine Bedienung zu rufen oder einen Fremden anzusprechen; wörtlich „da drüben“. Im Restaurant auch 여기요."@de ,
                        "Para llamar a un camarero o a un desconocido; literalmente «allí». En un restaurante también 여기요."@es ,
                        "Pour appeler un serveur ou aborder un inconnu ; littéralement « là-bas ». Au restaurant aussi 여기요."@fr .

