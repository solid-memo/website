    solid-memo:back "I don't need it"@en ,
                    "jag behöver det inte"@sv ,
                    "das brauche ich nicht"@de ,
                    "no lo necesito"@es ,
                    "je n'en ai pas besoin"@fr .

<#jamkkanmanyo>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-16T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "잠깐만요"@ko ;
    solid-memo:back "just a moment"@en ,
                    "ett ögonblick"@sv ,
                    "einen Moment"@de ,
                    "un momento"@es ,
                    "un instant"@fr ;
    solid-memo:backNote "Also to get past someone. Also 잠시만요."@en ,
                        "Också för att komma förbi någon. Också 잠시만요."@sv ,
                        "Auch, um an jemandem vorbeizukommen. Auch 잠시만요."@de ,
                        "También para pasar entre la gente. También 잠시만요."@es ,
                        "Aussi pour se frayer un passage. Aussi 잠시만요."@fr .

