                    "¿dónde hago transbordo?"@es ,
                    "où est-ce que je dois changer ?"@fr ;
    solid-memo:backNote "Also for buses."@en ,
                        "Gäller också bussar."@sv ,
                        "Auch bei Bussen."@de ,
                        "También para autobuses."@es ,
                        "Aussi pour les bus."@fr .

