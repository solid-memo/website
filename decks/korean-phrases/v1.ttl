    solid-memo:front "몇 번 출구예요?"@ko ;
    solid-memo:back "which exit is it?"@en ,
                    "vilken utgång är det?"@sv ,
                    "welcher Ausgang ist es?"@de ,
                    "¿qué salida es?"@es ,
                    "c'est quelle sortie ?"@fr ;
    solid-memo:backNote "Subway exits in Korea are numbered."@en ,
                        "Tunnelbanans utgångar i Korea är numrerade."@sv ,
                        "Die U-Bahn-Ausgänge in Korea sind nummeriert."@de ,
                        "Las salidas del metro en Corea están numeradas."@es ,
                        "En Corée, les sorties de métro sont numérotées."@fr .

<#eodieseogalatayo>
