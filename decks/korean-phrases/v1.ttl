<#pilyohaeyo>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-16T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "… 필요해요"@ko ;
    solid-memo:back "I need …"@en ,
                    "jag behöver …"@sv ,
                    "ich brauche …"@de ,
                    "necesito …"@es ,
                    "j'ai besoin de …"@fr ;
    solid-memo:backNote "In full …이 필요해요 after a consonant, …가 필요해요 after a vowel; the particle is often left out."@en ,
                        "Fullständigt …이 필요해요 efter en konsonant, …가 필요해요 efter en vokal; partikeln utelämnas ofta."@sv ,
                        "Vollständig …이 필요해요 nach einem Konsonanten, …가 필요해요 nach einem Vokal; die Partikel fällt oft weg."@de ,
                        "En forma completa, …이 필요해요 tras consonante y …가 필요해요 tras vocal; la partícula se omite a menudo."@es ,
                        "Forme complète : …이 필요해요 après une consonne, …가 필요해요 après une voyelle ; la particule tombe souvent."@fr .

<#pilyoeopeoyo>
