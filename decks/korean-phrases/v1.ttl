    solid-memo:front "처음 뵙겠습니다"@ko ;
    solid-memo:back "how do you do (on first meeting)"@en ,
                    "goddag (vid första mötet)"@sv ,
                    "sehr erfreut (beim ersten Treffen)"@de ,
                    "encantado/a (al conocerse)"@es ,
                    "enchanté(e) (à la première rencontre)"@fr ;
    solid-memo:backNote "Formal, said when meeting someone for the first time; literally \"I see you for the first time\"."@en ,
                        "Formellt, sägs när man träffar någon för första gången; ordagrant ”jag ser er för första gången”."@sv ,
                        "Förmlich, beim ersten Kennenlernen; wörtlich „ich sehe Sie zum ersten Mal“."@de ,
                        "Formal, al conocer a alguien por primera vez; literalmente «lo veo por primera vez»."@es ,
                        "Formel, à la première rencontre ; littéralement « je vous vois pour la première fois »."@fr .

