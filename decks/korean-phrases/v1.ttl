    solid-memo:front "이 버스 …에 가요?"@ko ;
    solid-memo:back "does this bus go to …?"@en ,
                    "går den här bussen till …?"@sv ,
                    "fährt dieser Bus nach …?"@de ,
                    "¿este autobús va a …?"@es ,
                    "ce bus va à … ?"@fr .

<#pyohanjangjuseyo>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-16T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "표 한 장 주세요"@ko ;
    solid-memo:back "one ticket, please"@en ,
                    "en biljett, tack"@sv ,
                    "eine Fahrkarte, bitte"@de ,
                    "un billete, por favor"@es ,
                    "un billet, s'il vous plaît"@fr ;
    solid-memo:backNote "장 counts flat things such as tickets; two tickets: 표 두 장."@en ,
                        "장 räknar platta saker som biljetter; två biljetter: 표 두 장."@sv ,
                        "장 zählt flache Dinge wie Fahrkarten; zwei Fahrkarten: 표 두 장."@de ,
                        "장 cuenta cosas planas como billetes; dos billetes: 표 두 장."@es ,
                        "장 compte les choses plates comme les billets ; deux billets : 표 두 장."@fr .

<#myeotbeonchulguyeyo>
