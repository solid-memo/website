<#alrereugigaiteoyo>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-16T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "알레르기가 있어요"@ko ;
    solid-memo:back "I have an allergy"@en ,
                    "jag har en allergi"@sv ,
                    "ich habe eine Allergie"@de ,
                    "tengo una alergia"@es ,
                    "j'ai une allergie"@fr ;
    solid-memo:backNote "With a food: 땅콩 알레르기가 있어요, \"I'm allergic to peanuts\"."@en ,
                        "Med ett livsmedel: 땅콩 알레르기가 있어요, ”jag är allergisk mot jordnötter”."@sv ,
                        "Mit einem Lebensmittel: 땅콩 알레르기가 있어요, „ich bin gegen Erdnüsse allergisch“."@de ,
                        "Con un alimento: 땅콩 알레르기가 있어요, «soy alérgico/a a los cacahuetes»."@es ,
                        "Avec un aliment : 땅콩 알레르기가 있어요, « je suis allergique aux cacahuètes »."@fr .

<#josimhaseyo>
