    solid-memo:back "I’m fine"@en ,
                    "jag mår bra"@sv ,
                    "잘 지내요"@ko ,
                    "mir geht es gut"@de ,
                    "estoy bien"@es ,
                    "je vais bien"@fr ;
    solid-memo:backNote "anā bi-khayr. Often followed by الْحَمْدُ لِلّٰه."@en ,
                        "anā bi-khayr. Följs ofta av الْحَمْدُ لِلّٰه."@sv ,
                        "anā bi-khayr. 흔히 뒤에 الْحَمْدُ لِلّٰه를 덧붙여요."@ko ,
                        "anā bi-khayr. Oft gefolgt von الْحَمْدُ لِلّٰه."@de ,
                        "anā bi-khayr. Suele ir seguido de الْحَمْدُ لِلّٰه."@es ,
                        "anā bi-khayr. Souvent suivi de الْحَمْدُ لِلّٰه."@fr .

