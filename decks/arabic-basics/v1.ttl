<#masau-l-khayr>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-14T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "مَسَاءُ الْخَيْر"@ar ;
    solid-memo:back "good evening"@en ,
                    "god kväll"@sv ,
                    "좋은 저녁이에요"@ko ,
                    "guten Abend"@de ,
                    "buenas tardes"@es ,
                    "bonsoir"@fr ;
    solid-memo:backNote "masāʼu l-khayr. Used from the afternoon on; the usual reply is مَسَاءُ النُّور."@en ,
                        "masāʼu l-khayr. Används från eftermiddagen och framåt; det vanliga svaret är مَسَاءُ النُّور."@sv ,
                        "masāʼu l-khayr. 오후부터 써요. 보통 مَسَاءُ النُّور로 답해요."@ko ,
                        "masāʼu l-khayr. Ab dem Nachmittag; die übliche Antwort ist مَسَاءُ النُّور."@de ,
                        "masāʼu l-khayr. Se usa desde la tarde; la respuesta habitual es مَسَاءُ النُّور."@es ,
                        "masāʼu l-khayr. S’emploie dès l’après-midi ; la réponse habituelle est مَسَاءُ النُّور."@fr .

