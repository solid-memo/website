<#hal>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-14T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "هَلْ"@ar ;
    solid-memo:back "(question word for yes/no questions)"@en ,
                    "(frågeord för ja/nej-frågor)"@sv ,
                    "(예/아니요 질문을 만드는 말)"@ko ,
                    "(Fragewort für Ja/Nein-Fragen)"@de ,
                    "(partícula de pregunta de sí o no)"@es ,
                    "(mot interrogatif pour les questions fermées)"@fr ;
    solid-memo:backNote "hal. Put at the start of a sentence to make it a yes/no question: هَلْ أَنْتَ بِخَيْر؟"@en ,
                        "hal. Sätts först i en mening för att göra den till en ja/nej-fråga: هَلْ أَنْتَ بِخَيْر؟"@sv ,
                        "hal. 문장 맨 앞에 붙여 예/아니요 질문을 만들어요. 예: هَلْ أَنْتَ بِخَيْر؟"@ko ,
                        "hal. Steht am Satzanfang und macht daraus eine Ja/Nein-Frage: هَلْ أَنْتَ بِخَيْر؟"@de ,
                        "hal. Se pone al principio de la frase para hacer una pregunta de sí o no: هَلْ أَنْتَ بِخَيْر؟"@es ,
                        "hal. Se place en début de phrase pour poser une question fermée : هَلْ أَنْتَ بِخَيْر؟"@fr .

