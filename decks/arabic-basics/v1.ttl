<#yani>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-14T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "يَعْنِي"@ar ;
    solid-memo:back "I mean / that is"@en ,
                    "alltså"@sv ,
                    "그러니까"@ko ,
                    "das heißt"@de ,
                    "es decir"@es ,
                    "c’est-à-dire"@fr ;
    solid-memo:backNote "yaʻnī. Literally “it means”; also a very common filler word in speech."@en ,
                        "yaʻnī. Ordagrant ”det betyder”; också ett mycket vanligt utfyllnadsord i tal."@sv ,
                        "yaʻnī. 글자 그대로는 ‘그것은 뜻한다’이며, 말할 때 아주 흔한 군말이기도 해요."@ko ,
                        "yaʻnī. Wörtlich „es bedeutet“; auch ein sehr häufiges Füllwort."@de ,
                        "yaʻnī. Literalmente «significa»; también una muletilla muy común al hablar."@es ,
                        "yaʻnī. Littéralement « cela signifie » ; aussi un mot de remplissage très courant à l’oral."@fr .

