      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Only the map site"@en ,
                              "Bara kartwebbplatsen"@sv ,
                              "지도 사이트만"@ko ,
                              "Nur die Kartenwebsite"@de ,
                              "Solo el sitio de mapas"@es ,
                              "Seulement le site cartographique"@fr ;
    solid-memo:distractorNote "Interactive user interfaces are outside DCAT's scope; the data service is the API."@en ,
                              "Interaktiva användargränssnitt ligger utanför DCAT:s räckvidd; datatjänsten är API:et."@sv ,
                              "대화형 사용자 인터페이스는 DCAT의 범위 밖이며, 데이터 서비스는 API입니다."@ko ,
                              "Interaktive Benutzeroberflächen liegen außerhalb des Anwendungsbereichs von DCAT; der Datenservice ist die API."@de ,
                              "Las interfaces de usuario interactivas quedan fuera del alcance de DCAT; el servicio de datos es la API."@es ,
                              "Les interfaces utilisateur interactives sortent du périmètre de DCAT ; le service de données est l’API."@fr .

<#q-distributions-2a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Both, as two data services"@en ,
                              "Båda, som två datatjänster"@sv ,
                              "둘 다: 데이터 서비스 두 개"@ko ,
                              "Beide, als zwei Datenservices"@de ,
                              "Ambos, como dos servicios de datos"@es ,
                              "Les deux, comme deux services de données"@fr ;
    solid-memo:distractorNote "The map site is not a data service; only the API behind it is."@en ,
                              "Kartwebbplatsen är ingen datatjänst; det är bara API:et bakom den."@sv ,
                              "지도 사이트는 데이터 서비스가 아니며, 그 뒤의 API만 데이터 서비스입니다."@ko ,
