      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Format: IANA; media type: EU File Type list"@en ,
                              "Format: IANA; mediatyp: EU:s filtypslista"@sv ,
                              "형식: IANA; 미디어 유형: EU 파일 유형 목록"@ko ,
                              "Format: IANA; Medientyp: EU-Dateitypliste"@de ,
                              "Formato: IANA; tipo de medio: lista de tipos de archivo de la UE"@es ,
                              "Format : IANA ; type de média : liste des types de fichiers de l’UE"@fr ;
    solid-memo:distractorNote "The two lists are swapped: IANA is for the media type."@en ,
                              "De två listorna har bytt plats: IANA gäller mediatypen."@sv ,
                              "두 목록이 뒤바뀌었습니다. IANA는 미디어 유형을 위한 목록입니다."@ko ,
                              "Die beiden Listen sind vertauscht: IANA ist für den Medientyp da."@de ,
                              "Las dos listas están intercambiadas: IANA es para el tipo de medio."@es ,
                              "Les deux listes sont inversées : l’IANA sert au type de média."@fr .

<#q-dcat-ap-vocabularies-1a-d2>
