<#q-change-over-time-1a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "dcat:hasVersion"@en ,
                              "dcat:hasVersion"@sv ,
