<#q-describing-datasets-0a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "dcterms:type for the concept; dcterms:type for the tags"@en ,
                              "dcterms:type för begreppet; dcterms:type för taggarna"@sv ,
                              "개념은 dcterms:type, 태그는 dcterms:type"@ko ,
