    solid-memo:distractorText "dcat:DatasetSeries"@en ,
                              "dcat:DatasetSeries"@sv ,
                              "dcat:DatasetSeries"@ko ,
                              "dcat:DatasetSeries"@de ,
                              "dcat:DatasetSeries"@es ,
                              "dcat:DatasetSeries"@fr ;
    solid-memo:distractorNote "Dataset series came in with DCAT-AP 3.0.0 and are part of the Swedish profile."@en ,
