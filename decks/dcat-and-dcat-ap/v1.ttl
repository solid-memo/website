                    "Titeln"@sv ,
                    "제목"@ko ,
                    "Der Titel"@de ,
                    "El título"@es ,
                    "Le titre"@fr ;
    solid-memo:backNote "dcterms:title has the range rdfs:Literal; the other three point to a concept, a period of time and a location."@en ,
                        "dcterms:title har värdemängden rdfs:Literal; de andra tre pekar på ett begrepp, en tidsperiod och en plats."@sv ,
                        "dcterms:title의 레인지는 rdfs:Literal이며, 나머지 셋은 각각 개념, 기간, 위치를 가리킵니다."@ko ,
                        "dcterms:title hat den Wertebereich rdfs:Literal; die anderen drei verweisen auf ein Konzept, einen Zeitraum und einen Ort."@de ,
                        "dcterms:title tiene el rango rdfs:Literal; los otros tres apuntan a un concepto, un período de tiempo y una ubicación."@es ,
                        "dcterms:title a pour codomaine rdfs:Literal ; les trois autres pointent vers un concept, une période et un lieu."@fr ;
    solid-memo:distractor <#q-describing-datasets-r01-d1> ,
                          <#q-describing-datasets-r01-d2> ,
                          <#q-describing-datasets-r01-d3> .

<#q-describing-datasets-r01-d1>
