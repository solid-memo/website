    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Shown on dataportal.se, stripped before Europe"@en ,
                              "Visas på dataportal.se, tas bort före Europa"@sv ,
                              "dataportal.se에 표시되고, 유럽 전달 전에 제거됨"@ko ,
                              "Auf dataportal.se gezeigt, vor der Weitergabe entfernt"@de ,
