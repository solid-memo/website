    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "CC BY 4.0, covering the data in the datasets"@en ,
                              "CC BY 4.0, som omfattar data i datamängderna"@sv ,
