    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Harvesters fetch the data files by IRI"@en ,
                              "Skördare hämtar datafilerna via IRI"@sv ,
                              "하베스터가 IRI로 데이터 파일을 가져옴"@ko ,
                              "Harvester holen die Datendateien per IRI ab"@de ,
                              "Los recolectores descargan los archivos de datos por IRI"@es ,
                              "Les moissonneurs récupèrent les fichiers de données par IRI"@fr ;
    solid-memo:distractorNote "Harvesting copies the metadata descriptions, not the data files."@en ,
                              "Skördning kopierar metadatabeskrivningarna, inte datafilerna."@sv ,
                              "하베스팅은 데이터 파일이 아니라 메타데이터 기술을 복사합니다."@ko ,
                              "Harvesting kopiert die Metadatenbeschreibungen, nicht die Datendateien."@de ,
                              "La recolección copia las descripciones de metadatos, no los archivos de datos."@es ,
                              "Le moissonnage copie les descriptions de métadonnées, pas les fichiers de données."@fr .

