                    "dcat:downloadURL och spdx:checksum"@sv ,
                    "dcat:downloadURL과 spdx:checksum"@ko ,
                    "dcat:downloadURL und spdx:checksum"@de ,
                    "dcat:downloadURL y spdx:checksum"@es ,
                    "dcat:downloadURL et spdx:checksum"@fr ;
    solid-memo:backNote "dcat:downloadURL gives the direct link to the file, and spdx:checksum, which DCAT relates to the download URL, lets a user verify the contents have not changed."@en ,
                        "dcat:downloadURL ger direktlänken till filen, och spdx:checksum, som DCAT kopplar till webbadressen för nedladdning, låter en användare kontrollera att innehållet inte har ändrats."@sv ,
                        "dcat:downloadURL은 파일로 가는 직접 링크를 주고, DCAT이 다운로드 URL과 관련짓는 spdx:checksum은 사용자가 내용이 바뀌지 않았는지 확인할 수 있게 해 줍니다."@ko ,
                        "dcat:downloadURL liefert den direkten Link zur Datei, und mit spdx:checksum, die DCAT auf die Download-URL bezieht, kann ein Nutzer prüfen, ob sich der Inhalt verändert hat."@de ,
                        "dcat:downloadURL da el enlace directo al archivo, y spdx:checksum, que DCAT relaciona con la URL de descarga, permite a un usuario verificar que el contenido no ha cambiado."@es ,
                        "dcat:downloadURL donne le lien direct vers le fichier, et spdx:checksum, que DCAT lie à l’URL de téléchargement, permet à un utilisateur de vérifier que le contenu n’a pas changé."@fr ;
    solid-memo:distractor <#q-distributions-r01-d1> ,
                          <#q-distributions-r01-d2> ,
                          <#q-distributions-r01-d3> .

