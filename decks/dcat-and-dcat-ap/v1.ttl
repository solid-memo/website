<#q-dcat-ap-se-0b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Rejected at harvest, with the whole catalog"@en ,
                              "Avvisas vid skördningen, tillsammans med hela katalogen"@sv ,
                              "하베스팅 때 카탈로그 전체와 함께 거부됨"@ko ,
                              "Beim Harvesting abgelehnt, mit dem ganzen Katalog"@de ,
