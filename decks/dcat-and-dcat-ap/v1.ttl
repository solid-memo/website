<#q-reading-dcat-1c-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Only if a profile declares them equal"@en ,
                              "Bara om en profil förklarar dem likvärdiga"@sv ,
                              "프로파일이 둘을 같다고 선언할 때만"@ko ,
                              "Nur wenn ein Profil sie gleichsetzt"@de ,
