                          <#q-responsibility-2a-d2> ,
                          <#q-responsibility-2a-d3> .

<#q-responsibility-2a-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "dcterms:license"@en ,
                              "dcterms:license"@sv ,
                              "dcterms:license"@ko ,
                              "dcterms:license"@de ,
                              "dcterms:license"@es ,
                              "dcterms:license"@fr ;
    solid-memo:distractorNote "A copyright notice is not a legal document under which the data is made available."@en ,
                              "En upphovsrättsangivelse är inte ett juridiskt dokument enligt vilket data görs tillgängliga."@sv ,
                              "저작권 표시는 데이터를 이용할 수 있게 하는 근거가 되는 법적 문서가 아닙니다."@ko ,
                              "Ein Urheberrechtsvermerk ist kein rechtliches Dokument, unter dem die Daten verfügbar gemacht werden."@de ,
                              "Un aviso de derechos de autor no es un documento jurídico bajo el cual se ponen los datos a disposición."@es ,
                              "Une mention de copyright n’est pas un document juridique sous lequel les données sont mises à disposition."@fr .

<#q-responsibility-2a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "dcterms:accessRights"@en ,
                              "dcterms:accessRights"@sv ,
                              "dcterms:accessRights"@ko ,
                              "dcterms:accessRights"@de ,
                              "dcterms:accessRights"@es ,
                              "dcterms:accessRights"@fr ;
    solid-memo:distractorNote "That says who can access the data, not who holds the copyright."@en ,
                              "Den anger vem som kan komma åt data, inte vem som innehar upphovsrätten."@sv ,
                              "이것은 누가 데이터에 접근할 수 있는지를 말할 뿐, 누가 저작권을 가졌는지를 말하지 않습니다."@ko ,
                              "Das sagt, wer auf die Daten zugreifen kann, nicht, wer das Urheberrecht hält."@de ,
                              "Esa dice quién puede acceder a los datos, no quién tiene los derechos de autor."@es ,
                              "Elle indique qui peut accéder aux données, non qui détient le copyright."@fr .

