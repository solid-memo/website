                              "Chaque CSV ne contient qu’une langue, et le jeu de données devrait indiquer les deux."@fr .

<#q-dcat-model-1c-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Dataset: both languages; each CSV: both"@en ,
                              "Datamängden: båda språken; varje CSV: båda"@sv ,
                              "데이터셋: 두 언어 모두; 각 CSV: 둘 다"@ko ,
