<#q-responsibility-1b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "dcterms:creator"@en ,
                              "dcterms:creator"@sv ,
                              "dcterms:creator"@ko ,
                              "dcterms:creator"@de ,
                              "dcterms:creator"@es ,
                              "dcterms:creator"@fr ;
    solid-memo:distractorNote "That names who produced the data, not a publication that cites it."@en ,
                              "Den anger vem som tog fram data, inte en publikation som citerar dem."@sv ,
                              "이것은 데이터를 만든 주체를 밝힐 뿐, 데이터를 인용한 출판물을 밝히지 않습니다."@ko ,
                              "Das nennt, wer die Daten erzeugt hat, keine Publikation, die sie zitiert."@de ,
                              "Esa nombra a quien produjo los datos, no una publicación que los cita."@es ,
                              "Elle nomme qui a produit les données, non une publication qui les cite."@fr .

