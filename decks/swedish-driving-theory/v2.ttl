      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "På de yttersta 25 procenten av slitbanans bredd"@sv ,
                              "Across the outer 25 percent of the tread's width"@en ;
    solid-memo:distractorNote "Mätningen gäller de mittersta 75 procenten, inte kanterna."@sv ,
                              "The measurement covers the middle 75 percent, not the edges."@en .

<#q-vehicle-2b-d2>
