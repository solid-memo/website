    solid-memo:distractorNote "Högerregeln gäller inte här; den som kommer från vägrenen väjer."@sv ,
                              "The right-hand rule does not apply here; whoever comes from the hard shoulder gives way."@en .

<#q-crossings-4b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Ingen, eftersom vägrenen hör till vägen"@sv ,
