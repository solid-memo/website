      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Spårvagnen ska lämna fri väg för dig"@sv ,
                              "The streetcar must leave the way clear for you"@en ;
    solid-memo:distractorNote "Tvärtom: utan ett vägmärke som säger något annat ska du lämna fri väg för spårvagnen."@sv ,
                              "The opposite: without a road sign saying otherwise, you must leave the way clear for the streetcar."@en .

<#q-meeting-5b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Den som har den andra till höger om sig"@sv ,
