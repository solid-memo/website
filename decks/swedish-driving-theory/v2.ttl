    solid-memo:distractorNote "Det är de mittersta 75 procenten, inte 50 procent."@sv ,
                              "It is the middle 75 percent, not 50 percent."@en .

<#q-vehicle-2c>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
