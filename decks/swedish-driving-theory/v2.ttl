                              "The law says the license must be revoked. Fines do not replace that."@en .

<#q-attitudes-2a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Det får en ny prövotid"@sv ,
