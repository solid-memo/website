    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Bara en ansökan när spärrtiden är slut"@sv ,
                              "Only an application when the waiting period ends"@en ;
    solid-memo:distractorNote "Det kan räcka om det hände efter prövotiden, men inte när det hände under prövotiden."@sv ,
                              "That can be enough if it happened after the probation period, but not when it happened during it."@en .

<#q-attitudes-r01-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Bara ett nytt kunskapsprov, inget körprov"@sv ,
