                              "A warning instead of revocation exists only for driving under the influence under 0.5 per mille, not for aggravated driving under the influence."@en .

<#q-driver-2a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Det återkallas bara vid olycka"@sv ,
