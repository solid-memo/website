                              "Alcohol impairs reaction time but also affects decisions, through lowered inhibitions."@en .

<#q-driver-0b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Föraren blir mer vaksam på risker runt bilen"@sv ,
