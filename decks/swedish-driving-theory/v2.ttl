<#q-crossings-4b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Du har stannat på vägrenen och ska köra ut på körbanan igen. Vem ska väja?"@sv ,
                     "You have stopped on the hard shoulder and are about to pull back out onto the roadway. Who must give way?"@en ;
    solid-memo:back "Du, mot fordonen på körbanan"@sv ,
                    "You, to the vehicles on the roadway"@en ;
    solid-memo:backNote "Den som kör in på körbanan från vägrenen har väjningsplikt mot fordon på körbanan (trafikförordningen 3 kap. 21 § tredje stycket)."@sv ,
                        "Whoever enters the roadway from the hard shoulder has a duty to give way to vehicles on the roadway (the Traffic Ordinance, chapter 3, section 21, third paragraph)."@en ;
    solid-memo:distractor <#q-crossings-4b-d1> ,
                          <#q-crossings-4b-d2> ,
                          <#q-crossings-4b-d3> .

<#q-crossings-4b-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Fordonen som närmar sig på körbanan"@sv ,
                              "The vehicles approaching on the roadway"@en ;
    solid-memo:distractorNote "Tvärtom: det är du som kommer från vägrenen som ska väja."@sv ,
                              "The other way around: you, coming from the hard shoulder, are the one who must give way."@en .

<#q-crossings-4b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Den som har den andra till höger"@sv ,
