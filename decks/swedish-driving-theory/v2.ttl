<#q-environment-7a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Polisen, genom beslut efter mätningar av luften"@sv ,
                              "The police, through decisions after measuring the air"@en ;
    solid-memo:distractorNote "Polisen bestämmer inte miljözoner; kommunen gör det genom lokala trafikföreskrifter."@sv ,
                              "The police do not decide environmental zones; the municipality does, through local traffic regulations."@en .

<#q-environment-7b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vilken utsläppsklass måste en dieselpersonbil minst klara för att få köras i miljözon klass 2?"@sv ,
