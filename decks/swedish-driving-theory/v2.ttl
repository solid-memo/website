                              "You may not drive on the median strip or on crossover roads between the roadways, and you may not turn around."@en .

<#q-roads-1b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Stannar på vägrenen och vänder när det är tomt"@sv ,
