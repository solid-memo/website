    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Nej, under gränsvärdet är det aldrig rattfylleri"@sv ,
                              "No, under the limit it is never driving under the influence"@en ;
    solid-memo:distractorNote "Den som är så påverkad att den inte kan köra betryggande döms även under gränsen."@sv ,
                              "Anyone so impaired that they cannot drive safely is convicted even under the limit."@en .

<#q-driver-1c-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Ja, men bara om du kör inom tättbebyggt område"@sv ,
                              "Yes, but only if you drive within a built-up area"@en ;
