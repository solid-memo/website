      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Du får köra om du håller lägre hastighet än vanligt"@sv ,
                              "You may drive if you keep a lower speed than usual"@en ;
    solid-memo:distractorNote "Lägre fart gör det inte tillåtet. Kan du inte köra betryggande får du inte köra alls."@sv ,
                              "A lower speed does not make it allowed. If you cannot drive safely, you must not drive at all."@en .

<#q-driver-0a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Regeln gäller bara alkohol, inte sjukdom eller trötthet"@sv ,
                              "The rule applies only to alcohol, not illness or fatigue"@en ;
    solid-memo:distractorNote "Regeln räknar uttryckligen upp både sjukdom och uttröttning, inte bara alkohol."@sv ,
                              "The rule expressly lists both illness and exhaustion, not only alcohol."@en .

<#q-driver-0a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Du får köra korta sträckor inom tättbebyggt område"@sv ,
