    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Halvvägs in på övergångsstället, så att gående kan gå runt"@sv ,
                              "Halfway onto the pedestrian crossing, so pedestrians can walk around"@en ;
    solid-memo:distractorNote "Också halvvägs in står du på övergångsstället, och det ska du undvika."@sv ,
                              "Even halfway onto it, you are standing on the pedestrian crossing, and you must avoid that."@en .

<#q-vulnerable-3a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Var som helst, bara du släpper fram gående"@sv ,
