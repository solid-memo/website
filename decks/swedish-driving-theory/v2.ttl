    solid-memo:distractorNote "Förordningen kräver två körbanor skilda åt, inte ett visst antal körfält."@sv ,
                              "The ordinance requires two separate roadways, not a particular number of lanes."@en .

<#q-roads-0b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:frontImage <https://upload.wikimedia.org/wikipedia/commons/0/01/Sweden_road_sign_E3.svg> ;
    solid-memo:frontImageDescription "En blå kvadrat med en vit bil sedd från sidan"@sv ,
                                     "A blue square with a white car seen from the side"@en ;
    solid-memo:front "Vad betyder märket?"@sv ,
                     "What does the sign mean?"@en ;
    solid-memo:back "Att en motortrafikled börjar"@sv ,
                    "That an expressway begins"@en ;
    solid-memo:backNote "Märke E3, motortrafikled. Reglerna för motortrafikled gäller fram till slutmärket E4, eller tills vägen övergår i motorväg (vägmärkesförordningen 2 kap. 11 och 12 §§)."@sv ,
                        "Sign E3, expressway. The rules for expressways apply up to the end sign E4, or until the road becomes a motorway (the Road Signs Ordinance, chapter 2, sections 11 and 12)."@en ;
    solid-memo:distractor <#q-roads-0b-d1> ,
                          <#q-roads-0b-d2> ,
                          <#q-roads-0b-d3> .

<#q-roads-0b-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Att en motorväg börjar"@sv ,
                              "That a motorway begins"@en ;
    solid-memo:distractorNote "Motorväg anges med märke E1, med en väg som går under en bro."@sv ,
                              "A motorway is marked with sign E1, with a road running under a bridge."@en .

<#q-roads-0b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Att en motortrafikled upphör"@sv ,
                              "That an expressway ends"@en ;
