    solid-memo:distractorNote "Systemen har begränsningar. Bromssträckan beror fortfarande på greppet mellan däcken och vägen."@sv ,
                              "The systems have limitations. The braking distance still depends on the grip between the tires and the road."@en .

<#q-distance-6a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Ersätta vinterdäcken när det är vinterväglag"@sv ,
