    solid-memo:back "Vitt eller gult"@sv ,
                    "White or yellow"@en ;
    solid-memo:backNote "Från ett fordon på väg får inte annat än vitt eller gult ljus visas framåt, utom lyktor med annan färg som är föreskriven för fordonet (trafikförordningen 3 kap. 76 §)."@sv ,
                        "A vehicle on the road may show only white or yellow light to the front, except lamps of another color prescribed for the vehicle (the Traffic Ordinance, chapter 3, section 76)."@en ;
    solid-memo:distractor <#q-vehicle-4a-d1> ,
                          <#q-vehicle-4a-d2> ,
                          <#q-vehicle-4a-d3> .

