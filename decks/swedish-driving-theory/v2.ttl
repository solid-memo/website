    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Alltid till höger om varandra, som vid andra möten"@sv ,
                              "Always to the right of each other, as in other encounters"@en ;
    solid-memo:distractorNote "Regeln tillåter just här att de håller till vänster om varandra, om det går utan fara."@sv ,
                              "Here, specifically, the rule allows them to keep to the left of each other, if it causes no danger."@en .

<#q-crossings-6c-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Till vänster om varandra, bara om en polis visar det"@sv ,
