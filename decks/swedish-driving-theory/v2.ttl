    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Backar längs vägrenen till avfarten"@sv ,
                              "Back up along the hard shoulder to the exit"@en ;
    solid-memo:distractorNote "Du får varken stanna eller backa på en motorväg."@sv ,
                              "You may neither stop nor back up on a motorway."@en .

<#q-roads-1b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Vänder via en förbindelseväg i skiljeremsan"@sv ,
