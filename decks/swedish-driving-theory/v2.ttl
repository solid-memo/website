                              "Inside the tunnel the sign gives the distance that is left, not the distance you have driven."@en .

<#q-roads-4b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vid infarten till en tunnel blinkar två röda ljus växelvis. Vad gör du?"@sv ,
                     "At the entrance to a tunnel, two red lights are flashing alternately. What do you do?"@en ;
    solid-memo:back "Stannar före stopplinjen, eller före signalen om stopplinje saknas"@sv ,
                    "Stop before the stop line, or before the signal if there is no stop line"@en ;
    solid-memo:backNote "Växelvis blinkande rött ljus vid bland annat tunnel betyder stopp (vägmärkesförordningen 3 kap. 19 och 20 §§)."@sv ,
                        "Alternately flashing red lights at tunnels, among other places, mean stop (the Road Signs Ordinance, chapter 3, sections 19 and 20)."@en ;
    solid-memo:distractor <#q-roads-4b-d1> ,
                          <#q-roads-4b-d2> ,
                          <#q-roads-4b-d3> .

<#q-roads-4b-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Saktar in och kör in om tunneln ser tom ut"@sv ,
                              "Slow down and drive in if the tunnel looks empty"@en ;
    solid-memo:distractorNote "Signalen betyder stopp, oavsett hur det ser ut i tunneln."@sv ,
                              "The signal means stop, no matter how things look in the tunnel."@en .

