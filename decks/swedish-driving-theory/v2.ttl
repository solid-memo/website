    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Du får göra provet, den gäller tills du har körkort"@sv ,
                              "You may take the test, it is valid until you have a license"@en ;
    solid-memo:distractorNote "Riskutbildningen gäller längst tills du har fått körkortet, men aldrig mer än fem år."@sv ,
                              "The risk training is valid at most until you have received your license, but never for more than five years."@en .

