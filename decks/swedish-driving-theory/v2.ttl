    solid-memo:distractorNote "Det är just så du kör sparsamt; aggressiv körning är tvärtom."@sv ,
                              "That is exactly how you drive fuel-efficiently; aggressive driving is the opposite."@en .

<#q-environment-2b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hur påverkar en hög hastighet bilens bränsleförbrukning?"@sv ,
                     "How does a high speed affect the car's fuel consumption?"@en ;
    solid-memo:back "Förbrukningen ökar kraftigt"@sv ,
                    "Consumption rises sharply"@en ;
    solid-memo:backNote "Hög hastighet ökar bränsleförbrukningen kraftigt. Europeiska miljöbyrån (EEA), Explaining road transport emissions, 2016."@sv ,
                        "A high speed sharply increases fuel consumption. European Environment Agency (EEA), Explaining road transport emissions, 2016."@en ;
    solid-memo:distractor <#q-environment-2b-d1> ,
                          <#q-environment-2b-d2> ,
                          <#q-environment-2b-d3> .

