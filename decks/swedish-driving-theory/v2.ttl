    solid-memo:back "Föraren blir mer självsäker och tar större risker"@sv ,
                    "The driver becomes more confident and takes bigger risks"@en ;
    solid-memo:backNote "Alkohol minskar hämningarna, ökar självsäkerheten och gör att föraren tar större risker, till exempel kör för fort. ERSO, Alcohol and drugs, avsnitt 1.3."@sv ,
                        "Alcohol lowers inhibitions, increases confidence and makes the driver take bigger risks, such as driving too fast. ERSO, Alcohol and drugs, section 1.3."@en ;
    solid-memo:distractor <#q-driver-0b-d1> ,
                          <#q-driver-0b-d2> ,
                          <#q-driver-0b-d3> .

<#q-driver-0b-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Föraren blir försiktigare och kör långsammare"@sv ,
                              "The driver becomes more careful and drives more slowly"@en ;
    solid-memo:distractorNote "Tvärtom: alkohol ökar risktagandet, till exempel att köra för fort."@sv ,
                              "On the contrary: alcohol increases risk-taking, such as driving too fast."@en .

<#q-driver-0b-d2>
    a solid-memo:Distractor ,
