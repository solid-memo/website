                              "That is shown by the Escape route sign, E29."@en .

<#q-roads-4a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Hur lång sträcka du redan har kört i tunneln"@sv ,
