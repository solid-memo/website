                              "Yes, if you are also wearing your belt"@en ;
    solid-memo:distractorNote "Bältet hjälper, men vid hög fart räcker inte bilens skydd."@sv ,
                              "The belt helps, but at high speed the car's protection is not enough."@en .

<#q-vehicle-5c-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Ja, de tar upp all kraft i krocken"@sv ,
