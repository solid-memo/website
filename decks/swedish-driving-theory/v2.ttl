    solid-memo:distractorNote "Andra fordon kör du om till vänster, men en spårvagn kör du om till höger."@sv ,
                              "You overtake other vehicles on the left, but you overtake a streetcar on the right."@en .

<#q-meeting-5a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Spårvagnen får inte köras om"@sv ,
