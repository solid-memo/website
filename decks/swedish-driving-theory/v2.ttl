<#q-attitudes-3b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Från vilken dag räknas prövotiden?"@sv ,
                     "From which day is the probation period counted?"@en ;
    solid-memo:back "Från dagen för förarprovet"@sv ,
                    "From the day of the license test"@en ;
    solid-memo:backNote "Prövotiden gäller från dagen för provet. Körkortslagen 3 kap. 18 §."@sv ,
                        "The probation period runs from the day of the test. The Driving License Act, chapter 3, section 18."@en ;
    solid-memo:distractor <#q-attitudes-3b-d1> ,
                          <#q-attitudes-3b-d2> ,
                          <#q-attitudes-3b-d3> .

<#q-attitudes-3b-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Från dagen körkortet lämnas ut"@sv ,
                              "From the day the license is handed out"@en ;
    solid-memo:distractorNote "Prövotiden räknas från provdagen, inte från när du får kortet."@sv ,
                              "The probation period is counted from the test day, not from when you receive the card."@en .

<#q-attitudes-3b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Från dagen för körkortstillståndet"@sv ,
                              "From the day of the learner's permit"@en ;
    solid-memo:distractorNote "Körkortstillståndet får du före provet. Prövotiden börjar på provdagen."@sv ,
                              "You get the learner's permit before the test. The probation period starts on the test day."@en .

<#q-attitudes-3b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Från dagen du fyller 18 år"@sv ,
                              "From the day you turn 18"@en ;
