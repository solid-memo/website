    solid-memo:distractorNote "Du ska stanna innan du kör in på den korsande vägen, inte inne i korsningen."@sv ,
                              "You must stop before you enter the crossing road, not inside the intersection."@en .

<#q-crossings-2a-d3>
    a solid-memo:Distractor ,
