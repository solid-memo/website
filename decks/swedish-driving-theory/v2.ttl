    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Aldrig, eftersom narkolepsi alltid är ett hinder för körkort B"@sv ,
                              "Never, because narcolepsy is always an obstacle to a B license"@en ;
    solid-memo:distractorNote "Narkolepsi är inte alltid ett hinder för B, om behandlingen fungerar och attackerna har upphört."@sv ,
                              "Narcolepsy is not always an obstacle to a B license, if the treatment works and the attacks have stopped."@en .

<#q-driver-5b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "När du lovar att bara köra dagtid och på kortare sträckor"@sv ,
