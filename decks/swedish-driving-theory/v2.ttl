    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Du har svängt i en korsning och ska passera ett bevakat övergångsställe. Hur ska du köra?"@sv ,
                     "You have turned at an intersection and are about to pass a controlled pedestrian crossing. How must you drive?"@en ;
    solid-memo:back "Med låg hastighet, och väja för gående som gått ut eller ska gå ut"@sv ,
                    "At low speed, giving way to pedestrians who have stepped out or are about to"@en ;
