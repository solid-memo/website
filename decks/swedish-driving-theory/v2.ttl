                              "A yellow arrow means you must change lanes, not stop."@en .

<#q-roads-5b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Stannar kvar i körfältet men sänker farten"@sv ,
