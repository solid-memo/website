    solid-memo:back "När den är en trafiksäkerhetsrisk som inte är obetydlig"@sv ,
                    "When it is a road safety risk that is not negligible"@en ;
    solid-memo:backNote "Varje sjukdom eller skada som kan påverka körförmågan bedöms från trafiksäkerhetssynpunkt; en risk som inte är obetydlig är ett hinder. TSFS 2010:125 1 kap. 4 §."@sv ,
                        "Every illness or injury that can affect driving ability is assessed from a road safety point of view; a risk that is not negligible is an obstacle. TSFS 2010:125, chapter 1, section 4."@en ;
    solid-memo:distractor <#q-driver-4b-d1> ,
                          <#q-driver-4b-d2> ,
                          <#q-driver-4b-d3> .

<#q-driver-4b-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Bara när den gör att du måste ligga på sjukhus"@sv ,
                              "Only when it means you have to stay in the hospital"@en ;
