                        "In darkness, at dusk and at dawn, the load must be marked at the rear with a lamp showing red light to the rear and with red reflectors (the Traffic Ordinance, chapter 3, section 82, second paragraph)."@en ;
    solid-memo:distractor <#q-vehicle-7c-d1> ,
                          <#q-vehicle-7c-d2> ,
                          <#q-vehicle-7c-d3> .

<#q-vehicle-7c-d1>
    a solid-memo:Distractor ,
