    solid-memo:distractorNote "Kursplanen säger att trötthet ökar olycks- och skaderisken."@sv ,
                              "The syllabus says that fatigue increases the risk of crashes and injuries."@en .

<#q-driver-5a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Den ökar risken bara på mycket långa resor"@sv ,
                              "It increases the risk only on very long trips"@en ;
    solid-memo:distractorNote "Kursplanen begränsar inte risken till långa resor."@sv ,
                              "The syllabus does not limit the risk to long trips."@en .

<#q-driver-5a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Den ökar risken bara för förare med sömnsjukdom"@sv ,
