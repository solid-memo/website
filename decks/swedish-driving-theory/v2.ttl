    solid-memo:distractorNote "Att du blinkar ändrar inte din väjningsplikt."@sv ,
                              "Signaling doesn't change your duty to give way."@en .

<#q-roads-2c>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Du ska lämna motorvägen och det finns ett retardationsfält. När kör du in i det?"@sv ,
                     "You are going to leave the motorway, and there is a deceleration lane. When do you move into it?"@en ;
    solid-memo:back "Så snart som möjligt"@sv ,
                    "As soon as possible"@en ;
    solid-memo:backNote "Trafikförordningen 3 kap. 23 § andra stycket. Lägg dig också i god tid i det körfält som passar bäst för att lämna vägen."@sv ,
                        "The Traffic Ordinance, chapter 3, section 23, second paragraph. Also move in good time into the lane best suited for leaving the road."@en ;
    solid-memo:distractor <#q-roads-2c-d1> ,
                          <#q-roads-2c-d2> .

<#q-roads-2c-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Först precis vid avfarten"@sv ,
