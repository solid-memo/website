                              "With a duty to stop, you must always stop, even when the road is clear."@en .

<#q-crossings-2b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
