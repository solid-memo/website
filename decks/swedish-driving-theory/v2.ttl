<#q-attitudes-3a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Sex månader"@sv ,
                              "Six months"@en ;
    solid-memo:distractorNote "Så kort prövotid finns inte. För B är den två år."@sv ,
