                              "The tire's inner tube"@en ;
    solid-memo:distractorNote "Föreskriften talar om armeringen, den förstärkning som finns inuti däcket."@sv ,
                              "The regulation talks about the reinforcement, the strengthening layer inside the tire."@en .

<#q-vehicle-2c-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
