                              "The regulation talks about the middle 75 percent of the width."@en .

<#q-vehicle-2b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "På de mittersta 50 procenten av slitbanans bredd"@sv ,
