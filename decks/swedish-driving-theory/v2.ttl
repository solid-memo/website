                              "M+S is only enough on certain axles of vehicles and trailers over 3,500 kg, not on a passenger car."@en .

<#q-distance-4c-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "En snöflinga utan alptopp"@sv ,
                              "A snowflake without a mountain peak"@en ;
