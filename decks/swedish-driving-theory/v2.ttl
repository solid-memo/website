    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vad upplyser vägmarkeringen Hastighet på körbanan om?"@sv ,
                     "What does the Speed road marking on the roadway tell you?"@en ;
    solid-memo:back "Högsta tillåtna hastighet"@sv ,
                    "The maximum permitted speed"@en ;
    solid-memo:backNote "Markering M29, hastighet, upplyser om högsta tillåtna hastighet. Vägmärkesförordningen 4 kap. 9 §."@sv ,
                        "Marking M29, speed, tells you the maximum permitted speed. The Road Signs Ordinance, chapter 4, section 9."@en ;
