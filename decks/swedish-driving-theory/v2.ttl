    solid-memo:distractorNote "Regeln skyddar andra trafikanter, inte din bil."@sv ,
                              "The rule protects other road users, not your car."@en .

<#q-speed-1b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Så att smutsen inte skymmer din vindruta"@sv ,
