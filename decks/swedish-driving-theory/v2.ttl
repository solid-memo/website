<#q-signals-4c>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "En gående är ute på körbanan när gångsignalen slår om till rött. Det finns ingen refug. Vad ska den gående göra?"@sv ,
                     "A pedestrian is out on the roadway when the pedestrian signal changes to red. There is no traffic island. What should the pedestrian do?"@en ;
    solid-memo:back "Gå vidare till andra sidan"@sv ,
                    "Keep walking to the other side"@en ;
    solid-memo:backNote "Den som är på körbanan när signalen slår om till rött ska fortsätta till andra sidan, eller stanna på refugen om det finns en. Vägmärkesförordningen 3 kap. 8 §."@sv ,
                        "Anyone who is on the roadway when the signal changes to red must continue to the other side, or stop on the traffic island if there is one. The Road Signs Ordinance, chapter 3, section 8."@en ;
    solid-memo:distractor <#q-signals-4c-d1> ,
                          <#q-signals-4c-d2> ,
                          <#q-signals-4c-d3> .

