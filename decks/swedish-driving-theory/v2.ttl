    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:frontImage <https://upload.wikimedia.org/wikipedia/commons/9/95/Sweden_road_sign_B8.svg> ;
    solid-memo:frontImageDescription "En blå kvadrat med en vit triangel och en svart cykel"@sv ,
                                     "A blue square with a white triangle and a black bicycle"@en ;
    solid-memo:front "Vad betyder märket för dig som kör bil?"@sv ,
                     "What does the sign mean for you as a car driver?"@en ;
    solid-memo:back "Du ska väja för cyklister som är på eller ska ut på överfarten"@sv ,
                    "You must give way to cyclists on or about to enter the crossing"@en ;
    solid-memo:backNote "Märke B8, cykelöverfart. Du väjer för cyklister och förare av moped klass II som är ute på eller just ska ut på den (trafikförordningen 3 kap. 61 a §)."@sv ,
                        "Sign B8, bicycle crossing. You give way to cyclists and class II moped riders who are on it or just about to ride onto it (the Traffic Ordinance, chapter 3, section 61 a)."@en ;
    solid-memo:distractor <#q-vulnerable-2a-d1> ,
                          <#q-vulnerable-2a-d2> ,
                          <#q-vulnerable-2a-d3> .

<#q-vulnerable-2a-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Cyklister som korsar här ska väja för dig"@sv ,
                              "Cyclists crossing here must give way to you"@en ;
    solid-memo:distractorNote "Tvärtom: vid en cykelöverfart är det du som har väjningsplikt."@sv ,
                              "The opposite: at a bicycle crossing, you are the one with the duty to give way."@en .

<#q-vulnerable-2a-d2>
