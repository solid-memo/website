                     "A yellow arrow pointing diagonally down to the left is lit above your lane. What do you do?"@en ;
    solid-memo:back "Byter till körfältet till vänster"@sv ,
                    "Move into the lane on the left"@en ;
    solid-memo:backNote "Gul pil: föraren ska byta körfält i den riktning pilen anger (vägmärkesförordningen 3 kap. 15 §)."@sv ,
                        "Yellow arrow: the driver must change lanes in the direction the arrow shows (the Road Signs Ordinance, chapter 3, section 15)."@en ;
    solid-memo:distractor <#q-roads-5b-d1> ,
                          <#q-roads-5b-d2> ,
                          <#q-roads-5b-d3> .

<#q-roads-5b-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Byter till körfältet till höger"@sv ,
                              "Move into the lane on the right"@en ;
    solid-memo:distractorNote "Du byter åt det håll pilen pekar, alltså åt vänster."@sv ,
                              "You move in the direction the arrow points, that is, to the left."@en .

<#q-roads-5b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Stannar och väntar på grön pil"@sv ,
