                              "The basic requirement is 1.6 mm, not 2 mm."@en .

<#q-vehicle-2a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "2,5 mm"@sv ,
                              "2.5 mm"@en ;
    solid-memo:distractorNote "Grundkravet är 1,6 mm, inte 2,5 mm."@sv ,
                              "The basic requirement is 1.6 mm, not 2.5 mm."@en .

<#q-vehicle-2b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-19T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Var på slitbanan mäts hur mycket som är kvar av däckets huvudmönster?"@sv ,
                     "Where on the tread is it measured how much of the tire's main tread grooves is left?"@en ;
    solid-memo:back "På de mittersta 75 procenten av slitbanans bredd"@sv ,
                    "Across the middle 75 percent of the tread's width"@en ;
    solid-memo:backNote "Det kvarvarande profildjupet i huvudmönstret räknas i de mittersta 75 procenten av slitbanans bredd (TSFS 2009:19 4 §)."@sv ,
                        "The remaining tread depth in the main grooves is counted across the middle 75 percent of the tread's width (TSFS 2009:19, section 4)."@en ;
    solid-memo:distractor <#q-vehicle-2b-d1> ,
                          <#q-vehicle-2b-d2> ,
                          <#q-vehicle-2b-d3> .

