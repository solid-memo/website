                              "The distance makes no difference. If you cannot drive safely, you must not drive."@en .

<#q-driver-3b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Ja, om du inte har druckit någon alkohol"@sv ,
                              "Yes, if you have not drunk any alcohol"@en ;
