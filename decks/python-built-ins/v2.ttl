<https://www.wikidata.org/wiki/Wikidata:Main_Page>
    dcterms:title "Wikidata: Swedish labels and aliases of programming terms (list, string, integer, floating point, tuple, set, iterator, absolute value, computer file, function, standard output, list comprehension, associative array)" ;
