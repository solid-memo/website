    rdfs:comment "Footer of https://sv.wikipedia.org/wiki/Flyttal (fetched 2026-10-04): \"Wikipedias text är tillgänglig under licensen Creative Commons Erkännande-dela-lika 4.0 Unported.\""@en .

<#len>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The number of items in the list xs"@en ,
                     "Antalet element i listan xs"@sv ;
    solid-memo:back "len(xs)"@zxx .

<#range-stop>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The integers 0, 1, …, n − 1 as a range object"@en ,
                     "Heltalen 0, 1, …, n − 1 som ett range-objekt"@sv ;
    solid-memo:back "range(n)"@zxx ;
    solid-memo:backNote "range(0, n) is the same; n itself is not included."@en ,
                        "range(0, n) är samma sak; n ingår inte."@sv .

<#range-start-stop>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The integers a, a + 1, …, b − 1 as a range object"@en ,
                     "Heltalen a, a + 1, …, b − 1 som ett range-objekt"@sv ;
    solid-memo:back "range(a, b)"@zxx .

<#enumerate>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An iterator of pairs (index, item) for the items of xs, counting from 0"@en ,
                     "En iterator med par (index, element) för elementen i xs, räknat från 0"@sv ;
    solid-memo:back "enumerate(xs)"@zxx ;
    solid-memo:backNote "An enumerate object; list(enumerate(xs)) gives the pairs as a list."@en ,
                        "Ett enumerate-objekt; list(enumerate(xs)) ger paren som en lista."@sv .

<#enumerate-start>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An iterator of pairs (number, item) for the items of xs, numbered from 1"@en ,
                     "En iterator med par (nummer, element) för elementen i xs, numrerade från 1"@sv ;
    solid-memo:back "enumerate(xs, start=1)"@zxx ;
    solid-memo:backNote "enumerate(xs, 1) does the same."@en ,
                        "enumerate(xs, 1) gör samma sak."@sv .

<#zip>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An iterator of pairs (x, y) of the items at the same positions in xs and ys"@en ,
                     "En iterator med par (x, y) av elementen på samma platser i xs och ys"@sv ;
    solid-memo:back "zip(xs, ys)"@zxx ;
    solid-memo:backNote "It stops when the shorter list runs out."@en ,
                        "Den slutar när den kortare listan tar slut."@sv .

<#sorted>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A new list of the items of xs in ascending order"@en ,
                     "En ny lista med elementen i xs i stigande ordning"@sv ;
    solid-memo:back "sorted(xs)"@zxx ;
    solid-memo:backNote "xs itself is not changed; xs.sort() sorts it in place instead."@en ,
                        "xs själv ändras inte; xs.sort() sorterar i stället listan på plats."@sv .

<#sorted-reverse>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A new list of the items of xs in descending order"@en ,
                     "En ny lista med elementen i xs i fallande ordning"@sv ;
    solid-memo:back "sorted(xs, reverse=True)"@zxx .

<#reversed>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An iterator over the items of xs from last to first"@en ,
                     "En iterator över elementen i xs från sista till första"@sv ;
    solid-memo:back "reversed(xs)"@zxx .

<#slice-reverse>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A new list of the items of xs in reverse order, using slicing"@en ,
                     "En ny lista med elementen i xs i omvänd ordning, med slicing"@sv ;
    solid-memo:back "xs[::-1]"@zxx ;
    solid-memo:backNote "A slice with step -1."@en ,
                        "En slice med steg -1."@sv .

<#sum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The sum of the numbers in xs"@en ,
                     "Summan av talen i xs"@sv ;
    solid-memo:back "sum(xs)"@zxx ;
    solid-memo:backNote "0 for an empty xs."@en ,
                        "0 om xs är tom."@sv .

<#min>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The smallest item in xs"@en ,
                     "Det minsta elementet i xs"@sv ;
    solid-memo:back "min(xs)"@zxx .

<#max>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The largest item in xs"@en ,
                     "Det största elementet i xs"@sv ;
    solid-memo:back "max(xs)"@zxx .

<#abs>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The absolute value of the number x"@en ,
                     "Absolutbeloppet av talet x"@sv ;
    solid-memo:back "abs(x)"@zxx .

<#round>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The number x rounded to the nearest integer"@en ,
                     "Talet x avrundat till närmaste heltal"@sv ;
    solid-memo:back "round(x)"@zxx ;
    solid-memo:backNote "Halves go to the even integer: round(2.5) is 2 and round(3.5) is 4."@en ,
                        "Vid exakt hälften väljs det jämna heltalet: round(2.5) är 2 och round(3.5) är 4."@sv .

<#round-digits>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The number x rounded to two decimal places"@en ,
                     "Talet x avrundat till två decimaler"@sv ;
    solid-memo:back "round(x, 2)"@zxx ;
    solid-memo:backNote "The result is a number; for text with two decimals, use f\"{x:.2f}\"."@en ,
                        "Resultatet är ett tal; för text med två decimaler, använd f\"{x:.2f}\"."@sv .

<#int>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The string s, such as \"42\", converted to an integer"@en ,
                     "Strängen s, till exempel ”42”, omvandlad till ett heltal"@sv ;
    solid-memo:back "int(s)"@zxx .

<#float>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The string s, such as \"3.5\", converted to a floating-point number"@en ,
                     "Strängen s, till exempel ”3.5”, omvandlad till ett flyttal"@sv ;
    solid-memo:back "float(s)"@zxx .

<#str>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The number n converted to a string"@en ,
                     "Talet n omvandlat till en sträng"@sv ;
    solid-memo:back "str(n)"@zxx ;
    solid-memo:backNote "f\"{n}\" gives the same string."@en ,
                        "f\"{n}\" ger samma sträng."@sv .

<#list-chars>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A list of the characters of the string s"@en ,
                     "En lista med tecknen i strängen s"@sv ;
    solid-memo:back "list(s)"@zxx .

<#dict-pairs>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A dict built from pairs, a list of (key, value) tuples"@en ,
                     "Ett dict-objekt byggt av pairs, en lista med tupler (nyckel, värde)"@sv ;
    solid-memo:back "dict(pairs)"@zxx ;
    solid-memo:backNote "A repeated key keeps the value from its last pair."@en ,
                        "En upprepad nyckel får värdet från sitt sista par."@sv .

<#set>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The items of xs without duplicates, as a set"@en ,
                     "Elementen i xs utan dubbletter, som en mängd"@sv ;
    solid-memo:back "set(xs)"@zxx ;
    solid-memo:backNote "A set has no defined order."@en ,
                        "En mängd har ingen bestämd ordning."@sv .

<#tuple>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The list xs converted to a tuple"@en ,
                     "Listan xs omvandlad till en tupel"@sv ;
    solid-memo:back "tuple(xs)"@zxx .

<#isinstance>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Whether x is an int, counting subclasses of int too"@en ,
                     "Om x är en int, underklasser till int inräknade"@sv ;
    solid-memo:back "isinstance(x, int)"@zxx ;
    solid-memo:backNote "It also gives True for True and False, since bool is a subclass of int; type(x) is int ignores subclasses."@en ,
                        "Ger alltså True även för True och False, eftersom bool är en underklass till int; type(x) is int bortser från underklasser."@sv .

<#type>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The type (class) of the object x"@en ,
                     "Typen (klassen) för objektet x"@sv ;
    solid-memo:back "type(x)"@zxx .

<#print>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Write x to standard output, followed by a newline"@en ,
                     "Skriv x till standard output, följt av en radbrytning"@sv ;
    solid-memo:back "print(x)"@zxx .

<#input>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Read a line typed by the user, after showing the prompt \"Name: \""@en ,
                     "Läs en rad som användaren skriver, efter att ha visat ledtexten ”Name: ”"@sv ;
    solid-memo:back "input(\"Name: \")"@zxx ;
    solid-memo:backNote "Returns the line as a string, without the newline."@en ,
                        "Ger raden som en sträng, utan radbrytningen."@sv .

<#open-read>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Open the text file at path for reading"@en ,
                     "Öppna textfilen på sökvägen path för läsning"@sv ;
    solid-memo:back "open(path)"@zxx ;
    solid-memo:backNote "Mode \"r\" is the default, so open(path, \"r\") is the same. Without encoding=…, Python 3.14 and earlier use the locale's encoding; from 3.15 the default is UTF-8."@en ,
                        "Läget \"r\" är förvalt, så open(path, \"r\") är samma sak. Utan encoding=… använder Python 3.14 och tidigare teckenkodningen från systemets språkinställning; från 3.15 är UTF-8 förvalt."@sv .

<#open-write>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Open the text file at path for writing, emptying it first"@en ,
                     "Öppna textfilen på sökvägen path för skrivning, så att den först töms"@sv ;
    solid-memo:back "open(path, \"w\")"@zxx ;
    solid-memo:backNote "Creates the file if it does not exist."@en ,
                        "Skapar filen om den inte finns."@sv .

<#file-read>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The whole contents of the open text file f, as one string"@en ,
                     "Hela innehållet i den öppna textfilen f, som en sträng"@sv ;
    solid-memo:back "f.read()"@zxx ;
    solid-memo:backNote "Reads from the current position to the end; at the end it gives \"\"."@en ,
                        "Läser från aktuell position till slutet; vid slutet ger den \"\"."@sv .

<#any>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Whether at least one item of xs counts as true"@en ,
                     "Om minst ett element i xs räknas som sant"@sv ;
    solid-memo:back "any(xs)"@zxx ;
    solid-memo:backNote "False for an empty xs."@en ,
                        "False om xs är tom."@sv .

<#all>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Whether every item of xs counts as true"@en ,
                     "Om alla element i xs räknas som sanna"@sv ;
    solid-memo:back "all(xs)"@zxx ;
    solid-memo:backNote "True for an empty xs."@en ,
                        "True om xs är tom."@sv .

<#map>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An iterator of f(x) for each item x of xs, with a call to a built-in function"@en ,
                     "En iterator med f(x) för varje element x i xs, med ett anrop av en inbyggd funktion"@sv ;
    solid-memo:back "map(f, xs)"@zxx .

<#filter>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An iterator over the items x of xs for which f(x) counts as true, with a call to a built-in function"@en ,
                     "En iterator över de element x i xs för vilka f(x) räknas som sant, med ett anrop av en inbyggd funktion"@sv ;
    solid-memo:back "filter(f, xs)"@zxx .

<#listcomp-map>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A list of f(x) for each item x of xs, written as a list comprehension"@en ,
                     "En lista med f(x) för varje element x i xs, skriven som en list comprehension"@sv ;
    solid-memo:back "[f(x) for x in xs]"@zxx ;
    solid-memo:backNote "The loop variable may have any name."@en ,
                        "Loopvariabeln kan heta vad som helst."@sv .

<#listcomp-filter>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A list of the items x of xs that are greater than 0, written as a list comprehension"@en ,
                     "En lista med de element x i xs som är större än 0, skriven som en list comprehension"@sv ;
    solid-memo:back "[x for x in xs if x > 0]"@zxx ;
    solid-memo:backNote "The loop variable may have any name."@en ,
                        "Loopvariabeln kan heta vad som helst."@sv .

<#fstring>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An f-string giving \"Hello, \" followed by the value of name and \"!\""@en ,
                     "En f-sträng som ger ”Hello, ” följt av värdet av name och ”!”"@sv ;
    solid-memo:back "f\"Hello, {name}!\""@zxx ;
    solid-memo:backNote "Single quotes work the same: f'Hello, {name}!'."@en ,
                        "Enkla citattecken fungerar likadant: f'Hello, {name}!'."@sv .

<#fstring-decimals>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An f-string giving the number x with exactly two decimals"@en ,
                     "En f-sträng som ger talet x med exakt två decimaler"@sv ;
    solid-memo:back "f\"{x:.2f}\""@zxx ;
    solid-memo:backNote "2.5 gives \"2.50\"."@en ,
                        "2.5 ger \"2.50\"."@sv .

<#slice-first>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The first three items of the list xs"@en ,
                     "De tre första elementen i listan xs"@sv ;
    solid-memo:back "xs[:3]"@zxx ;
    solid-memo:backNote "xs[0:3] is the same; a shorter list gives all its items."@en ,
                        "xs[0:3] är samma sak; en kortare lista ger alla sina element."@sv .

<#index-last>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The last item of the list xs"@en ,
                     "Det sista elementet i listan xs"@sv ;
    solid-memo:back "xs[-1]"@zxx .

<#slice-last>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The last three items of the list xs"@en ,
                     "De tre sista elementen i listan xs"@sv ;
    solid-memo:back "xs[-3:]"@zxx .

<#dict-get>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The value for the key k in the dict d, or None if k is missing"@en ,
                     "Värdet för nyckeln k i dict-objektet d, eller None om k saknas"@sv ;
    solid-memo:back "d.get(k)"@zxx ;
    solid-memo:backNote "d[k] raises KeyError instead when k is missing."@en ,
                        "d[k] utlöser i stället undantaget KeyError när k saknas."@sv .

<#dict-get-default>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The value for the key k in the dict d, or 0 if k is missing"@en ,
                     "Värdet för nyckeln k i dict-objektet d, eller 0 om k saknas"@sv ;
    solid-memo:back "d.get(k, 0)"@zxx .

<#split>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The words of the string s, split at runs of whitespace"@en ,
                     "Orden i strängen s, uppdelade vid varje följd av blanktecken"@sv ;
    solid-memo:back "s.split()"@zxx ;
    solid-memo:backNote "No empty strings for leading, trailing or repeated whitespace, unlike s.split(\" \")."@en ,
                        "Inga tomma strängar för inledande, avslutande eller upprepade blanktecken, till skillnad från s.split(\" \")."@sv .

<#split-sep>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The parts of the string s between its commas"@en ,
                     "Delarna av strängen s mellan dess kommatecken"@sv ;
    solid-memo:back "s.split(\",\")"@zxx ;
    solid-memo:backNote "Two commas in a row give an empty string."@en ,
                        "Två kommatecken i rad ger en tom sträng."@sv .

<#join>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The strings in words joined into one, with a space between each"@en ,
                     "Strängarna i words sammanfogade till en, med ett mellanslag mellan varje"@sv ;
    solid-memo:back "\" \".join(words)"@zxx .

<#strip>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The string s without leading and trailing whitespace"@en ,
                     "Strängen s utan blanktecken i början och slutet"@sv ;
    solid-memo:back "s.strip()"@zxx .

<#upper>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The string s in upper case"@en ,
                     "Strängen s med versaler"@sv ;
    solid-memo:back "s.upper()"@zxx .

<#in-list>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Whether x is an item of the list xs"@en ,
                     "Om x är ett element i listan xs"@sv ;
    solid-memo:back "x in xs"@zxx .

<#in-dict>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Whether k is a key in the dict d"@en ,
                     "Om k är en nyckel i dict-objektet d"@sv ;
    solid-memo:back "k in d"@zxx ;
    solid-memo:backNote "in tests the keys only; v in d.values() tests the values."@en ,
                        "in testar bara nycklarna; v in d.values() testar värdena."@sv .

<#turtle>
    a dcat:Distribution ;
    dcat:accessURL <> ;
    dcat:downloadURL <> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> .
