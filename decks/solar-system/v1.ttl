<#moon-charon>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Which dwarf planet does Charon orbit?"@en ,
                     "Vilken dvärgplanet kretsar Charon kring?"@sv ;
    solid-memo:back "Pluto"@en ,
                    "Pluto"@sv ;
    solid-memo:backNote "Pluto's largest moon, about half Pluto's size."@en ,
                        "Plutos största måne, ungefär hälften så stor som Pluto."@sv .

<#largest-planet>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Largest planet in the Solar System"@en ,
                     "Solsystemets största planet"@sv ;
    solid-memo:back "Jupiter"@en ,
                    "Jupiter"@sv .

<#smallest-planet>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Smallest planet in the Solar System"@en ,
                     "Solsystemets minsta planet"@sv ;
    solid-memo:back "Mercury"@en ,
                    "Merkurius"@sv .

<#hottest-planet>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hottest planet in the Solar System"@en ,
                     "Solsystemets hetaste planet"@sv ;
    solid-memo:back "Venus"@en ,
                    "Venus"@sv ;
    solid-memo:backNote "Hotter than Mercury, which is closer to the Sun: Venus's thick atmosphere traps the heat (about 467 °C at the surface)."@en ,
                        "Hetare än Merkurius, som ligger närmare solen: den täta atmosfären håller kvar värmen (cirka 467 °C vid ytan)."@sv .

<#densest-planet>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Densest planet in the Solar System"@en ,
                     "Solsystemets tätaste planet"@sv ;
    solid-memo:back "Earth"@en ,
                    "jorden"@sv ;
    solid-memo:backNote "About 5.5 g/cm³; Mercury is a close second."@en ,
                        "Cirka 5,5 g/cm³; Merkurius är en knapp tvåa."@sv .

<#least-dense-planet>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Least dense planet in the Solar System"@en ,
                     "Planeten med lägst täthet i solsystemet"@sv ;
    solid-memo:back "Saturn"@en ,
                    "Saturnus"@sv ;
    solid-memo:backNote "About 0.69 g/cm³, less than the density of water."@en ,
                        "Cirka 0,69 g/cm³, lägre än vattnets täthet."@sv .

<#shortest-day>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Planet with the shortest day (fastest rotation)"@en ,
                     "Planeten med kortast dygn (snabbast rotation)"@sv ;
    solid-memo:back "Jupiter"@en ,
                    "Jupiter"@sv ;
    solid-memo:backNote "One rotation takes just under 10 hours."@en ,
                        "Ett varv runt axeln tar knappt 10 timmar."@sv .

<#slowest-rotation>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Planet that takes longest to rotate once on its axis"@en ,
                     "Planeten som tar längst tid på sig att rotera ett varv kring sin axel"@sv ;
    solid-memo:back "Venus"@en ,
                    "Venus"@sv ;
    solid-memo:backNote "About 243 Earth days, longer than its year of about 225 days; it rotates backwards."@en ,
                        "Cirka 243 jorddygn, längre än dess år på cirka 225 dygn; den roterar baklänges."@sv .

<#sideways-planet>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Planet that rotates on its side"@en ,
                     "Planeten som roterar liggande på sidan"@sv ;
    solid-memo:back "Uranus"@en ,
                    "Uranus"@sv ;
    solid-memo:backNote "Its axis is tilted about 98°, almost in the plane of its orbit."@en ,
                        "Axeln lutar cirka 98°, nästan i banplanet."@sv .

<#great-red-spot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Planet with the Great Red Spot"@en ,
                     "Planeten med Stora röda fläcken"@sv ;
    solid-memo:back "Jupiter"@en ,
                    "Jupiter"@sv ;
    solid-memo:backNote "A giant storm larger than Earth."@en ,
                        "En jättestorm, större än jorden."@sv .

<#red-planet>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Planet called “the Red Planet”"@en ,
                     "Planeten som kallas ”den röda planeten”"@sv ;
    solid-memo:back "Mars"@en ,
                    "Mars"@sv ;
    solid-memo:backNote "Iron minerals in its dust and rocks rust and make the surface look red."@en ,
                        "Järnmineral i stoftet och stenarna rostar och får ytan att se röd ut."@sv .

<#liquid-water-surface>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The only planet with liquid water on its surface"@en ,
                     "Den enda planeten med flytande vatten på ytan"@sv ;
    solid-memo:back "Earth"@en ,
                    "jorden"@sv .

<#largest-rocky-planet>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Largest of the four rocky (terrestrial) planets"@en ,
                     "Den största av de fyra stenplaneterna"@sv ;
    solid-memo:back "Earth"@en ,
                    "jorden"@sv .

<#largest-moon-solar-system>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Largest moon in the Solar System"@en ,
                     "Solsystemets största måne"@sv ;
    solid-memo:back "Ganymede"@en ,
                    "Ganymedes"@sv ;
    solid-memo:backNote "Jupiter's largest moon, bigger than the planet Mercury."@en ,
                        "Jupiters största måne, större än planeten Merkurius."@sv .

<#moon-thick-atmosphere>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The only moon with a thick atmosphere"@en ,
                     "Den enda månen med en tät atmosfär"@sv ;
    solid-memo:back "Titan"@en ,
                    "Titan"@sv ;
    solid-memo:backNote "Saturn's largest moon."@en ,
                        "Saturnus största måne."@sv .

<#most-volcanic-body>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The most volcanically active body in the Solar System"@en ,
                     "Solsystemets mest vulkaniskt aktiva himlakropp"@sv ;
    solid-memo:back "Io"@en ,
                    "Io"@sv ;
    solid-memo:backNote "A moon of Jupiter, with hundreds of volcanoes."@en ,
                        "En av Jupiters månar, med hundratals vulkaner."@sv .

<#retrograde-large-moon>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The only large moon that orbits opposite to its planet's rotation (retrograde orbit)"@en ,
                     "Den enda stora månen som kretsar i motsatt riktning mot planetens rotation (retrograd bana)"@sv ;
    solid-memo:back "Triton"@en ,
                    "Triton"@sv ;
    solid-memo:backNote "Neptune's largest moon, probably a captured Kuiper Belt object."@en ,
                        "Neptunus största måne, troligen ett infångat objekt från Kuiperbältet."@sv .

