    rdfs:comment "Footer of the press release page, fetched today: \"© 2026. American Geophysical Union | All rights reserved\". No other licence is stated for the text. Verification only."@en .

<#planet-first>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1st planet from the Sun"@en ,
                     "Första planeten från solen"@sv ;
    solid-memo:back "Mercury"@en ,
                    "Merkurius"@sv .

<#planet-second>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "2nd planet from the Sun"@en ,
                     "Andra planeten från solen"@sv ;
    solid-memo:back "Venus"@en ,
                    "Venus"@sv .

