<#inch>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 inch (in)"@en ,
                     "1 tum (in)"@sv ;
    solid-memo:back "2.54 cm"@zxx ;
    solid-memo:backNote "Exact since 1959 (international yard and pound): 1 in = 25.4 mm."@en ,
                        "Exakt sedan 1959 (den internationella yarden och det internationella pundet): 1 in = 25,4 mm."@sv .

<#foot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 foot (ft)"@en ,
                     "1 fot (ft)"@sv ;
    solid-memo:back "0.3048 m"@zxx ;
    solid-memo:backNote "12 inches, exact. The old US survey foot (1200/3937 m) was deprecated at the end of 2022."@en ,
                        "12 tum, exakt. Den äldre amerikanska US survey foot (1200/3937 m) fasades ut vid utgången av 2022."@sv .

<#yard>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 yard (yd)"@en ,
                     "1 yard (yd)"@sv ;
    solid-memo:back "0.9144 m"@zxx ;
    solid-memo:backNote "3 feet, exact; also the definition in UK law."@en ,
                        "3 fot, exakt; också definitionen i brittisk lag."@sv .

<#mile>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 mile (mi)"@en ,
                     "1 engelsk mil (mi)"@sv ;
    solid-memo:back "1609.344 m"@zxx ;
    solid-memo:backNote "1760 yards = 5280 feet, exact. Also called the statute mile."@en ,
                        "1760 yard = 5280 fot, exakt. Kallas på engelska även statute mile."@sv .

<#nautical-mile>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 nautical mile"@en ,
                     "1 nautisk mil"@sv ;
    solid-memo:back "1852 m"@zxx ;
    solid-memo:backNote "Not an imperial or US customary unit: the international nautical mile, exact by definition (1929; adopted by the US in 1954). Included as a common non-SI unit."@en ,
                        "Ingen brittisk eller amerikansk enhet: den internationella nautiska milen (sjömil, distansminut), exakt per definition (1929; antagen i USA 1954). Med som vanlig enhet utanför SI."@sv .

<#fathom>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 fathom"@en ,
                     "1 engelsk famn (fathom)"@sv ;
    solid-memo:back "1.8288 m"@zxx ;
    solid-memo:backNote "6 feet, exact (international foot)."@en ,
                        "6 fot, exakt (internationell fot)."@sv .

<#chain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 chain (ch)"@en ,
                     "1 chain (ch)"@sv ;
    solid-memo:back "20.1168 m"@zxx ;
    solid-memo:backNote "66 feet = 22 yards, exact; 10 chains make a furlong."@en ,
                        "66 fot = 22 yard, exakt; 10 chain är en furlong."@sv .

<#furlong>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 furlong (fur)"@en ,
                     "1 furlong (fur)"@sv ;
    solid-memo:back "201.168 m"@zxx ;
    solid-memo:backNote "660 feet = 220 yards = 1/8 mile, exact."@en ,
                        "660 fot = 220 yard = 1/8 engelsk mil, exakt."@sv .

<#square-foot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 square foot (ft²)"@en ,
                     "1 kvadratfot (ft²)"@sv ;
    solid-memo:back "0.09290304 m²"@zxx ;
    solid-memo:backNote "144 square inches, exact."@en ,
                        "144 kvadrattum, exakt."@sv .

<#acre>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 acre"@en ,
                     "1 acre"@sv ;
    solid-memo:back "≈ 4047 m²"@zxx ;
    solid-memo:backNote "Exactly 4046.8564224 m² (43 560 ft² = 4840 yd²), about 0.4047 ha."@en ,
                        "Exakt 4046,8564224 m² (43 560 ft² = 4840 yd²), cirka 0,4047 ha."@sv .

<#square-mile>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 square mile (mi²)"@en ,
                     "1 engelsk kvadratmil (mi²)"@sv ;
    solid-memo:back "≈ 2.590 km²"@zxx ;
    solid-memo:backNote "Exactly 2.589988110336 km² (640 acres)."@en ,
                        "Exakt 2,589988110336 km² (640 acre)."@sv .

<#cubic-foot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 cubic foot (ft³)"@en ,
                     "1 kubikfot (ft³)"@sv ;
    solid-memo:back "≈ 28.32 L"@zxx ;
    solid-memo:backNote "Exactly 28.316846592 L (1728 cubic inches)."@en ,
                        "Exakt 28,316846592 l (1728 kubiktum)."@sv .

<#us-gallon>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 US gallon"@en ,
                     "1 amerikansk gallon"@sv ;
    solid-memo:back "≈ 3.785 L"@zxx ;
    solid-memo:backNote "Exactly 3.785411784 L (231 cubic inches). The imperial gallon is about 20 % larger."@en ,
                        "Exakt 3,785411784 l (231 kubiktum). Den brittiska (imperial) gallonen är cirka 20 % större."@sv .

<#imperial-gallon>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 imperial gallon"@en ,
                     "1 brittisk gallon (imperial)"@sv ;
    solid-memo:back "4.54609 L"@zxx ;
    solid-memo:backNote "Exact by definition (UK and Canada); 8 imperial pints = 160 imperial fluid ounces."@en ,
                        "Exakt per definition (Storbritannien och Kanada); 8 brittiska pint = 160 brittiska fluid ounce."@sv .

<#us-pint>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 US liquid pint"@en ,
                     "1 amerikansk pint (våt)"@sv ;
    solid-memo:back "≈ 0.4732 L"@zxx ;
    solid-memo:backNote "Exactly 0.473176473 L: 1/8 US gallon = 16 US fluid ounces. The US dry pint is larger (≈ 0.5506 L)."@en ,
                        "Exakt 0,473176473 l: 1/8 amerikansk gallon = 16 amerikanska fluid ounce. Den amerikanska torra pinten är större (≈ 0,5506 l)."@sv .

<#imperial-pint>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 imperial pint"@en ,
                     "1 brittisk pint (imperial)"@sv ;
    solid-memo:back "0.56826125 L"@zxx ;
    solid-memo:backNote "Exact: 1/8 imperial gallon = 20 imperial fluid ounces."@en ,
                        "Exakt: 1/8 brittisk gallon = 20 brittiska fluid ounce."@sv .

<#us-fluid-ounce>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 US fluid ounce"@en ,
                     "1 amerikanskt fluid ounce"@sv ;
    solid-memo:back "≈ 29.57 mL"@zxx ;
    solid-memo:backNote "Exactly 29.5735295625 mL: 1/128 US gallon. A volume, not the ounce of mass."@en ,
                        "Exakt 29,5735295625 ml: 1/128 amerikansk gallon. En volym, inte massenheten uns."@sv .

<#imperial-fluid-ounce>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 imperial fluid ounce"@en ,
                     "1 brittiskt fluid ounce (imperial)"@sv ;
    solid-memo:back "≈ 28.41 mL"@zxx ;
    solid-memo:backNote "Exactly 28.4130625 mL: 1/160 imperial gallon = 1/20 imperial pint."@en ,
                        "Exakt 28,4130625 ml: 1/160 brittisk gallon = 1/20 brittisk pint."@sv .

<#oil-barrel>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 barrel of oil (bbl)"@en ,
                     "1 fat olja (barrel, bbl)"@sv ;
    solid-memo:back "≈ 159.0 L"@zxx ;
    solid-memo:backNote "42 US gallons = exactly 158.987294928 L, the customary barrel for crude oil. Other barrels exist (31 gallons for beer in US tax law)."@en ,
                        "42 amerikanska gallon = exakt 158,987294928 l, det vedertagna fatet för råolja. Det finns andra fat (31 gallon för öl i amerikansk skattelag)."@sv .

<#grain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 grain (gr)"@en ,
                     "1 grain (gr)"@sv ;
    solid-memo:back "64.79891 mg"@zxx ;
    solid-memo:backNote "1/7000 pound, exact; the same grain in avoirdupois, troy and apothecaries' weight."@en ,
                        "1/7000 pund, exakt; samma grain i avoirdupois-, troy- och apoteksvikt."@sv .

<#ounce>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 ounce (avoirdupois, oz)"@en ,
                     "1 uns (avoirdupois, oz)"@sv ;
    solid-memo:back "≈ 28.35 g"@zxx ;
    solid-memo:backNote "Exactly 28.349523125 g: 1/16 pound. Not the troy ounce used for precious metals."@en ,
                        "Exakt 28,349523125 g: 1/16 pund. Inte troy-unsen som används för ädelmetaller."@sv .

<#troy-ounce>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 troy ounce (oz t)"@en ,
                     "1 troy-uns (oz t)"@sv ;
    solid-memo:back "≈ 31.10 g"@zxx ;
    solid-memo:backNote "Exactly 31.1034768 g (480 grains); the ounce for precious metals."@en ,
                        "Exakt 31,1034768 g (480 grain); unsen för ädelmetaller."@sv .

<#pound>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 pound (avoirdupois, lb)"@en ,
                     "1 pund (avoirdupois, lb)"@sv ;
    solid-memo:back "0.45359237 kg"@zxx ;
    solid-memo:backNote "Exact since 1959 (international yard and pound); 16 ounces = 7000 grains."@en ,
                        "Exakt sedan 1959 (den internationella yarden och det internationella pundet); 16 uns = 7000 grain."@sv .

<#stone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 stone (st)"@en ,
                     "1 stone (st)"@sv ;
    solid-memo:back "≈ 6.350 kg"@zxx ;
    solid-memo:backNote "14 pounds = exactly 6.35029318 kg. A British unit."@en ,
                        "14 pund = exakt 6,35029318 kg. En brittisk enhet."@sv .

<#short-ton>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 short ton (US ton)"@en ,
                     "1 short ton (amerikanskt ton)"@sv ;
    solid-memo:back "907.18474 kg"@zxx ;
    solid-memo:backNote "2000 pounds, exact; called simply ton in the US."@en ,
                        "2000 pund, exakt; kallas bara ton i USA."@sv .

<#long-ton>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 long ton (imperial ton)"@en ,
                     "1 engelskt ton (long ton)"@sv ;
    solid-memo:back "≈ 1016 kg"@zxx ;
    solid-memo:backNote "2240 pounds = exactly 1016.0469088 kg; the British ton."@en ,
                        "2240 pund = exakt 1016,0469088 kg; det brittiska tonnet."@sv .

<#mile-per-hour>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 mile per hour (mph)"@en ,
                     "1 engelsk mil per timme (mph)"@sv ;
    solid-memo:back "0.44704 m/s"@zxx ;
    solid-memo:backNote "Exact; 1 mph = 1.609344 km/h."@en ,
                        "Exakt; 1 mph = 1,609344 km/h."@sv .

<#knot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 knot (kn)"@en ,
                     "1 knop (kn)"@sv ;
    solid-memo:back "≈ 0.5144 m/s"@zxx ;
    solid-memo:backNote "1 nautical mile per hour = exactly 1.852 km/h (1852/3600 m/s). Not an imperial or US customary unit; included with the nautical mile."@en ,
                        "1 nautisk mil per timme = exakt 1,852 km/h (1852/3600 m/s). Ingen brittisk eller amerikansk enhet; finns med här tillsammans med den nautiska milen."@sv .

<#psi>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 psi (pound-force per square inch)"@en ,
                     "1 psi (pound-force per square inch)"@sv ;
    solid-memo:back "≈ 6895 Pa"@zxx ;
    solid-memo:backNote "≈ 6894.757 Pa, about 6.895 kPa."@en ,
                        "≈ 6894,757 Pa, cirka 6,895 kPa."@sv .

<#horsepower>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 horsepower (mechanical, hp)"@en ,
                     "1 brittisk hästkraft (hp)"@sv ;
    solid-memo:back "≈ 745.7 W"@zxx ;
    solid-memo:backNote "550 foot-pounds-force per second ≈ 745.6999 W. The metric horsepower (PS) is smaller, ≈ 735.5 W."@en ,
                        "550 foot-pound-force per sekund ≈ 745,6999 W. Den metriska hästkraften (hk) är mindre, ≈ 735,5 W."@sv .

<#btu>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 British thermal unit (Btu, IT)"@en ,
                     "1 Btu (British thermal unit, IT)"@sv ;
    solid-memo:back "≈ 1055 J"@zxx ;
    solid-memo:backNote "The International Table Btu: exactly 1055.05585262 J."@en ,
                        "Btu enligt International Table (IT): exakt 1055,05585262 J."@sv .

<#fahrenheit-to-celsius>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Convert °F to °C"@en ,
                     "Omvandla °F till °C"@sv ;
    solid-memo:back "°C = (°F − 32) / 1.8"@zxx ;
    solid-memo:backNote "Same as × 5/9. Check: 32 °F = 0 °C, 212 °F = 100 °C."@en ,
                        "Samma som × 5/9. Kontroll: 32 °F = 0 °C, 212 °F = 100 °C."@sv .

<#celsius-to-fahrenheit>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Convert °C to °F"@en ,
                     "Omvandla °C till °F"@sv ;
    solid-memo:back "°F = °C × 1.8 + 32"@zxx ;
    solid-memo:backNote "Same as × 9/5 + 32. Check: −40 °C = −40 °F."@en ,
                        "Samma som × 9/5 + 32. Kontroll: −40 °C = −40 °F."@sv .

