<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Olympic Games host cities"@en ,
                  "Olympiska spelens värdstäder"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The host cities of all 55 Summer and Winter Olympic Games held from Athens 1896 to Milano Cortina 2026 (the Games cancelled in 1916, 1940 and 1944 and the 1906 Intercalated Games are not included). Front: the Games, e.g. \"1912 Summer Olympics\"; back: the host city in English and Swedish, both cities for the co-hosted 2026 Games, with a note where it helps (such as the 1956 equestrian events in Stockholm). Taken from Wikidata and checked against the IOC's list of Games (olympics.com) and Olympedia."@en ,
                        "Värdstäderna för alla 55 olympiska sommar- och vinterspel som hållits från Aten 1896 till Milano Cortina 2026 (de inställda spelen 1916, 1940 och 1944 och extraspelen i Aten 1906 ingår inte). Framsida: spelen, t.ex. ”Olympiska sommarspelen 1912”; baksida: värdstaden på engelska och svenska, båda städerna för spelen 2026, som hade två värdstäder, med en anteckning där den hjälper (som ridsporten i Stockholm 1956). Uppgifterna är hämtade från Wikidata och kontrollerade mot IOK:s lista över spelen (olympics.com) och Olympedia."@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q159821> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:sports ;
    dcat:keyword "Olympic Games"@en ,
                 "Summer Olympics"@en ,
                 "Winter Olympics"@en ,
                 "host cities"@en ,
                 "sports history"@en ,
                 "olympiska spelen"@sv ,
                 "sommar-OS"@sv ,
                 "vinter-OS"@sv ,
                 "värdstäder"@sv ,
                 "idrottshistoria"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-06T00:00:00Z"^^xsd:dateTime ;
    adms:versionNotes "First release." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
