                     "tinningben"@sv ;
    solid-memo:back "Os temporale"@la ;
    solid-memo:backNote "Side of the skull, around the ear; one on each side."@en ,
                        "Skallens sida, runt örat; ett på varje sida."@sv .

<#sphenoid-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Sphenoid bone"@en ,
                     "kilben"@sv ;
    solid-memo:back "Os sphenoidale"@la ;
    solid-memo:backNote "Middle of the skull base."@en ,
                        "Mitt i skallbasen."@sv .

<#ethmoid-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ethmoid bone"@en ,
                     "silben"@sv ;
    solid-memo:back "Os ethmoidale"@la ;
    solid-memo:backNote "Between the eye sockets; separates the nasal cavity from the cranial cavity."@en ,
                        "Mellan ögonhålorna; skiljer näshålan från hjärnhålan."@sv .

<#nasal-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Nasal bone"@en ,
                     "näsben"@sv ;
    solid-memo:back "Os nasale"@la ;
    solid-memo:backNote "Upper part of the bridge of the nose; one on each side."@en ,
                        "Näsryggens övre del; ett på varje sida."@sv .

<#zygomatic-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Cheekbone"@en ,
                     "okben"@sv ;
    solid-memo:back "Os zygomaticum"@la ;
    solid-memo:backNote "Also called the zygomatic bone; one on each side."@en ,
                        "Kallas också kindben; ett på varje sida."@sv .

<#lacrimal-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Lacrimal bone"@en ,
                     "tårben"@sv ;
    solid-memo:back "Os lacrimale"@la ;
    solid-memo:backNote "Front of the inner wall of the eye socket; one on each side."@en ,
                        "Främre delen av ögonhålans inre vägg; ett på varje sida."@sv .

<#maxilla>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Upper jaw"@en ,
                     "överkäke"@sv ;
    solid-memo:back "Maxilla"@la ;
    solid-memo:backNote "Two bones, one on each side; they hold the upper teeth."@en ,
                        "Två ben, ett på varje sida; i dem sitter de övre tänderna."@sv .

<#mandible>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Lower jaw"@en ,
                     "underkäke"@sv ;
    solid-memo:back "Mandibula"@la ;
    solid-memo:backNote "Moves at the jaw joint; holds the lower teeth."@en ,
                        "Rör sig i käkleden; här sitter de nedre tänderna."@sv .

<#vomer>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vomer"@en ,
                     "plogben"@sv ;
    solid-memo:back "Vomer"@la ;
    solid-memo:backNote "Lower back part of the nasal septum."@en ,
                        "Nedre, bakre delen av nässkiljeväggen."@sv .

<#hyoid-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hyoid bone"@en ,
                     "tungben"@sv ;
    solid-memo:back "Os hyoideum"@la ;
    solid-memo:backNote "In the neck; it carries the root of the tongue and touches no other bone."@en ,
                        "I halsen; det bär tungroten och ledar inte mot något annat ben."@sv .

<#malleus>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hammer"@en ,
                     "hammaren"@sv ;
    solid-memo:back "Malleus"@la ;
    solid-memo:backNote "Ear ossicle attached to the eardrum."@en ,
                        "Hörselben som sitter fast i trumhinnan."@sv .

<#incus>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Anvil"@en ,
                     "städet"@sv ;
    solid-memo:back "Incus"@la ;
    solid-memo:backNote "Middle ear ossicle between the hammer and the stirrup."@en ,
                        "Hörselbenet mellan hammaren och stigbygeln."@sv .

<#stapes>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stirrup"@en ,
                     "stigbygeln"@sv ;
    solid-memo:back "Stapes"@la ;
    solid-memo:backNote "Ear ossicle; the smallest bone in the body."@en ,
                        "Hörselben; kroppens minsta ben."@sv .

<#auditory-ossicles>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Auditory ossicles"@en ,
                     "hörselben"@sv ;
    solid-memo:back "Ossicula auditus"@la ;
    solid-memo:backNote "The three small bones of the middle ear."@en ,
                        "Mellanörats tre små ben."@sv .

<#vertebral-column>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Backbone"@en ,
                     "ryggrad"@sv ;
    solid-memo:back "Columna vertebralis"@la ;
    solid-memo:backNote "Also called the spine or vertebral column."@en ,
                        "Kallas också kotpelare."@sv .

<#cervical-vertebrae>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Cervical vertebrae"@en ,
                     "halskotor"@sv ;
    solid-memo:back "Vertebrae cervicales"@la ;
    solid-memo:backNote "The seven vertebrae of the neck."@en ,
                        "Halsens sju kotor."@sv .

<#thoracic-vertebrae>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Thoracic vertebrae"@en ,
                     "bröstkotor"@sv ;
    solid-memo:back "Vertebrae thoracicae"@la ;
    solid-memo:backNote "The twelve vertebrae that the ribs join."@en ,
                        "De tolv kotor som revbenen ledar mot."@sv .

<#lumbar-vertebrae>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Lumbar vertebrae"@en ,
                     "ländkotor"@sv ;
    solid-memo:back "Vertebrae lumbales"@la ;
    solid-memo:backNote "The five vertebrae of the lower back."@en ,
                        "Ländryggens fem kotor."@sv .

<#atlas>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "First cervical vertebra"@en ,
                     "första halskotan"@sv ;
    solid-memo:back "Atlas"@la ;
    solid-memo:backNote "It carries the skull."@en ,
                        "Kallas också ringkotan; den bär upp skallen."@sv .

<#axis>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Second cervical vertebra"@en ,
                     "andra halskotan"@sv ;
    solid-memo:back "Axis"@la ;
    solid-memo:backNote "The atlas turns around its peg, the dens."@en ,
                        "Kallas också tappkotan; ringkotan vrider sig kring dess tapp (dens)."@sv .

<#sacrum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Sacrum"@en ,
                     "korsben"@sv ;
    solid-memo:back "Os sacrum"@la ;
    solid-memo:backNote "Fused vertebrae at the back of the pelvis."@en ,
                        "Sammanvuxna kotor i bäckenets bakre vägg."@sv .

<#coccyx>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Tailbone"@en ,
                     "svansben"@sv ;
    solid-memo:back "Os coccygis"@la ;
    solid-memo:backNote "The lowest end of the spine."@en ,
                        "Ryggradens nedersta del."@sv .

<#sternum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Breastbone"@en ,
                     "bröstben"@sv ;
    solid-memo:back "Sternum"@la ;
    solid-memo:backNote "Front of the chest."@en ,
                        "Mitt fram på bröstkorgen."@sv .

<#ribs>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ribs"@en ,
                     "revben"@sv ;
    solid-memo:back "Costae"@la ;
    solid-memo:backNote "Most people have twelve pairs."@en ,
                        "De flesta människor har tolv par."@sv .

<#clavicle>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Collarbone"@en ,
                     "nyckelben"@sv ;
    solid-memo:back "Clavicula"@la ;
    solid-memo:backNote "Between the breastbone and the shoulder blade."@en ,
                        "Mellan bröstbenet och skulderbladet."@sv .

<#scapula>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Shoulder blade"@en ,
                     "skulderblad"@sv ;
    solid-memo:back "Scapula"@la ;
    solid-memo:backNote "On the back of the rib cage."@en ,
                        "På bröstkorgens baksida."@sv .

<#humerus>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Humerus"@en ,
                     "överarmsben"@sv ;
    solid-memo:back "Humerus"@la ;
    solid-memo:backNote "The upper arm, from shoulder to elbow."@en ,
                        "Överarmen, från axeln till armbågen."@sv .

<#radius>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Radius"@en ,
                     "strålben"@sv ;
    solid-memo:back "Radius"@la ;
    solid-memo:backNote "Forearm, on the thumb side."@en ,
                        "Underarmen, på tumsidan."@sv .

<#ulna>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ulna"@en ,
                     "armbågsben"@sv ;
    solid-memo:back "Ulna"@la ;
    solid-memo:backNote "Forearm, on the little-finger side."@en ,
                        "Underarmen, på lillfingersidan."@sv .

<#carpal-bones>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Carpal bones"@en ,
                     "handlovsben"@sv ;
    solid-memo:back "Ossa carpi"@la ;
    solid-memo:backNote "The eight small bones of the wrist."@en ,
                        "Handlovens åtta små ben."@sv .

<#metacarpal-bones>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Metacarpal bones"@en ,
                     "mellanhandsben"@sv ;
    solid-memo:back "Ossa metacarpi"@la ;
    solid-memo:backNote "The five bones of the palm."@en ,
                        "Mellanhandens fem ben."@sv .

<#scaphoid-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Scaphoid bone"@en ,
                     "handlovens båtben"@sv ;
    solid-memo:back "Os scaphoideum"@la ;
    solid-memo:backNote "Wrist, on the thumb side."@en ,
                        "Handloven, på tumsidan."@sv .

<#lunate-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Lunate bone"@en ,
                     "månben"@sv ;
    solid-memo:back "Os lunatum"@la ;
    solid-memo:backNote "Wrist, in the row nearest the forearm, next to the scaphoid."@en ,
                        "Handloven, i raden närmast underarmen, bredvid båtbenet."@sv .

<#pisiform-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pisiform bone"@en ,
                     "ärtben"@sv ;
    solid-memo:back "Os pisiforme"@la ;
    solid-memo:backNote "Wrist; a small sesamoid bone on the little-finger side."@en ,
                        "Handloven; ett litet sesamben på lillfingersidan."@sv .

<#hamate-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hamate bone"@en ,
                     "hakben"@sv ;
    solid-memo:back "Os hamatum"@la ;
    solid-memo:backNote "Wrist, in the row nearest the fingers; it has a hook."@en ,
                        "Handloven, i raden närmast fingrarna; det har en krok."@sv .

<#hip-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hip bone"@en ,
                     "höftben"@sv ;
    solid-memo:back "Os coxae"@la ;
    solid-memo:backNote "The ilium, ischium and pubis grown together; one on each side."@en ,
                        "Tarmbenet, sittbenet och blygdbenet sammanvuxna; ett på varje sida."@sv .

<#ilium>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ilium"@en ,
                     "tarmben"@sv ;
    solid-memo:back "Os ilium"@la ;
    solid-memo:backNote "Upper part of the hip bone."@en ,
                        "Höftbenets övre del."@sv .

<#ischium>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ischium"@en ,
                     "sittben"@sv ;
    solid-memo:back "Os ischii"@la ;
    solid-memo:backNote "Lower back part of the hip bone."@en ,
                        "Höftbenets nedre, bakre del."@sv .

<#pubis>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pubic bone"@en ,
                     "blygdben"@sv ;
    solid-memo:back "Os pubis"@la ;
    solid-memo:backNote "Lower front part of the hip bone."@en ,
                        "Höftbenets nedre, främre del."@sv .

<#pelvis>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pelvis"@en ,
                     "bäcken"@sv ;
    solid-memo:back "Pelvis"@la ;
    solid-memo:backNote "The bony ring between the spine and the thigh bones."@en ,
                        "Benringen mellan ryggraden och lårbenen."@sv .

<#femur>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Thigh bone"@en ,
                     "lårben"@sv ;
    solid-memo:back "Femur"@la ;
    solid-memo:backNote "The longest bone in the body."@en ,
                        "Kroppens längsta ben."@sv .

<#patella>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Kneecap"@en ,
                     "knäskål"@sv ;
    solid-memo:back "Patella"@la ;
    solid-memo:backNote "Front of the knee; the body's largest sesamoid bone."@en ,
                        "Knäts framsida; kroppens största sesamben."@sv .

<#tibia>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Shinbone"@en ,
                     "skenben"@sv ;
    solid-memo:back "Tibia"@la ;
    solid-memo:backNote "The larger of the two lower-leg bones."@en ,
                        "Det större av underbenets två ben."@sv .

<#fibula>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Calf bone"@en ,
                     "vadben"@sv ;
    solid-memo:back "Fibula"@la ;
    solid-memo:backNote "The slender outer bone of the lower leg."@en ,
                        "Underbenets smala, yttre ben."@sv .

<#tarsal-bones>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Tarsal bones"@en ,
                     "fotrotsben"@sv ;
    solid-memo:back "Ossa tarsi"@la ;
    solid-memo:backNote "The seven bones of the hindfoot and midfoot."@en ,
                        "Fotrotens sju ben."@sv .

<#metatarsal-bones>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Metatarsal bones"@en ,
                     "mellanfotsben"@sv ;
    solid-memo:back "Ossa metatarsi"@la ;
    solid-memo:backNote "The five long bones between the tarsal bones and the toes."@en ,
                        "Mellanfotens fem långa ben."@sv .

<#talus>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Talus"@en ,
                     "språngben"@sv ;
    solid-memo:back "Talus"@la ;
    solid-memo:backNote "Ankle; it carries the shinbone."@en ,
                        "Fotleden; det bär skenbenet."@sv .

<#calcaneus>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Heel bone"@en ,
                     "hälben"@sv ;
    solid-memo:back "Calcaneus"@la ;
    solid-memo:backNote "The largest tarsal bone; it forms the heel."@en ,
                        "Det största fotrotsbenet; det bildar hälen."@sv .

<#navicular-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Navicular bone"@en ,
                     "fotens båtben"@sv ;
    solid-memo:back "Os naviculare"@la ;
    solid-memo:backNote "Inner side of the foot, in front of the talus."@en ,
                        "Fotens insida, framför språngbenet."@sv .

<#cuboid-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Cuboid bone"@en ,
                     "tärningsben"@sv ;
    solid-memo:back "Os cuboideum"@la ;
    solid-memo:backNote "Tarsal bone on the outer side of the foot."@en ,
                        "Fotrotsben på fotens utsida."@sv .

