    dcterms:creator "Svenska Akademien" ;
    rdfs:comment "https://svenska.se/ page footer: \"© Svenska Akademien\"; no open licence is stated for the dictionaries' content, so SAOL is treated as all rights reserved and used for verification only."@en .

<https://svenska.se/so/>
    dcterms:title "Svensk ordbok utgiven av Svenska Akademien (SO), on svenska.se" ;
    dcterms:creator "Svenska Akademien" ;
