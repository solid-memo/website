                              "On partage le plat"@fr ;
    solid-memo:distractorNote "That would be 우리 나눠서 먹어요; 내다 is to pay, 먹다 to eat."@en ,
                              "Det vore 우리 나눠서 먹어요; 내다 är att betala, 먹다 att äta."@sv ,
                              "Das wäre 우리 나눠서 먹어요; 내다 heißt zahlen, 먹다 essen."@de ,
                              "Eso sería 우리 나눠서 먹어요; 내다 es pagar, 먹다 comer."@es ,
                              "Ce serait 우리 나눠서 먹어요 ; 내다 veut dire payer, 먹다 manger."@fr .

<#q-paying-3a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Let's pay later"@en ,
                              "Vi betalar sen"@sv ,
                              "Lass uns später zahlen"@de ,
