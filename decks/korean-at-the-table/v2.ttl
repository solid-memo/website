<#q-paying-1a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "I paid last time"@en ,
                              "Jag betalade förra gången"@sv ,
                              "Letztes Mal habe ich bezahlt"@de ,
