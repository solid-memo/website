    solid-memo:distractorNote "That would be 배달이 좀 늦어지고 있습니다; 왔습니다 says it has come."@en ,
                              "Det vore 배달이 좀 늦어지고 있습니다; 왔습니다 säger att den har kommit."@sv ,
                              "Das wäre 배달이 좀 늦어지고 있습니다; 왔습니다 sagt, dass sie gekommen ist."@de ,
                              "Eso sería 배달이 좀 늦어지고 있습니다; 왔습니다 dice que ya ha llegado."@es ,
                              "Ce serait 배달이 좀 늦어지고 있습니다 ; 왔습니다 dit qu'elle est arrivée."@fr .

<#q-delivery-r02-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "I've come for the empty bowls"@en ,
                              "Jag kommer för att hämta skålarna"@sv ,
                              "Ich hole das Geschirr ab"@de ,
                              "Vengo a recoger los platos"@es ,
                              "Je viens reprendre la vaisselle"@fr ;
    solid-memo:distractorNote "That would be 그릇 찾으러 왔습니다; 배달 is a delivery."@en ,
                              "Det vore 그릇 찾으러 왔습니다; 배달 är en leverans."@sv ,
                              "Das wäre 그릇 찾으러 왔습니다; 배달 ist eine Lieferung."@de ,
                              "Eso sería 그릇 찾으러 왔습니다; 배달 es una entrega."@es ,
                              "Ce serait 그릇 찾으러 왔습니다 ; 배달 est une livraison."@fr .

