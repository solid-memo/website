      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "We're from the same town"@en ,
                              "Vi kommer från samma stad"@sv ,
                              "Wir kommen aus derselben Stadt"@de ,
                              "Somos de la misma ciudad"@es ,
                              "On vient de la même ville"@fr ;
