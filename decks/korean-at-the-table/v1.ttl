<#q-cafe-1b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "A large one, please"@en ,
                              "En stor, tack"@sv ,
                              "Einen großen, bitte"@de ,
                              "Uno grande, por favor"@es ,
                              "Un grand, s'il vous plaît"@fr ;
    solid-memo:distractorNote "That would be 큰 사이즈로 주세요; 연하게 says nothing about size."@en ,
                              "Det vore 큰 사이즈로 주세요; 연하게 säger inget om storlek."@sv ,
                              "Das wäre 큰 사이즈로 주세요; 연하게 sagt nichts über die Größe."@de ,
                              "Eso sería 큰 사이즈로 주세요; 연하게 no dice nada del tamaño."@es ,
