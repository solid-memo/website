                              "Ett studiepass slutar med ett meddelande om att det är klart, inte med en lista över kortlekens kort."@sv .

<#q-own-cards-1a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
