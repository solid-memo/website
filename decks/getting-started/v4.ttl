<#q-your-data-1b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Nobody, as a WebID needs no password"@en ,
                              "Ingen, eftersom ett WebID inte kräver lösenord"@sv ,
                              "아무도, WebID에는 비밀번호가 필요 없어서"@ko ,
