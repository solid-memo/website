                              "Un enlace a un informe de evaluación es opcional."@es ,
                              "Un lien vers un rapport d’évaluation est facultatif."@fr .

<#q-testing-and-law-1b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
