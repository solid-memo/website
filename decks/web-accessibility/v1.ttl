<#q-testing-and-law-2a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Level A and part of AA"@en ,
                              "Nivå A och en del av AA"@sv ,
                              "A 수준과 AA 수준 일부"@ko ,
                              "Stufe A und ein Teil von AA"@de ,
                              "Nivel A y parte del AA"@es ,
                              "Niveau A et une partie du AA"@fr ;
