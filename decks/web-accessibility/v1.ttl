<#q-testing-and-law-1c-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "An exemption from monitoring"@en ,
                              "Undantag från övervakningen"@sv ,
                              "모니터링 면제"@ko ,
                              "Eine Befreiung von der Überwachung"@de ,
                              "Una exención del seguimiento"@es ,
                              "Une dispense de contrôle"@fr ;
    solid-memo:distractorNote "Member States still monitor public sector sites at regular intervals."@en ,
                              "Medlemsstaterna övervakar ändå offentliga webbplatser med jämna mellanrum."@sv ,
