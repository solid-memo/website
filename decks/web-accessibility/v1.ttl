    solid-memo:distractorText "A `lang` attribute on the first paragraph"@en ,
                              "Med ett `lang`-attribut på första stycket"@sv ,
                              "첫 번째 문단에 지정한 `lang` 속성"@ko ,
                              "Mit einem `lang`-Attribut am ersten Absatz"@de ,
                              "Con un atributo `lang` en el primer párrafo"@es ,
                              "Un attribut `lang` sur le premier paragraphe"@fr ;
    solid-memo:distractorNote "That marks only the language of that one paragraph."@en ,
                              "Det anger bara språket för just det stycket."@sv ,
                              "그 문단 하나의 언어만 표시해요."@ko ,
                              "Das kennzeichnet nur die Sprache dieses einen Absatzes."@de ,
                              "Eso marca solo el idioma de ese párrafo."@es ,
                              "Cela ne signale que la langue de ce seul paragraphe."@fr .

<#q-understandable-0a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "A `charset` declaration in the `head` element"@en ,
                              "Med en `charset`-deklaration i `head`-elementet"@sv ,
                              "`head` 요소 안의 `charset` 선언"@ko ,
