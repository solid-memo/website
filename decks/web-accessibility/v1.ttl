<#q-perceivable-contrast-2b-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "1280 CSS pixels"@en ,
                              "1 280 CSS-pixlar"@sv ,
                              "1280 CSS 픽셀"@ko ,
                              "1280 CSS-Pixel"@de ,
                              "1280 píxeles CSS"@es ,
                              "1 280 pixels CSS"@fr ;
    solid-memo:distractorNote "That is the window width which, zoomed to 400 percent, leaves 320."@en ,
                              "Det är fönsterbredden som lämnar 320 när den zoomas till 400 procent."@sv ,
                              "400%로 확대하면 320이 남는 창 너비예요."@ko ,
                              "Das ist die Fensterbreite, die bei 400 Prozent Zoom 320 übrig lässt."@de ,
                              "Es el ancho de ventana que, ampliado al 400 %, deja 320."@es ,
                              "C’est la largeur de fenêtre qui, zoomée à 400 %, en laisse 320."@fr .

<#q-perceivable-contrast-2b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "256 CSS pixels"@en ,
                              "256 CSS-pixlar"@sv ,
                              "256 CSS 픽셀"@ko ,
                              "256 CSS-Pixel"@de ,
                              "256 píxeles CSS"@es ,
                              "256 pixels CSS"@fr ;
    solid-memo:distractorNote "That is the height for content that scrolls sideways."@en ,
                              "Det är höjden för innehåll som rullar i sidled."@sv ,
                              "가로로 스크롤되는 콘텐츠에 대한 높이예요."@ko ,
                              "Das ist die Höhe für Inhalte, die seitwärts scrollen."@de ,
                              "Es la altura para el contenido que se desplaza en horizontal."@es ,
                              "C’est la hauteur retenue pour un contenu à défilement horizontal."@fr .

