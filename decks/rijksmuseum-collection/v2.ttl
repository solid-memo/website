                    "Los síndicos de los pañeros — Rembrandt, 1662"@es ,
                    "Le Syndic de la guilde des drapiers — Rembrandt, 1662"@fr .

<#sk-a-4691>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
