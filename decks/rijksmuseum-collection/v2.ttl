<#ng-2005-24>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:frontImage <https://iiif.micr.io/uRTEh/full/!1280,1280/0/default.jpg> ;
    solid-memo:frontImageDescription "A box scene of small painted figures under an open thatched shelter, women in patterned wraps and headscarves, a man in a red coat, painted trees behind"@en ,
                                     "En scen i en låda med små målade figurer under ett öppet halmtak, kvinnor i mönstrade svepningar och huvuddukar, en man i röd rock, målade träd bakom"@sv ,
