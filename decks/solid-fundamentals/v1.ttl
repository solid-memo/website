                          <#q-read-write-8b-d3> .

<#q-read-write-8b-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "The server answers 404, because PATCH needs an existing target"@en ;
    solid-memo:distractorNote "Processing starts from an empty graph when the target does not exist."@en .

<#q-read-write-8b-d2>
