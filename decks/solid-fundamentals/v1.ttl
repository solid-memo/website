      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "SAI was withdrawn by the Solid Community Group."@en ;
    solid-memo:distractorNote "SAI is still an active draft, updated in 2026."@en .

<#q-interop-8b-d2>
