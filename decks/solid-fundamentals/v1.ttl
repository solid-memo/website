    solid-memo:front "In Solid, which `Content-Type` must a PATCH request carry to send an N3 Patch?"@en ;
    solid-memo:back "`text/n3`" ;
    solid-memo:backNote "N3 Patch uses the media type `text/n3`, and Solid servers must list it in `Accept-Patch` for RDF documents."@en ;
    solid-memo:distractor <#q-read-write-7a-d1> ,
                          <#q-read-write-7a-d2> ,
                          <#q-read-write-7a-d3> .

