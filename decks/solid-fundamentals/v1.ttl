    dcterms:created "2026-10-08T00:00:00.000Z"^^xsd:dateTime ;
    solid-memo:textFormat solid-memo:markdown ;
    solid-memo:front "A developer's Solid app treats only 200 and 204 as a successful PATCH. What happens on Community Solid Server 7.2 (2026)?"@en ;
    solid-memo:back "Every successful edit is reported as a failure: CSS sends 205"@en ;
    solid-memo:backNote "Treat any 2xx as success (`response.ok`); CSS 7.2 answers PUT on an existing resource, PATCH and DELETE with 205."@en ;
    solid-memo:distractor <#q-read-an-app-r02-d1> ,
                          <#q-read-an-app-r02-d2> ,
                          <#q-read-an-app-r02-d3> .

<#q-read-an-app-r02-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Nothing changes, because CSS answers every PATCH with 204"@en ;
    solid-memo:distractorNote "CSS 7.2 answered every successful PATCH with 205 Reset Content."@en .

<#q-read-an-app-r02-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "The edits are rejected, because the client must accept 205"@en ;
    solid-memo:distractorNote "The edit is applied; only the app's reading of the answer is wrong."@en .

<#q-read-an-app-r02-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Only edits sent with `If-Match` fail, because they answer 412"@en ;
    solid-memo:distractorNote "Conditional edits with a current ETag also answer 205."@en .

