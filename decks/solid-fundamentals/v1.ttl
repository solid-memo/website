<#q-read-an-app-r05>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-08T00:00:00.000Z"^^xsd:dateTime ;
    solid-memo:textFormat solid-memo:markdown ;
    solid-memo:front "Two mechanisms guard the Solid Notes example app's N3 Patch edits against a lost update. Which are they, and which still worked on node-solid-server 6.0.0 (2026)?"@en ;
    solid-memo:back "`If-Match` and the patch's deletes; on NSS 6 only the deletes"@en ;
    solid-memo:backNote "CSS 7.2 rejected a stale ETag with 412; NSS 6 sent no ETag, but the stale delete failed with 409, and `editNote` retried either way."@en ;
    solid-memo:distractor <#q-read-an-app-r05-d1> ,
                          <#q-read-an-app-r05-d2> ,
                          <#q-read-an-app-r05-d3> .

