    solid-memo:backNote "The provider dereferences the client ID and accepts only a `redirect_uri` listed in `redirect_uris`, character for character."@en ;
    solid-memo:distractor <#q-building-apps-9a-d1> ,
                          <#q-building-apps-9a-d2> ,
                          <#q-building-apps-9a-d3> .

