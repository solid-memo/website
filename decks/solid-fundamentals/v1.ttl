    solid-memo:distractorNote "SHACL does define `sh:targetClass`; Solid Memo chooses not to use it."@en .

<#q-app-walkthrough-10a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "A shape without a target is closed, which keeps foreign triples out."@en ;
    solid-memo:distractorNote "Closing is `sh:closed`, and Solid Memo's shapes are deliberately open."@en .

<#q-app-walkthrough-10a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Solid servers would otherwise reject writes that do not fit the shape."@en ;
