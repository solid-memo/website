<#q-read-an-app-17c>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-08T00:00:00.000Z"^^xsd:dateTime ;
    solid-memo:textFormat solid-memo:markdown ;
    solid-memo:front """A Solid app builds its CSP's `connect-src` from its pods' origins as below. What does it give for the pods `http://localhost:3000` and `https://pod.example`?

```js
const plain = origins.filter((o) => o.startsWith('http:'));
['connect-src', "'self'", 'https:', 'wss:',
  ...plain.flatMap((o) => [o, o.replace(/^http/, 'ws')])].join(' ')
```"""@en ;
    solid-memo:back "`connect-src 'self' https: wss: http://localhost:3000 ws://localhost:3000`" ;
    solid-memo:backNote "Only plain-http pods need extra sources; `https:` and `wss:` already match `https://pod.example` and its WebSocket."@en ;
