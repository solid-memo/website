    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "`If-Match` and WebSocket messages; on NSS 6 only `If-Match`"@en ;
    solid-memo:distractorNote "NSS 6 ignored If-Match and offered no WebSocket channel."@en .

<#q-read-an-app-r05-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "ETag checks and the Slug header; on NSS 6 only the Slug"@en ;
    solid-memo:distractorNote "A slug names a new resource; it guards no edit."@en .

<#q-read-an-app-r05-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "`If-Match` and `If-None-Match: *`; both worked on NSS 6"@en ;
    solid-memo:distractorNote "`If-None-Match: *` guards creation only, and NSS 6 ignored If-Match."@en .

