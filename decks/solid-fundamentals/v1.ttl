<#q-read-an-app-17b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-08T00:00:00.000Z"^^xsd:dateTime ;
    solid-memo:textFormat solid-memo:markdown ;
    solid-memo:front "A Solid app talks to a pod at `http://localhost:3000`. Why does its CSP list `ws://localhost:3000` in `connect-src`, when it already allows `wss:`?"@en ;
    solid-memo:back "Its notifications use plain `ws:`, which `wss:` doesn't match"@en ;
    solid-memo:backNote "A pod on plain http gives WebSocketChannel2023 URLs that start with `ws:`; `https:` and `wss:` only match encrypted origins, so without it live updates would be blocked."@en ;
    solid-memo:distractor <#q-read-an-app-17b-d1> ,
                          <#q-read-an-app-17b-d2> ,
                          <#q-read-an-app-17b-d3> .

