    solid-memo:front "A user has typed a long note in your Solid app when it sends her to the identity provider to log in. How do you keep the note?"@en ;
    solid-memo:back "Save it in `sessionStorage`, restore it after login"@en ;
    solid-memo:backNote "The login redirect unloads your page. `sessionStorage` survives it within the same tab, so save the route and draft there and restore them once `handleIncomingRedirect()` has run."@en ;
    solid-memo:distractor <#q-building-apps-8a-d1> ,
                          <#q-building-apps-8a-d2> ,
                          <#q-building-apps-8a-d3> .

<#q-building-apps-8a-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Keep it in a JavaScript variable until she returns"@en ;
