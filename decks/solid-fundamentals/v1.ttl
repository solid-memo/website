    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Pod: DPoP proofs; user: the `iss` check after the redirect"@en ;
    solid-memo:distractorNote "Neither stops a user typing her password into a fake page."@en .

<#q-security-r04-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Pod: PKCE; user: the profile listing the issuer"@en ;
    solid-memo:distractorNote "PKCE protects the code; the profile check protects pods, not passwords."@en .

<#q-security-r04-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "Pod: CORS; user: a strict Content Security Policy"@en ;
    solid-memo:distractorNote "CORS doesn't decide which tokens a pod believes, and CSP can't spot a fake site."@en .

<#q-security-r05>
    a solid-memo:Card ;
