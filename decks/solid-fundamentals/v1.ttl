<#q-building-apps-9b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-08T00:00:00.000Z"^^xsd:dateTime ;
    solid-memo:textFormat solid-memo:markdown ;
    solid-memo:front "You are developing a Solid app at `http://localhost:5173` and want logins to work with any identity provider. What is the simplest setup?"@en ;
