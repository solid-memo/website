    solid-memo:distractorText "It applies the patch to the first match only, in document order"@en ;
    solid-memo:distractorNote "The server never picks a match for you; ambiguity is refused."@en .

<#q-read-write-8a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
