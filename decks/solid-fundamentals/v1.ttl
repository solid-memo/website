<#q-interop-8b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-08T00:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "As of 2026, why should a new Solid app still support type indexes, even though Solid Application Interoperability (SAI) exists?"@en ;
    solid-memo:back "Most existing apps rely on them, not on SAI."@en ;
    solid-memo:backNote "Both are drafts, but type indexes are the de-facto mechanism, while SAI lacks server support and has only a few implementations."@en ;
    solid-memo:distractor <#q-interop-8b-d1> ,
                          <#q-interop-8b-d2> ,
                          <#q-interop-8b-d3> .

<#q-interop-8b-d1>
