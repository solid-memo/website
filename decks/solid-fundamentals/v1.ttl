<#q-read-an-app-8a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "At the PNG's URL plus `.meta`, written with a PUT of Turtle"@en ;
