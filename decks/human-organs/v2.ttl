<#brain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Brain"@en ,
                     "hjärna"@sv ;
    solid-memo:back "Encephalon"@la ;
    solid-memo:backNote "Nervous system: with the spinal cord, forms the central nervous system."@en ,
                        "Nervsystemet: bildar tillsammans med ryggmärgen det centrala nervsystemet."@sv .

<#cerebellum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Cerebellum"@en ,
                     "lillhjärna"@sv ;
    solid-memo:back "Cerebellum"@la ;
    solid-memo:backNote "Nervous system: coordinates movement and balance."@en ,
                        "Nervsystemet: samordnar rörelser och balans."@sv .

<#brainstem>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Brainstem"@en ,
                     "hjärnstam"@sv ;
    solid-memo:back "Truncus encephali"@la ;
    solid-memo:backNote "Nervous system: connects the cerebral hemispheres with the spinal cord."@en ,
                        "Nervsystemet: förbinder hjärnhalvorna med ryggmärgen."@sv .

<#spinal-cord>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Spinal cord"@en ,
                     "ryggmärg"@sv ;
    solid-memo:back "Medulla spinalis"@la ;
    solid-memo:backNote "Nervous system: runs from the brain down the vertebral canal."@en ,
                        "Nervsystemet: löper från hjärnan ned inuti ryggraden."@sv .

<#eye>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Eye"@en ,
                     "öga"@sv ;
    solid-memo:back "Oculus"@la ;
    solid-memo:backNote "Sense organs: the organ of sight."@en ,
                        "Sinnesorganen: synorganet."@sv .

<#cornea>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Cornea"@en ,
                     "hornhinna"@sv ;
    solid-memo:back "Cornea"@la ;
    solid-memo:backNote "Eye: the transparent front layer, the first to refract light."@en ,
                        "Ögat: det genomskinliga främre skiktet, som först bryter ljuset."@sv .

<#retina>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Retina"@en ,
                     "näthinna"@sv ;
    solid-memo:back "Retina"@la ;
    solid-memo:backNote "Eye: the light-sensitive inner layer that turns light into nerve signals."@en ,
                        "Ögat: det ljuskänsliga inre lagret, som omvandlar ljus till nervsignaler."@sv .

<#ear>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ear"@en ,
                     "öra"@sv ;
    solid-memo:back "Auris"@la ;
    solid-memo:backNote "Sense organs: the organ of hearing and balance."@en ,
                        "Sinnesorganen: hörsel- och balansorganet."@sv .

<#eardrum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Eardrum"@en ,
                     "trumhinna"@sv ;
    solid-memo:back "Membrana tympanica"@la ;
    solid-memo:backNote "Ear: the membrane between the ear canal and the middle ear."@en ,
                        "Örat: hinnan mellan hörselgången och mellanörat."@sv .

<#nose>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Nose"@en ,
                     "näsa"@sv ;
    solid-memo:back "Nasus"@la ;
    solid-memo:backNote "Respiratory system: part of the upper airways, with the organ of smell."@en ,
                        "Andningssystemet: en del av de övre luftvägarna, med luktorganet."@sv .

<#tongue>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Tongue"@en ,
                     "tunga"@sv ;
    solid-memo:back "Lingua"@la ;
    solid-memo:backNote "Digestive system: needed for chewing, swallowing and speech; carries the taste buds."@en ,
                        "Matsmältningssystemet: behövs för att tugga, svälja och tala; bär smaklökarna."@sv .

<#skin>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Skin"@en ,
                     "hud"@sv ;
    solid-memo:back "Cutis"@la ;
    solid-memo:backNote "The body's outer covering, protecting it from the environment."@en ,
                        "Kroppens yttersta hölje och skydd mot omgivningen."@sv .

<#heart>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Heart"@en ,
                     "hjärta"@sv ;
    solid-memo:back "Cor"@la ;
    solid-memo:backNote "Cardiovascular system: the muscular organ that pumps the blood."@en ,
                        "Hjärt- och kärlsystemet: det muskulära organ som pumpar blodet."@sv .

<#lungs>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Lungs"@en ,
                     "lungor"@sv ;
    solid-memo:back "Pulmones"@la ;
    solid-memo:backNote "Respiratory system: the pair of organs in the chest that oxygenate the blood."@en ,
                        "Andningssystemet: organparet i brösthålan som syresätter blodet."@sv .

<#trachea>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Windpipe"@en ,
                     "luftstrupe"@sv ;
    solid-memo:back "Trachea"@la ;
    solid-memo:backNote "Respiratory system: the tube that carries air from the larynx to the lungs."@en ,
                        "Andningssystemet: röret som leder luft från struphuvudet till lungorna."@sv .

<#larynx>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Voice box"@en ,
                     "struphuvud"@sv ;
    solid-memo:back "Larynx"@la ;
    solid-memo:backNote "Respiratory system: protects the windpipe and produces the voice."@en ,
                        "Andningssystemet: skyddar luftstrupen och bildar rösten."@sv .

<#vocal-fold>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vocal fold"@en ,
                     "stämband"@sv ;
    solid-memo:back "Plica vocalis"@la ;
    solid-memo:backNote "Larynx: one of the two folds that vibrate to make the voice."@en ,
                        "Struphuvudet: ett av de två veck som ger rösten när luft passerar mellan dem."@sv .

<#parotid-gland>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Parotid gland"@en ,
                     "öronspottkörtel"@sv ;
    solid-memo:back "Glandula parotidea"@la ;
    solid-memo:backNote "Digestive system: the largest salivary gland, in front of the ear."@en ,
                        "Matsmältningssystemet: den största spottkörteln, framför örat."@sv .

<#oesophagus>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Oesophagus"@en ,
                     "matstrupe"@sv ;
    solid-memo:back "Oesophagus"@la ;
    solid-memo:backNote "Digestive system: carries food from the pharynx to the stomach."@en ,
                        "Matsmältningssystemet: för maten från svalget till magsäcken."@sv .

<#stomach>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stomach"@en ,
                     "magsäck"@sv ;
    solid-memo:back "Gaster"@la ;
    solid-memo:backNote "Digestive system: lies between the oesophagus and the duodenum."@en ,
                        "Matsmältningssystemet: ligger mellan matstrupen och tolvfingertarmen."@sv .

<#small-intestine>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Small intestine"@en ,
                     "tunntarm"@sv ;
    solid-memo:back "Intestinum tenue"@la ;
    solid-memo:backNote "Digestive system: where most nutrients from food are absorbed."@en ,
                        "Matsmältningssystemet: här tas det mesta av näringsämnena i maten upp."@sv .

<#duodenum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Duodenum"@en ,
                     "tolvfingertarm"@sv ;
    solid-memo:back "Duodenum"@la ;
    solid-memo:backNote "Small intestine: its first part, after the stomach."@en ,
                        "Tunntarmen: dess första del, efter magsäcken."@sv .

<#large-intestine>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Large intestine"@en ,
                     "tjocktarm"@sv ;
    solid-memo:back "Intestinum crassum"@la ;
    solid-memo:backNote "Digestive system: absorbs water and salts from the gut contents."@en ,
                        "Matsmältningssystemet: tar upp vatten och salter ur tarminnehållet."@sv .

<#caecum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Caecum"@en ,
                     "blindtarm"@sv ;
    solid-memo:back "Caecum"@la ;
    solid-memo:backNote "Large intestine: the pouch where it begins; the appendix hangs from it."@en ,
                        "Tjocktarmen: utbuktningen där den börjar; blindtarmsbihanget sitter på den."@sv .

<#appendix>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Appendix"@en ,
                     "blindtarmsbihang"@sv ;
    solid-memo:back "Appendix vermiformis"@la ;
    solid-memo:backNote "Large intestine: a worm-shaped, blind-ended tube attached to the caecum; its inflammation is appendicitis."@en ,
                        "Tjocktarmen: maskformigt bihang till blindtarmen; inflammation i det kallas i dagligt tal blindtarmsinflammation."@sv .

<#rectum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Rectum"@en ,
                     "ändtarm"@sv ;
    solid-memo:back "Rectum"@la ;
    solid-memo:backNote "Large intestine: the part just before the anal canal."@en ,
                        "Tjocktarmen: delen närmast före tarmens sista avsnitt, det som mynnar i analöppningen."@sv .

<#liver>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Liver"@en ,
                     "lever"@sv ;
    solid-memo:back "Hepar"@la ;
    solid-memo:backNote "Digestive system: detoxifies, metabolises and stores substances."@en ,
                        "Matsmältningssystemet: står för avgiftning, ämnesomsättning och lagring av ämnen."@sv .

<#gallbladder>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Gallbladder"@en ,
                     "gallblåsa"@sv ;
    solid-memo:back "Vesica biliaris"@la ;
    solid-memo:backNote "Digestive system: stores bile and releases it into the duodenum."@en ,
                        "Matsmältningssystemet: lagrar galla och släpper ut den i tolvfingertarmen."@sv .

<#pancreas>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pancreas"@en ,
                     "bukspottkörtel"@sv ;
    solid-memo:back "Pancreas"@la ;
    solid-memo:backNote "Digestive and endocrine systems: makes digestive enzymes and insulin."@en ,
                        "Matsmältningssystemet och endokrina systemet: bildar matsmältningsenzymer och insulin."@sv .

<#kidney>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Kidney"@en ,
                     "njure"@sv ;
    solid-memo:back "Ren"@la ;
    solid-memo:backNote "Urinary system: filters the blood and makes urine."@en ,
                        "Urinsystemet: filtrerar blodet och bildar urin."@sv .

<#ureter>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ureter"@en ,
                     "urinledare"@sv ;
    solid-memo:back "Ureter"@la ;
    solid-memo:backNote "Urinary system: carries urine from the kidney to the bladder."@en ,
                        "Urinsystemet: för urinen från njuren till urinblåsan."@sv .

<#urinary-bladder>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Urinary bladder"@en ,
                     "urinblåsa"@sv ;
    solid-memo:back "Vesica urinaria"@la ;
    solid-memo:backNote "Urinary system: stores urine until it is passed."@en ,
                        "Urinsystemet: lagrar urinen fram till tömningen."@sv .

<#ovary>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ovary"@en ,
                     "äggstock"@sv ;
    solid-memo:back "Ovarium"@la ;
    solid-memo:backNote "Female reproductive system: produces egg cells and sex hormones."@en ,
                        "Kvinnliga könsorganen: bildar äggceller och könshormoner."@sv .

<#fallopian-tube>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Fallopian tube"@en ,
                     "äggledare"@sv ;
    solid-memo:back "Tuba uterina"@la ;
    solid-memo:backNote "Female reproductive system: carries egg cells from the ovary to the uterus."@en ,
                        "Kvinnliga könsorganen: för äggcellerna från äggstocken till livmodern."@sv .

<#uterus>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Womb"@en ,
                     "livmoder"@sv ;
    solid-memo:back "Uterus"@la ;
    solid-memo:backNote "Female reproductive system: where the fetus develops."@en ,
                        "Kvinnliga könsorganen: här utvecklas fostret."@sv .

<#testis>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Testicle"@en ,
                     "testikel"@sv ;
    solid-memo:back "Testis"@la ;
    solid-memo:backNote "Male reproductive system: produces sperm and male sex hormones."@en ,
                        "Manliga könsorganen: bildar spermier och manliga könshormoner."@sv .

<#thyroid-gland>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Thyroid gland"@en ,
                     "sköldkörtel"@sv ;
    solid-memo:back "Glandula thyroidea"@la ;
    solid-memo:backNote "Endocrine system: gland in the neck whose hormones are key to metabolism."@en ,
                        "Endokrina systemet: körtel i halsen vars hormoner är viktiga för ämnesomsättningen."@sv .

<#adrenal-gland>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Adrenal gland"@en ,
                     "binjure"@sv ;
    solid-memo:back "Glandula suprarenalis"@la ;
    solid-memo:backNote "Endocrine system: sits above the kidney; makes adrenaline and cortisol."@en ,
                        "Endokrina systemet: sitter ovanför njuren; bildar adrenalin och kortisol."@sv .

<#pituitary-gland>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pituitary gland"@en ,
                     "hypofys"@sv ;
    solid-memo:back "Hypophysis"@la ;
    solid-memo:backNote "Endocrine system: small gland under the brain, joined to the hypothalamus."@en ,
                        "Endokrina systemet: liten körtel under hjärnan, förbunden med hypotalamus."@sv .

<#pineal-gland>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pineal gland"@en ,
                     "tallkottkörtel"@sv ;
    solid-memo:back "Glandula pinealis"@la ;
    solid-memo:backNote "Endocrine system: gland in the brain that makes melatonin."@en ,
                        "Endokrina systemet: körtel i hjärnan som bildar melatonin."@sv .

<#spleen>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Spleen"@en ,
                     "mjälte"@sv ;
    solid-memo:back "Splen"@la ;
    solid-memo:backNote "Lymphatic system: filters the blood."@en ,
                        "Lymfsystemet: filtrerar blodet."@sv .

<#thymus>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Thymus"@en ,
                     "bräss"@sv ;
    solid-memo:back "Thymus"@la ;
    solid-memo:backNote "Lymphatic system: key to the immune system early in life; shrinks after puberty."@en ,
                        "Lymfsystemet: viktig för immunförsvaret tidigt i livet; krymper efter puberteten."@sv .

<#palatine-tonsil>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Palatine tonsil"@en ,
                     "halsmandel"@sv ;
    solid-memo:back "Tonsilla palatina"@la ;
    solid-memo:backNote "Lymphatic system: lymphoid tissue in the side wall of the throat, one on each side."@en ,
                        "Lymfsystemet: lymfvävnad i svalgets sidovägg, en på vardera sidan."@sv .

