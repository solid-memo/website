<#jjireuda>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To stab, pierce, poke"@en ,
                     "Att sticka, hugga, peta"@sv ;
    solid-memo:back "찌르다"@ko ;
    solid-memo:backNote "장미 가시가 손을 찔렀어요. — A rose thorn pricked my hand."@en ,
