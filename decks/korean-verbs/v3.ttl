    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To pass by, go past"@en ,
                     "Att gå förbi, passera"@sv ;
    solid-memo:back "지나가다"@ko ;
    solid-memo:backNote "버스가 그냥 지나갔어요. — The bus just went past."@en ,
                        "버스가 그냥 지나갔어요. — Bussen åkte bara förbi."@sv ,
                        "버스가 그냥 지나갔어요. — Der Bus ist einfach vorbeigefahren."@de ,
                        "버스가 그냥 지나갔어요. — El autobús pasó de largo."@es ,
                        "버스가 그냥 지나갔어요. — Le bus est passé sans s'arrêter."@fr .

<#deureonada>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To be revealed, show, become visible"@en ,
                     "Att avslöjas, synas, framträda"@sv ;
    solid-memo:back "드러나다"@ko ;
    solid-memo:backNote "결국 진실이 드러났어요. — In the end, the truth was revealed."@en ,
                        "결국 진실이 드러났어요. — Till slut avslöjades sanningen."@sv ,
                        "결국 진실이 드러났어요. — Am Ende kam die Wahrheit ans Licht."@de ,
                        "결국 진실이 드러났어요. — Al final, la verdad salió a la luz."@es ,
                        "결국 진실이 드러났어요. — Finalement, la vérité a été révélée."@fr .

<#malsseumhada>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To say, speak (honorific)"@en ,
                     "Att säga, tala (artigt)"@sv ;
    solid-memo:back "말씀하다"@ko ;
    solid-memo:backNote "선생님께서 천천히 말씀하셨어요. — The teacher spoke slowly."@en ,
                        "선생님께서 천천히 말씀하셨어요. — Läraren talade långsamt."@sv ,
                        "선생님께서 천천히 말씀하셨어요. — Der Lehrer hat langsam gesprochen."@de ,
                        "선생님께서 천천히 말씀하셨어요. — El profesor habló despacio."@es ,
                        "선생님께서 천천히 말씀하셨어요. — Le professeur a parlé lentement."@fr .

