    dcterms:creator "Sveriges Television (SVT Nyheter)" ;
    rdfs:comment "The article page (fetched 2026-10-04) states no open licence; a news article is protected under the Swedish Copyright Act (upphovsrättslagen 1960:729, 1 §), so it is treated as all rights reserved and used for verification only, with one short phrase quoted as evidence."@en .

<#amendment-1>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "First Amendment"@en ,
                     "Första tillägget"@sv ;
    solid-memo:back "Freedom of religion, speech, the press and assembly, and the right to petition the government"@en ,
                    "Religionsfrihet, yttrandefrihet, pressfrihet, mötesfrihet och rätten att vända sig till staten med klagomål"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-2>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Second Amendment"@en ,
                     "Andra tillägget"@sv ;
    solid-memo:back "The right to keep and bear arms"@en ,
                    "Rätten att inneha och bära vapen"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-3>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Third Amendment"@en ,
                     "Tredje tillägget"@sv ;
    solid-memo:back "No soldiers may be quartered in any house in peacetime without the owner's consent"@en ,
                    "Inga soldater får inkvarteras i något hus i fredstid utan ägarens samtycke"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-4>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Fourth Amendment"@en ,
                     "Fjärde tillägget"@sv ;
    solid-memo:back "Protection against unreasonable searches and seizures; warrants require probable cause"@en ,
                    "Skydd mot orimliga husrannsakningar och beslag; ett beslut om husrannsakan eller beslag kräver skälig misstanke"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-5>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Fifth Amendment"@en ,
                     "Femte tillägget"@sv ;
    solid-memo:back "Grand jury indictment, no double jeopardy, no self-incrimination, due process and compensation for property taken"@en ,
                    "Åtal genom åtalsjury, förbud mot att prövas två gånger för samma brott och mot tvång att vittna mot sig själv, rättssäkert förfarande och ersättning för egendom som tas i anspråk"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-6>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Sixth Amendment"@en ,
                     "Sjätte tillägget"@sv ;
    solid-memo:back "In criminal cases: a speedy and public trial by an impartial jury, the right to confront and call witnesses, and a defence lawyer"@en ,
                    "I brottmål: snabb och offentlig rättegång inför en opartisk jury, rätt att möta och kalla vittnen och rätt till försvarare"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-7>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Seventh Amendment"@en ,
                     "Sjunde tillägget"@sv ;
    solid-memo:back "The right to a jury trial in civil suits at common law over twenty dollars"@en ,
                    "Rätten till juryrättegång i civilmål enligt common law där värdet överstiger tjugo dollar"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-8>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Eighth Amendment"@en ,
                     "Åttonde tillägget"@sv ;
    solid-memo:back "No excessive bail or fines, and no cruel and unusual punishments"@en ,
                    "Förbud mot orimligt höga borgenssummor och böter samt mot grymma och ovanliga straff"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-9>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ninth Amendment"@en ,
                     "Nionde tillägget"@sv ;
    solid-memo:back "Listing certain rights in the Constitution does not deny other rights retained by the people"@en ,
                    "Att vissa rättigheter räknas upp i konstitutionen förnekar inte andra rättigheter som folket har kvar"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-10>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Tenth Amendment"@en ,
                     "Tionde tillägget"@sv ;
    solid-memo:back "Powers not delegated to the federal government, nor prohibited to the states, are reserved to the states or the people"@en ,
                    "Befogenheter som konstitutionen inte ger den federala staten och inte förbjuder delstaterna tillkommer delstaterna eller folket"@sv ;
    solid-memo:backNote "Ratified 1791; part of the Bill of Rights"@en ,
                        "Ratificerat 1791; ingår i Bill of Rights"@sv .

<#amendment-11>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Eleventh Amendment"@en ,
                     "Elfte tillägget"@sv ;
    solid-memo:back "Federal courts may not hear suits against a state by citizens of another state or of a foreign country"@en ,
                    "Federala domstolar får inte pröva mål mot en delstat som väckts av medborgare i en annan delstat eller i ett annat land"@sv ;
    solid-memo:backNote "Ratified 1795"@en ,
                        "Ratificerat 1795"@sv .

<#amendment-12>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Twelfth Amendment"@en ,
                     "Tolfte tillägget"@sv ;
    solid-memo:back "Electors cast separate votes for president and vice president"@en ,
                    "Elektorerna röstar separat på president och vicepresident"@sv ;
    solid-memo:backNote "Ratified 1804"@en ,
                        "Ratificerat 1804"@sv .

<#amendment-13>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Thirteenth Amendment"@en ,
                     "Trettonde tillägget"@sv ;
    solid-memo:back "Abolishes slavery and involuntary servitude, except as punishment for a crime"@en ,
                    "Avskaffar slaveri och annat tvångsarbete, utom som straff för brott"@sv ;
    solid-memo:backNote "Ratified 1865"@en ,
                        "Ratificerat 1865"@sv .

<#amendment-14>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Fourteenth Amendment"@en ,
                     "Fjortonde tillägget"@sv ;
    solid-memo:back "Citizenship for all persons born or naturalized in the US and subject to its jurisdiction; states must give everyone due process and equal protection of the laws"@en ,
                    "Medborgarskap för alla som är födda eller naturaliserade i USA och lyder under dess jurisdiktion; delstaterna måste ge alla rättssäkert förfarande och lika skydd av lagen"@sv ;
    solid-memo:backNote "Ratified 1868"@en ,
                        "Ratificerat 1868"@sv .

<#amendment-15>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Fifteenth Amendment"@en ,
                     "Femtonde tillägget"@sv ;
    solid-memo:back "The right to vote may not be denied on account of race, color or previous condition of servitude"@en ,
                    "Rösträtten får inte förvägras på grund av ras, hudfärg eller att man tidigare varit slav"@sv ;
    solid-memo:backNote "Ratified 1870"@en ,
                        "Ratificerat 1870"@sv .

<#amendment-16>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Sixteenth Amendment"@en ,
                     "Sextonde tillägget"@sv ;
    solid-memo:back "Congress may levy an income tax without apportioning it among the states"@en ,
                    "Kongressen får ta ut inkomstskatt utan att fördela den mellan delstaterna efter folkmängd"@sv ;
    solid-memo:backNote "Ratified 1913"@en ,
                        "Ratificerat 1913"@sv .

<#amendment-17>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Seventeenth Amendment"@en ,
                     "Sjuttonde tillägget"@sv ;
    solid-memo:back "Senators are elected directly by the people of each state"@en ,
                    "Senatorerna väljs direkt av folket i varje delstat"@sv ;
    solid-memo:backNote "Ratified 1913"@en ,
                        "Ratificerat 1913"@sv .

<#amendment-18>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Eighteenth Amendment"@en ,
                     "Artonde tillägget"@sv ;
    solid-memo:back "Prohibition: bans the manufacture, sale and transport of alcoholic drinks"@en ,
                    "Alkoholförbud: förbjuder tillverkning, försäljning och transport av alkoholdrycker"@sv ;
    solid-memo:backNote "Ratified 1919; repealed by the Twenty-first Amendment in 1933"@en ,
                        "Ratificerat 1919; upphävt genom tjugoförsta tillägget 1933"@sv .

<#amendment-19>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Nineteenth Amendment"@en ,
                     "Nittonde tillägget"@sv ;
    solid-memo:back "The right to vote may not be denied on account of sex (women's suffrage)"@en ,
                    "Rösträtten får inte förvägras på grund av kön (kvinnlig rösträtt)"@sv ;
    solid-memo:backNote "Ratified 1920"@en ,
                        "Ratificerat 1920"@sv .

<#amendment-20>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Twentieth Amendment"@en ,
                     "Tjugonde tillägget"@sv ;
    solid-memo:back "Presidential terms begin on 20 January and congressional terms on 3 January"@en ,
                    "Presidentens mandatperiod börjar den 20 januari och kongressledamöternas den 3 januari"@sv ;
    solid-memo:backNote "Ratified 1933"@en ,
                        "Ratificerat 1933"@sv .

<#amendment-21>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Twenty-first Amendment"@en ,
                     "Tjugoförsta tillägget"@sv ;
    solid-memo:back "Repeals Prohibition (the Eighteenth Amendment)"@en ,
                    "Upphäver alkoholförbudet (artonde tillägget)"@sv ;
    solid-memo:backNote "Ratified 1933"@en ,
                        "Ratificerat 1933"@sv .

<#amendment-22>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Twenty-second Amendment"@en ,
                     "Tjugoandra tillägget"@sv ;
    solid-memo:back "No one may be elected president more than twice"@en ,
                    "Ingen får väljas till president mer än två gånger"@sv ;
    solid-memo:backNote "Ratified 1951"@en ,
                        "Ratificerat 1951"@sv .

<#amendment-23>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Twenty-third Amendment"@en ,
                     "Tjugotredje tillägget"@sv ;
    solid-memo:back "Gives the District of Columbia electors in presidential elections"@en ,
                    "Ger District of Columbia elektorer i presidentval"@sv ;
    solid-memo:backNote "Ratified 1961"@en ,
                        "Ratificerat 1961"@sv .

<#amendment-24>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Twenty-fourth Amendment"@en ,
                     "Tjugofjärde tillägget"@sv ;
    solid-memo:back "The vote in federal elections may not be denied for failure to pay a poll tax or other tax"@en ,
                    "Rösträtten i federala val får inte förvägras för att man inte betalat kapitationsskatt eller annan skatt"@sv ;
    solid-memo:backNote "Ratified 1964"@en ,
                        "Ratificerat 1964"@sv .

<#amendment-25>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Twenty-fifth Amendment"@en ,
                     "Tjugofemte tillägget"@sv ;
    solid-memo:back "Rules for when the president is removed, resigns, dies or cannot discharge the office, and for filling a vacant vice presidency"@en ,
                    "Regler för när presidenten avsätts, avgår, dör eller inte kan sköta ämbetet, och för att tillsätta en vakant vicepresidentpost"@sv ;
    solid-memo:backNote "Ratified 1967"@en ,
                        "Ratificerat 1967"@sv .

<#amendment-26>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Twenty-sixth Amendment"@en ,
                     "Tjugosjätte tillägget"@sv ;
    solid-memo:back "Citizens aged 18 or older may not be denied the vote on account of age"@en ,
                    "Rösträtten får inte förvägras medborgare som fyllt 18 år på grund av ålder"@sv ;
    solid-memo:backNote "Ratified 1971"@en ,
                        "Ratificerat 1971"@sv .

<#amendment-27>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Twenty-seventh Amendment"@en ,
                     "Tjugosjunde tillägget"@sv ;
    solid-memo:back "A change in the pay of members of Congress takes effect only after the next House election"@en ,
                    "En ändring av kongressledamöternas arvode träder i kraft först efter nästa val till representanthuset"@sv ;
    solid-memo:backNote "Proposed 1789, ratified 1992"@en ,
                        "Föreslaget 1789, ratificerat 1992"@sv .

