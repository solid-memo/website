<#q-copyright-2b-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "License Must Not Restrict Other Software"@en ,
                              "Licensen får inte begränsa annan programvara"@sv ,
                              "라이선스는 다른 소프트웨어를 제한하지 않아야 함"@ko ,
                              "Die Lizenz darf andere Software nicht einschränken"@de ,
