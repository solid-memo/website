    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "a fortiori"@la ;
    solid-memo:back "with all the more reason"@en ,
                    "med så mycket större skäl"@sv .

<#a-posteriori>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "a posteriori"@la ;
    solid-memo:back "based on experience or observation"@en ,
                    "grundat på erfarenhet"@sv ;
    solid-memo:backNote "The opposite of a priori."@en ,
                        "Motsatsen till a priori."@sv .

<#a-priori>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "a priori"@la ;
    solid-memo:back "beforehand; independent of experience"@en ,
                    "på förhand; oberoende av erfarenhet"@sv ;
    solid-memo:backNote "The opposite of a posteriori."@en ,
                        "Motsatsen till a posteriori."@sv .

