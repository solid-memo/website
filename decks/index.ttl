<#http-status-codes>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "HTTP status codes"@en ,
                  "HTTP-statuskoder"@sv ,
                  "HTTP 상태 코드"@ko ,
                  "HTTP-Statuscodes"@de ,
                  "Códigos de estado HTTP"@es ,
                  "Codes de statut HTTP"@fr ;
    dcterms:description "Every HTTP status code and its reason phrase. The list follows MDN's HTTP response status codes reference; the codes and names themselves are defined by the IETF and recorded in the IANA HTTP Status Code Registry."@en ,
                        "Varje HTTP-statuskod och dess statusfras. Listan följer MDN:s referens över HTTP-statuskoder; koderna och fraserna definieras av IETF och förs in i IANA:s register över HTTP-statuskoder. Statusfraserna står på engelska, så som de skrivs i HTTP."@sv ,
                        "모든 HTTP 상태 코드와 그 사유 구문. 목록은 MDN의 HTTP 응답 상태 코드 문서를 따르며, 코드와 이름 자체는 IETF가 정의하고 IANA HTTP Status Code Registry에 기록되어 있다."@ko ,
                        "Jeder HTTP-Statuscode und sein Statustext. Die Liste folgt der MDN-Referenz zu den HTTP-Antwortstatuscodes; die Codes und Bezeichnungen selbst legt die IETF fest, und sie sind in der IANA HTTP Status Code Registry verzeichnet."@de ,
                        "Cada código de estado HTTP y su frase de estado. La lista sigue la referencia de códigos de estado de respuesta HTTP de MDN; los códigos y sus nombres los define el IETF y se recogen en el IANA HTTP Status Code Registry."@es ,
                        "Chaque code de statut HTTP et son intitulé. La liste suit la référence des codes de statut de réponse HTTP de MDN ; les codes et leurs intitulés sont définis par l’IETF et consignés dans l’IANA HTTP Status Code Registry."@fr ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ;
    dcat:keyword "HTTP"@en ,
                 "status codes"@en ,
                 "web"@en ,
                 "HTTP"@sv ,
                 "statuskoder"@sv ,
                 "webb"@sv ,
                 "HTTP"@ko ,
                 "상태 코드"@ko ,
                 "HTTP 상태 코드"@ko ,
                 "웹"@ko ,
                 "HTTP"@de ,
                 "Statuscodes"@de ,
                 "HTTP-Statuscodes"@de ,
                 "Web"@de ,
                 "HTTP"@es ,
                 "códigos de estado"@es ,
                 "códigos HTTP"@es ,
                 "web"@es ,
                 "HTTP"@fr ,
                 "codes de statut"@fr ,
                 "codes HTTP"@fr ,
                 "web"@fr ;
    dcat:first <https://solid-memo.com/decks/http-status-codes/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/http-status-codes/v2.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/http-status-codes/v1.ttl> ,
