<#physics-equations>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Physics equations"@en ,
                  "Fysikformler"@sv ;
    dcterms:description "42 fundamental equations of school and first-year university physics: motion and forces, energy, work and power, gravitation, oscillations, fluids, heat and gases, waves and optics, electricity and magnetism, and photons and relativity. Front: the law or quantity, naming every symbol, e.g. \"Ohm's law: voltage U across a resistance R carrying a current I\"; back: the equation, e.g. \"U = RI\". Voltage is U throughout, as in Swedish schools. Each equation is checked for dimensional consistency with SymPy and against OpenStax University Physics, and where they state it, against Wikidata and Swedish Wikipedia."@en ,
                        "42 grundläggande formler ur gymnasiets fysik och första årets högskolefysik: rörelse och krafter, energi, arbete och effekt, gravitation, svängningar, vätskor, värme och gaser, vågor och optik, elektricitet och magnetism samt fotoner och relativitet. Framsida: lagen eller storheten med alla beteckningar namngivna, t.ex. ”Ohms lag: spänningen U över resistansen R när strömmen är I”; baksida: formeln, t.ex. ”U = RI”. Spänning betecknas genomgående U, som i svensk skola. Varje formel är kontrollerad för dimensionell konsistens med SymPy och mot OpenStax University Physics, och där de anger den även mot Wikidata och svenska Wikipedia."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:physics ;
    dcat:keyword "physics"@en ,
                 "equations"@en ,
                 "formulas"@en ,
                 "mechanics"@en ,
                 "electricity"@en ,
                 "SI units"@en ,
                 "fysik"@sv ,
                 "formler"@sv ,
                 "ekvationer"@sv ,
                 "mekanik"@sv ,
                 "elektricitet"@sv ,
                 "SI-enheter"@sv ;
    dcat:first <https://solid-memo.com/decks/physics-equations/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/physics-equations/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/physics-equations/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/physics-equations/v1.ttl> .

