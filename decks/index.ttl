<#world-history-dates>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "World history dates"@en ,
                  "Årtal i världshistorien"@sv ;
    dcterms:description "87 landmark events of world history, from the Battle of Marathon to the September 11 attacks, spread across eras and continents. The front names the event in English and Swedish; the back gives the year it happened. A plain number is a year AD; years before Christ are written “490 BC” (“490 f.Kr.”). Years from Wikidata, each checked against Store norske leksikon."@en ,
                        "87 avgörande händelser i världshistorien, från slaget vid Marathon till 11 september-attackerna, spridda över epoker och världsdelar. Framsidan namnger händelsen på engelska och svenska; baksidan ger året då den inträffade. Ett tal utan tillägg är ett år efter Kristus; år före Kristus skrivs ”490 f.Kr.” (”490 BC”). Årtalen kommer från Wikidata och är kontrollerade mot Store norske leksikon."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:history ;
    dcat:keyword "history"@en ,
                 "world history"@en ,
                 "dates"@en ,
                 "historical events"@en ,
                 "historia"@sv ,
                 "världshistoria"@sv ,
                 "årtal"@sv ,
                 "historiska händelser"@sv ;
    dcat:first <https://solid-memo.com/decks/world-history-dates/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/world-history-dates/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/world-history-dates/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/world-history-dates/v1.ttl> .

