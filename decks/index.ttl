<#us-constitution-amendments>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Amendments to the US Constitution"@en ,
                  "Tilläggen till USA:s konstitution"@sv ;
    dcterms:description "All 27 amendments to the Constitution of the United States as of 4 October 2026, from the First Amendment (1791) to the Twenty-seventh (1992); the first ten form the Bill of Rights. Front: the amendment, e.g. \"Nineteenth Amendment\"; back: what it does, summarised in English and Swedish, with the year its ratification was completed in a note. Summaries written from the text of the Constitution as transcribed by the National Archives and printed in the House Manual; numbering and years from Wikidata, the National Archives and the House Manual."@en ,
                        "Samtliga 27 tillägg till USA:s konstitution per den 4 oktober 2026, från första tillägget (1791) till det tjugosjunde (1992); de tio första utgör Bill of Rights. Framsida: tillägget, t.ex. ”Nittonde tillägget”; baksida: vad det innebär, sammanfattat på engelska och svenska, med året då ratificeringen fullbordades i en anteckning. Sammanfattningarna bygger på konstitutionens text så som National Archives och representanthusets regelsamling (House Manual) återger den; numrering och år från Wikidata, National Archives och House Manual."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:history ;
    dcat:keyword "US Constitution"@en ,
                 "constitutional amendments"@en ,
                 "Bill of Rights"@en ,
                 "American history"@en ,
                 "civil rights"@en ,
                 "USA:s konstitution"@sv ,
                 "författningstillägg"@sv ,
                 "Bill of Rights"@sv ,
                 "amerikansk historia"@sv ,
                 "medborgerliga rättigheter"@sv ;
    dcat:first <https://solid-memo.com/decks/us-constitution-amendments/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/us-constitution-amendments/v1.ttl> ;
