<#derivatives>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Derivatives"@en ,
                  "Derivator"@sv ;
    dcterms:description "42 cards on derivatives for calculus students: the definition, the differentiation rules (sum, product, quotient, chain and more) and the derivatives of powers, roots, exponential, logarithmic, trigonometric, inverse trigonometric, hyperbolic and inverse hyperbolic functions. The rule or function on the front in plain notation such as d/dx sin x, the derivative on the back; angles in radians. Every card is checked with the computer algebra system SymPy and against the NIST Digital Library of Mathematical Functions or Wikipedia (most cards both); rule names checked against Wikidata."@en ,
                        "42 kort om derivator för den som läser matematisk analys: definitionen, deriveringsreglerna (summa-, produkt-, kvot- och kedjeregeln med flera) och derivatorna av potenser, rötter, exponential- och logaritmfunktioner, trigonometriska funktioner, arcusfunktioner, hyperboliska funktioner och deras inverser. Regeln eller funktionen på framsidan i enkel notation som d/dx sin x, derivatan på baksidan; vinklar i radianer. Varje kort är kontrollerat med datoralgebrasystemet SymPy och mot NIST Digital Library of Mathematical Functions eller Wikipedia (de flesta mot båda); regelnamnen är kontrollerade mot Wikidata."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:mathematics ;
    dcat:keyword "calculus"@en ,
                 "derivatives"@en ,
                 "differentiation rules"@en ,
                 "mathematics"@en ,
                 "matematisk analys"@sv ,
                 "infinitesimalkalkyl"@sv ,
                 "derivator"@sv ,
                 "deriveringsregler"@sv ,
                 "matematik"@sv ;
    dcat:first <https://solid-memo.com/decks/derivatives/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/derivatives/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/derivatives/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/derivatives/v1.ttl> .

<https://solid-memo.com/decks/derivatives/v1.ttl>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Derivatives"@en ,
                  "Derivator"@sv ;
    dcterms:creator <https://solid-memo.com/decks/derivatives/v1.ttl#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "42 cards on derivatives for calculus students: the definition, the differentiation rules (sum, product, quotient, chain and more) and the derivatives of powers, roots, exponential, logarithmic, trigonometric, inverse trigonometric, hyperbolic and inverse hyperbolic functions. The rule or function on the front in plain notation such as d/dx sin x, the derivative on the back; angles in radians. Every card is checked with the computer algebra system SymPy and against the NIST Digital Library of Mathematical Functions or Wikipedia (most cards both); rule names checked against Wikidata."@en ,
                        "42 kort om derivator för den som läser matematisk analys: definitionen, deriveringsreglerna (summa-, produkt-, kvot- och kedjeregeln med flera) och derivatorna av potenser, rötter, exponential- och logaritmfunktioner, trigonometriska funktioner, arcusfunktioner, hyperboliska funktioner och deras inverser. Regeln eller funktionen på framsidan i enkel notation som d/dx sin x, derivatan på baksidan; vinklar i radianer. Varje kort är kontrollerat med datoralgebrasystemet SymPy och mot NIST Digital Library of Mathematical Functions eller Wikipedia (de flesta mot båda); regelnamnen är kontrollerade mot Wikidata."@sv ;
    prov:wasDerivedFrom <https://solid-memo.com/decks/derivatives/v1.ttl#own-work> ,
                        <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <https://solid-memo.com/decks/derivatives/v1.ttl#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
