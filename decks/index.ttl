<#eurovision-winners>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Eurovision Song Contest winners"@en ,
                  "Vinnare i Eurovision Song Contest"@sv ;
    dcterms:description "The winners of every Eurovision Song Contest from the first, in 1956, to the 70th, in May 2026: 70 cards (no contest was held in 2020). Front: the contest, e.g. “Eurovision Song Contest 1974”; back: the winning country and song, e.g. Sweden – “Waterloo”, with the performer in a note. Song titles are given as performed, untranslated. The 1969 contest ended in a four-way tie, so its card names all four winners. Taken from Wikidata and the English Wikipedia and checked against the EBU’s eurovision.com and the Swedish Wikipedia."@en ,
                        "Vinnarna i varje Eurovision Song Contest från den första 1956 till den 70:e i maj 2026: 70 kort (år 2020 hölls ingen tävling). Framsida: tävlingen, t.ex. ”Eurovision Song Contest 1974”; baksida: vinnarlandet och låten, t.ex. Sverige – ”Waterloo”, med artisten i en anteckning. Låttitlarna står som de framfördes, oöversatta. Tävlingen 1969 slutade med att fyra bidrag delade segern, så det kortet nämner alla fyra. Uppgifterna är hämtade från Wikidata och engelskspråkiga Wikipedia och kontrollerade mot EBU:s eurovision.com och svenskspråkiga Wikipedia."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:music ;
    dcat:keyword "Eurovision Song Contest"@en ,
                 "Eurovision"@en ,
                 "song contest"@en ,
                 "pop music"@en ,
                 "winning songs"@en ,
                 "Eurovision Song Contest"@sv ,
                 "Eurovision"@sv ,
                 "sångtävling"@sv ,
                 "popmusik"@sv ,
                 "vinnarlåtar"@sv ;
    dcat:first <https://solid-memo.com/decks/eurovision-winners/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/eurovision-winners/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/eurovision-winners/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/eurovision-winners/v1.ttl> .

