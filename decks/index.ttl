                 "art history"@en ,
                 "landmarks"@en ,
                 "arkitektur"@sv ,
                 "arkitekter"@sv ,
                 "byggnader"@sv ,
                 "konsthistoria"@sv ,
                 "sevärdheter"@sv ;
