<#danish-monarchs>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Monarchs of Denmark"@en ,
                  "Danmarks regenter"@sv ;
    dcterms:description "The 22 monarchs of Denmark from Christian I, the first king of the House of Oldenburg (1448), to Frederik X, king since 14 January 2024, as of 4 October 2026. Front: the monarch's regnal name in English and Swedish; back: the years of the reign, counted from accession to death, deposition or abdication, with the royal house (Oldenburg or Glücksburg) and a short fact in a note. Taken from Wikidata (one note from the public-domain 1911 Encyclopædia Britannica) and checked against the Danish Royal House's list of monarchs (kongehuset.dk), Lex – Danmarks Nationalleksikon, Nationalencyklopedin and the Swedish Wikipedia."@en ,
                        "Danmarks 22 regenter från Kristian I, den förste kungen av huset Oldenburg (1448), till Frederik X, kung sedan den 14 januari 2024, per den 4 oktober 2026. Framsida: regentens namn på engelska och svenska; baksida: regeringsåren, räknade från trontillträdet till regentens död, avsättning eller abdikation, med kungahuset (Oldenburg eller Glücksburg) och en kort upplysning i en anteckning. Uppgifterna är hämtade från Wikidata (en anteckning från Encyclopædia Britannica 1911, som är fri från upphovsrätt) och kontrollerade mot det danska kungahusets regentlängd (kongehuset.dk), Lex – Danmarks Nationalleksikon, Nationalencyklopedin och svenskspråkiga Wikipedia."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:history ;
    dcat:keyword "Danish monarchs"@en ,
                 "kings of Denmark"@en ,
                 "Danish history"@en ,
                 "House of Oldenburg"@en ,
                 "House of Glücksburg"@en ,
                 "danska monarker"@sv ,
                 "Danmarks regenter"@sv ,
                 "Danmarks historia"@sv ,
                 "huset Oldenburg"@sv ,
                 "huset Glücksburg"@sv ;
    dcat:first <https://solid-memo.com/decks/danish-monarchs/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/danish-monarchs/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/danish-monarchs/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/danish-monarchs/v1.ttl> .

