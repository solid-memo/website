<#morse-code>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "International Morse code"@en ,
                  "Internationella morsealfabetet"@sv ;
    dcterms:description "The International Morse code of Recommendation ITU-R M.1677-1 (the 26 letters A–Z and É, the digits 0–9 and 13 of its 14 punctuation marks and signs; × is sent as X), plus the distress signal SOS from the International Regulations for Preventing Collisions at Sea: 51 cards in all. Front: the character; back: its code, written with · for a dot and − for a dash; studied in both directions. Å, Ä and Ö are not in the current ITU recommendation and are left out. The codes come from Wikidata and the US edition of the International Code of Signals (Pub. 102), checked against the ITU recommendation and Wikipedia."@en ,
                        "Det internationella morsealfabetet enligt rekommendationen ITU-R M.1677-1 (de 26 bokstäverna A–Z och É, siffrorna 0–9 och 13 av dess 14 skiljetecken och symboler; × sänds som X) samt nödsignalen SOS från de internationella sjövägsreglerna, sammanlagt 51 kort. Framsida: tecknet; baksida: dess kod, skriven med · för en kort och − för en lång signal; kortleken övas åt båda hållen. Å, Ä och Ö ingår inte i den gällande ITU-rekommendationen och har utelämnats. Koderna är hämtade från Wikidata och den amerikanska utgåvan av International Code of Signals (Pub. 102) och kontrollerade mot ITU-rekommendationen och Wikipedia."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ,
               topic:languages ;
    dcat:keyword "Morse code"@en ,
                 "telegraphy"@en ,
                 "SOS"@en ,
                 "amateur radio"@en ,
                 "ITU"@en ,
                 "morsealfabetet"@sv ,
                 "telegrafi"@sv ,
                 "SOS"@sv ,
                 "amatörradio"@sv ,
                 "ITU"@sv ;
    dcat:first <https://solid-memo.com/decks/morse-code/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/morse-code/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/morse-code/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/morse-code/v1.ttl> .

