<#sweden-counties-and-provinces>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Sweden's counties and provinces"@en ,
                  "Sveriges län och landskap"@sv ;
    dcterms:description "Sweden's 21 counties and 25 provinces in 46 cards, in English and Swedish. A county card shows the county's name and asks for its seat (residensstad); a province card shows the province's name and asks for the land (landsdel) it traditionally belongs to: Götaland, Svealand or Norrland. Compiled from Wikidata and checked against the county administrative boards' websites, Nationalencyklopedin and Wikipedia."@en ,
                        "Sveriges 21 län och 25 landskap på 46 kort, på engelska och svenska. Ett länskort visar länets namn och frågar efter residensstaden; ett landskapskort visar landskapets namn och frågar efter landsdelen det traditionellt hör till: Götaland, Svealand eller Norrland. Sammanställd från Wikidata och kontrollerad mot länsstyrelsernas webbplatser, Nationalencyklopedin och Wikipedia."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ;
    dcat:keyword "Sweden"@en ,
                 "counties"@en ,
                 "provinces"@en ,
