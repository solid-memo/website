<#swedish-monarchs>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Monarchs of Sweden since Gustav Vasa"@en ,
                  "Sveriges regenter sedan Gustav Vasa"@sv ;
    dcterms:description "The 23 monarchs of Sweden from Gustav I (elected 1523) to Carl XVI Gustaf, the two queens regnant included. Front: the monarch's regnal name in English and Swedish; back: the years of the reign, counted from accession to death, abdication or deposition, with the royal house, a short fact and any differing convention in a note. Taken from Wikidata and the public-domain 1911 Encyclopædia Britannica, and checked against the Royal Court's list of monarchs (kungahuset.se)."@en ,
                        "Sveriges 23 regenter från Gustav I (vald 1523) till Carl XVI Gustaf, de två regerande drottningarna inräknade. Framsida: regentens namn på engelska och svenska; baksida: regeringsåren, räknade från trontillträdet till regentens död, abdikation eller avsättning, med ätten, en kort upplysning och eventuella avvikande räknesätt i en anteckning. Uppgifterna kommer från Wikidata och den upphovsrättsfria Encyclopædia Britannica från 1911 och är kontrollerade mot Kungahusets regentlängd (kungahuset.se)."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:history ;
    dcat:keyword "Swedish monarchs"@en ,
                 "kings of Sweden"@en ,
                 "Swedish history"@en ,
                 "royal houses"@en ,
                 "svenska kungar"@sv ,
                 "regentlängd"@sv ,
                 "Sveriges historia"@sv ,
                 "kungaätter"@sv ;
    dcat:first <https://solid-memo.com/decks/swedish-monarchs/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/swedish-monarchs/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/swedish-monarchs/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/swedish-monarchs/v1.ttl> .

