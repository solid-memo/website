<#nordic-trees>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Nordic trees"@en ,
                  "Nordiska träd"@sv ;
    dcterms:description "46 trees and shrubs that grow wild in Sweden and the Nordic countries or are widely planted there: conifers such as spruce, pine, juniper, yew and larches, and broadleaves such as birches, alders, aspen, oaks, beech, ash, elms, limes, maples, rowan, cherries and willows. Front: the English name and the Swedish name; back: the scientific name, as accepted by Dyntaxa, the Swedish taxonomic database (September 2026), with a note where another checklist uses a different name. Names from Dyntaxa and Wikidata, checked against Kew's World Checklist of Vascular Plants and Wikipedia."@en ,
                        "46 träd och buskar som växer vilt i Sverige och Norden eller ofta planteras där: barrträd som gran, tall, en (enbuske), idegran och lärkar, och lövträd som björkar, alar, asp, ekar, bok, ask, almar, lindar, lönnar, rönn, körsbär och pilar. Framsida: det engelska och det svenska namnet; baksida: det vetenskapliga namnet, så som det godtas i Dyntaxa, Sveriges taxonomiska databas (september 2026), med en anteckning där en annan checklista använder ett annat namn. Namnen kommer från Dyntaxa och Wikidata och är kontrollerade mot Kews World Checklist of Vascular Plants och Wikipedia."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:biology ;
    dcat:keyword "trees"@en ,
                 "shrubs"@en ,
                 "botany"@en ,
                 "scientific names"@en ,
                 "Nordic countries"@en ,
                 "träd"@sv ,
                 "buskar"@sv ,
                 "botanik"@sv ,
                 "vetenskapliga namn"@sv ,
                 "Norden"@sv ;
    dcat:first <https://solid-memo.com/decks/nordic-trees/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/nordic-trees/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/nordic-trees/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/nordic-trees/v1.ttl> .

