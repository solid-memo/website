<#shakespeare-plays>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Shakespeare: characters and their plays"@en ,
                  "Shakespeare: rollfigurer och deras pjäser"@sv ;
    dcterms:description "60 characters from 28 of Shakespeare's plays (tragedies, comedies, romances and two histories), each of whom appears in only one play. Front: the character's name in English and in Swedish (where Swedish has an established form of its own, such as Ofelia, Jago or Botten, that form; otherwise the original name); back: the play, by its English and Swedish title, with a short note on who the character is. Characters whose name is in the play's title are left out. Built from the play texts (Project Gutenberg) and Wikidata, with the Swedish names checked against C. A. Hagberg's translation, and cross-checked against the Folger Shakespeare."@en ,
                        "60 rollfigurer ur 28 av Shakespeares pjäser (tragedier, komedier, sagospel och två krönikespel), som var och en förekommer i bara en pjäs. Framsida: rollfigurens namn på engelska och svenska (den etablerade svenska formen där en sådan finns, som Ofelia, Jago eller Botten, annars originalnamnet); baksida: pjäsen med dess engelska och svenska titel och en kort anteckning om vem rollfiguren är. Rollfigurer vars namn står i pjäsens titel ingår inte. Uppgifterna kommer från pjästexterna (Project Gutenberg) och Wikidata. De svenska namnen har kontrollerats mot C. A. Hagbergs översättning och allt har jämförts med Folger Shakespeare."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:literature ;
    dcat:keyword "Shakespeare"@en ,
                 "plays"@en ,
                 "characters"@en ,
                 "English literature"@en ,
                 "drama"@en ,
                 "pjäser"@sv ,
                 "rollfigurer"@sv ,
                 "engelsk litteratur"@sv ,
                 "dramatik"@sv ,
                 "teater"@sv ,
                 "Shakespeare"@sv ;
    dcat:first <https://solid-memo.com/decks/shakespeare-plays/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/shakespeare-plays/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/shakespeare-plays/v1.ttl> ;
