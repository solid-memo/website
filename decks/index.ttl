<#space-exploration>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Milestones of Space Exploration"@en ,
                  "Milstolpar i utforskningen av rymden"@sv ;
    dcterms:description "48 milestones of space exploration, from Sputnik 1, the first artificial satellite (1957), to Artemis II, the first crewed flight of the Artemis programme (2026), as of 4 October 2026. Front: the milestone, almost always an undisputed first, with the mission that achieved it, e.g. \"First crewed landing on the Moon (Apollo 11)\"; back: the year of the event itself (for a flyby or landing, not the launch year, which a note gives when it differs). Taken from Wikidata and NASA and checked against the Swedish Wikipedia."@en ,
                        "48 milstolpar i utforskningen av rymden, från Sputnik 1, den första konstgjorda satelliten (1957), till Artemis II, Artemisprogrammets första bemannade färd (2026), per den 4 oktober 2026. Framsida: milstolpen – nästan alltid något som obestridligen gjordes för första gången – med uppdraget som genomförde den, t.ex. ”Första bemannade månlandningen (Apollo 11)”; baksida: året då själva händelsen inträffade (för en förbiflygning eller landning inte uppskjutningsåret, som en anteckning anger när det skiljer sig). Uppgifterna är hämtade från Wikidata och NASA och kontrollerade mot svenskspråkiga Wikipedia."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:astronomy ,
               topic:history ;
    dcat:keyword "space exploration"@en ,
                 "spaceflight"@en ,
                 "space race"@en ,
                 "astronautics"@en ,
                 "NASA"@en ,
                 "rymdfart"@sv ,
                 "utforskningen av rymden"@sv ,
                 "rymdkapplöpningen"@sv ,
                 "astronautik"@sv ,
                 "NASA"@sv ;
    dcat:first <https://solid-memo.com/decks/space-exploration/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/space-exploration/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/space-exploration/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/space-exploration/v1.ttl> .

