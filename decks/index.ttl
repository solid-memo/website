<#nobel-peace-prize>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Nobel Peace Prize"@en ,
                  "Nobels fredspris"@sv ;
    dcterms:description "Every Nobel Peace Prize from 1901 to 2025, one card per prize year: 106 cards with the year on the front and the laureate or laureates (people and organisations) on the back, with a short note where it helps, for example where the prize was awarded a year late, posthumously or declined, where a laureate received more than one Nobel Prize, or where an organisation has changed its name. Years with no award are left out; the deck ends with the 2025 prize, as the 2026 prize had not been announced when the deck was made on 4 October 2026. From the Nobel Prize API and Wikidata, checked against NobelPrize.org. Not affiliated with or endorsed by the Nobel Foundation or the Norwegian Nobel Committee."@en ,
                        "Varje Nobels fredspris från 1901 till 2025, ett kort per prisår: 106 kort med året på framsidan och pristagaren eller pristagarna (personer och organisationer) på baksidan, med en kort anteckning där den hjälper, till exempel där priset tilldelades ett år senare eller postumt eller avböjdes, där en pristagare fått mer än ett nobelpris eller där en organisation bytt namn. År då priset inte delades ut är utelämnade; kortleken slutar med 2025 års pris, eftersom 2026 års pris inte var tillkännagivet när kortleken gjordes den 4 oktober 2026. Från Nobelprisets API och Wikidata, kontrollerat mot NobelPrize.org. Inte knuten till eller godkänd av Nobelstiftelsen eller Norska Nobelkommittén."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:history ;
    dcat:keyword "Nobel Peace Prize"@en ,
                 "Nobel laureates"@en ,
                 "peace"@en ,
                 "history"@en ,
                 "Nobels fredspris"@sv ,
                 "nobelpristagare"@sv ,
                 "fred"@sv ,
                 "historia"@sv ;
    dcat:first <https://solid-memo.com/decks/nobel-peace-prize/v1.ttl> ;
