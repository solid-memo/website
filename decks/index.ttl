<#minerals>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Minerals"@en ,
                  "Mineral"@sv ;
    dcterms:description "The formulas of 40 common minerals and the hardness of the ten Mohs reference minerals, in 50 cards. Forty cards show a mineral's name in English and Swedish on the front and its ideal chemical formula on the back, written with subscripts (quartz SiO₂, calcite CaCO₃). Ten cards ask for the hardness, from 1 to 10, of the ten reference minerals of the Mohs scale. The formulas come from Wikidata, checked against the IMA list of minerals, and the hardness values from the US Geological Survey. The Swedish names were checked against Svenska Akademiens ordböcker, SGU and the Swedish Wikipedia."@en ,
                        "Formlerna för 40 vanliga mineral och hårdheten hos Mohs tio referensmineral, på 50 kort. Fyrtio kort har mineralets namn på engelska och svenska på framsidan och dess idealformel på baksidan, skriven med nedsänkta siffror (kvarts SiO₂, kalkspat CaCO₃). Tio kort frågar efter hårdheten, från 1 till 10, hos de tio referensmineralen i Mohs hårdhetsskala. Formlerna kommer från Wikidata, kontrollerade mot IMA:s mineralförteckning, och hårdheterna från USA:s geologiska undersökning (USGS). De svenska namnen är kontrollerade mot Svenska Akademiens ordböcker, SGU och svenskspråkiga Wikipedia."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:chemistry ,
               topic:science ;
    dcat:keyword "minerals"@en ,
                 "mineralogy"@en ,
                 "geology"@en ,
                 "chemical formulas"@en ,
                 "Mohs scale"@en ,
                 "mineral"@sv ,
                 "mineralogi"@sv ,
                 "geologi"@sv ,
                 "kemiska formler"@sv ,
                 "Mohs hårdhetsskala"@sv ;
    dcat:first <https://solid-memo.com/decks/minerals/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/minerals/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/minerals/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/minerals/v1.ttl> .

