<#academy-award-best-picture>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Academy Award for Best Picture"@en ,
                  "Oscar för bästa film"@sv ;
    dcterms:description "Every film that has won the Academy Award for Best Picture, from Wings at the 1st ceremony (1929) to One Battle After Another at the 98th (15 March 2026), the latest as of 4 October 2026: 98 cards, one per ceremony. Front: the ceremony's number and the year it was held, e.g. \"Best Picture at the 71st Academy Awards (1999)\"; back: the film, in Swedish under its Swedish title where it has one. Taken from Wikidata and checked against the Academy's ceremony pages and the English and Swedish Wikipedia. Not affiliated with or endorsed by the Academy of Motion Picture Arts and Sciences."@en ,
                        "Varje film som har vunnit Oscar för bästa film, från Vingarna vid den 1:a galan (1929) till One Battle After Another vid den 98:e (15 mars 2026), den senaste per den 4 oktober 2026: 98 kort, ett per gala. Framsida: galans nummer och året den hölls, t.ex. ”Bästa film vid den 71:a Oscarsgalan (1999)”; baksida: filmen, på svenska under sin svenska titel där den har en. Uppgifterna är hämtade från Wikidata och kontrollerade mot den amerikanska filmakademiens webbsidor om galorna och mot engelska och svenska Wikipedia. Inte knuten till eller godkänd av Academy of Motion Picture Arts and Sciences."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:film ;
    dcat:keyword "Academy Awards"@en ,
                 "Oscars"@en ,
                 "Best Picture"@en ,
                 "film history"@en ,
                 "cinema"@en ,
                 "Oscarsgalan"@sv ,
                 "Oscar"@sv ,
                 "bästa film"@sv ,
                 "filmhistoria"@sv ,
                 "film"@sv ;
    dcat:first <https://solid-memo.com/decks/academy-award-best-picture/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/academy-award-best-picture/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/academy-award-best-picture/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/academy-award-best-picture/v1.ttl> .

