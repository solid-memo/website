                 "integration by parts"@en ,
                 "mathematics"@en ,
                 "infinitesimalkalkyl"@sv ,
                 "integraler"@sv ,
                 "primitiva funktioner"@sv ,
                 "partialintegration"@sv ,
                 "matematik"@sv ;
    dcat:first <https://solid-memo.com/decks/integrals/v1.ttl> ;
