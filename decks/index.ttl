<#sql-basics>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "SQL basics"@en ,
                  "Grundläggande SQL"@sv ;
    dcterms:description "48 everyday SQL statements: the front describes a task in plain words in English and Swedish, the back is the one statement that does it, on three example tables (customers, products and orders) and in one style: upper-case keywords, AS for aliases, <> for not equal and a closing semicolon. Every statement runs unchanged in both SQLite and PostgreSQL, so rows are limited with LIMIT; FETCH FIRST, which SQLite rejects, is given in a note. Each was run in SQLite 3.53 and PostgreSQL 16 and checked against both projects' documentation."@en ,
                        "48 vardagliga SQL-satser: på framsidan en uppgift beskriven med vanliga ord på engelska och svenska, på baksidan den sats som utför den, mot tre exempeltabeller (customers, products och orders) och i en enda stil: nyckelord med versaler, AS för alias, <> för ”inte lika med” och avslutande semikolon. Varje sats fungerar oförändrad i både SQLite och PostgreSQL, så antalet rader begränsas med LIMIT; FETCH FIRST, som SQLite inte godtar, nämns i en anteckning. Alla har körts i SQLite 3.53 och PostgreSQL 16 och kontrollerats mot båda projektens dokumentation."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ;
    dcat:keyword "SQL"@en ,
                 "databases"@en ,
                 "queries"@en ,
                 "SQLite"@en ,
                 "PostgreSQL"@en ,
                 "SQL"@sv ,
                 "databaser"@sv ,
                 "databasfrågor"@sv ,
                 "SQLite"@sv ,
                 "PostgreSQL"@sv ;
    dcat:first <https://solid-memo.com/decks/sql-basics/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/sql-basics/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/sql-basics/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/sql-basics/v1.ttl> .

