<#famous-buildings>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Famous buildings"@en ,
                  "Kända byggnader"@sv ;
    dcterms:description "50 famous buildings and their architects: 39 of the world's best-known, ranked by their number of Wikipedia and other Wikimedia sitelinks in Wikidata, from Hagia Sophia and the White House to Fallingwater, and 11 Nordic buildings ranked the same way, from Drottningholm Palace to Stockholm City Hall (buildings of unknown, collective or disputed authorship left out). Front: the building, in English or Swedish, with its city where that helps; back: its architect or pair of architects, with a note on those who completed it. Taken from Wikidata and checked against the English and Swedish Wikipedia and official sites."@en ,
                        "50 kända byggnader och deras arkitekter: 39 av världens mest kända, rangordnade efter hur många länkar till Wikipedia och andra Wikimediaprojekt de har i Wikidata, från Hagia Sofia och Vita huset till Fallingwater, och 11 nordiska byggnader rangordnade på samma sätt, från Drottningholms slott till Stockholms stadshus (byggnader med okänd, kollektiv eller omstridd upphovsman ingår inte). Framsida: byggnaden, på engelska eller svenska, med staden där det hjälper; baksida: arkitekten eller arkitektparet, med en anteckning om dem som fullbordade bygget. Uppgifterna är hämtade från Wikidata och kontrollerade mot engelska och svenska Wikipedia och officiella webbplatser."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:art ,
               topic:history ;
    dcat:keyword "architecture"@en ,
                 "architects"@en ,
                 "buildings"@en ,
                 "art history"@en ,
                 "landmarks"@en ,
                 "arkitektur"@sv ,
                 "arkitekter"@sv ,
                 "byggnader"@sv ,
                 "konsthistoria"@sv ,
                 "sevärdheter"@sv ;
    dcat:first <https://solid-memo.com/decks/famous-buildings/v1.ttl> ;
