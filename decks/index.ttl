                 "Planck-Einheiten"@de ,
                 "constantes físicas"@es ,
                 "CODATA"@es ,
                 "constantes definitorias del SI"@es ,
                 "física"@es ,
                 "unidades de Planck"@es ,
                 "constantes physiques"@fr ,
                 "CODATA"@fr ,
                 "constantes définissant le SI"@fr ,
                 "physique"@fr ,
                 "unités de Planck"@fr ;
    dcat:first <https://solid-memo.com/decks/physical-constants/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/physical-constants/v2.ttl> ;
