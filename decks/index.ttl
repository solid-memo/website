    dcterms:creator "Wikizionario contributors" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    <http://www.w3.org/2000/01/rdf-schema#comment> "https://it.wiktionary.org/wiki/casa — page footer: \"Il testo è disponibile secondo la licenza Creative Commons Attribuzione-Condividi allo stesso modo; possono applicarsi condizioni ulteriori.\", linking to https://creativecommons.org/licenses/by-sa/4.0/deed.it."@en .

