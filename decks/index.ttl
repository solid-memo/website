<#vitamins>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Vitamins"@en ,
                  "Vitaminer"@sv ;
    dcterms:description "The 13 vitamins in 35 cards of three kinds: a vitamin and the chemical name of the vitamin or its main form (e.g. “Vitamin B1: chemical name” → “thiamine”), with separate cards for vitamins D2, D3, K1 and K2; a classic deficiency disease or sign and the vitamin involved (e.g. scurvy → vitamin C); and whether each vitamin is fat-soluble or water-soluble. Text in English and Swedish; no dosage or health advice. Taken from the US National Institutes of Health's Office of Dietary Supplements fact sheets and Wikidata, checked against Livsmedelsverket (the Swedish Food Agency) and the Swedish Wikipedia."@en ,
                        "De 13 vitaminerna i 35 kort av tre slag: ett vitamin och det kemiska namnet på vitaminet eller dess huvudform (t.ex. ”Vitamin B1: kemiskt namn” → ”tiamin”), med egna kort för vitamin D2, D3, K1 och K2; en klassisk bristsjukdom eller ett bristtecken och vilket vitamin det gäller (t.ex. skörbjugg → C-vitamin); samt om varje vitamin är fettlösligt eller vattenlösligt. Text på engelska och svenska; inga doser eller hälsoråd. Uppgifterna kommer från faktabladen från Office of Dietary Supplements vid USA:s National Institutes of Health och från Wikidata och är kontrollerade mot Livsmedelsverket och svenskspråkiga Wikipedia."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:biology ,
               topic:chemistry ;
    dcat:keyword "vitamins"@en ,
                 "deficiency diseases"@en ,
                 "fat-soluble vitamins"@en ,
                 "water-soluble vitamins"@en ,
                 "nutrition"@en ,
                 "vitaminer"@sv ,
                 "bristsjukdomar"@sv ,
                 "fettlösliga vitaminer"@sv ,
                 "vattenlösliga vitaminer"@sv ,
                 "näringslära"@sv ;
    dcat:first <https://solid-memo.com/decks/vitamins/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/vitamins/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/vitamins/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/vitamins/v1.ttl> .

