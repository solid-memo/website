<#greek-alphabet>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Greek alphabet"@en ,
                  "Grekiska alfabetet"@sv ;
    dcterms:description "The 24 letters of the Greek alphabet in 24 cards, studied in both directions. The front shows a letter in upper and lower case (Α α), the back its name in English and Swedish (alpha, alfa). Names and characters from Wikidata, checked against the Unicode Character Database, Svenska Akademiens ordlista, the SALDO lexicon and Nationalencyklopedin."@en ,
                        "Det grekiska alfabetets 24 bokstäver på 24 kort, som övas åt båda hållen. Framsidan visar en bokstav som versal och gemen (Α α), baksidan dess namn på engelska och svenska (alpha, alfa). Namnen och tecknen kommer från Wikidata och har kontrollerats mot Unicodes teckendatabas, Svenska Akademiens ordlista, lexikonet SALDO och Nationalencyklopedin."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
