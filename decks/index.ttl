<#swedish-literature>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Swedish Literature"@en ,
                  "Svensk litteratur"@sv ;
    dcterms:description "60 works of Swedish literature and their authors, from Bellman's Fredman's Epistles (Fredmans epistlar, 1790) to the crime novels and bestsellers of the 21st century: novels, plays, poetry and children's books written in Swedish by Swedish authors. The works were chosen by how widely Wikimedia sites cover them and how often they have been published in Sweden (records in LIBRIS), at most three per author. Front: the title in Swedish and in English (the Swedish title for the four works with no English edition found); back: the author. Compiled from Wikidata and LIBRIS, the National Library of Sweden's catalogue, and checked against Wikipedia and Open Library."@en ,
                        "60 verk ur den svenska litteraturen och deras författare, från Bellmans Fredmans epistlar (1790) till 2000-talets deckare och storsäljare: romaner, pjäser, poesi och barnböcker skrivna på svenska av svenska författare. Verken är utvalda efter hur många Wikimediawebbplatser som behandlar dem och hur ofta de har getts ut i Sverige (poster i LIBRIS), högst tre per författare. Framsida: titeln på svenska och på engelska (den svenska titeln för de fyra verk som inte har hittats i engelsk utgåva); baksida: författaren. Sammanställd från Wikidata och Kungliga bibliotekets katalog LIBRIS och kontrollerad mot Wikipedia och Open Library."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:literature ,
               topic:swedish ;
    dcat:keyword "Swedish literature"@en ,
                 "novels"@en ,
                 "authors"@en ,
                 "children's books"@en ,
                 "crime fiction"@en ,
                 "svensk litteratur"@sv ,
                 "romaner"@sv ,
                 "författare"@sv ,
                 "barnböcker"@sv ,
                 "deckare"@sv ;
    dcat:first <https://solid-memo.com/decks/swedish-literature/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/swedish-literature/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/swedish-literature/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/swedish-literature/v1.ttl> .

