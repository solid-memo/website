<#common-ions>
    a dcat:DatasetSeries ,
      dcat:Dataset ;
    solid-memo:formatVersion 3 ;
    dcterms:title "Common ions"@en ,
                  "Vanliga joner"@sv ;
    dcterms:description "43 common ions of school chemistry: 16 cations, from the hydrogen and oxonium ions to iron(III) and aluminium, and 27 anions, from chloride and oxide to sulfate, phosphate, permanganate and thiosulfate. Front: the ion's name in English and Swedish, e.g. \"Sulfate ion\" / \"sulfatjon\"; back: its formula with the charge as a superscript, e.g. SO₄²⁻. English names follow IUPAC (oxonium, hydrogencarbonate), Swedish names are formed by the Swedish Chemical Society's writing rules and checked for use. Formulas from Wikidata and PubChem; names checked against the IUPAC Red Book and Swedish sources. Studied in both directions."@en ,
                        "43 vanliga joner från skolkemin: 16 katjoner, från vätejonen och oxoniumjonen till järn(III)jonen och aluminiumjonen, och 27 anjoner, från kloridjonen och oxidjonen till sulfatjonen, fosfatjonen, permanganatjonen och tiosulfatjonen. Framsida: jonens namn på engelska och svenska, t.ex. ”Sulfate ion” / ”sulfatjon”; baksida: dess formel med laddningen upphöjd, t.ex. SO₄²⁻. De engelska namnen följer IUPAC (oxonium, hydrogencarbonate), de svenska är bildade efter Svenska Kemisamfundets skrivregler och kontrollerade i bruk. Formlerna kommer från Wikidata och PubChem; namnen är kontrollerade mot IUPAC:s Red Book och svenska källor. Övas i båda riktningarna."@sv ;
    dcterms:publisher <#solid-memo> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:chemistry ;
    dcat:keyword "chemistry"@en ,
                 "ions"@en ,
                 "chemical formulas"@en ,
                 "cations"@en ,
                 "anions"@en ,
                 "kemi"@sv ,
                 "joner"@sv ,
                 "kemiska formler"@sv ,
                 "katjoner"@sv ,
                 "anjoner"@sv ;
    dcat:first <https://solid-memo.com/decks/common-ions/v1.ttl> ;
    dcat:last <https://solid-memo.com/decks/common-ions/v1.ttl> ;
    dcat:hasVersion <https://solid-memo.com/decks/common-ions/v1.ttl> ;
    dcat:hasCurrentVersion <https://solid-memo.com/decks/common-ions/v1.ttl> .

