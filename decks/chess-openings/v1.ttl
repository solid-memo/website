<#four-knights-game>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Four Knights Game"@en ,
                     "Fyrspringarspel"@sv ;
