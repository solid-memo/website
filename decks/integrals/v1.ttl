<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Integrals"@en ,
                  "Integraler"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:description "42 cards on integrals for calculus students: the definition of an antiderivative, the rules of integration (linearity, integration by parts, substitution, the fundamental theorem of calculus) and standard antiderivatives of powers and roots, exponential, logarithmic, trigonometric and hyperbolic functions, and of the forms that give arctan, arcsin and ln. Front: the integral or rule in plain notation such as ∫ sin x dx; back: the result, with + C for an indefinite integral; conditions on x in a note; angles in radians. Every result is machine-checked with SymPy by differentiation and numerical integration, and against the NIST Digital Library of Mathematical Functions and/or Wikipedia."@en ,
                        "42 kort om integraler för den som läser matematisk analys: definitionen av primitiv funktion, integrationsreglerna (linjäritet, partialintegration, integration genom substitution, analysens fundamentalsats) och standardprimitiver till potenser och rötter, exponential- och logaritmfunktioner, trigonometriska och hyperboliska funktioner samt till de uttryck som ger arctan, arcsin och ln. Framsida: integralen eller regeln i enkel notation som ∫ sin x dx; baksida: resultatet, med + C för en obestämd integral; villkor på x i en kommentar; vinklar i radianer. Varje resultat är maskinkontrollerat med SymPy genom derivering och numerisk integrering, och mot NIST Digital Library of Mathematical Functions och/eller Wikipedia."@sv ;
    prov:wasDerivedFrom <#own-work> ,
                        <https://www.wikidata.org/> ,
                        <https://en.wikipedia.org/wiki/Lists_of_integrals> ,
                        <https://sv.wikipedia.org/wiki/Primitiv_funktion> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:mathematics ;
    dcat:keyword "calculus"@en ,
                 "integrals"@en ,
                 "antiderivatives"@en ,
                 "integration by parts"@en ,
                 "mathematics"@en ,
                 "infinitesimalkalkyl"@sv ,
                 "integraler"@sv ,
                 "primitiva funktioner"@sv ,
                 "partialintegration"@sv ,
                 "matematik"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-06T00:00:00Z"^^xsd:dateTime ;
    adms:versionNotes "First release." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#integrals> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#integrals> ;
