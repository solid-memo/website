<#antiderivative-definition>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "F is an antiderivative of f if …"@en ,
                     "F är en primitiv funktion till f om …"@sv ;
    solid-memo:back "F′(x) = f(x)"@zxx ;
    solid-memo:backNote "For every x in the interval considered."@en ,
                        "För alla x i det aktuella intervallet."@sv .

<#indefinite-integral>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ f(x) dx"@zxx ;
    solid-memo:frontNote "F is an antiderivative of f"@en ,
                         "F är en primitiv funktion till f"@sv ;
    solid-memo:back "F(x) + C"@zxx ;
    solid-memo:backNote "C is an arbitrary constant, the constant of integration."@en ,
                        "C är en godtycklig konstant, integrationskonstanten."@sv .

<#sum-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ (f(x) + g(x)) dx"@zxx ;
    solid-memo:back "∫ f(x) dx + ∫ g(x) dx"@zxx ;
    solid-memo:backNote "Linearity of integration: integrate term by term; the same holds for a difference."@en ,
                        "Integrationen är linjär: integrera term för term; detsamma gäller en differens."@sv .

<#constant-multiple>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ k·f(x) dx"@zxx ;
    solid-memo:frontNote "k is a constant, k ≠ 0"@en ,
                         "k är en konstant, k ≠ 0"@sv ;
    solid-memo:back "k·∫ f(x) dx"@zxx ;
    solid-memo:backNote "A constant factor can be moved outside the integral. For k = 0 the left side is an arbitrary constant, hence k ≠ 0."@en ,
                        "En konstant faktor kan flyttas ut ur integralen. För k = 0 är vänsterledet en godtycklig konstant, därav k ≠ 0."@sv .

<#integration-by-parts>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Integration by parts: ∫ f(x)·g′(x) dx"@en ,
                     "Partialintegration: ∫ f(x)·g′(x) dx"@sv ;
    solid-memo:back "f(x)·g(x) − ∫ f′(x)·g(x) dx"@zxx ;
    solid-memo:backNote "The integral form of the product rule."@en ,
                        "Integralformen av produktregeln; kallas även partiell integration."@sv .

<#substitution>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Integration by substitution: ∫ f(g(x))·g′(x) dx"@en ,
                     "Integration genom substitution: ∫ f(g(x))·g′(x) dx"@sv ;
    solid-memo:frontNote "F is an antiderivative of f"@en ,
                         "F är en primitiv funktion till f"@sv ;
    solid-memo:back "F(g(x)) + C"@zxx ;
    solid-memo:backNote "Substitute u = g(x), du = g′(x) dx: ∫ f(u) du = F(u) + C. The integral form of the chain rule."@en ,
                        "Variabelbyte u = g(x), du = g′(x) dx: ∫ f(u) du = F(u) + C. Integralformen av kedjeregeln."@sv .

<#ftc-evaluation>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Fundamental theorem of calculus: ∫ₐᵇ f(x) dx"@en ,
                     "Analysens fundamentalsats: ∫ₐᵇ f(x) dx"@sv ;
    solid-memo:frontNote "F is an antiderivative of f, and f is continuous on [a, b]"@en ,
                         "F är en primitiv funktion till f, och f är kontinuerlig på [a, b]"@sv ;
    solid-memo:back "F(b) − F(a)"@zxx ;
    solid-memo:backNote "Also written [F(x)]ₐᵇ."@en ,
                        "Skrivs även [F(x)]ₐᵇ."@sv .

<#ftc-derivative>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx ∫ₐˣ f(t) dt"@zxx ;
    solid-memo:frontNote "f is continuous"@en ,
                         "f är kontinuerlig"@sv ;
    solid-memo:back "f(x)"@zxx ;
    solid-memo:backNote "Fundamental theorem of calculus: integrating and then differentiating gives f back."@en ,
                        "Analysens fundamentalsats: att integrera och sedan derivera ger tillbaka f."@sv .

<#zero-width-interval>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ₐᵃ f(x) dx"@zxx ;
    solid-memo:back "0"@zxx ;
    solid-memo:backNote "An integral over an interval of length zero."@en ,
                        "En integral över ett intervall med längden noll."@sv .

<#log-derivative>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ f′(x)/f(x) dx"@zxx ;
    solid-memo:back "ln|f(x)| + C"@zxx ;
    solid-memo:backNote "Where f(x) ≠ 0. Example: ∫ tan x dx = −ln|cos x| + C."@en ,
                        "Där f(x) ≠ 0. Exempel: ∫ tan x dx = −ln|cos x| + C."@sv .

<#constant>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ k dx"@zxx ;
    solid-memo:frontNote "k is a constant"@en ,
                         "k är en konstant"@sv ;
    solid-memo:back "kx + C"@zxx .

<#power-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ xⁿ dx"@zxx ;
    solid-memo:frontNote "n is a constant, n ≠ −1"@en ,
                         "n är en konstant, n ≠ −1"@sv ;
    solid-memo:back "xⁿ⁺¹/(n + 1) + C"@zxx ;
    solid-memo:backNote "For x > 0 when n is not an integer, and for x ≠ 0 when n is a negative integer. For n = −1: ln|x| + C."@en ,
                        "För x > 0 när n inte är ett heltal, och för x ≠ 0 när n är ett negativt heltal. För n = −1: ln|x| + C."@sv .

<#one-over-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ 1/x dx"@zxx ;
    solid-memo:back "ln|x| + C"@zxx ;
    solid-memo:backNote "For x ≠ 0. For x > 0 this is ln x + C; the constant may differ on the two sides of 0."@en ,
                        "För x ≠ 0. För x > 0 blir det ln x + C; konstanten kan vara olika på var sida om 0."@sv .

<#one-over-x-squared>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ 1/x² dx"@zxx ;
    solid-memo:back "−1/x + C"@zxx ;
    solid-memo:backNote "For x ≠ 0. The power rule with n = −2."@en ,
                        "För x ≠ 0. Potensregeln med n = −2."@sv .

<#square-root>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ √x dx"@zxx ;
    solid-memo:back "(2/3)·x√x + C"@zxx ;
    solid-memo:backNote "For x ≥ 0. Also written (2/3)·x^(3/2) + C: the power rule with n = 1/2."@en ,
                        "För x ≥ 0. Skrivs även (2/3)·x^(3/2) + C: potensregeln med n = 1/2."@sv .

<#one-over-square-root>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ 1/√x dx"@zxx ;
    solid-memo:back "2√x + C"@zxx ;
    solid-memo:backNote "For x > 0. The power rule with n = −1/2."@en ,
                        "För x > 0. Potensregeln med n = −1/2."@sv .

<#linear-reciprocal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ 1/(ax + b) dx"@zxx ;
    solid-memo:frontNote "a and b are constants, a ≠ 0"@en ,
                         "a och b är konstanter, a ≠ 0"@sv ;
    solid-memo:back "(1/a)·ln|ax + b| + C"@zxx ;
    solid-memo:backNote "For ax + b ≠ 0."@en ,
                        "För ax + b ≠ 0."@sv .

<#linear-power>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ (ax + b)ⁿ dx"@zxx ;
    solid-memo:frontNote "a, b and n are constants, a ≠ 0, n ≠ −1"@en ,
                         "a, b och n är konstanter, a ≠ 0, n ≠ −1"@sv ;
    solid-memo:back "(ax + b)ⁿ⁺¹/(a(n + 1)) + C"@zxx ;
    solid-memo:backNote "The power rule with the substitution u = ax + b. For ax + b > 0 when n is not an integer, and for ax + b ≠ 0 when n is a negative integer."@en ,
                        "Potensregeln med variabelbytet u = ax + b. För ax + b > 0 när n inte är ett heltal, och för ax + b ≠ 0 när n är ett negativt heltal."@sv .

<#e-to-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ eˣ dx"@zxx ;
    solid-memo:back "eˣ + C"@zxx .

<#e-to-kx>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ eᵏˣ dx"@zxx ;
    solid-memo:frontNote "k is a constant, k ≠ 0"@en ,
                         "k är en konstant, k ≠ 0"@sv ;
    solid-memo:back "eᵏˣ/k + C"@zxx .

<#a-to-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ aˣ dx"@zxx ;
    solid-memo:frontNote "a is a constant, a > 0, a ≠ 1"@en ,
                         "a är en konstant, a > 0, a ≠ 1"@sv ;
    solid-memo:back "aˣ/ln a + C"@zxx .

<#ln-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ ln x dx"@zxx ;
    solid-memo:back "x·ln x − x + C"@zxx ;
    solid-memo:backNote "For x > 0. Found by integration by parts with ln x = 1·ln x."@en ,
                        "För x > 0. Fås med partialintegration av 1·ln x."@sv .

<#sin>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ sin x dx"@zxx ;
    solid-memo:back "−cos x + C"@zxx .

<#cos>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ cos x dx"@zxx ;
    solid-memo:back "sin x + C"@zxx .

<#sin-kx>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ sin(kx) dx"@zxx ;
    solid-memo:frontNote "k is a constant, k ≠ 0"@en ,
                         "k är en konstant, k ≠ 0"@sv ;
    solid-memo:back "−cos(kx)/k + C"@zxx .

<#cos-kx>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ cos(kx) dx"@zxx ;
    solid-memo:frontNote "k is a constant, k ≠ 0"@en ,
                         "k är en konstant, k ≠ 0"@sv ;
    solid-memo:back "sin(kx)/k + C"@zxx .

<#sec-squared>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ sec² x dx"@zxx ;
    solid-memo:back "tan x + C"@zxx ;
    solid-memo:backNote "sec x = 1/cos x, so this is ∫ 1/cos² x dx. For cos x ≠ 0."@en ,
                        "sec x = 1/cos x, så detta är ∫ 1/cos² x dx. För cos x ≠ 0."@sv .

<#csc-squared>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ csc² x dx"@zxx ;
    solid-memo:back "−cot x + C"@zxx ;
    solid-memo:backNote "csc x = 1/sin x, so this is ∫ 1/sin² x dx. For sin x ≠ 0."@en ,
                        "csc x = 1/sin x, så detta är ∫ 1/sin² x dx. För sin x ≠ 0."@sv .

<#sec-tan>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ sec x·tan x dx"@zxx ;
    solid-memo:back "sec x + C"@zxx ;
    solid-memo:backNote "For cos x ≠ 0."@en ,
                        "För cos x ≠ 0."@sv .

<#csc-cot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ csc x·cot x dx"@zxx ;
    solid-memo:back "−csc x + C"@zxx ;
    solid-memo:backNote "For sin x ≠ 0."@en ,
                        "För sin x ≠ 0."@sv .

<#tan>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ tan x dx"@zxx ;
    solid-memo:back "−ln|cos x| + C"@zxx ;
    solid-memo:backNote "For cos x ≠ 0. Also written ln|sec x| + C."@en ,
                        "För cos x ≠ 0. Skrivs även ln|sec x| + C."@sv .

<#cot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ cot x dx"@zxx ;
    solid-memo:back "ln|sin x| + C"@zxx ;
    solid-memo:backNote "For sin x ≠ 0."@en ,
                        "För sin x ≠ 0."@sv .

<#sec>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ sec x dx"@zxx ;
    solid-memo:back "ln|sec x + tan x| + C"@zxx ;
    solid-memo:backNote "For cos x ≠ 0. Also written ln|tan(x/2 + π/4)| + C."@en ,
                        "För cos x ≠ 0. Skrivs även ln|tan(x/2 + π/4)| + C."@sv .

<#sin-squared>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ sin² x dx"@zxx ;
    solid-memo:back "x/2 − sin(2x)/4 + C"@zxx ;
    solid-memo:backNote "From sin² x = (1 − cos(2x))/2. Also written (x − sin x·cos x)/2 + C."@en ,
                        "Följer av sin² x = (1 − cos(2x))/2. Skrivs även (x − sin x·cos x)/2 + C."@sv .

<#cos-squared>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ cos² x dx"@zxx ;
    solid-memo:back "x/2 + sin(2x)/4 + C"@zxx ;
    solid-memo:backNote "From cos² x = (1 + cos(2x))/2. Also written (x + sin x·cos x)/2 + C."@en ,
                        "Följer av cos² x = (1 + cos(2x))/2. Skrivs även (x + sin x·cos x)/2 + C."@sv .

<#arctan>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ 1/(1 + x²) dx"@zxx ;
    solid-memo:back "arctan x + C"@zxx ;
    solid-memo:backNote "For every real x."@en ,
                        "För alla reella x."@sv .

<#arctan-a>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ 1/(a² + x²) dx"@zxx ;
    solid-memo:frontNote "a is a constant, a > 0"@en ,
                         "a är en konstant, a > 0"@sv ;
    solid-memo:back "(1/a)·arctan(x/a) + C"@zxx .

<#arcsin>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ 1/√(1 − x²) dx"@zxx ;
    solid-memo:back "arcsin x + C"@zxx ;
    solid-memo:backNote "For −1 < x < 1. −arccos x + C is also correct, since arcsin x + arccos x = π/2."@en ,
                        "För −1 < x < 1. Även −arccos x + C är rätt, eftersom arcsin x + arccos x = π/2."@sv .

<#arcsin-a>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ 1/√(a² − x²) dx"@zxx ;
    solid-memo:frontNote "a is a constant, a > 0"@en ,
                         "a är en konstant, a > 0"@sv ;
    solid-memo:back "arcsin(x/a) + C"@zxx ;
    solid-memo:backNote "For −a < x < a."@en ,
                        "För −a < x < a."@sv .

<#one-over-sqrt-x-squared-plus-one>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ 1/√(x² + 1) dx"@zxx ;
    solid-memo:back "ln(x + √(x² + 1)) + C"@zxx ;
    solid-memo:backNote "For every real x. Equal to arsinh x + C."@en ,
                        "För alla reella x. Lika med arsinh x + C."@sv .

<#sinh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ sinh x dx"@zxx ;
    solid-memo:back "cosh x + C"@zxx .

<#cosh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫ cosh x dx"@zxx ;
    solid-memo:back "sinh x + C"@zxx .

<#turtle>
    a dcat:Distribution ;
    dcat:accessURL <> ;
    dcat:downloadURL <> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
