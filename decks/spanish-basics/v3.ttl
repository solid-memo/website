<#uno>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "uno"@es ;
    solid-memo:back "1"@zxx ;
    solid-memo:backNote "Before a masculine noun it is shortened to un: un libro. Feminine: una."@en ,
                        "Före ett maskulint substantiv förkortas det till un: un libro. Femininum: una."@sv ,
                        "남성 명사 앞에서는 un으로 줄어요: un libro. 여성형: una."@ko ,
                        "Vor einem maskulinen Substantiv wird es zu un verkürzt: un libro. Femininum: una."@de ,
                        "Devant un nom masculin, il s’abrège en un : un libro. Féminin : una."@fr .

