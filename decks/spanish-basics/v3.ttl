<#buenos-dias>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "buenos días"@es ;
    solid-memo:back "good morning"@en ,
                    "god morgon"@sv ,
                    "좋은 아침입니다"@ko ,
                    "guten Morgen"@de ,
                    "bonjour"@fr ;
    solid-memo:backNote "Said all morning, until midday or lunchtime (la mañana)."@en ,
                        "Sägs hela förmiddagen, fram till mitt på dagen eller lunch (la mañana)."@sv ,
                        "아침 내내, 정오나 점심때까지 써요(la mañana)."@ko ,
                        "Sagt man den ganzen Vormittag, bis Mittag oder bis zum Mittagessen (la mañana)."@de ,
                        "Se dit toute la matinée, jusqu’à midi ou l’heure du déjeuner (la mañana)."@fr .

<#buenas-tardes>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "buenas tardes"@es ;
    solid-memo:back "good afternoon"@en ,
                    "god eftermiddag"@sv ,
                    "좋은 오후입니다"@ko ,
                    "guten Tag"@de ,
                    "bon après-midi"@fr ;
    solid-memo:backNote "Said from midday until nightfall (la tarde), so also in the early evening."@en ,
                        "Sägs från mitt på dagen tills det blir mörkt (la tarde), alltså även tidig kväll."@sv ,
                        "정오부터 해가 질 때까지 써요(la tarde). 그래서 이른 저녁에도 써요."@ko ,
                        "Sagt man von Mittag bis zum Einbruch der Dunkelheit (la tarde), also auch am frühen Abend."@de ,
                        "Se dit de midi jusqu’à la tombée de la nuit (la tarde), donc aussi en début de soirée."@fr .

