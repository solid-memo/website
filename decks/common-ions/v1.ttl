<#hydrogen-ion>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hydrogen ion"@en ,
                     "vätejon"@sv ;
    solid-memo:frontNote "the positive ion"@en ,
                         "den positiva jonen"@sv ;
    solid-memo:back "H⁺"@zxx ;
    solid-memo:backNote "In water it is bound to water molecules, e.g. as the oxonium ion H₃O⁺. The negative ion H⁻ is the hydride ion."@en ,
                        "I vatten är den bunden till vattenmolekyler, t.ex. som oxoniumjon, H₃O⁺. Den negativa jonen H⁻ kallas hydridjon."@sv .

