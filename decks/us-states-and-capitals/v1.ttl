<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "US states and capitals"@en ,
                  "USA:s delstater och huvudstäder"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The 50 states of the United States and their capitals, as of October 2026: 50 cards, studied in both directions. Front: the state, e.g. \"California\" (Swedish \"Kalifornien\"); back: its capital city, whose name is written the same in English and Swedish, with a short note for four states (New York, Illinois, Washington and Minnesota). Taken from Wikidata (the largest cities in two notes from the US Census Bureau's State Facts for Students) and checked against the Census Bureau and Nationalencyklopedin."@en ,
                        "USA:s 50 delstater och deras huvudstäder, enligt läget i oktober 2026: 50 kort som övas åt båda hållen. Framsida: delstaten, t.ex. ”Kalifornien”; baksida: dess huvudstad, vars namn skrivs likadant på engelska och svenska, med en kort anteckning för fyra delstater (New York, Illinois, Washington och Minnesota). Uppgifterna är hämtade från Wikidata, utom de största städerna i två av anteckningarna, som kommer från State Facts for Students från den amerikanska statistikmyndigheten US Census Bureau, och de är kontrollerade mot Census Bureau och Nationalencyklopedin."@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q35657> ,
                        <https://www.census.gov/schools/statefacts/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ;
    dcat:keyword "United States"@en ,
                 "US states"@en ,
                 "state capitals"@en ,
                 "geography"@en ,
                 "North America"@en ,
                 "USA"@en ,
                 "USA"@sv ,
                 "delstater"@sv ,
                 "huvudstäder"@sv ,
                 "geografi"@sv ,
                 "Nordamerika"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-06T00:00:00Z"^^xsd:dateTime ;
    adms:versionNotes "First release." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#us-states-and-capitals> ;
