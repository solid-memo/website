<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-25T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.wikidata.org/> ,
              <https://mesh.kib.ki.se/> ,
              <https://id.nlm.nih.gov/mesh/> ,
              <https://www.ninds.nih.gov/health-information/public-education/brain-basics/brain-basics-know-your-brain> ,
