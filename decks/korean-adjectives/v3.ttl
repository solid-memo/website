    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To be slender, oval (face)"@en ,
                     "Att vara smal, oval (ansikte)"@sv ;
    solid-memo:back "갸름하다"@ko ;
    solid-memo:backNote "그 배우는 얼굴이 갸름해요. — That actor has a slender face."@en ,
                        "그 배우는 얼굴이 갸름해요. — Den skådespelaren har ett smalt ansikte."@sv ,
                        "그 배우는 얼굴이 갸름해요. — Dieser Schauspieler hat ein schmales Gesicht."@de ,
                        "그 배우는 얼굴이 갸름해요. — Ese actor tiene la cara ovalada."@es ,
                        "그 배우는 얼굴이 갸름해요. — Cet acteur a le visage ovale."@fr .

