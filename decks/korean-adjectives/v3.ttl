    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To be bold, daring, fearless"@en ,
                     "Att vara djärv, oförskräckt"@sv ;
    solid-memo:back "대담하다"@ko ;
    solid-memo:backNote "그 아이는 나이에 비해 대담해요. — That child is bold for his age."@en ,
                        "그 아이는 나이에 비해 대담해요. — Det barnet är djärvt för sin ålder."@sv ,
                        "그 아이는 나이에 비해 대담해요. — Das Kind ist für sein Alter kühn."@de ,
