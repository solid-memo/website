    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To be late at night"@en ,
                     "Att vara sent på kvällen"@sv ;
    solid-memo:back "밤늦다"@ko ;
    solid-memo:backNote "밤늦게 전화해서 미안해요. — Sorry for calling so late at night."@en ,
                        "밤늦게 전화해서 미안해요. — Förlåt att jag ringer så sent på kvällen."@sv ,
