    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To be disappointing"@en ,
                     "Att vara nedslående"@sv ;
    solid-memo:back "실망스럽다"@ko ;
    solid-memo:backNote "시험 결과가 좀 실망스러워요. — The exam result is a bit disappointing."@en ,
                        "시험 결과가 좀 실망스러워요. — Provresultatet är lite nedslående."@sv ,
                        "시험 결과가 좀 실망스러워요. — Das Prüfungsergebnis ist etwas enttäuschend."@de ,
                        "시험 결과가 좀 실망스러워요. — El resultado del examen es un poco decepcionante."@es ,
                        "시험 결과가 좀 실망스러워요. — Le résultat de l'examen est un peu décevant."@fr .

