    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To be harsh, hard, unkind (life, the world)"@en ,
                     "Att vara hård, kärlekslös (om livet, världen)"@sv ;
    solid-memo:back "각박하다"@ko ;
    solid-memo:backNote "요즘 세상이 너무 각박해요. — The world is so harsh these days."@en ,
                        "요즘 세상이 너무 각박해요. — Världen är så hård nuförtiden."@sv ,
                        "요즘 세상이 너무 각박해요. — Die Welt ist heutzutage so hart."@de ,
                        "요즘 세상이 너무 각박해요. — Hoy en día el mundo es muy duro."@es ,
                        "요즘 세상이 너무 각박해요. — Le monde est si dur de nos jours."@fr .

<#bujayeonseureopda>
    a solid-memo:Card ;
