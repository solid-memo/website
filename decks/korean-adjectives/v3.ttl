    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To be ignorant, uneducated"@en ,
                     "Att vara okunnig, obildad, ignorant"@sv ;
    solid-memo:back "무식하다"@ko ;
