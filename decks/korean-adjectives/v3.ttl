    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To be dreadfully tiresome, sick of"@en ,
                     "Att vara outhärdlig, utled på"@sv ;
    solid-memo:back "지긋지긋하다"@ko ;
    solid-memo:backNote "이제 장마가 지긋지긋해요. — I'm sick of the rainy season by now."@en ,
                        "이제 장마가 지긋지긋해요. — Nu är jag utled på regnperioden."@sv ,
                        "이제 장마가 지긋지긋해요. — Ich habe die Regenzeit jetzt gründlich satt."@de ,
                        "이제 장마가 지긋지긋해요. — Ya estoy harto de la temporada de lluvias."@es ,
                        "이제 장마가 지긋지긋해요. — Maintenant, j'en ai vraiment assez de la saison des pluies."@fr .

