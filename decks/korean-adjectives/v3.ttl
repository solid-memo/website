<#gwaenhada>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-10T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "To be needless, pointless, for nothing"@en ,
                     "Att vara onödig, poänglös"@sv ;
    solid-memo:back "괜하다"@ko ;
    solid-memo:backNote "괜한 걱정을 했어요. — I worried for nothing."@en ,
                        "괜한 걱정을 했어요. — Jag oroade mig i onödan."@sv ,
                        "괜한 걱정을 했어요. — Ich habe mir umsonst Sorgen gemacht."@de ,
                        "괜한 걱정을 했어요. — Me preocupé sin motivo."@es ,
                        "괜한 걱정을 했어요. — Je me suis inquiété pour rien."@fr .

<#sisihada>
