<#for-all>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∀"@zxx ;
    solid-memo:back "for all"@en ,
                    "för alla"@sv ;
    solid-memo:backNote "The universal quantifier: ∀x P(x) says that P(x) holds for every x."@en ,
                        "Allkvantifikatorn: ∀x P(x) betyder att P(x) gäller för varje x."@sv .

<#there-exists>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∃"@zxx ;
    solid-memo:back "there exists"@en ,
                    "det finns"@sv ;
    solid-memo:backNote "The existential quantifier: ∃x P(x) says that P(x) holds for at least one x."@en ,
                        "Existenskvantifikatorn: ∃x P(x) betyder att P(x) gäller för minst ett x."@sv .

<#not>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "¬"@zxx ;
    solid-memo:back "not (negation)"@en ,
                    "icke (negation)"@sv ;
    solid-memo:backNote "¬p is true exactly when p is false."@en ,
                        "¬p är sann precis när p är falsk."@sv .

<#and>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∧"@zxx ;
    solid-memo:back "and (conjunction)"@en ,
                    "och (konjunktion)"@sv ;
    solid-memo:backNote "p ∧ q is true when both p and q are true."@en ,
                        "p ∧ q är sann när både p och q är sanna."@sv .

<#or>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∨"@zxx ;
    solid-memo:back "or (disjunction)"@en ,
                    "eller (disjunktion)"@sv ;
    solid-memo:backNote "Inclusive or: p ∨ q is true when at least one of p and q is true."@en ,
                        "Inklusivt eller: p ∨ q är sann när minst en av p och q är sann."@sv .

<#implies>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "⇒"@zxx ;
    solid-memo:back "implies (implication)"@en ,
                    "implicerar (implikation)"@sv ;
    solid-memo:backNote "p ⇒ q: if p, then q."@en ,
                        "p ⇒ q: om p, så q."@sv .

<#if-and-only-if>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "⇔"@zxx ;
    solid-memo:back "if and only if (equivalence)"@en ,
                    "om och endast om (ekvivalens)"@sv ;
    solid-memo:backNote "p ⇔ q: p and q are both true or both false."@en ,
                        "p ⇔ q: p och q är antingen båda sanna eller båda falska."@sv .

<#element-of>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∈"@zxx ;
    solid-memo:back "is an element of"@en ,
                    "är ett element i"@sv ;
    solid-memo:backNote "x ∈ A: x belongs to the set A."@en ,
                        "x ∈ A: x tillhör mängden A."@sv .

<#not-element-of>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∉"@zxx ;
    solid-memo:back "is not an element of"@en ,
                    "är inte ett element i"@sv .

<#empty-set>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∅"@zxx ;
    solid-memo:back "the empty set"@en ,
                    "den tomma mängden"@sv ;
    solid-memo:backNote "The set with no elements, also written {}."@en ,
                        "Mängden utan element, skrivs även {}."@sv .

<#subset-or-equal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "⊆"@zxx ;
    solid-memo:back "is a subset of"@en ,
                    "är en delmängd av"@sv ;
    solid-memo:backNote "A ⊆ B: every element of A is also in B; A may equal B."@en ,
                        "A ⊆ B: varje element i A finns också i B; A kan vara lika med B."@sv .

<#proper-subset>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "⊂"@zxx ;
    solid-memo:back "is a proper subset of"@en ,
                    "är en äkta delmängd av"@sv ;
    solid-memo:backNote "A ⊂ B: A ⊆ B and A ≠ B. Some authors use ⊂ for any subset (A = B allowed); ⊊ always means a proper subset."@en ,
                        "A ⊂ B: A ⊆ B och A ≠ B. Vissa författare använder ⊂ för delmängd i allmänhet (även när A = B); ⊊ betyder alltid äkta delmängd."@sv .

<#union>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∪"@zxx ;
    solid-memo:back "union"@en ,
                    "union"@sv ;
    solid-memo:backNote "A ∪ B: the elements that are in A or in B (or both)."@en ,
                        "A ∪ B: elementen som finns i A eller i B (eller i båda)."@sv .

<#intersection>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∩"@zxx ;
    solid-memo:back "intersection"@en ,
                    "snitt"@sv ;
    solid-memo:backNote "A ∩ B: the elements that are in both A and B."@en ,
                        "A ∩ B: elementen som finns i både A och B."@sv .

<#set-difference>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A ∖ B"@zxx ;
    solid-memo:back "set difference (A minus B)"@en ,
                    "mängddifferens (A minus B)"@sv ;
    solid-memo:backNote "The elements of A that are not in B."@en ,
                        "Elementen i A som inte finns i B."@sv .

<#natural-numbers>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "ℕ"@zxx ;
    solid-memo:back "the natural numbers"@en ,
                    "de naturliga talen"@sv ;
    solid-memo:backNote "Here including 0: {0, 1, 2, …}, as in ISO 80000-2 and Swedish schools; some authors start at 1."@en ,
                        "Här med 0: {0, 1, 2, …}, som i ISO 80000-2 och i svensk skola; vissa författare börjar på 1."@sv .

<#integers>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "ℤ"@zxx ;
    solid-memo:back "the integers"@en ,
                    "heltalen"@sv ;
    solid-memo:backNote "{…, −2, −1, 0, 1, 2, …}"@en ,
                        "{…, −2, −1, 0, 1, 2, …}"@sv .

<#rational-numbers>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "ℚ"@zxx ;
    solid-memo:back "the rational numbers"@en ,
                    "de rationella talen"@sv ;
    solid-memo:backNote "Numbers p/q with integers p and q, q ≠ 0."@en ,
                        "Tal p/q där p och q är heltal och q ≠ 0."@sv .

<#real-numbers>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "ℝ"@zxx ;
    solid-memo:back "the real numbers"@en ,
                    "de reella talen"@sv .

<#complex-numbers>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "ℂ"@zxx ;
    solid-memo:back "the complex numbers"@en ,
                    "de komplexa talen"@sv .

<#not-equal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "≠"@zxx ;
    solid-memo:back "is not equal to"@en ,
                    "är inte lika med"@sv .

<#approximately-equal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "≈"@zxx ;
    solid-memo:back "is approximately equal to"@en ,
                    "är ungefär lika med"@sv ;
    solid-memo:backNote "For example, π ≈ 3.14."@en ,
                        "Till exempel π ≈ 3,14."@sv .

<#proportional-to>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∝"@zxx ;
    solid-memo:back "is proportional to"@en ,
                    "är proportionell mot"@sv ;
    solid-memo:backNote "y ∝ x: y = kx for a constant k ≠ 0. Swedish texts more commonly write y ∼ x."@en ,
                        "y ∝ x: y = kx för en konstant k ≠ 0. I svenska texter skrivs oftare y ∼ x."@sv .

<#less-or-equal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "≤"@zxx ;
    solid-memo:back "is less than or equal to"@en ,
                    "är mindre än eller lika med"@sv .

<#greater-or-equal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "≥"@zxx ;
    solid-memo:back "is greater than or equal to"@en ,
                    "är större än eller lika med"@sv .

<#congruent-modulo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "a ≡ b (mod n)"@zxx ;
    solid-memo:back "a is congruent to b modulo n"@en ,
                    "a är kongruent med b modulo n"@sv ;
    solid-memo:backNote "n divides a − b: a and b leave the same remainder on division by n."@en ,
                        "n delar a − b: a och b ger samma rest vid division med n."@sv .

<#divides>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "a ∣ b"@zxx ;
    solid-memo:back "a divides b"@en ,
                    "a delar b"@sv ;
    solid-memo:backNote "b is an integer multiple of a: b = ka for an integer k."@en ,
                        "b är en heltalsmultipel av a: b = ka för ett heltal k."@sv .

<#parallel-to>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∥"@zxx ;
    solid-memo:back "is parallel to"@en ,
                    "är parallell med"@sv ;
    solid-memo:backNote "For lines, as in AB ∥ CD."@en ,
                        "För linjer, som i AB ∥ CD."@sv .

<#angle>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∠"@zxx ;
    solid-memo:back "angle"@en ,
                    "vinkel"@sv ;
    solid-memo:backNote "∠ABC: the angle at B between BA and BC."@en ,
                        "∠ABC: vinkeln vid B mellan BA och BC."@sv .

<#summation>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∑"@zxx ;
    solid-memo:back "sum"@en ,
                    "summa"@sv ;
    solid-memo:backNote "∑ₖ₌₁ⁿ aₖ = a₁ + a₂ + … + aₙ"@en ,
                        "∑ₖ₌₁ⁿ aₖ = a₁ + a₂ + … + aₙ"@sv .

<#product>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∏"@zxx ;
    solid-memo:back "product"@en ,
                    "produkt"@sv ;
    solid-memo:backNote "∏ₖ₌₁ⁿ aₖ = a₁ · a₂ · … · aₙ"@en ,
                        "∏ₖ₌₁ⁿ aₖ = a₁ · a₂ · … · aₙ"@sv .

<#square-root>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "√"@zxx ;
    solid-memo:back "square root"@en ,
                    "kvadratrot"@sv ;
    solid-memo:backNote "For a ≥ 0, √a is the non-negative number whose square is a."@en ,
                        "För a ≥ 0 är √a det icke-negativa tal vars kvadrat är a."@sv .

<#plus-minus>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "±"@zxx ;
    solid-memo:back "plus or minus"@en ,
                    "plus eller minus"@sv ;
    solid-memo:backNote "For example, x = ±2 means x = 2 or x = −2."@en ,
                        "Till exempel betyder x = ±2 att x = 2 eller x = −2."@sv .

<#absolute-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "|x|"@zxx ;
    solid-memo:back "absolute value of x"@en ,
                    "absolutbeloppet av x"@sv ;
    solid-memo:backNote "The distance from x to 0; for example, |−3| = 3."@en ,
                        "Avståndet från x till 0; till exempel |−3| = 3."@sv .

<#floor>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "⌊x⌋"@zxx ;
    solid-memo:back "floor of x"@en ,
                    "golvfunktionen av x"@sv ;
    solid-memo:backNote "x rounded down to the nearest integer; for example, ⌊3.7⌋ = 3 and ⌊−1.2⌋ = −2."@en ,
                        "x avrundat nedåt till närmaste heltal; till exempel ⌊3,7⌋ = 3 och ⌊−1,2⌋ = −2."@sv .

<#ceiling>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "⌈x⌉"@zxx ;
    solid-memo:back "ceiling of x"@en ,
                    "takfunktionen av x"@sv ;
    solid-memo:backNote "x rounded up to the nearest integer; for example, ⌈3.2⌉ = 4 and ⌈−1.8⌉ = −1."@en ,
                        "x avrundat uppåt till närmaste heltal; till exempel ⌈3,2⌉ = 4 och ⌈−1,8⌉ = −1."@sv .

<#factorial>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "n!"@zxx ;
    solid-memo:back "n factorial"@en ,
                    "n-fakultet"@sv ;
    solid-memo:backNote "n! = 1 · 2 · … · n; for example, 4! = 24. Also 0! = 1."@en ,
                        "n! = 1 · 2 · … · n; till exempel 4! = 24. Dessutom 0! = 1."@sv .

<#composition>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "g ∘ f"@zxx ;
    solid-memo:back "g composed with f"@en ,
                    "sammansättningen av g och f"@sv ;
    solid-memo:backNote "(g ∘ f)(x) = g(f(x)): first f, then g."@en ,
                        "(g ∘ f)(x) = g(f(x)): först f, sedan g."@sv .

<#integral>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∫"@zxx ;
    solid-memo:back "integral"@en ,
                    "integral"@sv ;
    solid-memo:backNote "∫ f(x) dx: an antiderivative; with limits a and b, the definite integral."@en ,
                        "∫ f(x) dx: en primitiv funktion; med gränserna a och b, den bestämda integralen."@sv .

<#partial-derivative>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∂"@zxx ;
    solid-memo:back "partial derivative"@en ,
                    "partiell derivata"@sv ;
    solid-memo:backNote "∂f/∂x: the rate at which f changes when only x varies."@en ,
                        "∂f/∂x: hur snabbt f ändras när bara x varierar."@sv .

<#nabla>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∇"@zxx ;
    solid-memo:back "nabla operator (del)"@en ,
                    "nablaoperatorn"@sv ;
    solid-memo:backNote "∇f is the gradient of f."@en ,
                        "∇f är gradienten av f."@sv .

<#pi>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "π"@zxx ;
    solid-memo:frontNote "a mathematical constant"@en ,
                         "en matematisk konstant"@sv ;
    solid-memo:back "pi: the ratio of a circle's circumference to its diameter"@en ,
                    "pi: kvoten mellan en cirkels omkrets och diameter"@sv ;
    solid-memo:backNote "π ≈ 3.14159"@en ,
                        "π ≈ 3,14159"@sv .

<#e>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "e"@zxx ;
    solid-memo:frontNote "a mathematical constant"@en ,
                         "en matematisk konstant"@sv ;
    solid-memo:back "Euler's number, the base of the natural logarithm"@en ,
                    "Eulers tal, basen för den naturliga logaritmen"@sv ;
    solid-memo:backNote "e ≈ 2.71828"@en ,
                        "e ≈ 2,71828"@sv .

<#imaginary-unit>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "i"@zxx ;
    solid-memo:frontNote "a mathematical constant"@en ,
                         "en matematisk konstant"@sv ;
    solid-memo:back "the imaginary unit"@en ,
                    "den imaginära enheten"@sv ;
    solid-memo:backNote "i² = −1; in electrical engineering often written j."@en ,
                        "i² = −1; inom elektroteknik skrivs den ofta j."@sv .

<#infinity>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "∞"@zxx ;
    solid-memo:back "infinity"@en ,
                    "oändlighet"@sv .

