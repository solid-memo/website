    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "bonsoir"@fr ;
    solid-memo:back "good evening"@en ,
                    "god kväll"@sv ,
                    "안녕하세요(저녁 인사)"@ko ,
                    "guten Abend"@de ,
                    "buenas noches"@es ;
    solid-memo:backNote "Said when meeting or leaving someone in the evening."@en ,
                        "Sägs när man möter eller lämnar någon på kvällen."@sv ,
                        "저녁에 사람을 만나거나 헤어질 때 해요."@ko ,
                        "Man sagt es abends beim Treffen oder Verabschieden."@de ,
                        "Se dice al encontrarse o despedirse de alguien por la tarde-noche."@es .

<#bonne-nuit>
    a solid-memo:Card ;
