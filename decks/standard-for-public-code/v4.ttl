<#q-reusable-2b-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "It fails only a SHOULD on documenting its modules"@en ;
    solid-memo:distractorNote "Depending on proprietary software for understanding breaks the MUST, not just a SHOULD."@en .

<#q-reusable-2b-d3>
