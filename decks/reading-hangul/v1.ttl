<#q-blocks-3a-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "[희망]"@en ,
                              "[희망]"@sv ,
                              "[희망]"@de ,
                              "[희망]"@es ,
                              "[희망]"@fr ;
    solid-memo:distractorNote "After a consonant, ㅢ is not kept as written; it is read [ㅣ]."@en ,
                              "Efter en konsonant behålls ㅢ inte som det skrivs; det uttalas [ㅣ]."@sv ,
                              "Nach einem Konsonanten bleibt ㅢ nicht wie geschrieben; es wird [ㅣ] gelesen."@de ,
                              "Tras una consonante, la ㅢ no se mantiene tal como se escribe: se lee [ㅣ]."@es ,
                              "Après une consonne, ㅢ ne se prononce pas telle qu’elle s’écrit : elle se lit [ㅣ]."@fr .

<#q-blocks-3a-d2>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "[흐망]"@en ,
                              "[흐망]"@sv ,
                              "[흐망]"@de ,
                              "[흐망]"@es ,
                              "[흐망]"@fr ;
    solid-memo:distractorNote "The ㅣ part of ㅢ is what stays, not the ㅡ part."@en ,
                              "Det är ㅣ-delen av ㅢ som blir kvar, inte ㅡ-delen."@sv ,
                              "Vom ㅢ bleibt der ㅣ-Teil erhalten, nicht der ㅡ-Teil."@de ,
                              "Lo que se mantiene de la ㅢ es la parte ㅣ, no la parte ㅡ."@es ,
                              "C’est la partie ㅣ de ㅢ qui reste, pas la partie ㅡ."@fr .

<#q-blocks-3a-d3>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "[회망]"@en ,
                              "[회망]"@sv ,
                              "[회망]"@de ,
                              "[회망]"@es ,
                              "[회망]"@fr ;
