<#q-sound-changes-3b>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-31T00:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "How is 좋다 (to be good) pronounced, in Hangul?"@en ,
                     "Hur uttalas 좋다 (att vara bra), skrivet med hangul?"@sv ,
                     "Wie wird 좋다 (gut sein) ausgesprochen, in Hangul?"@de ,
