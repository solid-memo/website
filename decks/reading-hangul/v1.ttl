    solid-memo:front "How is 종로 (a district of Seoul) pronounced, in Hangul?"@en ,
                     "Hur uttalas 종로 (en stadsdel i Seoul), skrivet med hangul?"@sv ,
                     "Wie wird 종로 (ein Bezirk in Seoul) ausgesprochen, in Hangul?"@de ,
                     "¿Cómo se pronuncia 종로 (un distrito de Seúl), escrito en hangul?"@es ,
                     "Comment se prononce 종로 (un arrondissement de Séoul), en hangeul ?"@fr ;
    solid-memo:back "[종노]"@en ,
                    "[종노]"@sv ,
                    "[종노]"@de ,
                    "[종노]"@es ,
