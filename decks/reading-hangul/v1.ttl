<#q-how-hangul-works-r01>
    a solid-memo:Card ;
    solid-memo:formatVersion 5 ;
    dcterms:created "2026-10-31T00:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "In the word 꿀벌 (honeybee), which letter is read right after ㄲ?"@en ,
                     "Vilken bokstav läses direkt efter ㄲ i ordet 꿀벌 (honungsbi)?"@sv ,
                     "Welcher Buchstabe wird im Wort 꿀벌 (Honigbiene) direkt nach ㄲ gelesen?"@de ,
                     "En la palabra 꿀벌 (abeja), ¿qué letra se lee justo después de ㄲ?"@es ,
                     "Dans le mot 꿀벌 « abeille », quelle lettre se lit juste après ㄲ ?"@fr ;
    solid-memo:back "ㅜ"@en ,
                    "ㅜ"@sv ,
                    "ㅜ"@de ,
                    "ㅜ"@es ,
                    "ㅜ"@fr ;
    solid-memo:backNote "ㄲ is the initial consonant of 꿀, and the vowel comes right after the initial. 꿀 is read ㄲ, ㅜ, ㄹ."@en ,
                        "ㄲ är den inledande konsonanten i 꿀, och vokalen kommer direkt efter den inledande konsonanten. 꿀 läses ㄲ, ㅜ, ㄹ."@sv ,
                        "ㄲ ist der Anfangskonsonant von 꿀, und der Vokal folgt direkt auf den Anfangskonsonanten. 꿀 wird ㄲ, ㅜ, ㄹ gelesen."@de ,
                        "ㄲ es la consonante inicial de 꿀, y la vocal va justo después de la inicial. 꿀 se lee ㄲ, ㅜ, ㄹ."@es ,
                        "ㄲ est la consonne initiale de 꿀, et la voyelle suit directement l’initiale. 꿀 se lit ㄲ, ㅜ, ㄹ."@fr ;
    solid-memo:distractor <#q-how-hangul-works-r01-d1> ,
                          <#q-how-hangul-works-r01-d2> ,
                          <#q-how-hangul-works-r01-d3> .

<#q-how-hangul-works-r01-d1>
    a solid-memo:Distractor ,
      schema:Answer ;
    solid-memo:formatVersion 1 ;
    solid-memo:distractorText "ㄹ"@en ,
                              "ㄹ"@sv ,
                              "ㄹ"@de ,
                              "ㄹ"@es ,
                              "ㄹ"@fr ;
    solid-memo:distractorNote "That is the final of 꿀, read after the vowel."@en ,
                              "Det är slutkonsonanten i 꿀, som läses efter vokalen."@sv ,
                              "Das ist der Endkonsonant von 꿀, gelesen nach dem Vokal."@de ,
                              "Esa es la final de 꿀, que se lee después de la vocal."@es ,
                              "C’est la finale de 꿀, lue après la voyelle."@fr .

