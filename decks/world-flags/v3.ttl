                 "지리"@ko ,
                 "Länder"@de ,
                 "Flaggen"@de ,
                 "Geografie"@de ,
                 "países"@es ,
                 "banderas"@es ,
                 "geografía"@es ,
                 "pays"@fr ,
                 "drapeaux"@fr ,
                 "géographie"@fr ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 6 ;
    dcat:version "3" ;
    dcat:prev <https://solid-memo.com/decks/world-flags/v2.ttl> ;
    dcat:previousVersion <https://solid-memo.com/decks/world-flags/v2.ttl> ;
    dcterms:issued "2026-10-22T00:00:00Z"^^xsd:dateTime ;
    adms:versionNotes "Each flag is described, in English and Swedish, so a screen reader can say what it shows: its stripes, colors and emblems, never the country; no card's front or back was changed." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#world-flags> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#world-flags> ;
