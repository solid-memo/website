                 "지리"@ko ,
                 "Länder"@de ,
                 "Flaggen"@de ,
                 "Geografie"@de ,
                 "países"@es ,
                 "banderas"@es ,
                 "geografía"@es ,
                 "pays"@fr ,
                 "drapeaux"@fr ,
                 "géographie"@fr ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 ;
    dcat:version "2" ;
    dcat:prev <https://solid-memo.com/decks/world-flags/v1.ttl> ;
    dcat:previousVersion <https://solid-memo.com/decks/world-flags/v1.ttl> ;
    dcterms:issued "2026-10-10T00:00:00Z"^^xsd:dateTime ;
    adms:versionNotes "Title, description and keywords in Korean, German, Spanish and French as well, now that the app speaks them; no card was changed." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#world-flags> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#world-flags> ;
