    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "presto"@it ;
    solid-memo:back "Very fast"@en ,
                    "Mycket snabbt"@sv .

<#prestissimo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "prestissimo"@it ;
    solid-memo:back "As fast as possible"@en ,
                    "Så snabbt som möjligt"@sv .

<#accelerando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "accelerando"@it ;
    solid-memo:frontNote "Abbreviation: accel."@en ,
                         "Förkortning: accel."@sv ;
    solid-memo:back "Gradually getting faster"@en ,
                    "Gradvis allt snabbare"@sv .

<#ritardando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "ritardando"@it ;
    solid-memo:frontNote "Abbreviation: ritard., rit."@en ,
                         "Förkortning: ritard., rit."@sv ;
    solid-memo:back "Gradually getting slower"@en ,
                    "Gradvis allt långsammare"@sv ;
    solid-memo:backNote "rit. can also stand for ritenuto (held back)."@en ,
                        "rit. kan också stå för ritenuto (återhållet)."@sv .

<#rallentando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "rallentando"@it ;
    solid-memo:frontNote "Abbreviation: rall."@en ,
                         "Förkortning: rall."@sv ;
    solid-memo:back "Gradually slowing down"@en ,
                    "Gradvis saktare"@sv ;
    solid-memo:backNote "Means the same as ritardando."@en ,
                        "Betyder samma sak som ritardando."@sv .

<#allargando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "allargando"@it ;
    solid-memo:back "Broadening: slower, and usually fuller in tone"@en ,
                    "Breddande: långsammare och oftast fylligare i tonen"@sv .

<#a-tempo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "a tempo"@it ;
    solid-memo:back "Back to the normal tempo after a change"@en ,
                    "Tillbaka till grundtempot efter en ändring"@sv ;
    solid-memo:backNote "Tempo primo is used in the same way."@en ,
                        "Tempo primo används på samma sätt."@sv .

<#tempo-primo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "tempo primo"@it ;
    solid-memo:frontNote "Also written: Tempo I"@en ,
                         "Skrivs även: Tempo I"@sv ;
    solid-memo:back "Back to the original tempo"@en ,
                    "Tillbaka till det ursprungliga tempot"@sv ;
    solid-memo:backNote "Literally ‘first tempo’. A tempo is used in the same way."@en ,
                        "Ordagrant ’första tempot’. A tempo används på samma sätt."@sv .

<#rubato>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "rubato"@it ;
    solid-memo:back "Flexible tempo: time taken from some notes and given to others"@en ,
                    "Fritt tempo: tid tas från vissa toner och ges till andra"@sv ;
    solid-memo:backNote "Short for tempo rubato, literally ‘robbed time’."@en ,
                        "Kortform av tempo rubato, ordagrant ’stulen tid’."@sv .

<#meno-mosso>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "meno mosso"@it ;
    solid-memo:back "Less motion: immediately slower"@en ,
                    "Mindre rörelse: genast långsammare"@sv .

<#piu-mosso>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "più mosso"@it ;
    solid-memo:back "More motion: immediately faster"@en ,
                    "Mer rörelse: genast snabbare"@sv .

<#pianissimo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "pianissimo"@it ;
    solid-memo:frontNote "Abbreviation: pp"@en ,
                         "Förkortning: pp"@sv ;
    solid-memo:back "Very soft"@en ,
                    "Mycket svagt"@sv .

<#piano>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "piano"@it ;
    solid-memo:frontNote "Abbreviation: p"@en ,
                         "Förkortning: p"@sv ;
    solid-memo:back "Soft"@en ,
                    "Svagt"@sv .

<#mezzo-piano>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "mezzo piano"@it ;
    solid-memo:frontNote "Abbreviation: mp"@en ,
                         "Förkortning: mp"@sv ;
    solid-memo:back "Medium soft"@en ,
                    "Medelsvagt"@sv .

<#mezzo-forte>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "mezzo forte"@it ;
    solid-memo:frontNote "Abbreviation: mf"@en ,
                         "Förkortning: mf"@sv ;
    solid-memo:back "Medium loud"@en ,
                    "Medelstarkt"@sv .

<#forte>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "forte"@it ;
    solid-memo:frontNote "Abbreviation: f"@en ,
                         "Förkortning: f"@sv ;
    solid-memo:back "Loud"@en ,
                    "Starkt"@sv ;
    solid-memo:backNote "Literally ‘strong’."@en ,
                        "Ordagrant ’stark’."@sv .

<#fortissimo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "fortissimo"@it ;
    solid-memo:frontNote "Abbreviation: ff"@en ,
                         "Förkortning: ff"@sv ;
    solid-memo:back "Very loud"@en ,
                    "Mycket starkt"@sv .

<#crescendo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "crescendo"@it ;
    solid-memo:frontNote "Abbreviation: cresc."@en ,
                         "Förkortning: cresc."@sv ;
    solid-memo:back "Gradually getting louder"@en ,
                    "Gradvis allt starkare"@sv .

<#decrescendo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "decrescendo"@it ;
    solid-memo:frontNote "Abbreviation: decresc."@en ,
                         "Förkortning: decresc."@sv ;
    solid-memo:back "Gradually getting softer"@en ,
                    "Gradvis allt svagare"@sv ;
    solid-memo:backNote "Means the same as diminuendo."@en ,
                        "Betyder samma sak som diminuendo."@sv .

<#diminuendo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "diminuendo"@it ;
    solid-memo:frontNote "Abbreviation: dim."@en ,
                         "Förkortning: dim."@sv ;
    solid-memo:back "Gradually getting softer"@en ,
                    "Gradvis allt svagare"@sv ;
    solid-memo:backNote "Means the same as decrescendo."@en ,
                        "Betyder samma sak som decrescendo."@sv .

<#sforzando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "sforzando"@it ;
    solid-memo:frontNote "Abbreviation: sfz, sf"@en ,
                         "Förkortning: sfz, sf"@sv ;
    solid-memo:back "With a sudden strong accent on one note or chord"@en ,
                    "Med plötslig, kraftig betoning av en enskild ton eller ett ackord"@sv .

<#fortepiano>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "fortepiano"@it ;
    solid-memo:frontNote "Abbreviation: fp"@en ,
                         "Förkortning: fp"@sv ;
    solid-memo:back "Loud, then immediately soft"@en ,
                    "Starkt, sedan genast svagt"@sv ;
    solid-memo:backNote "Also an older name for the piano."@en ,
                        "Även en äldre benämning på piano."@sv .

<#morendo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "morendo"@it ;
    solid-memo:back "Dying away: ever softer, often also slower"@en ,
                    "Bortdöende: allt svagare, ofta också långsammare"@sv .

<#staccato>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "staccato"@it ;
    solid-memo:frontNote "Abbreviation: stacc."@en ,
                         "Förkortning: stacc."@sv ;
    solid-memo:back "Detached: each note short and separated from the next"@en ,
                    "Avskilt: varje ton kort och skild från nästa"@sv ;
    solid-memo:backNote "Marked with a dot above or below the note."@en ,
                        "Markeras med en punkt över eller under noten."@sv .

<#legato>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "legato"@it ;
    solid-memo:back "Smoothly connected, with no gap between the notes"@en ,
                    "Bundet, tonerna sammanhängande utan avbrott"@sv ;
    solid-memo:backNote "Literally ‘bound’."@en ,
                        "Ordagrant ’bundet’."@sv .

<#marcato>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "marcato"@it ;
    solid-memo:frontNote "Abbreviation: marc."@en ,
                         "Förkortning: marc."@sv ;
    solid-memo:back "Marked: each note clearly emphasised"@en ,
                    "Markerat: varje ton tydligt betonad"@sv .

<#tenuto>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "tenuto"@it ;
    solid-memo:frontNote "Abbreviation: ten."@en ,
                         "Förkortning: ten."@sv ;
    solid-memo:back "Each note held for its full value"@en ,
                    "Varje ton hålls ut hela sitt notvärde"@sv ;
    solid-memo:backNote "Literally ‘held’."@en ,
                        "Ordagrant ’hållen’."@sv .

<#pizzicato>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "pizzicato"@it ;
    solid-memo:frontNote "Abbreviation: pizz."@en ,
                         "Förkortning: pizz."@sv ;
    solid-memo:back "Plucked with the fingers instead of bowed"@en ,
                    "Knäppt med fingrarna i stället för spelat med stråke"@sv .

<#arco>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "arco"@it ;
    solid-memo:back "With the bow again (after plucking)"@en ,
                    "Med stråken igen (efter knäppning)"@sv ;
    solid-memo:backNote "Literally ‘bow’."@en ,
                        "Ordagrant ’stråke’."@sv .

<#glissando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "glissando"@it ;
    solid-memo:back "Gliding through the pitches between two notes"@en ,
                    "Glidning genom tonhöjderna mellan två toner"@sv ;
    solid-memo:backNote "An Italian-style word formed from French glisser, ‘to slide’."@en ,
                        "Ett italieniserat ord bildat av franskans glisser, ’glida’."@sv .

<#tutti>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "tutti"@it ;
    solid-memo:back "All together: the whole ensemble performs"@en ,
                    "Alla tillsammans: hela ensemblen medverkar"@sv ;
    solid-memo:backNote "Literally ‘all’."@en ,
                        "Ordagrant ’alla’."@sv .

<#da-capo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "da capo"@it ;
    solid-memo:frontNote "Abbreviation: D.C."@en ,
                         "Förkortning: D.C."@sv ;
    solid-memo:back "Repeat from the beginning"@en ,
                    "Upprepa från början"@sv ;
    solid-memo:backNote "Literally ‘from the head’."@en ,
                        "Ordagrant ’från huvudet’."@sv .

<#dal-segno>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "dal segno"@it ;
    solid-memo:frontNote "Abbreviation: D.S."@en ,
                         "Förkortning: D.S."@sv ;
    solid-memo:back "Repeat from the sign"@en ,
                    "Upprepa från tecknet"@sv .

<#fine>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "fine"@it ;
    solid-memo:back "The end: the piece stops here after a repeat"@en ,
                    "Slut: här slutar stycket efter en repris"@sv .

<#attacca>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "attacca"@it ;
    solid-memo:back "Go straight on to the next movement or section without a break"@en ,
                    "Gå direkt vidare till nästa sats eller avsnitt utan uppehåll"@sv .

<#dolce>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "dolce"@it ;
    solid-memo:frontNote "Abbreviation: dol."@en ,
                         "Förkortning: dol."@sv ;
    solid-memo:back "Sweetly and gently"@en ,
                    "Ljuvt och milt"@sv .

<#cantabile>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "cantabile"@it ;
    solid-memo:back "In a singing style"@en ,
                    "Sjungande"@sv .

<#espressivo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "espressivo"@it ;
    solid-memo:frontNote "Abbreviation: espr."@en ,
                         "Förkortning: espr."@sv ;
    solid-memo:back "Expressively"@en ,
                    "Uttrycksfullt"@sv .

<#grazioso>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "grazioso"@it ;
    solid-memo:back "Gracefully"@en ,
                    "Graciöst"@sv .

<#maestoso>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "maestoso"@it ;
    solid-memo:back "Majestically"@en ,
                    "Majestätiskt"@sv .

<#agitato>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "agitato"@it ;
    solid-memo:back "Agitated, restless"@en ,
                    "Upprört, oroligt"@sv .

<#con-brio>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "con brio"@it ;
    solid-memo:back "With spirit and fire"@en ,
                    "Med liv och glöd"@sv .

<#leggiero>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "leggiero"@it ;
    solid-memo:back "Lightly, with a light touch"@en ,
                    "Lätt, med lätt anslag"@sv ;
    solid-memo:backNote "Modern Italian spells it leggero."@en ,
                        "På modern italienska stavas det leggero."@sv .

<#tranquillo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "tranquillo"@it ;
    solid-memo:back "Calmly"@en ,
                    "Lugnt"@sv .

<#sotto-voce>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "sotto voce"@it ;
    solid-memo:back "In an undertone, hushed"@en ,
                    "Med dämpad röst eller ton"@sv ;
    solid-memo:backNote "Literally ‘under the voice’."@en ,
                        "Ordagrant ’under rösten’."@sv .

<#pesante>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "pesante"@it ;
    solid-memo:back "Heavily, weightily"@en ,
                    "Tungt"@sv .

<#giocoso>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "giocoso"@it ;
    solid-memo:back "Playfully, merrily"@en ,
                    "Lekfullt, muntert"@sv .

<#molto>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "molto"@it ;
    solid-memo:back "Very, much"@en ,
                    "Mycket"@sv .

<#poco-a-poco>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "poco a poco"@it ;
    solid-memo:back "Little by little, gradually"@en ,
                    "Lite i taget, gradvis"@sv .

<#sempre>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "sempre"@it ;
    solid-memo:back "Always, throughout"@en ,
                    "Alltid, hela tiden"@sv .

<#subito>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "subito"@it ;
    solid-memo:back "Suddenly, at once"@en ,
                    "Plötsligt, genast"@sv .

