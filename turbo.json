{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "dependsOn": [
        "transit"
      ],
      "outputLogs": "new-only"
    },
    "test": {
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts"
      ],
      "dependsOn": [
        "transit"
      ],
      "outputLogs": "new-only"
    },
    "build": {
      "dependsOn": [
        "transit",
        "^generate:check"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "GITHUB_SHA"
      ]
    },
    "generate:check": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputLogs": "new-only"
    },
    "format:turtle": {
      "cache": false
    },
    "format:turtle:check": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputLogs": "new-only"
    },
    "test:pod": {
      "cache": false,
      "env": [
        "SOLID_SERVER_URL",
        "SOLID_SERVER_NAME",
        "SOLID_SERVERS",
        "E2E_RESULT_JSON"
      ],
      "dependsOn": [
        "transit"
      ]
    }
  }
}
