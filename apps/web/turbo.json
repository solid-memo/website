{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        ".env*",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/CNAME",
        "$TURBO_ROOT$/ns/**",
        "$TURBO_ROOT$/decks/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/publiccode.yml",
        "$TURBO_ROOT$/*.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/packages/solid-memo-client/src/**",
        "$TURBO_ROOT$/packages/solid-memo-client/package.json"
      ],
      "env": [
        "$TURBO_EXTENDS$",
        "VITE_*",
        "DOCS_DIAGRAMS"
      ],
      "passThroughEnv": [
        "PLAYWRIGHT_*",
        "XDG_CACHE_HOME"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        ".env*",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/CNAME",
        "$TURBO_ROOT$/ns/**",
        "$TURBO_ROOT$/decks/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/packages/solid-memo-client/src/**",
        "$TURBO_ROOT$/packages/solid-memo-client/package.json"
      ],
      "env": [
        "$TURBO_EXTENDS$",
        "VITE_*",
        "DOCS_DIAGRAMS"
      ],
      "passThroughEnv": [
        "PLAYWRIGHT_*",
        "XDG_CACHE_HOME"
      ]
    }
  }
}
