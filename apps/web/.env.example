# The settings a build of the site reads (docs/configuration.md).
#
# Copy this file to apps/web/.env.local (ignored by git) or apps/web/.env,
# and uncomment the lines you want; or set the variables in the
# environment of `npm run build`. Every setting is optional: an unset or
# blank one is this deployment's own value, given below. They are read
# when the site is built, so a change needs a new build.

# What the site calls itself: the landing page's heading, the wordmark,
# the browser tab's title, the page's title and link preview, and the
# name the identity provider shows at login. Text on one line.
# VITE_APP_NAME=Solid Memo

# The repository the footer links to: "Source code", the build's commit
# (<url>/commit/<sha>) and "Report an issue" (<url>/issues/new/choose).
# VITE_REPO_URL=https://github.com/solid-memo/website

# The Pod providers suggested at login (every one) and for creating a Pod
# (those with a signUpUrl), as a JSON array on one line. Each has a unique
# id, a name, an https oidcIssuer and, optionally, an https signUpUrl.
# Unset, the list in packages/domain/src/podProvider.ts.
# VITE_POD_PROVIDERS=[{"id":"solidcommunity","name":"solidcommunity.net","oidcIssuer":"https://solidcommunity.net/"}]

# The deck library's index (docs/deck-library.md). Unset, the library
# published with the site, from decks/.
# VITE_LIBRARY_INDEX_URL=https://example.org/decks/index.ttl
