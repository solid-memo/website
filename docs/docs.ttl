<boundaries.md>
    a schema:TechArticle ;
    schema:isPartOf <#the-code> ;
    schema:position 20 ;
    dcterms:abstract "the import rules between packages, and the vendor libraries each may use, as `npm run check:boundaries` enforces them."@en .

