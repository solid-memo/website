{
  "name": "solid-memo",
  "description": "Spaced-repetition flashcards that live in your own Solid pod.",
  "private": true,
  "license": "MIT",
  "version": "6.20.3",
  "homepage": "https://solid-memo.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solid-memo/website.git"
  },
  "bugs": {
    "url": "https://github.com/solid-memo/website/issues"
  },
  "author": "Anton Wiklund (https://github.com/antwika)",
  "keywords": [
    "solid",
    "solid-pod",
    "spaced-repetition",
    "flashcards",
    "sm-2",
    "linked-data",
    "rdf",
    "shacl",
    "dcat",
    "preact"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e/*"
  ],
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "npm run dev -w @solid-memo/web",
    "start": "npm run build && npm run preview -w @solid-memo/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run lint:markdown && npm run lint:spelling && npm run lint:prose && turbo run typecheck test test:roundtrip generate:check format:turtle:check library:check && npm run check:repository",
    "check:ci": "npm run lint && npm run lint:markdown && npm run lint:spelling && npm run lint:prose && turbo run typecheck test test:roundtrip generate:check format:turtle:check && npm run check:repository",
    "check:repository": "npm run check:boundaries && npm run check:exports && npm run check:scripts && npm run check:docs && npm run check:dependencies && npm run check:reuse && npm run check:actions && npm run check:keys",
    "check:breaking": "node -e \"import('./scripts/checkBreaking.ts').then((m) => m.run(process))\" --",
    "check:closes": "node -e \"import('./scripts/checkClosesIssue.ts').then((m) => m.run(process))\" --",
    "check:boundaries": "node -e \"import('./scripts/checkBoundaries.ts').then((m) => m.run(process))\"",
    "check:exports": "node -e \"import('./scripts/checkExports.ts').then((m) => m.run(process))\"",
    "check:scripts": "tsc --noEmit -p scripts && vitest run --coverage --root scripts",
    "check:docs": "node -e \"import('./scripts/checkDocs.ts').then((m) => m.run(process))\"",
    "check:dependencies": "node -e \"import('./scripts/checkDependencies.ts').then((m) => m.run(process))\"",
    "check:reuse": "node -e \"import('./scripts/checkReuse.ts').then((m) => m.run(process))\"",
    "check:actions": "node -e \"import('./scripts/checkActions.ts').then((m) => m.run(process))\"",
    "check:keys": "node -e \"import('./scripts/checkQueryKeys.ts').then((m) => m.run(process))\"",
    "ci:gate": "node -e \"import('./scripts/ciGate.ts').then((m) => m.run(process))\"",
    "check:providers": "node -e \"import('./scripts/checkProviders.ts').then((m) => m.run(process))\"",
    "coverage:summary": "node -e \"import('./scripts/coverageSummary.ts').then((m) => m.run(process))\"",
    "release:commit": "node -e \"import('./scripts/releaseCommit.ts').then((m) => m.run(process))\" --",
    "release:version": "node -e \"import('./scripts/releaseVersion.ts').then((m) => m.run(process))\" --",
    "docs:archive": "node -e \"import('./scripts/docsArchive.ts').then((m) => m.run(process))\" --",
    "site:version": "node -e \"import('./scripts/siteVersion.ts').then((m) => m.run(process))\" --",
    "lint": "biome check .",
    "format": "biome check --write .",
    "lint:markdown": "markdownlint-cli2",
    "lint:spelling": "cspell --no-progress",
    "lint:prose": "node -e \"import('./scripts/checkProse.ts').then((m) => m.run(process))\" --",
    "lint:reuse": "reuse lint",
    "lint:workflows": "actionlint && zizmor --offline --no-progress .github",
    "lint:commits": "commitlint --from origin/main --to HEAD && { test -z \"$(git rev-list --merges origin/main..HEAD)\" || { echo 'A merge commit is not linted: update the branch by rebasing it on main (git rebase origin/main).' >&2; exit 1; }; }",
    "crosscheck": "python3 scripts/shacl_crosscheck.py",
    "test:crosscheck": "python3 -m unittest discover -s scripts",
    "test:pod": "npm run test:pod -w @solid-memo/e2e-pod",
    "pod": "npm run pod -w @solid-memo/e2e-pod",
    "pod:clean": "npm run pod:clean -w @solid-memo/e2e-pod",
    "journeys": "npm run test:journeys -w @solid-memo/e2e-journeys --",
    "screenshots": "npm run screenshots -w @solid-memo/e2e-journeys",
    "browsers": "npm run browsers -w @solid-memo/site",
    "generate": "npm run generate -w @solid-memo/vocab",
    "generate:check": "turbo run generate:check",
    "library": "node -e \"import('@solid-memo/shacl/node/deckLibrary').then((m) => m.run(process))\" --",
    "library:check": "node -e \"import('@solid-memo/shacl/node/deckLibrary').then((m) => m.run(process))\" -- --check",
    "format:turtle": "turbo run format:turtle",
    "format:turtle:check": "turbo run format:turtle:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cspell": "^10.4.0",
    "json5": "^2.2.3",
    "markdownlint-cli2": "^0.24.0",
    "readable-stream": "^4.8.0",
    "semantic-release": "^25.0.9",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
