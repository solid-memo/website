@base <https://solid-memo.com/ns/bounds/deck.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .

# The most Solid Memo reads of a deck's catalog entry in a pod, at
# every format: each property of every version of its shape that needs
# a bound. A reader takes at most sh:maxCount values (of a text, one
# per language), no string longer than sh:maxLength, and only an IRI
# sh:pattern names, and it stops as it reaches a bound, so it never
# builds a longer list (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "DeckBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of a deck's catalog entry in a pod, at every format." ;
    sh:property <#title> ,
                <#description> ,
                <#creator> ,
                <#license> ,
                <#cardsDocument> ,
                <#reviewsDocument> ,
                <#source> ,
                <#theme> ,
                <#keyword> ,
                <#distribution> ,
                <#wasDerivedFrom> .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .

# At most 100 creators (MAX_DECK_METADATA, all a deck keeps): agents'
# URLs, or before format 3 names anyone may type, as long as a term
# may be. A migration names an agent for each, so no more are read
# than kept.
<#creator>
    a sh:PropertyShape ;
    sh:path dcterms:creator ;
    sh:maxCount 100 ;
    sh:maxLength 16383 ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#license>
    a sh:PropertyShape ;
    sh:path dcterms:license ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#cardsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:cardsDocument ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#reviewsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewsDocument ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#source>
    a sh:PropertyShape ;
    sh:path dcterms:source ;
    sh:pattern "^https?://" .

# At most 100 themes (MAX_DECK_METADATA, all a deck keeps).
<#theme>
    a sh:PropertyShape ;
    sh:path dcat:theme ;
    sh:maxCount 100 ;
    sh:pattern "^https?://" .

# At most 1,000 keywords in all its languages (MAX_DECK_KEYWORDS, all
# a deck keeps), each as long as a term may be.
<#keyword>
    a sh:PropertyShape ;
    sh:path dcat:keyword ;
    sh:maxCount 1000 ;
    sh:maxLength 16383 .

# At most 100 distributions: a deck in a pod has one.
<#distribution>
    a sh:PropertyShape ;
    sh:path dcat:distribution ;
    sh:maxCount 100 ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#wasDerivedFrom>
    a sh:PropertyShape ;
    sh:path prov:wasDerivedFrom ;
    sh:pattern "^https?://" .

# The terms Solid Memo reads of a deck's catalog entry beside its
# record: outside the deck's shape, so every write of the entry keeps
# them. A small shape of their own, read as a record is, within the
# same bounds (docs/shapes.md, Bounds).
<#terms>
    a sh:NodeShape ;
    sh:name "DeckTerms" ;
    rdfs:comment "The terms Solid Memo reads of a deck's catalog entry beside its record: outside the deck's shape, so every write of the entry keeps them." ;
    sh:property <#term-completedChapter> ,
                <#term-deckCardLanguage> ,
                <#term-deckPictureHost> ,
                <#term-deckPausedAt> ,
                <#term-deckResumesOn> ,
                <#term-position> .

# At most 2,000 completed chapters: twice the 1,000 a deck keeps
# (MAX_COMPLETED_CHAPTERS), so that values of other courses read first
# leave room for the course's own, which are kept first.
<#term-completedChapter>
    a sh:PropertyShape ;
    sh:path solid-memo:completedChapter ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 2000 ;
    sh:pattern "^https?://" .

# A language tag: 255 characters, well past the 35 every tag fits in.
<#term-deckCardLanguage>
    a sh:PropertyShape ;
    sh:path solid-memo:deckCardLanguage ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 255 .

# At most 1,000 hosts, ten times the 100 a deck keeps
# (MAX_PICTURE_HOSTS), so that values that are no host leave room for
# those that are; a host is at most 253 characters.
<#term-deckPictureHost>
    a sh:PropertyShape ;
    sh:path solid-memo:deckPictureHost ;
    sh:datatype xsd:string ;
    sh:maxCount 1000 ;
    sh:maxLength 253 .

# When the deck was paused.
<#term-deckPausedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:deckPausedAt ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .

# A day, YYYY-MM-DD: 64 characters leave room for any year a date
# holds.
<#term-deckResumesOn>
    a sh:PropertyShape ;
    sh:path solid-memo:deckResumesOn ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 64 .

# The deck's place among its group's members.
<#term-position>
    a sh:PropertyShape ;
    sh:path solid-memo:position ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 .
