@base <https://solid-memo.com/ns/bounds/type-registration.ttl> .

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix solid:   <http://www.w3.org/ns/solid/terms#> .

# What Solid Memo reads of a type index's registration. A small shape
# of their own, read as a record is, within the same bounds
# (docs/shapes.md, Bounds).
<#terms>
    a sh:NodeShape ;
    sh:name "TypeRegistrationTerms" ;
    rdfs:comment "What Solid Memo reads of a type index's registration." ;
    sh:property <#instance> ,
                <#instanceContainer> ,
                <#title> .

# At most 256 registered documents: a registration names one.
<#instance>
    a sh:PropertyShape ;
    sh:path solid:instance ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 256 ;
    sh:pattern "^https?://" .

# At most 256 registered containers: a registration names one.
<#instanceContainer>
    a sh:PropertyShape ;
    sh:path solid:instanceContainer ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 256 ;
    sh:pattern "^https?://" .

# Text anyone may type, as long as a term may be.
<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 16383 .
