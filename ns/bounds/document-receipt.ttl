@base <https://solid-memo.com/ns/bounds/document-receipt.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .

# The most Solid Memo reads of a document's receipt in the digest:
# each property of every version of its shape that needs a bound. A
# reader takes at most sh:maxCount values (of a text, one per
# language), no string longer than sh:maxLength, and only an IRI
# sh:pattern names, and it stops as it reaches a bound, so it never
# builds a longer list (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "DocumentReceiptBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of a document's receipt in the digest." ;
    sh:property <#receiptOf> ,
                <#documentVersion> ,
                <#conformedTo> .

# An http(s) URL, as every IRI a record holds.
<#receiptOf>
    a sh:PropertyShape ;
    sh:path solid-memo:receiptOf ;
    sh:pattern "^https?://" .

# An ETag or a ruleset's name: at most 512 characters, as no longer
# version is ever sent (MAX_SENT_VERSION_LENGTH).
<#documentVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:documentVersion ;
    sh:maxLength 512 .

# An ETag or a ruleset's name: at most 512 characters, as no longer
# version is ever sent (MAX_SENT_VERSION_LENGTH).
<#conformedTo>
    a sh:PropertyShape ;
    sh:path solid-memo:conformedTo ;
    sh:maxLength 512 .
