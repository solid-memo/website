@base <https://solid-memo.com/ns/bounds/catalog.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .

# The most Solid Memo reads of a catalog: an instance's, or the
# library's index: each property of every version of its shape that
# needs a bound. A reader takes at most sh:maxCount values (of a text,
# one per language), no string longer than sh:maxLength, and only an
# IRI sh:pattern names, and it stops as it reaches a bound, so it
# never builds a longer list (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "CatalogBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of a catalog: an instance's, or the library's index." ;
    sh:property <#title> ,
                <#description> ,
                <#publisher> ,
                <#license> ,
                <#themeTaxonomy> ,
                <#dataset> .

# Text anyone may type, as long as a term may be.
<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:maxLength 16383 .

# Text anyone may type, as long as a term may be.
<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:maxLength 16383 .

# An http(s) URL, as every IRI a record holds.
<#publisher>
    a sh:PropertyShape ;
    sh:path dcterms:publisher ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#license>
    a sh:PropertyShape ;
    sh:path dcterms:license ;
    sh:pattern "^https?://" .

# At most 100 theme schemes: the app names 2.
<#themeTaxonomy>
    a sh:PropertyShape ;
    sh:path dcat:themeTaxonomy ;
    sh:maxCount 100 ;
    sh:pattern "^https?://" .

# At most 1,000 datasets: an instance has no more decks than that
# (MAX_CATALOG_LINKS), and the library's index lists 116.
<#dataset>
    a sh:PropertyShape ;
    sh:path dcat:dataset ;
    sh:maxCount 1000 ;
    sh:pattern "^https?://" .

# The terms Solid Memo reads of a catalog beside its record: an
# instance's releases, drafts and deck groups, and the course the
# library offers newcomers. A small shape of their own, read as a
# record is, within the same bounds (docs/shapes.md, Bounds).
<#terms>
    a sh:NodeShape ;
    sh:name "CatalogTerms" ;
    rdfs:comment "The terms Solid Memo reads of a catalog beside its record: an instance's releases, drafts and deck groups, and the course the library offers newcomers." ;
    sh:property <#term-publishedRelease> ,
                <#term-releaseDraft> ,
                <#term-catalog> ,
                <#term-newcomerCourse> .

# At most 1,001 releases: one past the most an instance follows
# (MAX_CATALOG_LINKS), so that a catalog linking more is told and
# refused, not read.
<#term-publishedRelease>
    a sh:PropertyShape ;
    sh:path solid-memo:publishedRelease ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1001 ;
    sh:pattern "^https?://" .

# At most 1,001 drafts: one past the most an instance follows
# (MAX_CATALOG_LINKS), so that a catalog linking more is told and
# refused, not read.
<#term-releaseDraft>
    a sh:PropertyShape ;
    sh:path solid-memo:releaseDraft ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1001 ;
    sh:pattern "^https?://" .

# At most 1,001 deck groups at the top: one past the most an instance
# has (MAX_DECK_GROUPS), so that a catalog linking more is told and
# refused, not read.
<#term-catalog>
    a sh:PropertyShape ;
    sh:path dcat:catalog ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1001 ;
    sh:pattern "^https?://" .

# The course the library offers newcomers: an http(s) URL.
<#term-newcomerCourse>
    a sh:PropertyShape ;
    sh:path solid-memo:newcomerCourse ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:pattern "^https?://" .
