@base <https://solid-memo.com/ns/bounds/preferences.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .

# The most Solid Memo reads of the preferences, at every format: each
# property of every version of its shape that needs a bound. A reader
# takes at most sh:maxCount values (of a text, one per language), no
# string longer than sh:maxLength, and only an IRI sh:pattern names,
# and it stops as it reaches a bound, so it never builds a longer list
# (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "PreferencesBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of the preferences, at every format." ;
    sh:property <#palette> .

# An http(s) URL, as every IRI a record holds.
<#palette>
    a sh:PropertyShape ;
    sh:path solid-memo:palette ;
    sh:pattern "^https?://" .

# The terms Solid Memo reads of the preferences beside their record:
# outside their shape, so every write of them keeps them. A small
# shape of their own, read as a record is, within the same bounds
# (docs/shapes.md, Bounds).
<#terms>
    a sh:NodeShape ;
    sh:name "PreferencesTerms" ;
    rdfs:comment "The terms Solid Memo reads of the preferences beside their record: outside their shape, so every write of them keeps them." ;
    sh:property <#term-connectedScreenSkipped> .

# Whether logging in skips the Connected screen.
<#term-connectedScreenSkipped>
    a sh:PropertyShape ;
    sh:path solid-memo:connectedScreenSkipped ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .
