@base <https://solid-memo.com/ns/bounds/chapter.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix schema:     <https://schema.org/> .

# The most Solid Memo reads of a course's chapter: each property of
# every version of its shape that needs a bound. A reader takes at
# most sh:maxCount values (of a text, one per language), no string
# longer than sh:maxLength, and only an IRI sh:pattern names, and it
# stops as it reaches a bound, so it never builds a longer list
# (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "ChapterBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of a course's chapter." ;
    sh:property <#title> ,
                <#description> ,
                <#isPartOf> ,
                <#reviewQuestion> ,
                <#textFormat> .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .

# An http(s) URL, as every IRI a record holds.
<#isPartOf>
    a sh:PropertyShape ;
    sh:path schema:isPartOf ;
    sh:pattern "^https?://" .

# At most 1,000 cards asked in a chapter's review: the library's
# chapters ask 9 at most.
<#reviewQuestion>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewQuestion ;
    sh:maxCount 1000 ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#textFormat>
    a sh:PropertyShape ;
    sh:path solid-memo:textFormat ;
    sh:pattern "^https?://" .
