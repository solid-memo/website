@base <https://solid-memo.com/ns/bounds/distractor.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .

# The most Solid Memo reads of a wrong option: each property of every
# version of its shape that needs a bound. A reader takes at most
# sh:maxCount values (of a text, one per language), no string longer
# than sh:maxLength, and only an IRI sh:pattern names, and it stops as
# it reaches a bound, so it never builds a longer list
# (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "DistractorBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of a wrong option." ;
    sh:property <#distractorText> ,
                <#distractorNote> .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#distractorText>
    a sh:PropertyShape ;
    sh:path solid-memo:distractorText ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#distractorNote>
    a sh:PropertyShape ;
    sh:path solid-memo:distractorNote ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .
