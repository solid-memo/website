@base <https://solid-memo.com/ns/bounds/draft-deck.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix adms:       <http://www.w3.org/ns/adms#> .

# The most Solid Memo reads of a draft's deck: each property of every
# version of its shape that needs a bound. A reader takes at most
# sh:maxCount values (of a text, one per language), no string longer
# than sh:maxLength, and only an IRI sh:pattern names, and it stops as
# it reaches a bound, so it never builds a longer list
# (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "DraftDeckBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of a draft's deck." ;
    sh:property <#title> ,
                <#description> ,
                <#creator> ,
                <#publisher> ,
                <#license> ,
                <#theme> ,
                <#keyword> ,
                <#language> ,
                <#version> ,
                <#versionNotes> ,
                <#inSeries> ,
                <#isVersionOf> ,
                <#prev> ,
                <#previousVersion> ,
                <#distribution> ,
                <#wasDerivedFrom> ,
                <#releasedAs> .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .

# At most 100 creators (MAX_DECK_METADATA, all a deck keeps).
<#creator>
    a sh:PropertyShape ;
    sh:path dcterms:creator ;
    sh:maxCount 100 ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#publisher>
    a sh:PropertyShape ;
    sh:path dcterms:publisher ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#license>
    a sh:PropertyShape ;
    sh:path dcterms:license ;
    sh:pattern "^https?://" .

# At most 100 themes (MAX_DECK_METADATA, all a deck keeps).
<#theme>
    a sh:PropertyShape ;
    sh:path dcat:theme ;
    sh:maxCount 100 ;
    sh:pattern "^https?://" .

# At most 1,000 keywords in all its languages (MAX_DECK_KEYWORDS),
# each as long as a term may be.
<#keyword>
    a sh:PropertyShape ;
    sh:path dcat:keyword ;
    sh:maxCount 1000 ;
    sh:maxLength 16383 .

# At most 100 languages (MAX_DECK_METADATA).
<#language>
    a sh:PropertyShape ;
    sh:path dcterms:language ;
    sh:maxCount 100 ;
    sh:pattern "^https?://" .

# A version number, 1, 2, …: 64 characters is far past any.
<#version>
    a sh:PropertyShape ;
    sh:path dcat:version ;
    sh:maxLength 64 .

# Text anyone may type, as long as a term may be.
<#versionNotes>
    a sh:PropertyShape ;
    sh:path adms:versionNotes ;
    sh:maxLength 16383 .

# An http(s) URL, as every IRI a record holds.
<#inSeries>
    a sh:PropertyShape ;
    sh:path dcat:inSeries ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#isVersionOf>
    a sh:PropertyShape ;
    sh:path dcat:isVersionOf ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#prev>
    a sh:PropertyShape ;
    sh:path dcat:prev ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#previousVersion>
    a sh:PropertyShape ;
    sh:path dcat:previousVersion ;
    sh:pattern "^https?://" .

# At most 100 distributions: a release has one.
<#distribution>
    a sh:PropertyShape ;
    sh:path dcat:distribution ;
    sh:maxCount 100 ;
    sh:pattern "^https?://" .

# At most 1,000 sources: the library's releases name 248 at most.
<#wasDerivedFrom>
    a sh:PropertyShape ;
    sh:path prov:wasDerivedFrom ;
    sh:maxCount 1000 ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#releasedAs>
    a sh:PropertyShape ;
    sh:path solid-memo:releasedAs ;
    sh:pattern "^https?://" .
