@base <https://solid-memo.com/ns/bounds/answer.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .

# The most Solid Memo reads of an answer of the answer log: each
# property of every version of its shape that needs a bound. A reader
# takes at most sh:maxCount values (of a text, one per language), no
# string longer than sh:maxLength, and only an IRI sh:pattern names,
# and it stops as it reaches a bound, so it never builds a longer list
# (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "AnswerBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of an answer of the answer log." ;
    sh:property <#answeredDeck> ,
                <#answeredCard> ,
                <#answeredOn> ,
                <#priorDue> ,
                <#chosenDistractor> .

# An http(s) URL, as every IRI a record holds.
<#answeredDeck>
    a sh:PropertyShape ;
    sh:path solid-memo:answeredDeck ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#answeredCard>
    a sh:PropertyShape ;
    sh:path solid-memo:answeredCard ;
    sh:pattern "^https?://" .

# A day, YYYY-MM-DD: 64 characters leave room for any year a date
# holds.
<#answeredOn>
    a sh:PropertyShape ;
    sh:path solid-memo:answeredOn ;
    sh:maxLength 64 .

# A day, YYYY-MM-DD: 64 characters leave room for any year a date
# holds.
<#priorDue>
    a sh:PropertyShape ;
    sh:path solid-memo:priorDue ;
    sh:maxLength 64 .

# An http(s) URL, as every IRI a record holds.
<#chosenDistractor>
    a sh:PropertyShape ;
    sh:path solid-memo:chosenDistractor ;
    sh:pattern "^https?://" .
