@base <https://solid-memo.com/ns/bounds/palette.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .

# The most Solid Memo reads of a palette of the user's own: each
# property of every version of its shape that needs a bound. A reader
# takes at most sh:maxCount values (of a text, one per language), no
# string longer than sh:maxLength, and only an IRI sh:pattern names,
# and it stops as it reaches a bound, so it never builds a longer list
# (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "PaletteBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of a palette of the user's own." ;
    sh:property <#title> ,
                <#basedOn> ,
                <#lightColors> ,
                <#darkColors> .

# A name in up to 32 languages (MAX_PALETTE_NAME_LANGUAGES), each up
# to 200 characters (MAX_PALETTE_NAME_CHARACTERS), as the palette
# editor writes it.
<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:maxCount 32 ;
    sh:maxLength 200 .

# An http(s) URL, as every IRI a record holds.
<#basedOn>
    a sh:PropertyShape ;
    sh:path solid-memo:basedOn ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#lightColors>
    a sh:PropertyShape ;
    sh:path solid-memo:lightColors ;
    sh:pattern "^https?://" .

# An http(s) URL, as every IRI a record holds.
<#darkColors>
    a sh:PropertyShape ;
    sh:path solid-memo:darkColors ;
    sh:pattern "^https?://" .
