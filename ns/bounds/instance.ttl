@base <https://solid-memo.com/ns/bounds/instance.ttl> .

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# The most Solid Memo reads of an instance: each property of every
# version of its shape that needs a bound. A reader takes at most
# sh:maxCount values (of a text, one per language), no string longer
# than sh:maxLength, and only an IRI sh:pattern names, and it stops as
# it reaches a bound, so it never builds a longer list
# (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "InstanceBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of an instance." ;
    sh:property <#title> ,
                <#replaces> .

# Text anyone may type, as long as a term may be.
<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:maxLength 16383 .

# An http(s) URL, as every IRI a record holds.
<#replaces>
    a sh:PropertyShape ;
    sh:path dcterms:replaces ;
    sh:pattern "^https?://" .
