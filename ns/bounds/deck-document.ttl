@base <https://solid-memo.com/ns/bounds/deck-document.ttl> .

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# What Solid Memo reads of a deck's cards or reviews document itself:
# the decks it says it is part of. A small shape of their own, read as
# a record is, within the same bounds (docs/shapes.md, Bounds).
<#terms>
    a sh:NodeShape ;
    sh:name "DeckDocumentTerms" ;
    rdfs:comment "What Solid Memo reads of a deck's cards or reviews document itself: the decks it says it is part of." ;
    sh:property <#isPartOf> .

# At most 1,000 decks: an instance has no more (MAX_CATALOG_LINKS).
<#isPartOf>
    a sh:PropertyShape ;
    sh:path dcterms:isPartOf ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1000 ;
    sh:pattern "^https?://" .
