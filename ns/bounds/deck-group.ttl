@base <https://solid-memo.com/ns/bounds/deck-group.ttl> .

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

# The most Solid Memo reads of a deck group: each property of every
# version of its shape that needs a bound. A reader takes at most
# sh:maxCount values (of a text, one per language), no string longer
# than sh:maxLength, and only an IRI sh:pattern names, and it stops as
# it reaches a bound, so it never builds a longer list
# (docs/shapes.md, Bounds).
<#bounds>
    a sh:NodeShape ;
    sh:name "DeckGroupBounds" ;
    rdfs:comment "The bounds on what Solid Memo reads of a deck group." ;
    sh:property <#title> ,
                <#description> ,
                <#publisher> ,
                <#dataset> ,
                <#catalog> .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .

# Text anyone may type, in up to 100 languages (MAX_DECK_METADATA, the
# most a deck keeps of its title's), each value as long as a term may
# be (16,383 characters, MAX_TERM_CHARACTERS).
<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:maxCount 100 ;
    sh:maxLength 16383 .

# An http(s) URL, as every IRI a record holds.
<#publisher>
    a sh:PropertyShape ;
    sh:path dcterms:publisher ;
    sh:pattern "^https?://" .

# At most 1,000 decks: an instance has no more (MAX_CATALOG_LINKS).
<#dataset>
    a sh:PropertyShape ;
    sh:path dcat:dataset ;
    sh:maxCount 1000 ;
    sh:pattern "^https?://" .

# At most 1,000 sub-groups: an instance has no more groups
# (MAX_DECK_GROUPS).
<#catalog>
    a sh:PropertyShape ;
    sh:path dcat:catalog ;
    sh:maxCount 1000 ;
    sh:pattern "^https?://" .
