@base <https://solid-memo.com/ns/vocab/topics.ttl> .

@prefix topic:   <https://solid-memo.com/ns/vocab/topics.ttl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# What decks are about: a SKOS concept scheme used with dcat:theme on
# decks (next to the EU data theme EDUC) and declared as a theme
# taxonomy of the catalogues. Every concept has its label and
# definition in each language the scheme's title is in (English,
# Swedish, Korean, German, Spanish and French, the app's languages).
# Concepts are only ever added; a concept that should go is
# deprecated, never removed, since decks point at it. So a topic's IRI
# never changes and carries no version: each addition bumps
# owl:versionInfo and adds a change note, and every concept says in its
# history note when it arrived.
<>
    a skos:ConceptScheme ;
    owl:versionInfo "1.10" ;
    skos:changeNote "1.0: languages, swedish, geography, computing, science, chemistry." ,
                    "1.1: art." ,
                    "1.2: labour-market." ,
                    "1.3: every topic named and defined in Swedish as well as English." ,
                    "1.4: history, literature, music, mythology, mathematics, sports, economics, astronomy, biology, physics, greek, latin, spanish (for the authored decks)." ,
                    "1.5: french, german." ,
                    "1.6: film, finnish, italian, portuguese." ,
                    "1.7: linked-data." ,
                    "1.8: korean; every topic named and defined in Korean as well." ,
                    "1.9: every topic named and defined in German, Spanish and French as well." ,
                    "1.10: japanese, english." ;
    dcterms:title "Solid Memo topics"@en ,
                  "Solid Memo-ämnen"@sv ,
                  "Solid Memo 주제"@ko ,
                  "Solid-Memo-Themen"@de ,
                  "Temas de Solid Memo"@es ,
                  "Thèmes de Solid Memo"@fr ;
    skos:definition "What a deck of flashcards is about."@en ,
                    "Vad en kortlek med flashcards handlar om."@sv ,
                    "플래시카드 덱이 다루는 내용."@ko ,
                    "Worum es in einem Stapel Karteikarten geht."@de ,
                    "De qué trata un mazo de tarjetas de memoria."@es ,
                    "Ce dont traite un paquet de cartes mémoire."@fr ;
    skos:hasTopConcept topic:languages ,
                       topic:geography ,
                       topic:computing ,
                       topic:science ,
                       topic:art ,
                       topic:labour-market ,
                       topic:history ,
                       topic:literature ,
                       topic:music ,
                       topic:mythology ,
                       topic:mathematics ,
                       topic:sports ,
                       topic:economics ,
                       topic:film .

topic:languages
    a skos:Concept ;
    skos:prefLabel "Languages"@en ,
                   "Språk"@sv ,
                   "언어"@ko ,
                   "Sprachen"@de ,
                   "Idiomas"@es ,
                   "Langues"@fr ;
    skos:definition "Vocabulary and grammar of human languages."@en ,
                    "Ordförråd och grammatik i mänskliga språk."@sv ,
                    "인간 언어의 어휘와 문법."@ko ,
                    "Wortschatz und Grammatik menschlicher Sprachen."@de ,
                    "Vocabulario y gramática de los idiomas humanos."@es ,
                    "Vocabulaire et grammaire des langues humaines."@fr ;
    skos:inScheme <> ;
    skos:topConceptOf <> ;
    skos:narrower topic:swedish ,
                  topic:spanish ,
                  topic:latin ,
                  topic:greek ,
                  topic:french ,
                  topic:german ,
                  topic:italian ,
                  topic:finnish ,
                  topic:portuguese ,
                  topic:korean ,
                  topic:japanese ,
                  topic:english ;
    skos:historyNote "Since 1.0." .

