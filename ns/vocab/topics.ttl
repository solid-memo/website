    skos:prefLabel "Linked data"@en ,
                   "Länkade data"@sv ,
                   "링크드 데이터"@ko ;
    skos:definition "Data on the web described with RDF and named and linked by IRIs, and the Solid specifications built on it."@en ,
                    "Data på webben som beskrivs med RDF och namnges och länkas med IRI:er, och Solid-specifikationerna som bygger på det."@sv ,
                    "RDF로 기술되고 IRI로 이름 붙여지고 연결되는 웹의 데이터, 그리고 그 위에 세워진 Solid 사양."@ko ;
    skos:inScheme <> ;
    skos:broader topic:computing ;
    skos:historyNote "Since 1.7." .

