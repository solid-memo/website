@base <https://solid-memo.com/ns/vocab/v1.ttl> .

@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

# The Solid Memo vocabulary. Terms are only ever ADDED within this
# namespace; a term's meaning or range never changes. A breaking change is
# a new namespace (ns/vocab/v2.ttl#), never an edit of this one. Each addition
# bumps owl:versionInfo and appends to the change note; every term says in
# its history note when it arrived.
<>
    a owl:Ontology ;
    dcterms:title "Solid Memo vocabulary, v1" ;
    dcterms:description "Terms for spaced-repetition flashcards stored in a Solid pod: instances, decks, cards, SM-2 review state and study preferences." ;
    owl:versionInfo "1.12" ;
    skos:changeNote "1.0: Instance, Deck, Card, ReviewState, Preferences, formatVersion, cardsDocument, reviewsDocument, front, back, the SM-2 fields and the study caps. 1.1: developerMode. 1.2: the previous* snapshot. 1.3: frontImage, backImage (card format 2). 1.4: cardCount (library index). 1.5: direction (deck format 2). 1.6: the StudyDirections and InvalidDataPolicies concept schemes, studyDirection (deck format 3) and invalidDataPolicy (preferences format 3); direction deprecated. 1.7: deckNewCardsPerDay, deckMaxReviewsPerDay (a deck's own study caps). 1.8: frontNote, backLabel, backNote (card format 3). 1.9: DocumentReceipt and DeckSchedule, the instance digest that lets a visit skip documents that have not changed. 1.10: Answer, the answer log the study statistics are computed from. 1.11: the Themes concept scheme and theme (preferences format 4). 1.12: frontImageDescription, backImageDescription (card format 4, without a version bump)." .

#################### Classes ####################

solid-memo:Instance
    a owl:Class ;
    rdfs:label "Instance" ;
    rdfs:comment "One Solid Memo data location: a container in a pod holding decks, cards, review state and preferences. Described by the container's meta document." ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:Deck
    a owl:Class ;
    rdfs:label "Deck" ;
    rdfs:comment "A named set of cards studied together. In a pod, a subject of the instance's catalog document; in the deck library, the document itself." ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:Card
    a owl:Class ;
    rdfs:label "Card" ;
    rdfs:comment "A flashcard: a front and a back, each text, a picture, or both." ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:ReviewState
    a owl:Class ;
    rdfs:label "Review state" ;
    rdfs:comment "SM-2 scheduling state of one card in one study direction. Its subject is named after the card: #<cardId> for front-to-back, #<cardId>@back-to-front for the other way." ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:Preferences
    a owl:Class ;
    rdfs:label "Preferences" ;
    rdfs:comment "Study preferences of one instance: daily caps, the day boundary, the answer scale and developer mode." ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:DocumentReceipt
    a owl:Class ;
    rdfs:label "Document receipt" ;
    rdfs:comment "What Solid Memo found an instance document to be at one version of it (its ETag): that it conformed to the shapes, that nothing in it was in an older format. A subject of the instance's digest document; derived data, rebuilt whenever it does not hold." ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:DeckSchedule
    a owl:Class ;
    rdfs:label "Deck schedule" ;
    rdfs:comment "How many of a deck's prompts fall due on which study day and how many are still new, computed from given versions of its cards and reviews documents, so the deck list can count today's study without them. A subject of the instance's digest document; derived data, rebuilt whenever it does not hold." ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:Answer
    a owl:Class ;
    rdfs:label "Answer" ;
    rdfs:comment "One grade given to one prompt (a card, studied one way) during study: an entry of the instance's answer log, one document per study month, which the study statistics are computed from. Appended, never edited; resetting a study day removes that day's answers." ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.10." .

#################### Shared ####################

solid-memo:formatVersion
    a owl:DatatypeProperty ;
    rdfs:label "format version" ;
    rdfs:comment "Which version of its class's shape the subject conforms to. Absent means 1, the format that predates the field. Every subject Solid Memo writes carries it." ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

#################### Deck ####################

solid-memo:cardsDocument
    a owl:ObjectProperty ;
    rdfs:label "cards document" ;
    rdfs:comment "The document holding the deck's cards, one sm:Card per hash fragment." ;
    rdfs:domain solid-memo:Deck ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:reviewsDocument
    a owl:ObjectProperty ;
    rdfs:label "reviews document" ;
    rdfs:comment "The document holding the deck's review states, joined to its cards by fragment id." ;
    rdfs:domain solid-memo:Deck ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:direction
    a owl:DatatypeProperty ;
    rdfs:label "direction" ;
    rdfs:comment "How the deck is studied: \"front-to-back\", \"back-to-front\" or \"bidirectional\" (every card asked both ways, each way scheduled on its own). Absent means front-to-back." ;
    rdfs:domain solid-memo:Deck ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.5 for deck format 2; deprecated in 1.6 for studyDirection." ;
    owl:deprecated true ;
    dcterms:isReplacedBy solid-memo:studyDirection .

solid-memo:studyDirection
    a owl:ObjectProperty ;
    rdfs:label "study direction" ;
    rdfs:comment "How the deck is studied: a concept of solid-memo:StudyDirections. Replaces the string-valued direction." ;
    rdfs:domain solid-memo:Deck ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6 for deck format 3." .

solid-memo:cardCount
    a owl:DatatypeProperty ;
    rdfs:label "card count" ;
    rdfs:comment "In the deck library's index only: how many cards a listed deck document holds." ;
    rdfs:domain solid-memo:Deck ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.4 for the library index." .

solid-memo:deckNewCardsPerDay
    a owl:DatatypeProperty ;
    rdfs:label "deck new cards per day" ;
    rdfs:comment "Maximum unseen cards of this deck introduced per study day, in place of the instance's newCardsPerDay. Absent means the instance's." ;
    rdfs:domain solid-memo:Deck ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.7." .

solid-memo:deckMaxReviewsPerDay
    a owl:DatatypeProperty ;
    rdfs:label "deck max reviews per day" ;
    rdfs:comment "Maximum due-card reviews of this deck per study day, in place of the instance's maxReviewsPerDay. Absent means the instance's." ;
    rdfs:domain solid-memo:Deck ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.7." .

#################### Card ####################

solid-memo:front
    a owl:DatatypeProperty ;
    rdfs:label "front" ;
    rdfs:comment "Text on the front of the card." ;
    rdfs:domain solid-memo:Card ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:back
    a owl:DatatypeProperty ;
    rdfs:label "back" ;
    rdfs:comment "Text on the back of the card." ;
    rdfs:domain solid-memo:Card ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:frontImage
    a owl:ObjectProperty ;
    rdfs:label "front image" ;
    rdfs:comment "A picture on the front of the card, shown above any text. Always an IRI, never a string literal." ;
    rdfs:domain solid-memo:Card ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.3 for card format 2." .

solid-memo:backImage
    a owl:ObjectProperty ;
    rdfs:label "back image" ;
    rdfs:comment "A picture on the back of the card, shown above any text. Always an IRI, never a string literal." ;
    rdfs:domain solid-memo:Card ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.3 for card format 2." .

solid-memo:frontImageDescription
    a owl:DatatypeProperty ;
    rdfs:label "front image description" ;
    rdfs:comment "What the front's picture shows, in words: its text alternative for whoever cannot see it. Language-tagged text, one per language. While the front is the question it should not give the answer away." ;
    rdfs:domain solid-memo:Card ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.12, in card format 4 without a version bump: an older reader ignores it." .

solid-memo:backImageDescription
    a owl:DatatypeProperty ;
    rdfs:label "back image description" ;
    rdfs:comment "What the back's picture shows, in words: its text alternative for whoever cannot see it. Language-tagged text, one per language. While the back is the question it should not give the answer away." ;
    rdfs:domain solid-memo:Card ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.12, in card format 4 without a version bump: an older reader ignores it." .

solid-memo:frontNote
    a owl:DatatypeProperty ;
    rdfs:label "front note" ;
    rdfs:comment "A short note under the front's text, smaller, shown once the answer is revealed, so it never gives the answer away: what holds of the front (\"Out of use\"). Language-tagged text in any language, one per language." ;
    rdfs:domain solid-memo:Card ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.8 for card format 3." .

solid-memo:backLabel
    a owl:DatatypeProperty ;
    rdfs:label "back label" ;
    rdfs:comment "A short caption above the back's text that says what kind of answer it is (\"Out of use · replaced by\", \"Capital\", \"Past tense\"), shown whenever the back is, smaller than it. The back's text stays the answer itself. Language-tagged text in any language, one per language." ;
    rdfs:domain solid-memo:Card ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.8 for card format 3." .

solid-memo:backNote
    a owl:DatatypeProperty ;
    rdfs:label "back note" ;
    rdfs:comment "A short note under the back's text, smaller, shown once the answer is revealed: when or why something changed, where it comes from. The back's text stays the answer itself. Language-tagged text in any language, one per language." ;
    rdfs:domain solid-memo:Card ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.8 for card format 3." .

#################### Review state ####################

solid-memo:easeFactor
    a owl:DatatypeProperty ;
    rdfs:label "ease factor" ;
    rdfs:comment "SM-2 easiness factor, never below 1.3." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:intervalDays
    a owl:DatatypeProperty ;
    rdfs:label "interval (days)" ;
    rdfs:comment "Days between the last review and the next due day." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:repetitions
    a owl:DatatypeProperty ;
    rdfs:label "repetitions" ;
    rdfs:comment "Successful reviews in a row." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:due
    a owl:DatatypeProperty ;
    rdfs:label "due" ;
    rdfs:comment "The study day the card becomes due, as a plain \"YYYY-MM-DD\" string: a study day is a calendar label, not an instant, and an xsd:date would risk timezone shifts." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:firstReviewedAt
    a owl:DatatypeProperty ;
    rdfs:label "first reviewed at" ;
    rdfs:comment "When the card was first reviewed in this direction (its introduction)." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:lastReviewedAt
    a owl:DatatypeProperty ;
    rdfs:label "last reviewed at" ;
    rdfs:comment "When the card was most recently reviewed in this direction." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:previousEaseFactor
    a owl:DatatypeProperty ;
    rdfs:label "previous ease factor" ;
    rdfs:comment "Snapshot: the ease factor before the first review of the study day of lastReviewedAt. The five previous* terms are written all together or not at all; resetting the day restores them." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.2 for resetting the study day." .

solid-memo:previousIntervalDays
    a owl:DatatypeProperty ;
    rdfs:label "previous interval (days)" ;
    rdfs:comment "Snapshot: the interval before the first review of the study day." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.2 for resetting the study day." .

solid-memo:previousRepetitions
    a owl:DatatypeProperty ;
    rdfs:label "previous repetitions" ;
    rdfs:comment "Snapshot: the repetition count before the first review of the study day." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.2 for resetting the study day." .

solid-memo:previousDue
    a owl:DatatypeProperty ;
    rdfs:label "previous due" ;
    rdfs:comment "Snapshot: the due day before the first review of the study day." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.2 for resetting the study day." .

solid-memo:previousLastReviewedAt
    a owl:DatatypeProperty ;
    rdfs:label "previous last reviewed at" ;
    rdfs:comment "Snapshot: lastReviewedAt before the first review of the study day." ;
    rdfs:domain solid-memo:ReviewState ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.2 for resetting the study day." .

#################### Preferences ####################

solid-memo:newCardsPerDay
    a owl:DatatypeProperty ;
    rdfs:label "new cards per day" ;
    rdfs:comment "Maximum unseen cards introduced per study day." ;
    rdfs:domain solid-memo:Preferences ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:maxReviewsPerDay
    a owl:DatatypeProperty ;
    rdfs:label "max reviews per day" ;
    rdfs:comment "Maximum due-card reviews per study day." ;
    rdfs:domain solid-memo:Preferences ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:dayBoundaryHour
    a owl:DatatypeProperty ;
    rdfs:label "day boundary hour" ;
    rdfs:comment "Local hour (0-23) at which the study day rolls over: with 4, reviewing at 03:00 still counts as the previous day." ;
    rdfs:domain solid-memo:Preferences ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:answerScale
    a owl:DatatypeProperty ;
    rdfs:label "answer scale" ;
    rdfs:comment "Which grading buttons a study session shows: \"sm2\" (the six SM-2 grades) or \"minimal\"." ;
    rdfs:domain solid-memo:Preferences ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Since 1.0." .

solid-memo:developerMode
    a owl:DatatypeProperty ;
    rdfs:label "developer mode" ;
    rdfs:comment "Whether the instance shows developer tools (the raw WebID document, shape validation). Absent means off." ;
    rdfs:domain solid-memo:Preferences ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.1." .

solid-memo:invalidDataPolicy
    a owl:ObjectProperty ;
    rdfs:label "invalid data policy" ;
    rdfs:comment "What the app does when data in the instance does not conform to its shapes: a concept of solid-memo:InvalidDataPolicies." ;
    rdfs:domain solid-memo:Preferences ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6 for preferences format 3." .

solid-memo:theme
    a owl:ObjectProperty ;
    rdfs:label "theme" ;
    rdfs:comment "Whether the app is shown light, dark, or as the browser prefers: a concept of solid-memo:Themes." ;
    rdfs:domain solid-memo:Preferences ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.11 for preferences format 4." .

#################### Digest ####################

solid-memo:receiptOf
    a owl:ObjectProperty ;
    rdfs:label "receipt of" ;
    rdfs:comment "The document a receipt is about." ;
    rdfs:domain solid-memo:DocumentReceipt ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:documentVersion
    a owl:DatatypeProperty ;
    rdfs:label "document version" ;
    rdfs:comment "The version of the document a receipt is about: its ETag, as the pod gave it." ;
    rdfs:domain solid-memo:DocumentReceipt ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:conformedTo
    a owl:DatatypeProperty ;
    rdfs:label "conformed to" ;
    rdfs:comment "At that version the document conformed to Solid Memo's shapes; the value names the rules (a hash of the shapes) it was checked by." ;
    rdfs:domain solid-memo:DocumentReceipt ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:latestFormat
    a owl:DatatypeProperty ;
    rdfs:label "latest format" ;
    rdfs:comment "True when, at that version, nothing in the document was in an older format than the app that wrote the receipt knew." ;
    rdfs:domain solid-memo:DocumentReceipt ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:scheduleOf
    a owl:ObjectProperty ;
    rdfs:label "schedule of" ;
    rdfs:comment "The deck a schedule is about." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range solid-memo:Deck ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:cardsVersion
    a owl:DatatypeProperty ;
    rdfs:label "cards version" ;
    rdfs:comment "The version (ETag) of the deck's cards document the schedule was computed from." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:reviewsVersion
    a owl:DatatypeProperty ;
    rdfs:label "reviews version" ;
    rdfs:comment "The version (ETag) of the deck's reviews document the schedule was computed from; \"absent\" when there was none." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:scheduledDirection
    a owl:ObjectProperty ;
    rdfs:label "scheduled direction" ;
    rdfs:comment "The study direction the schedule was computed for: a concept of solid-memo:StudyDirections." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:scheduledDayBoundaryHour
    a owl:DatatypeProperty ;
    rdfs:label "scheduled day boundary hour" ;
    rdfs:comment "The day boundary hour the schedule's study days were counted with." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:scheduledOn
    a owl:DatatypeProperty ;
    rdfs:label "scheduled on" ;
    rdfs:comment "The study day (\"YYYY-MM-DD\") the schedule was computed on." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:dueOnDay
    a owl:DatatypeProperty ;
    rdfs:label "due on day" ;
    rdfs:comment "How many reviewed prompts fall due on one study day, as \"YYYY-MM-DD count\"; one value per day." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:unreviewedCount
    a owl:DatatypeProperty ;
    rdfs:label "unreviewed count" ;
    rdfs:comment "How many of the deck's prompts (cards in use, in each direction studied) were never reviewed." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:reviewedOnDayCount
    a owl:DatatypeProperty ;
    rdfs:label "reviewed on day count" ;
    rdfs:comment "How many reviews were made on the study day the schedule was computed on." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

solid-memo:introducedOnDayCount
    a owl:DatatypeProperty ;
    rdfs:label "introduced on day count" ;
    rdfs:comment "How many prompts were first reviewed on the study day the schedule was computed on." ;
    rdfs:domain solid-memo:DeckSchedule ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.9." .

#################### Answer log ####################

solid-memo:answeredDeck
    a owl:ObjectProperty ;
    rdfs:label "answered deck" ;
    rdfs:comment "The deck the answer was given in: its catalog entry, which may since have been removed." ;
    rdfs:domain solid-memo:Answer ;
    rdfs:range solid-memo:Deck ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.10." .

solid-memo:answeredCard
    a owl:ObjectProperty ;
    rdfs:label "answered card" ;
    rdfs:comment "The card the answer was given to, which may since have been removed." ;
    rdfs:domain solid-memo:Answer ;
    rdfs:range solid-memo:Card ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.10." .

solid-memo:answeredDirection
    a owl:ObjectProperty ;
    rdfs:label "answered direction" ;
    rdfs:comment "The way the card was asked: a concept of solid-memo:StudyDirections." ;
    rdfs:domain solid-memo:Answer ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.10." .

solid-memo:grade
    a owl:DatatypeProperty ;
    rdfs:label "grade" ;
    rdfs:comment "The SM-2 quality of the answer, 0 to 5, whichever answer scale gave it; below 3 means the card was forgotten." ;
    rdfs:domain solid-memo:Answer ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.10." .

solid-memo:answeredAt
    a owl:DatatypeProperty ;
    rdfs:label "answered at" ;
    rdfs:comment "When the answer was given." ;
    rdfs:domain solid-memo:Answer ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.10." .

solid-memo:answeredOn
    a owl:DatatypeProperty ;
    rdfs:label "answered on" ;
    rdfs:comment "The study day the answer counts towards, as a plain \"YYYY-MM-DD\" string, fixed when it was given, so a later change of the day boundary does not move it." ;
    rdfs:domain solid-memo:Answer ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.10." .

solid-memo:priorIntervalDays
    a owl:DatatypeProperty ;
    rdfs:label "prior interval (days)" ;
    rdfs:comment "The prompt's interval before the answer; absent on a prompt's first answer, which introduced it." ;
    rdfs:domain solid-memo:Answer ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.10." .

solid-memo:nextIntervalDays
    a owl:DatatypeProperty ;
    rdfs:label "next interval (days)" ;
    rdfs:comment "The prompt's interval after the answer: the days until it is due again." ;
    rdfs:domain solid-memo:Answer ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.10." .

#################### Concept schemes ####################

solid-memo:StudyDirections
    a skos:ConceptScheme ;
    dcterms:title "Study directions"@en ;
    skos:definition "The ways a deck can be studied."@en ;
    skos:hasTopConcept solid-memo:frontToBack ,
                       solid-memo:backToFront ,
                       solid-memo:bidirectional ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6." .

solid-memo:frontToBack
    a skos:Concept ;
    skos:prefLabel "Front to back"@en ;
    skos:definition "Each card is shown by its front and answered with its back."@en ;
    skos:notation "front-to-back" ;
    skos:inScheme solid-memo:StudyDirections ;
    skos:topConceptOf solid-memo:StudyDirections ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6." .

solid-memo:backToFront
    a skos:Concept ;
    skos:prefLabel "Back to front"@en ;
    skos:definition "Each card is shown by its back and answered with its front."@en ;
    skos:notation "back-to-front" ;
    skos:inScheme solid-memo:StudyDirections ;
    skos:topConceptOf solid-memo:StudyDirections ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6." .

solid-memo:bidirectional
    a skos:Concept ;
    skos:prefLabel "Both ways"@en ;
    skos:definition "Each card is asked both ways, each way scheduled on its own."@en ;
    skos:notation "bidirectional" ;
    skos:inScheme solid-memo:StudyDirections ;
    skos:topConceptOf solid-memo:StudyDirections ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6." .

solid-memo:InvalidDataPolicies
    a skos:ConceptScheme ;
    dcterms:title "Invalid data policies"@en ;
    skos:definition "What the app does when data in an instance does not conform to its shapes."@en ;
    skos:hasTopConcept solid-memo:blockInstance ,
                       solid-memo:blockSubject ,
                       solid-memo:warnOnly ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6." .

solid-memo:blockInstance
    a skos:Concept ;
    skos:prefLabel "Block the instance"@en ;
    skos:definition "Any invalid data stops the app from using the instance until it is repaired. The default."@en ;
    skos:notation "block-instance" ;
    skos:inScheme solid-memo:InvalidDataPolicies ;
    skos:topConceptOf solid-memo:InvalidDataPolicies ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6." .

solid-memo:blockSubject
    a skos:Concept ;
    skos:prefLabel "Set invalid data aside"@en ;
    skos:definition "Decks with invalid data are set aside until they are repaired; everything else keeps working."@en ;
    skos:notation "block-subject" ;
    skos:inScheme solid-memo:InvalidDataPolicies ;
    skos:topConceptOf solid-memo:InvalidDataPolicies ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6." .

solid-memo:warnOnly
    a skos:Concept ;
    skos:prefLabel "Warn only"@en ;
    skos:definition "Invalid data is reported, and the app keeps working with it."@en ;
    skos:notation "warn-only" ;
    skos:inScheme solid-memo:InvalidDataPolicies ;
    skos:topConceptOf solid-memo:InvalidDataPolicies ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.6." .

solid-memo:Themes
    a skos:ConceptScheme ;
    dcterms:title "Themes"@en ;
    skos:definition "How the app is shown: light, dark, or as the browser prefers."@en ;
    skos:hasTopConcept solid-memo:systemTheme ,
                       solid-memo:lightTheme ,
                       solid-memo:darkTheme ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.11." .

solid-memo:systemTheme
    a skos:Concept ;
    skos:prefLabel "As the browser prefers"@en ;
    skos:definition "The app is light or dark as the browser or operating system prefers, following it when it changes. The default."@en ;
    skos:notation "system" ;
    skos:inScheme solid-memo:Themes ;
    skos:topConceptOf solid-memo:Themes ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.11." .

solid-memo:lightTheme
    a skos:Concept ;
    skos:prefLabel "Light"@en ;
    skos:definition "The app is shown light, whatever the browser prefers."@en ;
    skos:notation "light" ;
    skos:inScheme solid-memo:Themes ;
    skos:topConceptOf solid-memo:Themes ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.11." .

solid-memo:darkTheme
    a skos:Concept ;
    skos:prefLabel "Dark"@en ;
    skos:definition "The app is shown dark, whatever the browser prefers."@en ;
    skos:notation "dark" ;
    skos:inScheme solid-memo:Themes ;
    skos:topConceptOf solid-memo:Themes ;
    rdfs:isDefinedBy <> ;
    skos:historyNote "Added in 1.11." .
