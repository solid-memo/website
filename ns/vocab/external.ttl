@base <https://solid-memo.com/ns/vocab/external.ttl> .

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# The external terms Solid Memo data points at, described just enough for
# validation: a profile's sh:class checks (DCAT-AP) look for a value's
# type in the data graph, so this document is loaded next to the data
# being checked (see docs/validation.md). The EU entries are extracts of
# the Publications Office authority tables, which are the authority for
# their labels; only the terms Solid Memo uses are listed. Add a term
# here before data uses it.
<http://publications.europa.eu/resource/authority/data-theme>
    a skos:ConceptScheme ;
    dcterms:title "Data theme"@en .

<http://publications.europa.eu/resource/authority/data-theme/EDUC>
    a skos:Concept ;
    skos:prefLabel "Education, culture and sport"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/data-theme> .

<http://publications.europa.eu/resource/authority/language>
    a skos:ConceptScheme ;
    dcterms:title "Language"@en .

<http://publications.europa.eu/resource/authority/language/ENG>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "English"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/SWE>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "Swedish"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/SPA>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "Spanish"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/LAT>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "Latin"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/ITA>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "Italian"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/ELL>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "Modern Greek"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/FRA>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "French"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/DEU>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "German"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/FIN>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "Finnish"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/POR>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "Portuguese"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/JPN>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "Japanese"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/language/KOR>
    a skos:Concept ,
      dcterms:LinguisticSystem ;
    skos:prefLabel "Korean"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/language> .

<http://publications.europa.eu/resource/authority/file-type>
    a skos:ConceptScheme ;
    dcterms:title "File type"@en .

<http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE>
    a skos:Concept ,
      dcterms:MediaTypeOrExtent ;
    skos:prefLabel "RDF Turtle"@en ;
    skos:inScheme <http://publications.europa.eu/resource/authority/file-type> .

<https://www.iana.org/assignments/media-types/text/turtle>
    a dcterms:MediaType ;
    rdfs:label "text/turtle" .

<https://www.iana.org/assignments/media-types/text/markdown>
    a dcterms:MediaType ;
    rdfs:label "text/markdown" .
