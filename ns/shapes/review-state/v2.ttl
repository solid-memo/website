@base <https://solid-memo.com/ns/shapes/review-state/v2.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# Review-state format 2: the same fields as format 1, now with the format
# version stated, the previous* snapshot written all together or not at
# all, and the per-direction subject naming (#<cardId> for front-to-back,
# #<cardId>@back-to-front for the other way) part of the contract. Since
# vocabulary 1.16, without a format bump, a state may name its card
# (solid-memo:reviewOf), its direction (solid-memo:reviewDirection) and its
# scheduler (solid-memo:scheduler); a state that names its card may have
# any subject.
<#shape>
    a sh:NodeShape ;
    sh:name "ReviewStateV2" ;
    rdfs:comment "Review-state format 2: SM-2 fields, an all-or-nothing previous* snapshot, per-direction subjects; the card, direction and scheduler may be named (since vocabulary 1.16, without a format bump), and a state that names its card may have any subject." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:ReviewState ;
    sh:or ( [ sh:pattern "#[^#@]+(@back-to-front)?$" ] [ sh:path solid-memo:reviewOf ; sh:minCount 1 ] ) ;
    sh:xone ( <#noSnapshot> <#fullSnapshot> ) ;
    sh:message "A review state names its card with solid-memo:reviewOf or is named #<cardId> or #<cardId>@back-to-front, and its previous* snapshot is all five triples or none."@en ,
               "Ett repetitionstillstånd anger sitt kort med solid-memo:reviewOf eller heter #<cardId> eller #<cardId>@back-to-front, och dess ögonblicksbild previous* består av alla fem trippler eller ingen."@sv ;
    sh:property <#formatVersion> ,
                <#easeFactor> ,
                <#intervalDays> ,
                <#repetitions> ,
                <#due> ,
                <#firstReviewedAt> ,
                <#lastReviewedAt> ,
                <#previousEaseFactor> ,
                <#previousIntervalDays> ,
                <#previousRepetitions> ,
                <#previousDue> ,
                <#previousLastReviewedAt> ,
                <#reviewOf> ,
                <#reviewDirection> ,
                <#scheduler> .

# The snapshot is all five previous* triples or none of them: a partial
# snapshot could only restore a state that never existed.
<#noSnapshot>
    a sh:NodeShape ;
    sh:property [ sh:path solid-memo:previousEaseFactor ; sh:maxCount 0 ] ,
                [ sh:path solid-memo:previousIntervalDays ; sh:maxCount 0 ] ,
                [ sh:path solid-memo:previousRepetitions ; sh:maxCount 0 ] ,
                [ sh:path solid-memo:previousDue ; sh:maxCount 0 ] ,
                [ sh:path solid-memo:previousLastReviewedAt ; sh:maxCount 0 ] .

<#fullSnapshot>
    a sh:NodeShape ;
    sh:property [ sh:path solid-memo:previousEaseFactor ; sh:minCount 1 ] ,
                [ sh:path solid-memo:previousIntervalDays ; sh:minCount 1 ] ,
                [ sh:path solid-memo:previousRepetitions ; sh:minCount 1 ] ,
                [ sh:path solid-memo:previousDue ; sh:minCount 1 ] ,
                [ sh:path solid-memo:previousLastReviewedAt ; sh:minCount 1 ] .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 2 ;
    sh:message "Review-state format 2 states its format version, 2."@en ,
               "Format 2 för repetitionstillstånd anger sin formatversion, 2."@sv .

<#easeFactor>
    a sh:PropertyShape ;
    sh:path solid-memo:easeFactor ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#intervalDays>
    a sh:PropertyShape ;
    sh:path solid-memo:intervalDays ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#repetitions>
    a sh:PropertyShape ;
    sh:path solid-memo:repetitions ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#due>
    a sh:PropertyShape ;
    sh:path solid-memo:due ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
    sh:message "The due day is a plain \"YYYY-MM-DD\" string."@en ,
               "Förfallodagen är en vanlig sträng \"YYYY-MM-DD\"."@sv .

<#firstReviewedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:firstReviewedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#lastReviewedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:lastReviewedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#previousEaseFactor>
    a sh:PropertyShape ;
    sh:path solid-memo:previousEaseFactor ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 .

<#previousIntervalDays>
    a sh:PropertyShape ;
    sh:path solid-memo:previousIntervalDays ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 .

<#previousRepetitions>
    a sh:PropertyShape ;
    sh:path solid-memo:previousRepetitions ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 .

<#previousDue>
    a sh:PropertyShape ;
    sh:path solid-memo:previousDue ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
    sh:message "The previous due day is a plain \"YYYY-MM-DD\" string."@en ,
               "Den föregående förfallodagen är en vanlig sträng \"YYYY-MM-DD\"."@sv .

<#previousLastReviewedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:previousLastReviewedAt ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .

<#reviewOf>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewOf ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A review state names at most one card, an IRI (<…#cardId>), never a string literal."@en ,
               "Ett repetitionstillstånd anger högst ett kort, en IRI (<…#cardId>), aldrig en strängliteral."@sv .

<#reviewDirection>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewDirection ;
    sh:name "direction" ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:frontToBack solid-memo:backToFront ) ;
    sh:message "A review state's direction is at most one of solid-memo:frontToBack or solid-memo:backToFront."@en ,
               "Ett repetitionstillstånds riktning är högst en av solid-memo:frontToBack och solid-memo:backToFront."@sv .

# No sh:in: a scheduler this app does not know is read and kept, never a
# violation; the app leaves such a state alone (see docs/data-model.md).
<#scheduler>
    a sh:PropertyShape ;
    sh:path solid-memo:scheduler ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A review state's scheduler is at most one IRI, a concept of solid-memo:Schedulers."@en ,
               "Ett repetitionstillstånds schemaläggare är högst en IRI, ett begrepp i solid-memo:Schedulers."@sv .
