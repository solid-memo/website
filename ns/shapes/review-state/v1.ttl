@base <https://solid-memo.com/ns/shapes/review-state/v1.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# Review-state format 1: the SM-2 fields of one card in one direction.
# The direction is not a triple: it is in the subject's name, #<cardId>
# for front-to-back and #<cardId>@back-to-front for the other way. States
# written before the format was versioned may already carry the previous*
# snapshot, so format 1 admits it.
<#shape>
    a sh:NodeShape ;
    sh:name "ReviewStateV1" ;
    rdfs:comment "Review-state format 1: the SM-2 fields; the previous* snapshot is admitted." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:ReviewState ;
    sh:pattern "#[^#@]+(@back-to-front)?$" ;
    sh:property <#formatVersion> ,
                <#easeFactor> ,
                <#intervalDays> ,
                <#repetitions> ,
                <#due> ,
                <#firstReviewedAt> ,
                <#lastReviewedAt> ,
                <#previousEaseFactor> ,
                <#previousIntervalDays> ,
                <#previousRepetitions> ,
                <#previousDue> ,
                <#previousLastReviewedAt> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:in ( 1 ) ;
    sh:message "Review-state format 1 states no format version, or 1."@en ,
               "Format 1 för repetitionstillstånd anger ingen formatversion, eller 1."@sv .

<#easeFactor>
    a sh:PropertyShape ;
    sh:path solid-memo:easeFactor ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#intervalDays>
    a sh:PropertyShape ;
    sh:path solid-memo:intervalDays ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#repetitions>
    a sh:PropertyShape ;
    sh:path solid-memo:repetitions ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#due>
    a sh:PropertyShape ;
    sh:path solid-memo:due ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
    sh:message "The due day is a plain \"YYYY-MM-DD\" string."@en ,
               "Förfallodagen är en vanlig sträng \"YYYY-MM-DD\"."@sv .

<#firstReviewedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:firstReviewedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#lastReviewedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:lastReviewedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#previousEaseFactor>
    a sh:PropertyShape ;
    sh:path solid-memo:previousEaseFactor ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 .

<#previousIntervalDays>
    a sh:PropertyShape ;
    sh:path solid-memo:previousIntervalDays ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 .

<#previousRepetitions>
    a sh:PropertyShape ;
    sh:path solid-memo:previousRepetitions ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 .

<#previousDue>
    a sh:PropertyShape ;
    sh:path solid-memo:previousDue ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
    sh:message "The previous due day is a plain \"YYYY-MM-DD\" string."@en ,
               "Den föregående förfallodagen är en vanlig sträng \"YYYY-MM-DD\"."@sv .

<#previousLastReviewedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:previousLastReviewedAt ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .
