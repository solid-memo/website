@base <https://solid-memo.com/ns/shapes/instance/v1.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# Instance format 1: the meta document of an instance container.
<#shape>
    a sh:NodeShape ;
    sh:name "InstanceV1" ;
    rdfs:comment "Instance format 1: a title and a creation time." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Instance ;
    sh:property <#formatVersion> ,
                <#title> ,
                <#created> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:in ( 1 ) ;
    sh:message "Instance format 1 states no format version, or 1."@en ,
               "Instansformat 1 anger ingen formatversion, eller 1."@sv .

<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#created>
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .
