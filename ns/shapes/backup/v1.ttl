@base <https://solid-memo.com/ns/shapes/backup/v1.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# A backup, format 1: the subject #it of a backup's manifest, in the
# instance's backups/ folder: what an update saved before it changed
# documents in place, and what it was made for.
<#shape>
    a sh:NodeShape ;
    sh:name "BackupV1" ;
    rdfs:comment "Backup format 1: what it was made for (the instance or a deck), when it was made, and for a deck the library release it came from." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Backup ;
    sh:property <#formatVersion> ,
                <#backupOf> ,
                <#created> ,
                <#release> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:in ( 1 ) .

<#backupOf>
    a sh:PropertyShape ;
    sh:path solid-memo:backupOf ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#created>
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#release>
    a sh:PropertyShape ;
    sh:path solid-memo:releaseBackedUp ;
    sh:name "release" ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 .
