@base <https://solid-memo.com/ns/shapes/card/v5.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .

# Card format 5: card format 4, and a note or label is language-tagged text in any language, one per language; English is no longer required.
<#shape>
    a sh:NodeShape ;
    sh:name "CardV5" ;
    rdfs:comment "Card format 5: each side has text, a picture or both (a picture is always an IRI); a side's text is untagged, its language unknown, or language-tagged, one text per language; a side's picture may have a description, its text alternative, language-tagged text, one per language; each side may have a note under it, shown once the answer is revealed, and the back a label above it that says how the answer relates to the front, all three language-tagged text in any language, one per language; a retired card, which is kept but no longer studied, states owl:deprecated true; a card asked as a multiple-choice question names its wrong options, distractors of the same document (since vocabulary 1.14, without a format bump)." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Card ;
    sh:property <#formatVersion> ,
                <#front> ,
                <#back> ,
                <#frontImage> ,
                <#backImage> ,
                <#frontImageDescription> ,
                <#backImageDescription> ,
                <#frontNote> ,
                <#backLabel> ,
                <#backNote> ,
                <#created> ,
                <#deprecated> ,
                <#distractor> ;
    sh:or ( [ sh:path solid-memo:front ; sh:minCount 1 ] [ sh:path solid-memo:frontImage ; sh:minCount 1 ] ) ,
          ( [ sh:path solid-memo:back ; sh:minCount 1 ] [ sh:path solid-memo:backImage ; sh:minCount 1 ] ) ,
          ( [ sh:path solid-memo:front ; sh:qualifiedValueShape <#untagged> ; sh:qualifiedMaxCount 0 ] [ sh:path solid-memo:front ; sh:qualifiedValueShape <#tagged> ; sh:qualifiedMaxCount 0 ] ) ,
          ( [ sh:path solid-memo:back ; sh:qualifiedValueShape <#untagged> ; sh:qualifiedMaxCount 0 ] [ sh:path solid-memo:back ; sh:qualifiedValueShape <#tagged> ; sh:qualifiedMaxCount 0 ] ) ;
    sh:message "Each side of a card needs text or a picture, its text either untagged or language-tagged, never both."@en ,
               "Varje sida av ett kort behöver text eller en bild, med texten antingen otaggad eller språktaggad, aldrig båda."@sv .

<#untagged>
    a sh:NodeShape ;
    sh:datatype xsd:string .

<#tagged>
    a sh:NodeShape ;
    sh:datatype rdf:langString .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 5 ;
    sh:message "Card format 5 states its format version, 5."@en ,
               "Kortformat 5 anger sin formatversion, 5."@sv .

<#front>
    a sh:PropertyShape ;
    sh:path solid-memo:front ;
    sh:or ( <#untagged> <#tagged> ) ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape <#untagged> ;
    sh:qualifiedMaxCount 1 ;
    sh:message "A side's text is one untagged text (\"…\"), or language-tagged text, one per language (\"…\"@en)."@en ,
               "En sidas text är en otaggad text (\"…\") eller språktaggad text, en per språk (\"…\"@en)."@sv .

<#back>
    a sh:PropertyShape ;
    sh:path solid-memo:back ;
    sh:or ( <#untagged> <#tagged> ) ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape <#untagged> ;
    sh:qualifiedMaxCount 1 ;
    sh:message "A side's text is one untagged text (\"…\"), or language-tagged text, one per language (\"…\"@en)."@en ,
               "En sidas text är en otaggad text (\"…\") eller språktaggad text, en per språk (\"…\"@en)."@sv .

<#frontImage>
    a sh:PropertyShape ;
    sh:path solid-memo:frontImage ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A picture is an IRI (<https://…>), never a string literal."@en ,
               "En bild är en IRI (<https://…>), aldrig en strängliteral."@sv .

<#backImage>
    a sh:PropertyShape ;
    sh:path solid-memo:backImage ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A picture is an IRI (<https://…>), never a string literal."@en ,
               "En bild är en IRI (<https://…>), aldrig en strängliteral."@sv .

<#frontImageDescription>
    a sh:PropertyShape ;
    sh:path solid-memo:frontImageDescription ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:message "A picture's description is language-tagged text, one per language (\"…\"@en)."@en ,
               "En bildbeskrivning är språktaggad text, en per språk (\"…\"@en)."@sv .

<#backImageDescription>
    a sh:PropertyShape ;
    sh:path solid-memo:backImageDescription ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:message "A picture's description is language-tagged text, one per language (\"…\"@en)."@en ,
               "En bildbeskrivning är språktaggad text, en per språk (\"…\"@en)."@sv .

<#frontNote>
    a sh:PropertyShape ;
    sh:path solid-memo:frontNote ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:message "A note under the front is language-tagged text in any language, one per language (\"…\"@sv)."@en ,
               "En anteckning under framsidan är språktaggad text på valfritt språk, en per språk (\"…\"@sv)."@sv .

<#backLabel>
    a sh:PropertyShape ;
    sh:path solid-memo:backLabel ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:message "A label above the back is language-tagged text in any language, one per language (\"…\"@sv)."@en ,
               "En etikett ovanför baksidan är språktaggad text på valfritt språk, en per språk (\"…\"@sv)."@sv .

<#backNote>
    a sh:PropertyShape ;
    sh:path solid-memo:backNote ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:message "A note under the back is language-tagged text in any language, one per language (\"…\"@sv)."@en ,
               "En anteckning under baksidan är språktaggad text på valfritt språk, en per språk (\"…\"@sv)."@sv .

<#created>
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .

<#deprecated>
    a sh:PropertyShape ;
    sh:path owl:deprecated ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:message "A retired card states owl:deprecated true, a boolean."@en ,
               "Ett kort som tagits ur bruk anger owl:deprecated true, ett booleskt värde."@sv .

<#distractor>
    a sh:PropertyShape ;
    sh:path solid-memo:distractor ;
    sh:nodeKind sh:IRI ;
    sh:message "A card's distractors, its wrong options, are IRIs (<#…>) of solid-memo:Distractor subjects, never string literals."@en ,
               "Ett korts distraktorer, dess felaktiga alternativ, är IRI:er (<#…>) till solid-memo:Distractor-subjekt, aldrig strängliteraler."@sv .
