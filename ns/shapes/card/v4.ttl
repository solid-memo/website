@base <https://solid-memo.com/ns/shapes/card/v4.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .

# Card format 4: card format 3, and a side's text may be language-tagged, one text per language ("Mona Lisa"@en), or untagged when its language is not known, never both.
<#shape>
    a sh:NodeShape ;
    sh:name "CardV4" ;
    rdfs:comment "Card format 4: each side has text, a picture or both (a picture is always an IRI); a side's text is untagged, its language unknown, or language-tagged, one text per language; a side's picture may have a description, its text alternative, language-tagged text, one per language (added without a version bump: an older reader ignores it); each side may have a note under it, shown once the answer is revealed, and the back a label above it that says how the answer relates to the front, all three language-tagged text with an English value; a retired card, which is kept but no longer studied, states owl:deprecated true." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Card ;
    sh:property <#formatVersion> ,
                <#front> ,
                <#back> ,
                <#frontImage> ,
                <#backImage> ,
                <#frontImageDescription> ,
                <#backImageDescription> ,
                <#frontNote> ,
                <#backLabel> ,
                <#backNote> ,
                <#created> ,
                <#deprecated> ;
    sh:or ( [ sh:path solid-memo:front ; sh:minCount 1 ] [ sh:path solid-memo:frontImage ; sh:minCount 1 ] ) ,
          ( [ sh:path solid-memo:back ; sh:minCount 1 ] [ sh:path solid-memo:backImage ; sh:minCount 1 ] ) ,
          ( [ sh:path solid-memo:frontNote ; sh:maxCount 0 ] [ sh:path solid-memo:frontNote ; sh:qualifiedValueShape <#english> ; sh:qualifiedMinCount 1 ] ) ,
          ( [ sh:path solid-memo:backLabel ; sh:maxCount 0 ] [ sh:path solid-memo:backLabel ; sh:qualifiedValueShape <#english> ; sh:qualifiedMinCount 1 ] ) ,
          ( [ sh:path solid-memo:backNote ; sh:maxCount 0 ] [ sh:path solid-memo:backNote ; sh:qualifiedValueShape <#english> ; sh:qualifiedMinCount 1 ] ) ,
          ( [ sh:path solid-memo:front ; sh:qualifiedValueShape <#untagged> ; sh:qualifiedMaxCount 0 ] [ sh:path solid-memo:front ; sh:qualifiedValueShape <#tagged> ; sh:qualifiedMaxCount 0 ] ) ,
          ( [ sh:path solid-memo:back ; sh:qualifiedValueShape <#untagged> ; sh:qualifiedMaxCount 0 ] [ sh:path solid-memo:back ; sh:qualifiedValueShape <#tagged> ; sh:qualifiedMaxCount 0 ] ) ;
    sh:message "Each side of a card needs text or a picture, its text either untagged or language-tagged, never both, and a note or label, when there is one, an English text (\"…\"@en)."@en ,
               "Varje sida av ett kort behöver text eller en bild, med texten antingen otaggad eller språktaggad, aldrig båda, och en anteckning eller etikett, när det finns en, en engelsk text (\"…\"@en)."@sv .

<#english>
    a sh:NodeShape ;
    sh:languageIn ( "en" ) .

<#untagged>
    a sh:NodeShape ;
    sh:datatype xsd:string .

<#tagged>
    a sh:NodeShape ;
    sh:datatype rdf:langString .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 4 ;
    sh:message "Card format 4 states its format version, 4."@en ,
               "Kortformat 4 anger sin formatversion, 4."@sv .

<#front>
    a sh:PropertyShape ;
    sh:path solid-memo:front ;
    sh:or ( <#untagged> <#tagged> ) ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape <#untagged> ;
    sh:qualifiedMaxCount 1 ;
    sh:message "A side's text is one untagged text (\"…\"), or language-tagged text, one per language (\"…\"@en)."@en ,
               "En sidas text är en otaggad text (\"…\") eller språktaggad text, en per språk (\"…\"@en)."@sv .

<#back>
    a sh:PropertyShape ;
    sh:path solid-memo:back ;
    sh:or ( <#untagged> <#tagged> ) ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape <#untagged> ;
    sh:qualifiedMaxCount 1 ;
    sh:message "A side's text is one untagged text (\"…\"), or language-tagged text, one per language (\"…\"@en)."@en ,
               "En sidas text är en otaggad text (\"…\") eller språktaggad text, en per språk (\"…\"@en)."@sv .

<#frontImage>
    a sh:PropertyShape ;
    sh:path solid-memo:frontImage ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A picture is an IRI (<https://…>), never a string literal."@en ,
               "En bild är en IRI (<https://…>), aldrig en strängliteral."@sv .

<#backImage>
    a sh:PropertyShape ;
    sh:path solid-memo:backImage ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A picture is an IRI (<https://…>), never a string literal."@en ,
               "En bild är en IRI (<https://…>), aldrig en strängliteral."@sv .

<#frontImageDescription>
    a sh:PropertyShape ;
    sh:path solid-memo:frontImageDescription ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:message "A picture's description is language-tagged text, one per language (\"…\"@en)."@en ,
               "En bildbeskrivning är språktaggad text, en per språk (\"…\"@en)."@sv .

<#backImageDescription>
    a sh:PropertyShape ;
    sh:path solid-memo:backImageDescription ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:message "A picture's description is language-tagged text, one per language (\"…\"@en)."@en ,
               "En bildbeskrivning är språktaggad text, en per språk (\"…\"@en)."@sv .

<#frontNote>
    a sh:PropertyShape ;
    sh:path solid-memo:frontNote ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape <#english> ;
    sh:qualifiedMaxCount 1 ;
    sh:message "A note under the front is language-tagged text, one per language, and one of them English (\"…\"@en)."@en ,
               "En anteckning under framsidan är språktaggad text, en per språk, och en av dem på engelska (\"…\"@en)."@sv .

<#backLabel>
    a sh:PropertyShape ;
    sh:path solid-memo:backLabel ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape <#english> ;
    sh:qualifiedMaxCount 1 ;
    sh:message "A label above the back is language-tagged text, one per language, and one of them English (\"…\"@en)."@en ,
               "En etikett ovanför baksidan är språktaggad text, en per språk, och en av dem på engelska (\"…\"@en)."@sv .

<#backNote>
    a sh:PropertyShape ;
    sh:path solid-memo:backNote ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape <#english> ;
    sh:qualifiedMaxCount 1 ;
    sh:message "A note under the back is language-tagged text, one per language, and one of them English (\"…\"@en)."@en ,
               "En anteckning under baksidan är språktaggad text, en per språk, och en av dem på engelska (\"…\"@en)."@sv .

<#created>
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .

<#deprecated>
    a sh:PropertyShape ;
    sh:path owl:deprecated ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:message "A retired card states owl:deprecated true, a boolean."@en ,
               "Ett kort som tagits ur bruk anger owl:deprecated true, ett booleskt värde."@sv .
