@base <https://solid-memo.com/ns/shapes/deck/v5.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .
@prefix adms:       <http://www.w3.org/ns/adms#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .

# Deck format 5: deck format 4, and a title and description are
# language-tagged text in any language, one per language; English is no
# longer required. A deck's text is in the language its maker says it is
# in, so a deck titled only in Swedish or Japanese is a whole deck. A
# format-4 reader requires an English title and description and would
# flag such a deck as invalid, hence the new version.
#
# As in format 4, a deck is a DCAT dataset. It states its study direction
# as a SKOS concept (solid-memo:studyDirection), names its creators as
# foaf:Agent nodes of the same document, and names what it was drawn from
# with prov:wasDerivedFrom: in a pod, the library release it was imported
# from. Topics (dcat:theme) and keywords are optional. A deck may set its
# own study caps. Library releases stay at format 4 (LibraryDeckV4):
# English first is the library's curation policy.
<#inPod>
    a sh:NodeShape ;
    sh:name "DeckV5" ;
    rdfs:comment "Deck format 5 as a catalog entry in a pod: a dcat:Dataset." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Deck ;
    sh:property <#formatVersion> ,
                <#dataset> ,
                <#title> ,
                <#description> ,
                <#created> ,
                <#modified> ,
                <#creator> ,
                <#license> ,
                <#studyDirection> ,
                <#noDirection> ,
                <#themes> ,
                <#keywords> ,
                <#distributions> ,
                <#cardsDocument> ,
                <#reviewsDocument> ,
                <#source> ,
                <#noSource> ,
                <#newCardsPerDay> ,
                <#maxReviewsPerDay> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 5 ;
    sh:message "Deck format 5 states its format version, 5."@en ,
               "Kortleksformat 5 anger sin formatversion, 5."@sv .

<#dataset>
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:hasValue dcat:Dataset ;
    sh:message "A format-5 deck is a dcat:Dataset."@en ,
               "En kortlek i format 5 är ett dcat:Dataset."@sv .

<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:message "A deck's title is language-tagged text in any language, one per language (\"…\"@sv)."@en ,
               "En kortleks titel är språktaggad text på valfritt språk, en per språk (\"…\"@sv)."@sv .

<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:message "A deck's description is language-tagged text in any language, one per language (\"…\"@sv)."@en ,
               "En kortleks beskrivning är språktaggad text på valfritt språk, en per språk (\"…\"@sv)."@sv .

<#created>
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .

<#modified>
    a sh:PropertyShape ;
    sh:path dcterms:modified ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:message "A modification time is an xsd:dateTime, like the creation time."@en ,
               "En ändringstid är ett xsd:dateTime, liksom tiden då den skapades."@sv .

<#creator>
    a sh:PropertyShape ;
    sh:path dcterms:creator ;
    sh:nodeKind sh:IRI ;
    sh:message "A creator is a foaf:Agent node (<#agent-…>), never a string literal."@en ,
               "En skapare är en foaf:Agent-nod (<#agent-…>), aldrig en strängliteral."@sv .

<#license>
    a sh:PropertyShape ;
    sh:path dcterms:license ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A licence is an IRI (<https://…>), never a string literal."@en ,
               "En licens är en IRI (<https://…>), aldrig en strängliteral."@sv .

<#studyDirection>
    a sh:PropertyShape ;
    sh:path solid-memo:studyDirection ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:frontToBack solid-memo:backToFront solid-memo:bidirectional ) ;
    sh:message "A format-5 deck states its study direction, a concept of solid-memo:StudyDirections."@en ,
               "En kortlek i format 5 anger sin studieriktning, ett begrepp i solid-memo:StudyDirections."@sv .

<#noDirection>
    a sh:PropertyShape ;
    sh:path solid-memo:direction ;
    sh:maxCount 0 ;
    sh:message "Format 5 states the study direction with solid-memo:studyDirection, not the deprecated solid-memo:direction."@en ,
               "Format 5 anger studieriktningen med solid-memo:studyDirection, inte med den utfasade solid-memo:direction."@sv .

<#themes>
    a sh:PropertyShape ;
    sh:path dcat:theme ;
    sh:nodeKind sh:IRI ;
    sh:message "A theme is a skos:Concept IRI, never a string literal."@en ,
               "Ett tema är en IRI till ett skos:Concept, aldrig en strängliteral."@sv .

<#keywords>
    a sh:PropertyShape ;
    sh:path dcat:keyword ;
    sh:datatype xsd:string .

<#distributions>
    a sh:PropertyShape ;
    sh:path dcat:distribution ;
    sh:nodeKind sh:IRI .

<#cardsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:cardsDocument ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#reviewsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewsDocument ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#source>
    a sh:PropertyShape ;
    sh:path prov:wasDerivedFrom ;
    sh:name "source" ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "In a pod, a deck is derived from at most one library release: the one it was imported from."@en ,
               "I en Pod härstammar en kortlek från högst en biblioteksutgåva: den som den importerades från."@sv .

<#newCardsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:deckNewCardsPerDay ;
    sh:name "newCardsPerDay" ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxCount 1 ;
    sh:message "A deck's new cards per day is one whole number, 0 or more."@en ,
               "En kortleks antal nya kort per dag är ett heltal, 0 eller mer."@sv .

<#maxReviewsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:deckMaxReviewsPerDay ;
    sh:name "maxReviewsPerDay" ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxCount 1 ;
    sh:message "A deck's max reviews per day is one whole number, 0 or more."@en ,
               "En kortleks högsta antal repetitioner per dag är ett heltal, 0 eller mer."@sv .

<#noSource>
    a sh:PropertyShape ;
    sh:path dcterms:source ;
    sh:maxCount 0 ;
    sh:message "A format-5 deck names what it is drawn from with prov:wasDerivedFrom: dcterms:source is for datasets described alongside."@en ,
               "En kortlek i format 5 anger vad den bygger på med prov:wasDerivedFrom: dcterms:source är för datamängder som beskrivs bredvid."@sv .
