@base <https://solid-memo.com/ns/shapes/deck/v1.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# Deck format 1: a title and, in a pod, the links to the deck's two
# documents. The same deck entry is shaped two ways: as a subject of an
# instance's catalog (<#inPod>) and as a deck-library document
# (<#inLibrary>), which has no pod documents and may list its sources.
<#inPod>
    a sh:NodeShape ;
    sh:name "DeckV1" ;
    rdfs:comment "Deck format 1 as a catalog entry in a pod." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Deck ;
    sh:property <#formatVersion> ,
                <#title> ,
                <#created> ,
                <#creator> ,
                <#license> ,
                <#description> ,
                <#cardsDocument> ,
                <#reviewsDocument> ,
                <#source> .

<#inLibrary>
    a sh:NodeShape ;
    sh:name "LibraryDeckV1" ;
    rdfs:comment "Deck format 1 as a deck-library document." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Deck ;
    sh:property <#formatVersion> ,
                <#title> ,
                <#created> ,
                <#creator> ,
                <#license> ,
                <#description> ,
                <#noCardsDocument> ,
                <#noReviewsDocument> ,
                <#sources> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:in ( 1 ) ;
    sh:message "Deck format 1 states no format version, or 1."@en ,
               "Kortleksformat 1 anger ingen formatversion, eller 1."@sv .

<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#created>
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .

<#creator>
    a sh:PropertyShape ;
    sh:path dcterms:creator ;
    sh:datatype xsd:string .

<#license>
    a sh:PropertyShape ;
    sh:path dcterms:license ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A licence is an IRI (<https://…>), never a string literal."@en ,
               "En licens är en IRI (<https://…>), aldrig en strängliteral."@sv .

<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

<#cardsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:cardsDocument ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#reviewsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewsDocument ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#source>
    a sh:PropertyShape ;
    sh:path dcterms:source ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "In a pod, a deck's source is the one library document it was imported from."@en ,
               "I en Pod är en kortleks källa det enda biblioteksdokument den importerades från."@sv .

<#noCardsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:cardsDocument ;
    sh:maxCount 0 ;
    sh:message "A library deck has no cards document: its cards are in the file."@en ,
               "En bibliotekskortlek har inget kortdokument: dess kort finns i filen."@sv .

<#noReviewsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewsDocument ;
    sh:maxCount 0 ;
    sh:message "A library deck has no reviews document."@en ,
               "En bibliotekskortlek har inget repetitionsdokument."@sv .

<#sources>
    a sh:PropertyShape ;
    sh:path dcterms:source ;
    sh:nodeKind sh:IRI ;
    sh:message "A source is an IRI (<https://…>), never a string literal."@en ,
               "En källa är en IRI (<https://…>), aldrig en strängliteral."@sv .
