@base <https://solid-memo.com/ns/shapes/fsrs-review-state/v1.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# FSRS review-state format 1 (vocabulary 1.21): the FSRS-6 scheduling
# state of one card in one study direction. It is a
# solid-memo:ReviewState, as an SM-2 state is, told apart by its
# scheduler: a subject that states solid-memo:scheduler solid-memo:fsrs6
# is checked against this shape, every other review state against the
# review-state shapes (pickShape in packages/shacl/src/registry.ts). It
# always names its card and direction, so its subject follows no naming
# rule; the app names it #<cardId>@fsrs6 or #<cardId>@back-to-front@fsrs6.
# The previous* snapshot, for resetting the study day, is all four
# triples or none.
<#shape>
    a sh:NodeShape ;
    sh:name "FsrsReviewStateV1" ;
    rdfs:comment "FSRS review-state format 1: an FSRS-6 state of one card in one direction, both named, with its stability, difficulty, due day, first and last review, and an all-or-nothing previous* snapshot." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:ReviewState ;
    sh:xone ( <#noSnapshot> <#fullSnapshot> ) ;
    sh:message "An FSRS-6 review state's previous* snapshot is all four triples (previousStability, previousDifficulty, previousDue, previousLastReviewedAt) or none."@en ,
               "Ett FSRS-6-repetitionstillstånds ögonblicksbild previous* består av alla fyra trippler (previousStability, previousDifficulty, previousDue, previousLastReviewedAt) eller ingen."@sv ;
    sh:property <#formatVersion> ,
                <#scheduler> ,
                <#reviewOf> ,
                <#reviewDirection> ,
                <#stability> ,
                <#difficulty> ,
                <#due> ,
                <#firstReviewedAt> ,
                <#lastReviewedAt> ,
                <#previousStability> ,
                <#previousDifficulty> ,
                <#previousDue> ,
                <#previousLastReviewedAt> .

# The snapshot is all four previous* triples or none of them: a partial
# snapshot could only restore a state that never existed.
<#noSnapshot>
    a sh:NodeShape ;
    sh:property [ sh:path solid-memo:previousStability ; sh:maxCount 0 ] ,
                [ sh:path solid-memo:previousDifficulty ; sh:maxCount 0 ] ,
                [ sh:path solid-memo:previousDue ; sh:maxCount 0 ] ,
                [ sh:path solid-memo:previousLastReviewedAt ; sh:maxCount 0 ] .

<#fullSnapshot>
    a sh:NodeShape ;
    sh:property [ sh:path solid-memo:previousStability ; sh:minCount 1 ] ,
                [ sh:path solid-memo:previousDifficulty ; sh:minCount 1 ] ,
                [ sh:path solid-memo:previousDue ; sh:minCount 1 ] ,
                [ sh:path solid-memo:previousLastReviewedAt ; sh:minCount 1 ] .

# Format 1 states its version too: every state the app writes is stamped.
<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( 1 ) ;
    sh:message "FSRS review-state format 1 states its format version, 1."@en ,
               "Format 1 för FSRS-repetitionstillstånd anger sin formatversion, 1."@sv .

# The fixed value that tells this shape from the review-state shapes:
# the writer stamps it, and a state without it is never checked here.
<#scheduler>
    a sh:PropertyShape ;
    sh:path solid-memo:scheduler ;
    sh:hasValue solid-memo:fsrs6 ;
    sh:maxCount 1 ;
    sh:message "An FSRS-6 review state names its scheduler, solid-memo:fsrs6, and no other."@en ,
               "Ett FSRS-6-repetitionstillstånd anger sin schemaläggare, solid-memo:fsrs6, och ingen annan."@sv .

<#reviewOf>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewOf ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An FSRS-6 review state names exactly one card, an IRI (<…#cardId>), never a string literal."@en ,
               "Ett FSRS-6-repetitionstillstånd anger exakt ett kort, en IRI (<…#cardId>), aldrig en strängliteral."@sv .

<#reviewDirection>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewDirection ;
    sh:name "direction" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:frontToBack solid-memo:backToFront ) ;
    sh:message "An FSRS-6 review state's direction is exactly one of solid-memo:frontToBack or solid-memo:backToFront."@en ,
               "Ett FSRS-6-repetitionstillstånds riktning är exakt en av solid-memo:frontToBack och solid-memo:backToFront."@sv .

<#stability>
    a sh:PropertyShape ;
    sh:path solid-memo:stability ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minExclusive 0 ;
    sh:message "An FSRS-6 review state's stability is one decimal number of days, greater than 0."@en ,
               "Ett FSRS-6-repetitionstillstånds stabilitet är ett decimaltal dagar, större än 0."@sv .

<#difficulty>
    a sh:PropertyShape ;
    sh:path solid-memo:difficulty ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minInclusive 1 ;
    sh:maxInclusive 10 ;
    sh:message "An FSRS-6 review state's difficulty is one decimal number from 1 to 10."@en ,
               "Ett FSRS-6-repetitionstillstånds svårighetsgrad är ett decimaltal från 1 till 10."@sv .

<#due>
    a sh:PropertyShape ;
    sh:path solid-memo:due ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
    sh:message "The due day is a plain \"YYYY-MM-DD\" string."@en ,
               "Förfallodagen är en vanlig sträng \"YYYY-MM-DD\"."@sv .

<#firstReviewedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:firstReviewedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#lastReviewedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:lastReviewedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#previousStability>
    a sh:PropertyShape ;
    sh:path solid-memo:previousStability ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minExclusive 0 ;
    sh:message "The previous stability is one decimal number of days, greater than 0."@en ,
               "Den föregående stabiliteten är ett decimaltal dagar, större än 0."@sv .

<#previousDifficulty>
    a sh:PropertyShape ;
    sh:path solid-memo:previousDifficulty ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minInclusive 1 ;
    sh:maxInclusive 10 ;
    sh:message "The previous difficulty is one decimal number from 1 to 10."@en ,
               "Den föregående svårighetsgraden är ett decimaltal från 1 till 10."@sv .

<#previousDue>
    a sh:PropertyShape ;
    sh:path solid-memo:previousDue ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
    sh:message "The previous due day is a plain \"YYYY-MM-DD\" string."@en ,
               "Den föregående förfallodagen är en vanlig sträng \"YYYY-MM-DD\"."@sv .

<#previousLastReviewedAt>
    a sh:PropertyShape ;
    sh:path solid-memo:previousLastReviewedAt ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .
