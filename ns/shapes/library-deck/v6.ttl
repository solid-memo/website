@base <https://solid-memo.com/ns/shapes/library-deck/v6.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .
@prefix adms:       <http://www.w3.org/ns/adms#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .

# Library deck format 6: one release of a deck, library deck format 5
# (shapes/library-deck/v5.ttl) that may describe its series and its
# publisher in the release document itself, so a release published in a
# pod is whole without an index. Beside the release, the document may hold
# its series (dcat:inSeries, a dcat:DatasetSeries, checked as
# LibraryDeckSeriesV3) and its publisher (dcterms:publisher, a
# foaf:Agent, checked as AgentV1), as the library index holds them for
# this repository's releases. A format-5 reader looks for the series in
# an index only and would find none, hence the new version; the property
# shapes are format 5's. This document is the library deck's own (the
# pod's deck is DeckV6 in shapes/deck/v6.ttl; a draft of a release is
# DraftDeckV1 in shapes/draft-deck/v1.ttl).
#
# As in format 5, the title and description are language-tagged text,
# one per language and one of them English, and the keywords are
# language-tagged, several per language. Each document is one release of
# a deck: it says which series it belongs to, its version and the release
# before it. Classes of values (agents, concepts, licences) are checked by
# the DCAT-AP profile, which is run with the reference data (see
# docs/validation.md). A library release never sets study caps, the caps
# being the learner's.
<#inLibrary>
    a sh:NodeShape ;
    sh:name "LibraryDeckV6" ;
    rdfs:comment "Library deck format 6: one release of a deck, a dcat:Dataset in the deck's series, whose keywords are language-tagged, several per language, and whose series and publisher may be described in the release document itself." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Deck ;
    sh:property <#formatVersion> ,
                <#dataset> ,
                <#title> ,
                <#description> ,
                <#created> ,
                <#modified> ,
                <#issued> ,
                <#creator> ,
                <#publisher> ,
                <#license> ,
                <#studyDirection> ,
                <#noDirection> ,
                <#libraryThemes> ,
                <#keywords> ,
                <#languages> ,
                <#version> ,
                <#versionNotes> ,
                <#inSeries> ,
                <#isVersionOf> ,
                <#previous> ,
                <#previousVersion> ,
                <#libraryDistributions> ,
                <#derivedFrom> ,
                <#noCardsDocument> ,
                <#noReviewsDocument> ,
                <#noSource> ,
                <#noNewCardsPerDay> ,
                <#noMaxReviewsPerDay> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 6 ;
    sh:message "Library deck format 6 states its format version, 6."@en ,
               "Bibliotekskortleksformat 6 anger sin formatversion, 6."@sv .

<#dataset>
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:hasValue dcat:Dataset ;
    sh:message "A format-6 library deck is a dcat:Dataset."@en ,
               "En bibliotekskortlek i format 6 är ett dcat:Dataset."@sv .

<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape <#english> ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
    sh:message "A title is language-tagged text, one per language, and one of them English (\"…\"@en)."@en ,
               "En titel är språktaggad text, en per språk, och en av dem på engelska (\"…\"@en)."@sv .

<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape <#english> ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
    sh:message "A description is language-tagged text, one per language, and one of them English (\"…\"@en), as DCAT-AP asks of every dataset."@en ,
               "En beskrivning är språktaggad text, en per språk, och en av dem på engelska (\"…\"@en), som DCAT-AP kräver av varje datamängd."@sv .

<#english>
    a sh:NodeShape ;
    sh:languageIn ( "en" ) .

<#created>
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .

<#modified>
    a sh:PropertyShape ;
    sh:path dcterms:modified ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:message "A modification time is an xsd:dateTime, like the creation time."@en ,
               "En ändringstid är ett xsd:dateTime, liksom tiden då den skapades."@sv .

<#issued>
    a sh:PropertyShape ;
    sh:path dcterms:issued ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:message "A release time is an xsd:dateTime."@en ,
               "En utgivningstid är ett xsd:dateTime."@sv .

<#creator>
    a sh:PropertyShape ;
    sh:path dcterms:creator ;
    sh:nodeKind sh:IRI ;
    sh:message "A creator is a foaf:Agent node (<#agent-…>), never a string literal."@en ,
               "En skapare är en foaf:Agent-nod (<#agent-…>), aldrig en strängliteral."@sv .

<#publisher>
    a sh:PropertyShape ;
    sh:path dcterms:publisher ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A library deck names its publisher, a foaf:Agent."@en ,
               "En bibliotekskortlek anger sin utgivare, en foaf:Agent."@sv .

<#license>
    a sh:PropertyShape ;
    sh:path dcterms:license ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A licence is an IRI (<https://…>), never a string literal."@en ,
               "En licens är en IRI (<https://…>), aldrig en strängliteral."@sv .

<#studyDirection>
    a sh:PropertyShape ;
    sh:path solid-memo:studyDirection ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:frontToBack solid-memo:backToFront solid-memo:bidirectional ) ;
    sh:message "A format-6 library deck states its study direction, a concept of solid-memo:StudyDirections."@en ,
               "En bibliotekskortlek i format 6 anger sin studieriktning, ett begrepp i solid-memo:StudyDirections."@sv .

<#noDirection>
    a sh:PropertyShape ;
    sh:path solid-memo:direction ;
    sh:maxCount 0 ;
    sh:message "Library deck format 6 states the study direction with solid-memo:studyDirection, not the deprecated solid-memo:direction."@en ,
               "Bibliotekskortleksformat 6 anger studieriktningen med solid-memo:studyDirection, inte med den utfasade solid-memo:direction."@sv .

<#libraryThemes>
    a sh:PropertyShape ;
    sh:path dcat:theme ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:hasValue <http://publications.europa.eu/resource/authority/data-theme/EDUC> ;
    sh:message "A library deck has the EU data theme EDUC (education) among its themes."@en ,
               "En bibliotekskortlek har EU:s datatema EDUC (utbildning) bland sina teman."@sv .

<#keywords>
    a sh:PropertyShape ;
    sh:path dcat:keyword ;
    sh:datatype rdf:langString ;
    sh:message "A library deck's keyword is language-tagged text (\"…\"@sv), several per language."@en ,
               "En bibliotekskortleks nyckelord är språktaggad text (\"…\"@sv), flera per språk."@sv .

<#languages>
    a sh:PropertyShape ;
    sh:path dcterms:language ;
    sh:nodeKind sh:IRI ;
    sh:message "A language is an EU authority-table IRI, never a string literal."@en ,
               "Ett språk är en IRI ur EU:s auktoritetstabeller, aldrig en strängliteral."@sv .

<#version>
    a sh:PropertyShape ;
    sh:path dcat:version ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^[1-9][0-9]*$" ;
    sh:message "A release states its version: 1, 2, …"@en ,
               "En utgåva anger sin version: 1, 2, …"@sv .

<#versionNotes>
    a sh:PropertyShape ;
    sh:path adms:versionNotes ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

<#inSeries>
    a sh:PropertyShape ;
    sh:path dcat:inSeries ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A release belongs to its deck's series."@en ,
               "En utgåva hör till sin kortleks serie."@sv .

<#isVersionOf>
    a sh:PropertyShape ;
    sh:path dcat:isVersionOf ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A release is a version of its deck's series."@en ,
               "En utgåva är en version i sin kortleks serie."@sv .

<#previous>
    a sh:PropertyShape ;
    sh:path dcat:prev ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 .

<#previousVersion>
    a sh:PropertyShape ;
    sh:path dcat:previousVersion ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 .

<#libraryDistributions>
    a sh:PropertyShape ;
    sh:path dcat:distribution ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "A release has a distribution: its Turtle file."@en ,
               "En utgåva har en distribution: sin Turtle-fil."@sv .

<#derivedFrom>
    a sh:PropertyShape ;
    sh:path prov:wasDerivedFrom ;
    sh:nodeKind sh:IRI ;
    sh:message "A source the deck is drawn from is an IRI (<https://…>), never a string literal."@en ,
               "En källa som kortleken bygger på är en IRI (<https://…>), aldrig en strängliteral."@sv .

<#noCardsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:cardsDocument ;
    sh:maxCount 0 ;
    sh:message "A library deck has no cards document: its cards are in the file."@en ,
               "En bibliotekskortlek har inget kortdokument: dess kort finns i filen."@sv .

<#noReviewsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewsDocument ;
    sh:maxCount 0 ;
    sh:message "A library deck has no reviews document."@en ,
               "En bibliotekskortlek har inget repetitionsdokument."@sv .

<#noSource>
    a sh:PropertyShape ;
    sh:path dcterms:source ;
    sh:maxCount 0 ;
    sh:message "A format-6 library deck names what it is drawn from with prov:wasDerivedFrom: dcterms:source is for datasets described alongside."@en ,
               "En bibliotekskortlek i format 6 anger vad den bygger på med prov:wasDerivedFrom: dcterms:source är för datamängder som beskrivs bredvid."@sv .

<#noNewCardsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:deckNewCardsPerDay ;
    sh:maxCount 0 ;
    sh:message "A library deck sets no study caps: they are the learner's."@en ,
               "En bibliotekskortlek anger inga studiegränser: dem bestämmer den som studerar."@sv .

<#noMaxReviewsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:deckMaxReviewsPerDay ;
    sh:maxCount 0 ;
    sh:message "A library deck sets no study caps: they are the learner's."@en ,
               "En bibliotekskortlek anger inga studiegränser: dem bestämmer den som studerar."@sv .
