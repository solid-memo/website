@base <https://solid-memo.com/ns/shapes/preferences/v6.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# Preferences format 6 (vocabulary 1.22): format 5 plus the palette,
# a concept of solid-memo:Palettes, and the text size, a concept of
# solid-memo:TextSizes. The palette lists no concepts: a later palette,
# or one of the user's own, needs no new format, and a reader that does
# not know it keeps it and shows the standard colors.
<#shape>
    a sh:NodeShape ;
    sh:name "PreferencesV6" ;
    rdfs:comment "Preferences format 6: every field required, the palette and the text size among them." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Preferences ;
    sh:property <#formatVersion> ,
                <#newCardsPerDay> ,
                <#maxReviewsPerDay> ,
                <#dayBoundaryHour> ,
                <#answerScale> ,
                <#developerMode> ,
                <#invalidDataPolicy> ,
                <#theme> ,
                <#scheduler> ,
                <#desiredRetention> ,
                <#schedulerInvitationDismissed> ,
                <#palette> ,
                <#textSize> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 6 ;
    sh:message "Preferences format 6 states its format version, 6."@en ,
               "Inställningsformat 6 anger sin formatversion, 6."@sv .

<#newCardsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:newCardsPerDay ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#maxReviewsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:maxReviewsPerDay ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#dayBoundaryHour>
    a sh:PropertyShape ;
    sh:path solid-memo:dayBoundaryHour ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxInclusive 23 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The day boundary is an hour of the day, 0 to 23."@en ,
               "Dagens början är en timme på dygnet, 0 till 23."@sv .

<#answerScale>
    a sh:PropertyShape ;
    sh:path solid-memo:answerScale ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "sm2" "minimal" ) ;
    sh:message "The answer scale is sm2 or minimal."@en ,
               "Svarsskalan är sm2 eller minimal."@sv .

<#developerMode>
    a sh:PropertyShape ;
    sh:path solid-memo:developerMode ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#invalidDataPolicy>
    a sh:PropertyShape ;
    sh:path solid-memo:invalidDataPolicy ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:blockInstance solid-memo:blockSubject solid-memo:warnOnly ) ;
    sh:message "Preferences state what to do with invalid data: a concept of solid-memo:InvalidDataPolicies."@en ,
               "Inställningarna anger vad som ska göras med ogiltig data: ett begrepp i solid-memo:InvalidDataPolicies."@sv .

<#theme>
    a sh:PropertyShape ;
    sh:path solid-memo:theme ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:systemTheme solid-memo:lightTheme solid-memo:darkTheme ) ;
    sh:message "Preferences state the theme: a concept of solid-memo:Themes."@en ,
               "Inställningarna anger temat: ett begrepp i solid-memo:Themes."@sv .

<#scheduler>
    a sh:PropertyShape ;
    sh:path solid-memo:studyScheduler ;
    sh:name "scheduler" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:sm2 solid-memo:fsrs6 ) ;
    sh:message "Preferences state the scheduler that sets the due days: solid-memo:sm2 or solid-memo:fsrs6."@en ,
               "Inställningarna anger schemaläggaren som bestämmer förfallodagarna: solid-memo:sm2 eller solid-memo:fsrs6."@sv .

<#desiredRetention>
    a sh:PropertyShape ;
    sh:path solid-memo:desiredRetention ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.7 ;
    sh:maxInclusive 0.97 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The desired retention is one decimal share from 0.7 to 0.97."@en ,
               "Önskad retention är en decimal andel från 0,7 till 0,97."@sv .

<#schedulerInvitationDismissed>
    a sh:PropertyShape ;
    sh:path solid-memo:schedulerInvitationDismissed ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Preferences state whether the invitation to switch to FSRS-6 was dismissed: true or false."@en ,
               "Inställningarna anger om inbjudan att byta till FSRS-6 har avböjts: true eller false."@sv .

<#palette>
    a sh:PropertyShape ;
    sh:path solid-memo:palette ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Preferences state the palette: one IRI, a concept of solid-memo:Palettes or another palette."@en ,
               "Inställningarna anger färgpaletten: en IRI, ett begrepp i solid-memo:Palettes eller en annan palett."@sv .

<#textSize>
    a sh:PropertyShape ;
    sh:path solid-memo:textSize ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:defaultTextSize solid-memo:largeTextSize solid-memo:largerTextSize solid-memo:largestTextSize ) ;
    sh:message "Preferences state the text size: a concept of solid-memo:TextSizes."@en ,
               "Inställningarna anger textstorleken: ett begrepp i solid-memo:TextSizes."@sv .
