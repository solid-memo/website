@base <https://solid-memo.com/ns/shapes/preferences/v4.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# Preferences format 4: format 3 plus the theme the app is shown in, a
# concept of solid-memo:Themes.
<#shape>
    a sh:NodeShape ;
    sh:name "PreferencesV4" ;
    rdfs:comment "Preferences format 4: every field required, the theme among them." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Preferences ;
    sh:property <#formatVersion> ,
                <#newCardsPerDay> ,
                <#maxReviewsPerDay> ,
                <#dayBoundaryHour> ,
                <#answerScale> ,
                <#developerMode> ,
                <#invalidDataPolicy> ,
                <#theme> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 4 ;
    sh:message "Preferences format 4 states its format version, 4."@en ,
               "Inställningsformat 4 anger sin formatversion, 4."@sv .

<#newCardsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:newCardsPerDay ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#maxReviewsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:maxReviewsPerDay ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#dayBoundaryHour>
    a sh:PropertyShape ;
    sh:path solid-memo:dayBoundaryHour ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxInclusive 23 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The day boundary is an hour of the day, 0 to 23."@en ,
               "Dagens början är en timme på dygnet, 0 till 23."@sv .

<#answerScale>
    a sh:PropertyShape ;
    sh:path solid-memo:answerScale ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "sm2" "minimal" ) ;
    sh:message "The answer scale is sm2 or minimal."@en ,
               "Svarsskalan är sm2 eller minimal."@sv .

<#developerMode>
    a sh:PropertyShape ;
    sh:path solid-memo:developerMode ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#invalidDataPolicy>
    a sh:PropertyShape ;
    sh:path solid-memo:invalidDataPolicy ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:blockInstance solid-memo:blockSubject solid-memo:warnOnly ) ;
    sh:message "Preferences state what to do with invalid data: a concept of solid-memo:InvalidDataPolicies."@en ,
               "Inställningarna anger vad som ska göras med ogiltig data: ett begrepp i solid-memo:InvalidDataPolicies."@sv .

<#theme>
    a sh:PropertyShape ;
    sh:path solid-memo:theme ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:systemTheme solid-memo:lightTheme solid-memo:darkTheme ) ;
    sh:message "Preferences state the theme: a concept of solid-memo:Themes."@en ,
               "Inställningarna anger temat: ett begrepp i solid-memo:Themes."@sv .
