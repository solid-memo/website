@base <https://solid-memo.com/ns/shapes/document-receipt/v1.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# A document receipt, format 1: in the instance's digest document, what
# the app found one instance document to be at one version (ETag).
<#shape>
    a sh:NodeShape ;
    sh:name "DocumentReceiptV1" ;
    rdfs:comment "Document receipt format 1: the document and its version; that it conformed to the shapes (under named rules), and that nothing in it was in an older format, each when so." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:DocumentReceipt ;
    sh:property <#formatVersion> ,
                <#document> ,
                <#version> ,
                <#conformedTo> ,
                <#latestFormat> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:in ( 1 ) .

<#document>
    a sh:PropertyShape ;
    sh:path solid-memo:receiptOf ;
    sh:name "document" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#version>
    a sh:PropertyShape ;
    sh:path solid-memo:documentVersion ;
    sh:name "version" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#conformedTo>
    a sh:PropertyShape ;
    sh:path solid-memo:conformedTo ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

<#latestFormat>
    a sh:PropertyShape ;
    sh:path solid-memo:latestFormat ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .
