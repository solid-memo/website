@base <https://solid-memo.com/ns/shapes/deck-series/v1.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .

# A deck of the library across its releases: a dataset series whose
# members are the releases, which are also its versions. It is typed
# dcat:Dataset too (DCAT 3 makes a series a dataset, and SHACL checks
# only stated types). Subjects of the library index, never of a pod.
<#inLibrary>
    a sh:NodeShape ;
    sh:name "LibraryDeckSeriesV1" ;
    rdfs:comment "A library deck across its releases: a dcat:DatasetSeries." ;
    sh:nodeKind sh:IRI ;
    sh:class dcat:DatasetSeries ;
    sh:property <#formatVersion> ,
                <#dataset> ,
                <#title> ,
                <#description> ,
                <#publisher> ,
                <#themes> ,
                <#keywords> ,
                <#first> ,
                <#last> ,
                <#versions> ,
                <#currentVersion> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:in ( 1 ) .

<#dataset>
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:hasValue dcat:Dataset ;
    sh:message "A deck series is a dcat:Dataset too."@en ,
               "En kortleksserie är också ett dcat:Dataset."@sv .

<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#publisher>
    a sh:PropertyShape ;
    sh:path dcterms:publisher ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#themes>
    a sh:PropertyShape ;
    sh:path dcat:theme ;
    sh:nodeKind sh:IRI .

<#keywords>
    a sh:PropertyShape ;
    sh:path dcat:keyword ;
    sh:datatype xsd:string .

<#first>
    a sh:PropertyShape ;
    sh:path dcat:first ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#last>
    a sh:PropertyShape ;
    sh:path dcat:last ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#versions>
    a sh:PropertyShape ;
    sh:path dcat:hasVersion ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "A deck series lists every release as a version."@en ,
               "En kortleksserie listar varje utgåva som en version."@sv .

<#currentVersion>
    a sh:PropertyShape ;
    sh:path dcat:hasCurrentVersion ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A deck series names its current release."@en ,
               "En kortleksserie anger sin aktuella utgåva."@sv .
