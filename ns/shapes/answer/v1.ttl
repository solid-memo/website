@base <https://solid-memo.com/ns/shapes/answer/v1.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# An answer, format 1: an entry of the instance's answer log, one grade
# given to one prompt during study.
<#shape>
    a sh:NodeShape ;
    sh:name "AnswerV1" ;
    rdfs:comment "Answer format 1: the deck and card answered, the way it was asked, the SM-2 grade, when it was given and the study day it counts towards, and the prompt's interval before (absent on its first answer) and after." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Answer ;
    sh:property <#formatVersion> ,
                <#deck> ,
                <#card> ,
                <#direction> ,
                <#grade> ,
                <#answeredAt> ,
                <#studyDay> ,
                <#priorIntervalDays> ,
                <#nextIntervalDays> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:in ( 1 ) .

<#deck>
    a sh:PropertyShape ;
    sh:path solid-memo:answeredDeck ;
    sh:name "deck" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An answer names the deck it was given in, an IRI."@en ,
               "Ett svar anger kortleken det gavs i, en IRI."@sv .

<#card>
    a sh:PropertyShape ;
    sh:path solid-memo:answeredCard ;
    sh:name "card" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An answer names the card it was given to, an IRI."@en ,
               "Ett svar anger kortet det gavs till, en IRI."@sv .

<#direction>
    a sh:PropertyShape ;
    sh:path solid-memo:answeredDirection ;
    sh:name "direction" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:frontToBack solid-memo:backToFront ) ;
    sh:message "An answer states the way the card was asked: solid-memo:frontToBack or solid-memo:backToFront."@en ,
               "Ett svar anger hur kortet frågades: solid-memo:frontToBack eller solid-memo:backToFront."@sv .

<#grade>
    a sh:PropertyShape ;
    sh:path solid-memo:grade ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxInclusive 5 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An answer's grade is one whole number, 0 to 5."@en ,
               "Ett svars betyg är ett heltal, 0 till 5."@sv .

<#answeredAt>
    a sh:PropertyShape ;
    sh:path solid-memo:answeredAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An answer states when it was given, one xsd:dateTime."@en ,
               "Ett svar anger när det gavs, ett xsd:dateTime."@sv .

<#studyDay>
    a sh:PropertyShape ;
    sh:path solid-memo:answeredOn ;
    sh:name "studyDay" ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The study day an answer counts towards is a plain \"YYYY-MM-DD\" string."@en ,
               "Studiedagen som ett svar räknas till är en vanlig sträng \"YYYY-MM-DD\"."@sv .

<#priorIntervalDays>
    a sh:PropertyShape ;
    sh:path solid-memo:priorIntervalDays ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxCount 1 ;
    sh:message "An interval is one whole number of days, 0 or more."@en ,
               "Ett intervall är ett heltal dagar, 0 eller fler."@sv .

<#nextIntervalDays>
    a sh:PropertyShape ;
    sh:path solid-memo:nextIntervalDays ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An interval is one whole number of days, 0 or more."@en ,
               "Ett intervall är ett heltal dagar, 0 eller fler."@sv .
