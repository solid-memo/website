@base <https://solid-memo.com/ns/shapes/backup-entry/v1.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/ns/vocab/v1.ttl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# A backup entry, format 1: in a backup's manifest, one document the
# update was to change, where its bytes are kept, the Content-Type and
# version they were served with, and the version the update left it at.
<#shape>
    a sh:NodeShape ;
    sh:name "BackupEntryV1" ;
    rdfs:comment "Backup entry format 1: the document; where its bytes are kept, and the Content-Type and version they were served with, unless there was no document; the version the update left it at, once it wrote it." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:BackupEntry ;
    sh:property <#formatVersion> ,
                <#document> ,
                <#copy> ,
                <#contentType> ,
                <#versionBackedUp> ,
                <#versionUpdated> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:in ( 1 ) .

<#document>
    a sh:PropertyShape ;
    sh:path solid-memo:backedUpDocument ;
    sh:name "document" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#copy>
    a sh:PropertyShape ;
    sh:path solid-memo:backupCopy ;
    sh:name "copy" ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 .

<#contentType>
    a sh:PropertyShape ;
    sh:path solid-memo:contentTypeBackedUp ;
    sh:name "contentType" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

<#versionBackedUp>
    a sh:PropertyShape ;
    sh:path solid-memo:versionBackedUp ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

<#versionUpdated>
    a sh:PropertyShape ;
    sh:path solid-memo:versionUpdated ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .
